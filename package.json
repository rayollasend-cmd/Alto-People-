{
  "name": "alto-people",
  "private": true,
  "version": "0.1.0",
  "description": "Alto People — workforce management HR platform for Alto Etho LLC",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm -w @alto-people/shared run build",
    "dev": "concurrently -n shared,web,api -c yellow,blue,green \"npm -w @alto-people/shared run dev\" \"npm -w apps/web run dev\" \"npm -w apps/api run dev\"",
    "dev:web": "npm -w apps/web run dev",
    "dev:api": "npm -w apps/api run dev",
    "build": "turbo run build --concurrency=1",
    "build:web": "turbo run build --filter=@alto-people/web",
    "build:api": "turbo run build --filter=@alto-people/api",
    "build:shared": "turbo run build --filter=@alto-people/shared",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint lint:design lint:i18n",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm -w apps/api run db:migrate",
    "db:seed": "npm -w apps/api run db:seed",
    "db:studio": "npm -w apps/api run db:studio",
    "test": "turbo run test --concurrency=1",
    "test:shared": "turbo run test --filter=@alto-people/shared",
    "test:api": "turbo run test --filter=@alto-people/api",
    "test:web": "turbo run test --filter=@alto-people/web",
    "clean": "rimraf \"apps/*/dist\" \"packages/*/dist\" \"apps/*/node_modules\" \"packages/*/node_modules\" node_modules .turbo \"apps/*/.turbo\" \"packages/*/.turbo\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "rimraf": "^5.0.10",
    "turbo": "^2.11.8",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "node-fetch": "^2.7.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    }
  }
}
