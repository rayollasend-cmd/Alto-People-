# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# TypeScript-emitted artifacts from Vite config compilation
apps/web/vite.config.js
apps/web/vite.config.d.ts

# Env
.env
.env.local
.env.*.local
.env.test

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Vite
*.local

# Document storage (Phase 9 — local fs; S3 in production)
apps/api/uploads/

# Generated sample EFW2/EFW2C files for AccuWage validation (script output)
apps/api/scripts/output/

# Face-api.js model weights — downloaded at build time by
# apps/web/scripts/fetch-face-models.mjs; ~6.5MB of binary data
# we don't need to track.
apps/web/public/face-models/

# Local Claude Code agent state
.claude/*
# Project skills are shared with every Claude Code session on this repo;
# local settings and locks stay out.
!.claude/skills/

# Turborepo: the local task cache (.turbo/cache) and per-package run logs
.turbo/

# Storybook static build (npm -w apps/web run build-storybook)
storybook-static/
build-storybook.log

# Lighthouse CI working dir (npm -w apps/web run lhci); reports land in
# apps/web/e2e-results/lighthouse
.lighthouseci/

# Playwright artifacts
apps/web/e2e-results/

# Quota-window triage output — names, emails and phone numbers of people
# whose mail failed. Read it, work it, delete it; it never belongs in git.
quota-triage/
apps/api/quota-triage/
