      "size": -1,
      "text": "{\"requests\":[{\"id\":\"da7a7011-e5bf-44f8-8d55-0fb66ee8f2a9\",\"kind\":\"STAFFING\",\"subject\":\"One more in receiving for Saturday’s truck\",\"body\":\"The holiday freight lands Saturday morning. Can we have an extra person in receiving from 6 to 10?\",\"status\":\"RESOLVED\",\"resolution\":\"Added Carlos Mendoza to receiving Saturday 6–10 AM; he has confirmed.\",\"createdAt\":\"2026-10-23T16:29:06.294Z\",\"resolvedAt\":\"2026-10-23T21:29:06.294Z\",\"dueAt\":\"2026-10-24T16:29:06.294Z\",\"desk\":\"Workforce desk\",\"owner\":\"Dana\",\"associateId\":null,\"associateName\":null,\"overdue\":false},{\"id\":\"e4d756b2-c63f-44b2-a276-2c470a3ca645\",\"kind\":\"STAFFING\",\"subject\":\"Two more overnight stockers for Friday\",\"body\":\"Truck volume is up — we need two more on the overnight this Friday, 10 PM start.\",\"status\":\"RESOLVED\",\"resolution\":\"Done — two overnight stockers added for Friday; both confirmed on the schedule.\",\"createdAt\":\"2026-09-18T18:58:42.922Z\",\"resolvedAt\":\"2026-09-19T13:58:42.922Z\",\"dueAt\":\"2026-09-20T20:58:42.922Z\",\"desk\":\"Workforce desk\",\"owner\":\"Dana\",\"associateId\":null,\"associateName\":null,\"overdue\":false}]}"
