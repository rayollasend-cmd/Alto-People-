      "text": "{\"total\":5,\"sources\":[{\"key\":\"access-certifications\",\"label\":\"Access to certify\",\"description\":\"Accounts in an open access certification waiting on your decision.\",\"count\":0,\"path\":\"/admin/access-certifications\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"policies-to-sign\",\"label\":\"Policies to sign\",\"description\":\"Policies sent to you that are waiting for your signature.\",\"count\":0,\"path\":\"/agreements?tab=policies\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"my-agreements\",\"label\":\"Agreements to sign\",\"description\":\"Agreements waiting for your signature.\",\"count\":0,\"path\":\"/agreements\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"my-documents\",\"label\":\"Documents needing attention\",\"description\":\"Documents that expired, were sent back, or expire within 60 days.\",\"count\":0,\"path\":\"/documents\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"my-pay-notices\",\"label\":\"Pay notice to sign\",\"description\":\"A written notice of your pay rate and payday that state law asks you to sign.\",\"count\":0,\"path\":\"/me/pay-notices\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"my-punch-fixes\",\"label\":\"Punches to fix\",\"description\":\"A shift you didn’t clock out of — tell us when you left.\",\"count\":0,\"path\":\"/time-attendance?fix=1\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"my-ot-offers\",\"label\":\"Extra hours offered\",\"description\":\"Open shifts offered to you — take them or pass.\",\"count\":0,\"path\":\"/time-attendance?tab=offers\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"my-shifts\",\"label\":\"Shifts to confirm\",\"description\":\"Upcoming shifts you have not confirmed yet.\",\"count\":3,\"path\":\"/scheduling\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"my-training\",\"label\":\"Training due\",\"description\":\"Required courses not yet complete, and certifications that expire within 30 days.\",\"count\":0,\"path\":\"/l