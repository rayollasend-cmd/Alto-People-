      "text": "{\"notifications\":[{\"id\":\"6ea42e62-072e-4bb5-b99e-c04eb6bc505d\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"a1d462f4-30e0-4f9d-af3f-d4f36d3f68da\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"An open shift fits your availability\",\"body\":\"Wed, Oct 28, 2:00 PM at Front Beach 218 is open. If you'd like the hours, it's yours to pick up — no need to answer otherwise.\\n\\nSent by Hugo on WhatsApp, an AI agent — admin@altohr.com answers for it.\",\"category\":\"hugo_note\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-10-26T14:32:04.614Z\",\"readAt\":null,\"seenAt\":null,\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/marketplace?shift=da7a7011-a277-43fe-878b-ec6e29a561a8\",\"createdAt\":\"2026-10-26T14:32:04.615Z\"},{\"id\":\"c39c7c83-f542-4f6e-b46c-ed259e270d22\",\"channel\":\"IN_APP\",\"status\":\"QUEUED\",\"recipientUserId\":\"a1d462f4-30e0-4f9d-af3f-d4f36d3f68da\",\"recipientPhone\":null,\"recipientEmail\":\"maria.lopez@example.com\",\"subject\":\"Shift reminder\",\"body\":\"You're scheduled soon: Cashier at Coastal Resort Holdings · Tue, Oct 27, 6:00 AM–2:00 PM\",\"category\":\"shift_reminder\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":null,\"readAt\":null,\"seenAt\":null,\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/scheduling\",\"createdAt\":\"2026-10-26T14:32:04.571Z\"},{\"id\":\"15bba263-a923-4a77-85e3-1ece2b4c876c\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"a1d462f4-30e0-4f9d-af3f-d4f36d3f68da\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"[Reminder] 5 onboarding tasks still open — Seaside Hospitality Group\",\"body\":\"Hi Maria,\\n\\nYour onboarding for Seaside Hospitality Group is 38% complete, but nothing has moved in 3 days. Still outstanding:\\n\\n  • Complete profile information\\n  • Take your profile photo\\n  • W-4 tax withholding\\n  • Set up direct deposit or Branch card\\n  • Acknowledge company policies\",\"category\":\"onboarding.progress_reminder\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-10-25T19:16:53.657Z\",\"readAt\":null,\"seenAt\":null,\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/onboarding/me/b61916e8-8afc-454d-b01b-75c0fe7ed396\",\"createdAt\":\"2026-10-25T19:16:53.657Z\"},{\"id\":\"e0dcefa6-2e2c-493b-b296-d4749219c18a\",\"channel\":\"IN_APP\",\"status\":\"READ\",\"recipientUserId\":\"a1d462f4-30e0-4f9d-af3f-d4f36d3f68da\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"[Reminder] 8 onboarding tasks still open — Seaside Hospitality Group\",\"body\":\"Hi Maria,\\n\\nYour onboarding for Seaside Hospitality Group is 0% complete, but nothing has moved in 33 days. Still outstanding:\\n\\n  • Complete profile information\\n  • Take your profile photo\\n  • Upload identity documents\\n  • I-9 employment eligibility\\n  • W-4 tax withholding\\n  • Set up direct deposit or Branch card\\n  • Acknowledge company policies\\n  • Sign Associate Employment Agreement\",\"category\":\"onboarding.progress_reminder\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-10-22T16:21:54.913Z\",\"readAt\":\"2026-10-22T20:40:35.041Z\",\"seenAt\":\"2026-10-22T20:40:35.041Z\",\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/onboarding/me/b61916e8-8afc-454d-b01b-75c0fe7ed396\",\"createdAt\":\"2026-10-22T16:21:54.914Z\"},{\"id\":\"21ab680f-f934-4997-901e-85b7b345d90e\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"a1d462f4-30e0-4f9d-af3f-d4f36d3f68da\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"[Reminder] 8 onboarding tasks still open — Seaside Hospitality Group\",\"body\":\"Hi Maria,\\n\\nYour onboarding for Seaside Hospitality Group is 0% complete, but nothing has moved in 31 days. Still outstanding:\\n\\n  • Complete profile information\\n  • Take your profile photo