     "content": {
      "mimeType": "application/json; charset=utf-8",
      "size": -1,
      "text": "{\"settings\":{\"fareCents\":500,\"noShowFeeCents\":100,\"cutoffHours\":10,\"shortNoticeMinutes\":90,\"dispatchPhone\":null,\"driverMaxHoursPerDay\":10,\"driverMinRestHours\":8,\"preTripRequired\":true,\"driverShiftLocationId\":null},\"consent\":null,\"authorization\":{\"current\":false,\"signedAt\":null,\"signedName\":null,\"version\":null,\"fareCents\":null,\"noShowFeeCents\":null,\"withdrawnAt\":null,\"documentId\":null,\"reason\":\"No signed authorization on file.\",\"agreement\":{\"title\":\"Authorization for van ride charges\",\"body\":\"I ask Alto HR to provide van rides between my home or pickup point and my work site, and I authorize the charges below to be deducted from my pay.\\n\\n1. The charge for each ride I board is $5.00. If I book a ride, the driver arrives at the pickup point, waits at least three minutes, and I do not board, the no-show fee is $1.00. A ride I cancel before the driver arrives costs nothing. A ride cancelled by Alto HR costs nothing.\\n2. Charges are deducted from the paycheck for the pay period in which the ride took place, or the next one. Each charge is listed on my pay statement with the number of rides and missed rides it covers.\\n3. No deduction will reduce my pay for any workweek below the applicable minimum wage. If a charge would, only the part that keeps my pay at or above the minimum wage is deducted in that period and the rest is carried to a later period, and my pay statement says so.\\n4. These are the only amounts this authorization covers. If the rate changes, no ride is charged at the new rate until I have signed a new authorization that names it.\\n5. If I board a ride at a time no signed authorization covers it — for example after a rate change, before I sign again — the charge for that ride is held, not waived. It is deducted only after I sign this authorization, at the price the ride was booked at, and item 3 applies to it.\\n6. I may withdraw this authorization at any time in the app or in writing. Rides already taken are still charged; no new ride is booked after I withdraw.\\n7. Rides are voluntary. Whether I use the van has no effect on my employment, my schedule or my pay.\\n\\nI have read this authorization in a language I understand. By typing my name below I sign it.\",\"version\":2,\"lang\":\"en\",\"fareCents\":500,\"noShowFeeCents\":100}},\"places\":[{\"id\":\"7f179a6c-3851-41e9-b6d3-1a01549b6bb0\",\"label\":\"Home\",\"address\":\"218 Beachview Ave, Panama City Beach, FL 32413\",\"lat\":null,\"lng\":null,\"located\":false}],\"stops\":[{\"id\":\"a98f04b7-6040-4028-9f42-2aa1afd24f78\",\"name\":\"Gulf Pines Apartments\",\"address\":\"7209 Thomas Dr, Panama City Beach, FL 32408\"},{\"id\":\"62b690c2-17f5-4d10-b94a-6c867e9d0d77\",\"name\":\"Seaside Housing\",\"address\":\"17751 Panama City Beach Pkwy, Panama City Beach, FL 32413\"}],\"stores\":[{\"id\":\"d9ce5bd1-a062-4a1a-9b69-a33677377b69\",\"name\":\"Front Beach 218\",\"timezone\":\"America/Chicago\",\"clientName\":\"Coastal Resort Holdings\",\"address\":\"15495 Panama City Beach Pkwy, Panama City Beach, FL\",\"mine\":false,\"windows\":[{\"label\":\"Morning\",\"startMinute\":360,\"endMinute\":840},{\"label\":\"Swing\",\"startMinute\":840,\"endMinute\":1320},{\"label\":\"Overnight\",\"startMinute\":1320,\"endMinute\":360}]}],\"shifts\":[],\"rides\":[{\"id\":\"efe3ad55-b385-47e9-ac4d-0ee2c29d9410\",\"direction\":\"FROM_WORK\",\"targetAt\":\"2026-09-19T19:30:00.000Z\",\"serviceDate\":\"2026-09-19\",\"status\":\"REQUESTED\",\"shiftId\":null,\"windowLabel\":null,\"note\":null,\"shortNotice\":false,\"pickup\":{\"kind\":\"address\",\"id\":null,\"name\":null,\"address\":\"1500 NW 7th St, Miami, FL 33125\"},\"point\":{\"lat\":25.7795,\"lng\":-80.2197},\"store\":{\"id\":\"3506aa2b-f44b-4993-91c4-2c79187a03ed\",\"name\":\"Demo Store\",\"timezone\":\"America/New_York\",\"clientId\":\"01bd3699-3ae4-455d-bb1a-519e245f23f9\",\"clientName\":\"Seaside Hospitality Group\"},\"rider\":{\"associateId\":\"beeddd37-d7fc-4