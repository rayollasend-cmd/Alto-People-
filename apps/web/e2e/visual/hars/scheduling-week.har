0Z\"},{\"id\":\"097c4ef9-a919-40bc-b101-da8a65d51251\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-8212-dca6a7ab55ca\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"Store ops today: 1 shift across 1 store\",\"body\":\"Ops digest for 2026-09-18:\\n\\n  • Coastal Resort Holdings: 1 ops shift — 1 still open\\n\\nFull detail: the Store Ops board.\",\"category\":\"ops.digest\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-09-19T00:36:03.882Z\",\"readAt\":\"2026-10-25T14:29:06.294Z\",\"seenAt\":\"2026-10-26T12:59:49.338Z\",\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/ops\",\"createdAt\":\"2026-09-19T00:36:03.882Z\"},{\"id\":\"65f1fd9a-1376-441d-91f7-0e0db028e136\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-8212-dca6a7ab55ca\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"Overdue: General Liability insurance current\",\"body\":\"Compliance attestation for January 2026 is overdue.\\n\\nWalmart MSA Section 7 — General Liability insurance must be in force at all times. Each year, confirm the policy is current and the certificate of insurance has been provided to Walmart. Attach the COI as evidence if available.\\n\\nOpen the Compliance scorecard → Billing & invoicing tile to record when you completed this and confirm the outcome.\",\"category\":\"compliance.attestation.GENERAL_LIABILITY.2026-01-01\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-09-18T21:13:28.940Z\",\"readAt\":\"2026-10-25T14:29:06.294Z\",\"seenAt\":\"2026-10-26T12:59:49.338Z\",\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/compliance?tab=scorecard\",\"createdAt\":\"2026-09-18T21:13:28.941Z\"},{\"id\":\"2f39d5cf-af4f-439c-9b0f-9d52767e1da7\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-8212-dca6a7ab55ca\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"Overdue: OSHA 300A summary posted (Feb 1 – Apr 30)\",\"body\":\"Compliance attestation for January 2026 is overdue.\\n\\nOSHA 1904.32 — certify the prior year’s Form 300A summary and post it at each establishment from February 1 through April 30. Confirm here once posted; attach the signed 300A as evidence if available.\\n\\nOpen the Compliance scorecard → Billing & invoicing tile to record when you completed this and confirm the outcome.\",\"category\":\"compliance.attestation.OSHA_300A_POSTING.2026-01-01\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-09-18T21:13:28.933Z\",\"readAt\":\"2026-10-25T14:29:06.294Z\",\"seenAt\":\"2026-10-26T12:59:49.338Z\",\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/compliance?tab=scorecard\",\"createdAt\":\"2026-09-18T21:13:28.934Z\"},{\"id\":\"05e4bcd6-6517-45ca-aadd-6f988360e19f\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-8212-dca6a7ab55ca\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"Overdue: Workers Comp insurance current\",\"body\":\"Compliance attestation for January 2026 is overdue.\\n\\nWalmart MSA Section 7 — Workers Comp insurance must be in force at all times. Each year, confirm the policy is current and the certificate of insurance has been provided to Walmart. Attach the COI as evidence if available.\\n\\nOpen the Compliance scorecard → Billing & invoicing tile to record when you completed this and confirm the outcome.\",\"category\":\"compliance.attestation.WORKERS_COMP.2026-01-01\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-09-18T21:13:28.921Z\",\"readAt\":\"2026-10-25T14:29:06.294Z\",\"seenAt\":\"2026-10-26T12:59:49.338Z\",\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/compliance?tab=scorecard\",\"createdAt\":\"2026-09-18T21:13:28.922Z\"},{\"id\":\"c5f10822-fce4-425a-8f52-7035b02d5c5e\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-8212-dca6a7ab55ca\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"Overdue: Fieldglass timesheet submitted (Mon 2pm PST)\",\"body\":\"Compliance attestation for the week of 2026-09-14 is overdue.\\n\\nWalmart SOW — Fieldglass timesheet must be submitted by Monday 2pm PST every week. Confirm here once it's filed.\\n\\nOpen the Compliance scorecard → Billing & invoicing tile to record when you completed this and confirm the outcome.\",\"category\":\"compliance.attestation.FIELDGLASS_TIMESHEET.2026-09-14\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-09-18T21:13:28.912Z\",\"readAt\":\"2026-10-25T14:29:06.294Z\",\"seenAt\":\"2026-10-26T12:59:49.338Z\",\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/compliance?tab=scorecard\",\"createdAt\":\"2026-09-18T21:13:28.912Z\"},{\"id\":\"056172c7-8431-4f5f-8299-8b1b3be296bd\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-8212-dca6a7ab55ca\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"Due 2026-09-18: Invoices reviewed for 90-day forfeiture window\",\"body\":\"Compliance attestation for the week of 2026-09-14 is due by 2026-09-18.\\n\\nWalmart MSA — invoices not submitted within 90 days are forfeit. Review the AR aging in QBO weekly and confirm any approaching 90 days have been escalated.\\n\\nOpen the Compliance scorecard → Billing & invoicing tile to record when you completed this and confirm the outcome.\",\"category\":\"compliance.attestation.INVOICE_FORFEITURE.2026-09-14\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-09-18T21:13:28.902Z\",\"readAt\":\"2026-10-25T14:29:06.294Z\",\"seenAt\":\"2026-10-26T12:59:49.338Z\",\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/compliance?tab=scorecard\",\"createdAt\":\"2026-09-18T21:13:28.902Z\"},{\"id\":\"96641ef9-1493-4d07-804c-fc479efd0eef\",\"channel\":\"IN_APP\",\"status\"