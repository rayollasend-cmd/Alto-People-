,\"category\":\"relay.escalation\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-10-18T04:17:27.692Z\",\"readAt\":null,\"seenAt\":null,\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/relay#client-requests:e4d756b2-c63f-44b2-a276-2c470a3ca645:l2\",\"createdAt\":\"2026-10-18T04:17:27.693Z\"},{\"id\":\"b65cb608-b098-43de-a45a-3446b9748bec\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-8212-dca6a7ab55ca\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"Recordable safety incident — Aaliyah Brooks\",\"body\":\"days away on 2026-10-09. Cut on the left hand from a box cutter while breaking down cartons.\\n\\nReview it in the OSHA injury log; the compliance scorecard safety tile tracks it until resolved.\",\"category\":\"compliance\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-10-18T01:48:18.373Z\",\"readAt\":null,\"seenAt\":null,\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/compliance/osha\",\"createdAt\":\"2026-10-18T01:48:18.374Z\"},{\"id\":\"d59d8fd6-6f7b-43eb-a441-115c8c61a6b9\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-8212-dca6a7ab55ca\",\"recipientPhone\":null,\"recipientEmail\":null,\"subject\":\"Recordable safety incident — Gerodney Lee\",\"body\":\"medical treatment on 2026-10-16. Strained lower back lifting a case of water in the stockroom.\\n\\nReview it in the OSHA injury log; the compliance scorecard safety tile tracks it until resolved.\",\"category\":\"compliance\",\"externalRef\":null,\"providerMessageId\":null,\"failureReason\":null,\"sentAt\":\"2026-10-18T01:48:18.366Z\",\"readAt\":null,\"seenAt\":null,\"senderUserId\":null,\"senderEmail\":null,\"linkUrl\":\"/compliance/osha\",\"createdAt\":\"2026-10-18T01:48:18.366Z\"},{\"id\":\"b7b0675a-5457-4dad-8ea8-177444c2e9b6\",\"channel\":\"IN_APP\",\"status\":\"SENT\",\"recipientUserId\":\"59431ae2-972f-4874-821