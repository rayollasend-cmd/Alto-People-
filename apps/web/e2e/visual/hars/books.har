      "text": "{\"total\":55,\"sources\":[{\"key\":\"approvals\",\"label\":\"Shift & time-off approvals\",\"description\":\"Shift swaps, open-shift pickups, time off and walk-in clock-ins waiting for a manager.\",\"count\":2,\"path\":\"/approvals?tab=timeoff\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"timesheets\",\"label\":\"Timesheets to approve\",\"description\":\"Finished punches from the last 90 days waiting for approval — unapproved time can’t be paid or billed.\",\"count\":0,\"path\":\"/time-attendance?tab=queue\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"agent-proposals\",\"label\":\"Suggested by an AI agent\",\"description\":\"Shifts to fill, cases to open and other actions an agent proposes. Nothing happens until you decide.\",\"count\":0,\"path\":\"/approvals?tab=proposals\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"time-corrections\",\"label\":\"Punch corrections\",\"description\":\"Workers asking to fix a missed or wrong punch, each with their signed attestation.\",\"count\":0,\"path\":\"/time-attendance?tab=corrections\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"break-flags\",\"label\":\"Missed breaks reported\",\"description\":\"Workers who said at clock-out they didn’t get a meal or rest break, where the labor rules aren’t paid live yet.\",\"count\":0,\"path\":\"/time-attendance?tab=breaks\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"reimbursements\",\"label\":\"Reimbursements\",\"description\":\"Expense claims waiting on a manager’s approval, and approved ones waiting on Finance to settle into the next run.\",\"count\":0,\"path\":\"/reimbursements\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"approval-requests\",\"label\":\"Pay & access changes\",\"description\":\"Pay and bill-rate changes, separations, promotions, requisitions and access changes that need a second person — you.\",\"count\":1,\"path\":\"/approvals?tab=requests\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"workflow-tasks\",\"label\":\"Tasks from workflows\",\"description\":\"What a workflow handed you, or your role, to do.\",\"count\":0,\"path\":\"/workflows?tab=tasks\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"referral-bonuses\",\"label\":\"Referral bonuses\",\"description\":\"Referral bonuses marketing has proposed, waiting on Finance to approve onto a payroll run.\",\"count\":0,\"path\":\"/marketing/bonuses\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"kiosk-review\",\"label\":\"Kiosk punches to review\",\"description\":\"Clock-ins the kiosk flagged — a face mismatch or impossible travel — waiting for a ruling.\",\"count\":0,\"path\":\"/time-attendance/kiosk?tab=review\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"onboarding-review\",\"label\":\"Applications to review\",\"description\":\"New hires who submitted their paperwork and are waiting on HR.\",\"count\":1,\"path\":\"/onboarding?status=TO_REVIEW\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"onboarding-stuck\",\"label\":\"Onboarding stuck\",\"description\":\"New hires whose onboarding has not moved in more than 7 days: no task done and no invite. A nudge now saves the start date.\",\"count\":0,\"path\":\"/onboarding?status=STUCK\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"i9-section2\",\"label\":\"I-9 Section 2 to complete\",\"description\":\"New hires who signed Section 1 and uploaded their documents — HR has three business days from their first day to examine them.\",\"count\":0,\"path\":\"/compliance?tab=i9\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"i9-reverification\",\"label\":\"I-9 reverification due\",\"description\":\"Work authorizations that have expired or expire within 90 days — Supplement B is due by the expiry date.\",\"count\":0,\"path\":\"/compliance?tab=i9&status=work_auth\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"i9-retention\",\"label\":\"I-9s past retention\",\"description\":\"People who left more than a year ago and were hired more than three years ago — their I-9s may now be destroyed.\",\"count\":0,\"path\":\"/compliance?tab=i9&status=retention\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"everify\",\"label\":\"E-Verify cases to open\",\"description\":\"I-9s with Section 2 done and no E-Verify case yet — the federal portal wants the case within three business days.\",\"count\":0,\"path\":\"/compliance?tab=everify&status=not_run\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"everify-mismatches\",\"label\":\"E-Verify mismatches to act on\",\"description\":\"E-Verify returned a Tentative Nonconfirmation: give the employee the notice and record whether they will take action.\",\"count\":0,\"path\":\"/compliance?tab=everify&status=issue\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"screening-decisions\",\"label\":\"Background checks to decide\",\"description\":\"Reports that came back “consider”, and adverse actions whose waiting period is over.\",\"count\":0,\"path\":\"/compliance?tab=background\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"drug-results-review\",\"label\":\"Drug test results to review\",\"description\":\"Results that are not a verified negative — a positive awaiting the Medical Review Officer, a dilute, or a cancelled test.\",\"count\":0,\"path\":\"/compliance?tab=drug-tests\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"efile-rejected\",\"label\":\"Tax filings rejected\",\"description\":\"The agency rejected an e-filed form. Fix what it named and file again.\",\"count\":0,\"path\":\"/payroll/year-end?tab=forms\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"provider-health\",\"label\":\"Connections failing\",\"description\":\"A connected provider (E-Verify, screening, drug tests, tax filing or payouts) is answering with errors.\",\"count\":0,\"path\":\"/integrations\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"access-certifications\",\"label\":\"Access to certify\",\"description\":\"Accounts in an open access certification waiting on your decision.\",\"count\":0,\"path\":\"/admin/access-certifications\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"hr-cases\",\"label\":\"HR cases\",\"description\":\"Open cases assigned to you, plus unassigned ones your desk can pick up.\",\"count\":0,\"path\":\"/hr-cases\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"hr-cases-sla\",\"label\":\"HR cases past their SLA\",\"description\":\"Open cases that passed their resolution target. Oldest breach first.\",\"count\":0,\"path\":\"/hr-cases?sla=breached\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"leave-desk\",\"label\":\"Leave of absence\",\"description\":\"Notices owed, certifications due within 3 days, and returns to work due this week.\",\"count\":2,\"path\":\"/leave\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"ui-claims\",\"label\":\"Unemployment claims\",\"description\":\"State notices to answer within 3 days, and hearings in the next week.\",\"count\":1,\"path\":\"/claims/unemployment\",\"urgency\":\"legal\",\"dueAt\":\"2026-10-24T00:00:00.000Z\"},{\"key\":\"wc-claims\",\"label\":\"Workers’ comp reports due\",\"description\":\"First reports of injury not yet sent to the carrier that are due within 2 days.\",\"count\":1,\"path\":\"/claims/workers-comp\",\"urgency\":\"legal\",\"dueAt\":\"2026-10-25T00:00:00.000Z\"},{\"key\":\"verification-letters\",\"label\":\"Letters to approve\",\"description\":\"Employment and income verification letters people have asked for.\",\"count\":0,\"path\":\"/documents?tab=letters\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"hotline\",\"label\":\"Hotline reports\",\"description\":\"Anonymous reports that are received, being triaged or under investigation.\",\"count\":0,\"path\":\"/hotline-admin\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"expirations\",\"label\":\"Expiring qualifications\",\"description\":\"Certifications and licenses that have expired or expire within 30 days.\",\"count\":0,\"path\":\"/expirations\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"contract-duties\",\"label\":\"Contract duties overdue\",\"description\":\"Every contract duty is confirmed for its period.\",\"count\":0,\"path\":\"/compliance?tab=scorecard\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"tasks\",\"label\":\"Tasks needing a person\",\"description\":\"Work the engine queued for a person, or that a worker stalled on or failed.\",\"count\":3,\"path\":\"/tasks?needs=1\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"relay\",\"label\":\"Relay rulings\",\"description\":\"Decisions another desk asked yours to rule on.\",\"count\":0,\"path\":\"/relay\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"client-requests\",\"label\":\"Client requests\",\"description\":\"Staffing, issue, billing and feedback requests from client stores that nobody has resolved — each on an SLA clock.\",\"count\":0,\"path\":\"/relay?tab=requests\",\"urgency\":\"routine\",\"dueAt\":null,\"watching\":true},{\"key\":\"fieldglass-setup\",\"label\":\"Fieldglass setup\",\"description\":\"Workers to add, transfer or close out in Fieldglass.\",\"count\":0,\"path\":\"/fieldglass\",\"urgency\":\"routine\",\"dueAt\":null,\"watching\":true},{\"key\":\"call-outs\",\"label\":\"Call-outs looking for cover\",\"description\":\"Someone called out of a shift in the next day and a half and nobody has taken it yet — the cover flow is already running.\",\"count\":0,\"path\":\"/call-outs\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"payroll-review\",\"label\":\"Payroll to review and sign\",\"description\":\"Payroll runs whose review report no one has signed off on yet, or whose numbers changed after the sign-off. They can’t pay out until someone does.\",\"count\":0,\"path\":\"/payroll/review\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"payroll-missed-paydays\",\"label\":\"Paydays with no run\",\"description\":\"Every past payday has a run.\",\"count\":0,\"path\":\"/payroll?ledger=missed\",\"urgency\":\"money\",\"dueAt\":null,\"watching\":true},{\"key\":\"pay-schedule-unassigned\",\"label\":\"People on no pay schedule\",\"description\":\"Hired people no pay schedule covers. No payroll run will pay them until a rule, the company default or a person puts them on one.\",\"count\":0,\"path\":\"/payroll/schedules?view=unassigned\",\"urgency\":\"routine\",\"dueAt\":null,\"watching\":true},{\"key\":\"pay-schedule-moves\",\"label\":\"Pay schedule moves starting this week\",\"description\":\"People whose pay schedule changes in the next seven days — a transfer, a hire or a rule change. Their last check on the old schedule covers through the day before.\",\"count\":0,\"path\":\"/payroll/schedules\",\"urgency\":\"routine\",\"dueAt\":null,\"watching\":true},{\"key\":\"financial-changes\",\"label\":\"Pay account changes to verify\",\"description\":\"Bank, pay card, W-4 and legal-name changes waiting on a verification call before payroll pays into them.\",\"count\":0,\"path\":\"/payroll/financial-changes\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"unbilled-pay\",\"label\":\"Billable pay not billed\",\"description\":\"$32,021.40 of billable pay is not on any statement.\",\"count\":34,\"path\":\"/finance/pay-bill?period=2026-09-12:2026-09-25\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"pay-notices-unsigned\",\"label\":\"Pay notices not signed\",\"description\":\"State pay notices (NY, CA, IL, WA) sent more than 7 days ago and still not acknowledged.\",\"count\":0,\"path\":\"/payroll/compliance?tab=notices\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"new-hire-reports\",\"label\":\"New-hire reports due\",\"description\":\"Hires to report to the state new-hire directory within five days, or already late.\",\"count\":10,\"path\":\"/payroll/compliance?tab=newhire\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"wotc-filings\",\"label\":\"WOTC filings due\",\"description\":\"Hires whose tax credit screening points to a target group and whose 28-day state filing deadline is this week or past.\",\"count\":0,\"path\":\"/payroll/wotc\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"aca-offers-due\",\"label\":\"ACA offers due\",\"description\":\"Full-time workers (by hours or by hire) with no offer of coverage recorded for the stability period that starts within 30 days.\",\"count\":0,\"path\":\"/benefits/aca\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"carrier-answers\",\"label\":\"Carrier answers\",\"description\":\"Enrollment files a carrier rejected, and files sent more than 3 business days ago with no answer from the carrier.\",\"count\":0,\"path\":\"/benefits/carriers\",\"urgency\":\"routine\",\"dueAt\":null,\"watching\":true},{\"key\":\"state-tax-review\",\"label\":\"State tax tables to review\",\"description\":\"States where people work whose withholding was added but not yet reviewed with your tax adviser — payroll can’t finalize with them until it is.\",\"count\":0,\"path\":\"/payroll/tax-tables?tab=state\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"local-tax-review\",\"label\":\"Local taxes to review\",\"description\":\"Cities, counties and school districts your people live or work in whose rates haven’t been reviewed with your tax adviser — payroll can’t finalize with them until they are.\",\"count\":0,\"path\":\"/payroll/tax-tables?tab=local\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"payroll-taxes\",\"label\":\"Payroll taxes\",\"description\":\"Tax deposits due this week or late, payments that failed, returns due within two weeks and agency notices waiting on a response.\",\"count\":0,\"path\":\"/payroll/taxes\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"certified-payroll\",\"label\":\"Certified payroll\",\"description\":\"Prevailing-wage weeks that have ended without a signed WH-347 submitted to the agency.\",\"count\":0,\"path\":\"/payroll/certified\",\"urgency\":\"legal\",\"dueAt\":null},{\"key\":\"payroll-funding\",\"label\":\"Payroll funding\",\"description\":\"Payroll isn’t paid through your own ACH.\",\"count\":0,\"path\":\"/payroll/banking\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"contractors\",\"label\":\"Contractors\",\"description\":\"IRS mismatch notices to answer and contractor payment runs waiting for a second approver.\",\"count\":0,\"path\":\"/payroll/contractors\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"hugo-tasks\",\"label\":\"Tasks waiting on you\",\"description\":\"Work you handed the assistant that needs your answer to go on — cover not found, a document to upload again, shifts still unconfirmed.\",\"count\":0,\"path\":\"/?hugo=tasks\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"messages\",\"label\":\"Unread messages\",\"description\":\"Messages in your threads you have not read yet.\",\"count\":0,\"path\":\"/messages\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"transport\",\"label\":\"Transportation\",\"description\":\"An SOS or an unanswered driver, seats today without a van, vans running late, incidents, safety issues, lapsing papers and driver requests.\",\"count\":0,\"path\":\"/transport\",\"urgency\":\"routine\",\"dueAt\":null},{\"key\":\"books-bills\",\"label\":\"Bills to approve\",\"description\":\"Vendor bills a second person entered, waiting for your approval.\",\"count\":0,\"path\":\"/books/bills?tab=approve\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"books-bills-late\",\"label\":\"Late bills\",\"description\":\"Approved vendor bills past their due date and not yet paid.\",\"count\":0,\"path\":\"/books/bills?status=late\",\"urgency\":\"money\",\"dueAt\":null},{\"key\":\"books-bills-due\",\"label\":\"Bills due in the next 7 days\",\"description\":\"Approved vendor bills due today or in the next seven days. Late ones are under Late bills.\",\"count\":0,\"path\":\"/books/bills?status=due\",\"urgency\":\"money\",\"dueAt\":null}]}"
