# apps/api environment — every key config/env.ts reads, in the schema's
# order, with its default where it has one. Secrets are left blank; optional
# keys are commented out. src/__tests__/config/envExample.test.ts fails when
# this file and the schema disagree, so add a key here when you add it there.
#
# Local Docker Compose values are filled in for the keys the API refuses to
# start without.

# development | test | production. Production turns on the fail-loud guards below.
NODE_ENV=development

# The port the API listens on.
PORT=3001

# Comma-separated list of allowed origins. Browser sends Origin without
# path/query, so each entry is just scheme + host (+ optional port).
# Examples: "https://altohr.com,https://www.altohr.com,http://localhost:5173".
CORS_ORIGIN=http://localhost:5173

# Postgres connection string (local Docker Compose default). Tests use schema=alto_test.
DATABASE_URL=postgresql://alto:alto_dev@localhost:5432/alto_people?schema=public

# DIRECT_URL is consumed by Prisma migrate, not by app code — but we
# still validate it's present so devs aren't surprised.
# DIRECT_URL=

# Signs sessions. At least 32 chars: openssl rand -base64 48. Rotate for production.
JWT_SECRET=replace-me-with-output-of-openssl-rand-base64-48

# Session lifetime in seconds (24h).
JWT_TTL_SECONDS=86400

# Field-encryption key 0 (bank accounts, SSNs). 32 bytes base64: openssl rand -base64 32.
PAYOUT_ENCRYPTION_KEY=replace-me-with-output-of-openssl-rand-base64-32

# Independent key for encrypting TOTP secrets at rest. Defaults to
# PAYOUT_ENCRYPTION_KEY in dev so we don't bloat .env. Production should
# set its own — rotation invalidates every enrolled user's secret, so
# keeping MFA on a separate key avoids dragging payouts along on rotation.
# MFA_SECRET_ENCRYPTION_KEY=

# Ping the DB every N seconds to keep Neon's serverless compute from
# suspending mid-session. Each ping is a single SELECT 1. Defaults to 0
# (off) everywhere — production runs Neon with auto-suspend disabled at
# the branch level, so keep-alive pings would just burn compute hours
# for no upside. Set to e.g. 240 to opt in if you move to a Neon tier
# that suspends idle compute.
KEEP_ALIVE_INTERVAL_SECONDS=0

# Phase 16 invitation flow.
# Base URL the magic link in invitation emails points to. In dev this is
# the Vite dev server; in prod it's wherever the web app is hosted.
APP_BASE_URL=http://localhost:5173

# Default invite token lifetime in seconds. 7 days = 604800.
# INVITE_TOKEN_TTL_SECONDS=

# Optional: real Resend API key. If unset, EMAIL notifications stay
# stubbed — the body (with magic link) prints to the API console and a
# STUB-EMAIL-... ref is returned so the UI flow still works end-to-end.
# Web push (VAPID). All optional — with keys absent, push is cleanly
# "not configured": the public-key endpoint 404s so clients never
# subscribe, and the sender no-ops. Generate once with
# `npx web-push generate-vapid-keys`; rotating keys orphans every
# outstanding subscription (clients re-subscribe on next visit).
# VAPID_PUBLIC_KEY=

# Web push (VAPID) private key; pairs with VAPID_PUBLIC_KEY. Unset: web push is off.
# VAPID_PRIVATE_KEY=

# Web push contact, a mailto: address shown to the push services.
# VAPID_SUBJECT=

# Native app push (apps/mobile). All optional — absent, native push is a
# no-op and web push keeps working. APNs uses token auth (.p8 key);
# FCM uses the HTTP v1 API with a service account.
# APNS_KEY_ID=

# Apple developer team id for native iOS push.
# APNS_TEAM_ID=

# The .p8 PEM for APNs token auth, newlines as \n.
# APNS_PRIVATE_KEY=

# The iOS app bundle id the pushes are sent to.
APNS_BUNDLE_ID=com.altohr.people

# production | sandbox (development builds).
APNS_ENV=production

# Firebase project for Android push (FCM HTTP v1).
# FCM_PROJECT_ID=

# The Firebase service account email.
# FCM_CLIENT_EMAIL=

# The Firebase service account private key, newlines as \n.
# FCM_PRIVATE_KEY=

# Apple Wallet worker badge (PassKit). Absent → "Add to Apple Wallet"
# answers 503 wallet_not_configured with what to set.
# PASS_TYPE_ID=

# Apple Wallet badge: the team id on the Pass Type ID certificate.
# PASS_TEAM_ID=

# Apple Wallet badge: the Pass Type ID certificate PEM.
# PASS_CERT_PEM=

# Apple Wallet badge: the certificate private key PEM.
# PASS_KEY_PEM=

# Apple Wallet badge: the private key passphrase, if any.
# PASS_KEY_PASSPHRASE=

# Apple Wallet badge: the Apple WWDR G4 intermediate certificate PEM.
# PASS_WWDR_PEM=

# Google Wallet worker badge (Generic pass, "Save to Google Wallet" JWT).
# GOOGLE_WALLET_ISSUER_ID=

# Google Wallet badge: the service account email.
# GOOGLE_WALLET_CLIENT_EMAIL=

# Google Wallet badge: the service account private key.
# GOOGLE_WALLET_PRIVATE_KEY=

# Signs NFC badges and Wallet pass QR codes. Unset: derived from KIOSK_PIN_SECRET.
# KIOSK_BADGE_SECRET=

# Resend transactional email. Unset: email bodies print to the API console.
RESEND_API_KEY=

# Sender shown in real Resend emails. Required only when RESEND_API_KEY is set.
# Must match Resend's accepted formats:
#   - bare:        hr@altohr.com
#   - with name:   Alto HR <hr@altohr.com>
# Whitespace is trimmed; surrounding quotes are stripped (Railway / Heroku
# dashboards sometimes preserve literal quotes when an env value contains
# angle brackets, which breaks Resend with a 422 validation_error).
RESEND_FROM=

# Reply-To header on all transactional email. Lets recipients write back
# to a monitored mailbox even though Resend itself sends from the no-reply
# hr@ address. Set to a real inbox in production (e.g. info@altohr.com).
# RESEND_REPLY_TO=

# Svix signing secret for Resend's inbound email-event webhook
# (email.delivered / bounced / complained), as shown on the Resend
# dashboard's webhook page — format "whsec_<base64>". When unset, the
# /resend/webhook endpoint refuses every request with 503 — never run
# an unauthenticated webhook in any environment.
# RESEND_WEBHOOK_SECRET=

# Phase 17 — invite reminder cron. 0 (default) disables. Set e.g. 1800
# (every 30 min) in production. The threshold for "stale" is hard-coded
# at 48h in lib/inviteReminder.ts; this only controls scan cadence.
# On by default (6h) — the sweep is the only automation keeping stalled
# onboarding moving. Set 0 to disable.
INVITE_REMINDER_INTERVAL_SECONDS=21600

# Onboarding ghost purge (lib/onboardingPurge.ts): hard-deletes invites
# unaccepted after 3 days and abandoned onboardings after 10 idle days
# (final notice at 8). On by default (6h scan). Set 0 to disable.
ONBOARDING_PURGE_INTERVAL_SECONDS=21600

# Automatic stale-application nudge (lib/staleNudge.ts): the same
# personalized "you're X% done" email as the manual Nudge-all-stale
# button, on a timer, for in-flight applications past the 7-day
# staleness rule. Per recipient: at most one automatic nudge per 72h
# and 3 ever — the manual button stays uncapped. On by default (6h
# scan). Set 0 to disable.
STALE_NUDGE_INTERVAL_SECONDS=21600

# Held onboarding invites (the Undo window) are sent by a timer; this
# sweep is the net for a restart in between. 0 disables it.
DUE_INVITE_SWEEP_SECONDS=15

# Recruiting clean-up: quiet candidates close as No response, and
# onboarding invites nobody touched expire. 0 disables it.
RECRUITING_CLEANUP_INTERVAL_SECONDS=21600

# How often the ready-to-work nudge sweep runs. 0 disables.
READY_TO_WORK_NUDGE_INTERVAL_SECONDS=3600

# Hours after approval before a not-yet-scheduled associate is nudged.
READY_TO_WORK_NUDGE_AFTER_HOURS=48

# Dormancy auto-deactivation (lib/dormancySweep.ts): associates with no
# clock-ins, worked shifts, or upcoming schedule for DEACTIVATE_DAYS are
# auto-deactivated (same pause as the manual button — one-click
# Reactivate restores them), with an admin warning WARN_DAYS ahead.
# Scan every 6h by default; either 0 disables the whole sweep.
DORMANCY_SWEEP_INTERVAL_SECONDS=21600

# Days without a sign-in before an account is deactivated. 0 disables the sweep.
DORMANCY_DEACTIVATE_DAYS=30

# Days before deactivation the warning email goes out.
DORMANCY_WARN_DAYS=7

# Store-ops evening digest (lib/opsDigest.ts): summarizes each store's
# ops shifts once per org-day after 8pm. On by default (hourly scan).
# Set 0 to disable.
OPS_DIGEST_INTERVAL_SECONDS=3600

# Store-shift SOP sweep (lib/storeShiftSop.ts): reminds a supervisor to
# submit their SOP before their shift window ends and escalates one still
# open 30 minutes after. Every 5 minutes by default; 0 disables.
OPS_SOP_SWEEP_SECONDS=300

# Client-portal morning note (lib/portalDigest.ts): one message per
# portal account per org-day after PORTAL_DIGEST_HOUR with today's and
# tomorrow's headcount and open slots. Silent when nothing is
# scheduled. Set 0 to disable.
PORTAL_DIGEST_INTERVAL_SECONDS=1800

# Local hour (deployment timezone) after which the portal digest may send.
PORTAL_DIGEST_HOUR=6

# Saturday service-report email to every portal account
# (lib/serviceReportMailer.ts). Interval = how often we CHECK; sends
# once per account per week after SERVICE_REPORT_MAIL_HOUR org time.
SERVICE_REPORT_MAIL_INTERVAL_SECONDS=3600

# Local hour after which the daily service report mails.
SERVICE_REPORT_MAIL_HOUR=7

# Monday portal-engagement digest to HR / Operations Manager / Chairman
# (lib/portalEngagement.ts): last week's sign-ins and report pulls per
# portal account. Interval = how often we CHECK; sends once per week
# after PORTAL_ENGAGEMENT_DIGEST_HOUR org time. 0 disables.
PORTAL_ENGAGEMENT_DIGEST_INTERVAL_SECONDS=3600

# Local hour after which the portal engagement digest may send.
PORTAL_ENGAGEMENT_DIGEST_HOUR=7

# "Your 6am wave is 2 short" push to portal accounts + supervisors
# (lib/portalCoverageAlert.ts): checked every N seconds, a wave rings
# once per org-day after the grace period. 0 disables.
PORTAL_COVERAGE_ALERT_INTERVAL_SECONDS=600

# Minutes after a shift start before a short store alerts the portal.
PORTAL_COVERAGE_ALERT_GRACE_MINUTES=15

# Ring only when a shift is short by at least this share of its headcount
# (and always at least one person): 10% of a 47-person overnight is 5.
PORTAL_COVERAGE_ALERT_MIN_SHORT_PCT=10

# Manual compliance attestation reminder cron. 0 (default) disables;
# production should set 3600 (hourly) so HR gets pinged the day a
# weekly/monthly compliance attestation comes due. Per-signal de-dup
# inside the sweep ensures a 1h cadence doesn't spam HR — each
# (key, periodStart) reminder fires at most once per 24h.
# On by default like the other compliance-hygiene sweeps (the 24h
# per-signal de-dup makes hourly ticks safe). Set 0 to disable.
ATTESTATION_REMINDER_INTERVAL_SECONDS=3600

# Daily push of the scorecard's 0–30-day expirations (work auth, drug
# tests, J-1 program ends, training certs). Set 0 to disable.
EXPIRATION_DIGEST_INTERVAL_SECONDS=86400

# Workflow worker (lib/workflow): executes queued runs and retries due
# webhooks, per tenant. 0 disables the timer (runs still queue).
WORKFLOW_WORKER_INTERVAL_SECONDS=20

# The HMAC secret workflow WEBHOOK steps sign with when a definition names none.
# WEBHOOK_SIGNING_SECRET=

# Access grants (lib/accessChanges): temporary elevated roles revert when they expire.
ACCESS_GRANT_SWEEP_INTERVAL_SECONDS=300

# Notification retention sweep (read bell rows >90d, delivery-audit
# rows >365d). 0 disables. Daily is plenty — the windows are month-scale.
NOTIFICATION_RETENTION_INTERVAL_SECONDS=86400

# The Alto vans' map: address → coordinates for pickups, stops and
# stores. 'nominatim' (OpenStreetMap, no key, ~1 lookup/second — results
# are cached in GeoCache so each address is looked up once), 'mapbox'
# (needs MAPBOX_TOKEN), or 'off' (no lookups; the tests). Unset: mapbox
# when a token is present, else nominatim — off under NODE_ENV=test.
# GEOCODER=

# Mapbox token for address search (house numbers, businesses). Unset: Nominatim, limited.
# MAPBOX_TOKEN=

# Standing ride bookings (lib/rideSeries) are booked forward this often;
# 0 turns the sweep off (a series is still booked when it is created).
RIDE_SERIES_INTERVAL_SECONDS=3600

# The assistant's model. Unset: the assistant answers from its intent
# registry alone (lib/hugo) — no model call, nothing leaves the server.
# Set: Claude answers with the same intents as tools, knowing the page
# the person is on (lib/assistantModel).
# ANTHROPIC_API_KEY=

# The Claude model the assistant answers with when ANTHROPIC_API_KEY is set.
ASSISTANT_MODEL=claude-opus-5

# Call-outs by phone and text (lib/callOuts, routes/voice): Twilio's
# webhooks are verified with the auth token. Unset: the voice/SMS
# webhooks answer 503 and nothing else changes.
# TWILIO_ACCOUNT_SID=

# Twilio auth token: verifies inbound webhooks and authenticates outbound texts.
# TWILIO_AUTH_TOKEN=

# The public base URL Twilio calls (e.g. https://api.example.com) — the
# signature covers the exact URL. Unset: rebuilt from the request.
# TWILIO_WEBHOOK_BASE_URL=

# Outbound texts (lib/sms, the SMS channel of lib/notifications): the
# Twilio Messages API sends from a Messaging Service (preferred: pooled
# numbers, carrier STOP handling) or one long-code number in E.164. With
# the account SID + auth token + one of these two set, texts go out for
# real; with any missing, every SMS is recorded NOT_CONFIGURED — never
# SENT — and the composer, the crew-text dialog and the broadcast log
# say so. Replies and STOP land on POST /voice/sms.
# TWILIO_MESSAGING_SERVICE_SID=

# The E.164 number outbound texts come from (when no messaging service SID is set).
# TWILIO_FROM_NUMBER=

# Signs the assistant's proposed actions (lib/assistantActions). Unset:
# derived from SESSION_SECRET/JWT secret.
# ASSISTANT_ACTION_SECRET=

# Nightly retention scoring (lib/retention). 0 turns it off.
RETENTION_INTERVAL_SECONDS=86400

# Van trail retention sweep (RideRunPing rows >30 days). 0 disables.
VAN_TRAIL_RETENTION_INTERVAL_SECONDS=86400

# Daily compliance-score snapshot (org + per-client). The interval is only
# how often we CHECK for today's row — one row/day/scope regardless. 0
# disables (and with it the scorecard trend + week-delta features).
COMPLIANCE_SNAPSHOT_INTERVAL_SECONDS=3600

# Day-before shift reminder cron. Default 1800 (every 30 minutes) — the
# audit of 2026-10-21 found it defaulting to 0 and set nowhere, so no
# reminder ever went out. 0 disables. Each assigned+published shift
# starting within the next 24h is reminded exactly once —
# Shift.reminderSentAt is claimed with a guarded update, so overlapping
# sweeps/replicas can't double-send.
# Who may bulk-export SSN and bank data — the payroll census, the
# new-hire report, the external payroll sheet, the audit packet — as
# comma-separated emails. The capability export:payroll-pii still
# decides whether a ROLE may touch SSNs at all; this narrows the
# whole-roster download to named people, because reading one record in
# the UI and downloading two thousand are different risks.
#
# Unset means the capability alone decides: a blank value on a deploy
# must never be able to stop payday. Every export taken that way says
# so in the log and carries `exportAuthority: 'unset'` on its audit row.
# PII_BULK_EXPORT_USERS=

# Day-before shift reminder sweep cadence. On by default; 0 disables.
SHIFT_REMINDER_INTERVAL_SECONDS=1800

# Daily schedule digest to admins (Sling-style morning summary: every
# shift today, who's on it, fill/unconfirmed counts). The sweep runs
# every N seconds but sends at most once per local day, after
# SCHEDULE_DIGEST_HOUR in the deployment timezone. Default 900 so the
# digest lands within ~15 min of the hour; 0 disables.
SCHEDULE_DIGEST_INTERVAL_SECONDS=900

# Local hour (0-23, deployment timezone) after which the daily digest
# may send. Default 6 → admins have it before the first shift.
SCHEDULE_DIGEST_HOUR=6

# Associate week-ahead digest: the evening before each CLIENT's week
# start (Client.weekStartsOn — some clients run Sun–Sat weeks, others
# Wed–Tue), every associate scheduled that week gets their shift list.
# Sweep cadence in seconds; default 1800 (every 30 minutes); 0 disables.
WEEK_AHEAD_INTERVAL_SECONDS=1800

# Local hour (deployment timezone) after which the "evening before"
# send may fire. Default 17 (5 PM).
WEEK_AHEAD_SEND_HOUR=17

# Robot incident evidence retention (lib/robotIncidentRetention): once a
# day per tenant with robotics on, the hour's samples, events and the
# people on shift are removed from incidents past their five-year
# retainUntil; the report itself stays. 0 turns the sweep off.
ROBOT_INCIDENT_RETENTION_INTERVAL_SECONDS=86400

# Kiosk maintenance cron: auto-closes forgotten clock-outs and purges
# selfies past their retention window. Default 3600 (hourly); 0
# disables. Thresholds (18h forgotten-shift, 90d selfie retention) are
# hard-coded in lib/kioskMaintenance.ts.
KIOSK_MAINTENANCE_INTERVAL_SECONDS=3600

# Nightly audit hash-chain verification (lib/auditChain
# runAuditChainChecks): every tenant's chain recomputed and recorded as
# an AuditChainCheck; a break raises an AUDIT_CHAIN security alert to the
# security contact and the operator's org admins. Default daily; 0 off.
AUDIT_CHAIN_CHECK_INTERVAL_SECONDS=86400

# SOC 2 decision 7: kiosk selfies and face templates written before the
# seal are encrypted in place, in batches, by a job that runs at boot and
# then at this cadence until no plaintext row is left. 0 turns it off.
BIOMETRIC_SEAL_INTERVAL_SECONDS=3600

# Outbound webhook delivery worker (Phase 93 follow-up). Sweeps due
# PENDING/RETRYING WebhookDelivery rows and POSTs them with the HMAC
# X-Alto-Signature. On by default (60s) — subscriptions already exist
# in the admin UI and silently never delivering is worse than a spare
# query per minute. Set 0 to disable (e.g. one-off scripts). Backoff
# and the 6-attempt cap are hard-coded in lib/webhookDispatch.ts.
WEBHOOK_DELIVERY_INTERVAL_SECONDS=60

# Document maintenance cron: purges blob bytes for REJECTED docs once
# they've passed REJECTED_DOC_RETENTION_DAYS (30, hard-coded). Defaults
# to 86400 (daily) — this is a compliance/storage-hygiene sweep we
# want on by default; set to 0 only if a downstream job handles purges.
# The DocumentRecord row stays for audit — only the file leaves disk.
DOCUMENT_MAINTENANCE_INTERVAL_SECONDS=86400

# Offer-letter backfill sweep (lib/offerLetters.ts): files the published
# offer-letter template for every APPROVED associate with no OFFER_LETTER
# document — the catch-all behind the approval hook, and the automatic
# backfill for people approved before the hook existed. Letters with
# unresolved template tokens are never filed. Default 6h; 0 disables.
OFFER_LETTER_SWEEP_INTERVAL_SECONDS=21600

# Org-wide labor-rate fallbacks, applied AFTER a shift's own rate and the
# per-(client, position) defaults. Product owner (2026-08-17): standard
# pay is $15/hr associates and $18/hr leads; the Walmart SOW bill rates
# are $21.21 (associate) / $24.24 (lead). Set to 0 to disable a fallback.
DEFAULT_ASSOCIATE_PAY_RATE=15

# Org-wide fallback pay rate ($/h) for lead positions.
DEFAULT_LEAD_PAY_RATE=18

# Org-wide fallback bill rate ($/h) for associates.
DEFAULT_ASSOCIATE_BILL_RATE=21.21

# Org-wide fallback bill rate ($/h) for leads.
DEFAULT_LEAD_BILL_RATE=24.24

# Fully-loaded labor: employer-side statutory burden as a percentage on
# top of wages (FICA 7.65 + FUTA ~0.6 + FL SUTA ~2.7 + workers' comp —
# one knob, per the live-cost design; default 12) and an allocated
# overhead per WORKED hour (housing + transport + supervision ÷ hours;
# default 0 until the owner supplies it). Both drive the live floor
# board's loaded cost. OT (past 40h/week, ALL clients combined) pays and
# bills at 1.5× — $31.82 billed on the $21.21 SOW rate.
LABOR_BURDEN_PERCENT=12

# Fully-loaded cost of losing one associate (recruiting + onboarding +
# ramp gap) — drives the executive turnover-cost figure.
EXEC_COST_PER_SEPARATION=400

# Fixed overhead added per labor hour in margin math ($/h).
LABOR_OVERHEAD_PER_HOUR=0

# Market rates (lib/marketWages): the BLS public API key raises the daily
# quota and the series-per-request limit (50 vs 25). Without it the
# refresh still works, more slowly; OEWS tables can also be imported.
# BLS_API_KEY=

# How often market wage data (BLS) is refreshed.
MARKET_WAGE_REFRESH_HOURS=24 * 7

# The margin a bill rate is priced to when a client has no target set.
DEFAULT_TARGET_MARGIN_PCT=25

# Schedule gate on kiosk clock-ins (product owner, 2026-08-19): a fresh
# CLOCK_IN requires an ASSIGNED shift covering the punch (2h early
# allowance). Blocked punches park as a ClockInRequest for a supervisor
# to approve (backdated entry) or deny. Clock-outs, breaks, and rejoins
# are never gated. Explicit string parse — z.coerce.boolean() would
# treat the string "false" as true.
# KIOSK_REQUIRE_SCHEDULED_SHIFT=

# Scheduled-report delivery sweep (lib/reportScheduleRunner.ts): runs
# ReportSchedule rows whose nextRunAt has passed and emails the CSV to
# the stored recipients. Ticks every N seconds; each tick only touches
# due schedules, so a 5-minute cadence (default 300) is cheap. Set 0
# to disable (schedules then accumulate as due until re-enabled).
REPORT_SCHEDULE_INTERVAL_SECONDS=300

# Multi-replica deployment hint. The kiosk rate limit keeps state
# per-process (see lib/kioskRateLimit.ts). When MULTI_REPLICA=1 we
# refuse to boot unless a shared rate-limit store has been wired up
# via setKioskRateLimitStore() before the listener starts. Default
# 0 covers the existing single-replica Railway deployment. Ops sets
# it to 1 only after installing a Redis-backed (or equivalent)
# adapter — leaving the default state-per-process behavior in a
# multi-replica setup lets an attacker bypass the PIN lockout by
# round-robin'ing replicas.
MULTI_REPLICA=0

# Phase 22 — payroll disbursement adapter. STUB (default) returns
# synthetic refs; WISE / BRANCH attempt the real provider when the
# matching API key is also set. Falls back to STUB if the chosen
# provider's key is missing.
PAYROLL_DISBURSEMENT_PROVIDER=STUB

# Wise payouts API key (PAYROLL_DISBURSEMENT_PROVIDER=WISE).
# WISE_API_KEY=

# Wise profile that owns the USD balance transfers fund from. Required
# (with the API key) before the WISE provider makes real calls.
# WISE_PROFILE_ID=

# Wise API base URL (sandbox or live).
# WISE_API_BASE_URL=

# Tier-1 honesty guard: in production the STUB adapter refuses to mark
# items paid unless this is explicitly true. A run that "disbursed" via
# stub moves no money — that must be an opt-in, never a silent default.
PAYROLL_ALLOW_STUB_DISBURSEMENT=false

# Tier-3 — four-eyes control: when true, a FINALIZED run must be
# approved by someone other than its creator before it can disburse.
PAYROLL_REQUIRE_SECOND_APPROVAL=false

# When the electronic provider reports no_payout_rail for an associate
# (no Branch card, no bank account), fall back to issuing a paper check
# from the check register instead of HELDing the item.
PAYROLL_CHECK_FALLBACK=false

# Branch pay-card API key (PAYROLL_DISBURSEMENT_PROVIDER=BRANCH).
# BRANCH_API_KEY=

# Phase 45 — Branch payments rail. BRANCH_API_BASE_URL lets ops point
# at sandbox vs production without a code change; BRANCH_WEBHOOK_SECRET
# is the shared HMAC secret Branch signs status-change webhooks with.
# When the secret is missing, the webhook endpoint refuses every
# request — never run unauthenticated in any environment.
# BRANCH_API_BASE_URL=

# Signs Branch disbursement webhooks at /branch/webhook.
# BRANCH_WEBHOOK_SECRET=

# SCIM 2.0 provisioning bearer (Microsoft Entra ID / Okta). When unset,
# every /scim/v2/* request answers 503 — the surface never runs
# unauthenticated (same posture as BRANCH_WEBHOOK_SECRET above). Min 32
# chars; generate with `openssl rand -base64 32` and paste the same value
# into the IdP's provisioning credential. Rotating it revokes the old
# token immediately — update the IdP at the same time.
# SCIM_TOKEN=

# Phase 44 — QuickBooks Online (Intuit). When both client id and secret
# are set, OAuth is wired and JournalEntry POSTs hit Intuit's v3 API.
# Otherwise the integration runs in stub mode: connect/disconnect work
# for the UI flow but actual posting just logs the would-be JE payload
# to the API console (and stamps a STUB-QBO-... id on the run).
# Sandbox vs production routing is controlled by INTUIT_ENV; sandbox
# hits the apidev URL, production hits the prod URL. The OAuth redirect
# URI must be registered in the Intuit developer dashboard and equal to
# {APP_BASE_URL}/api/quickbooks/connect/callback.
# INTUIT_CLIENT_ID=

# QuickBooks Online OAuth client secret; pairs with INTUIT_CLIENT_ID.
# INTUIT_CLIENT_SECRET=

# sandbox | production for the QuickBooks Online API.
INTUIT_ENV=sandbox

# The books (2027-01): Intuit's webhook verifier token for the company QuickBooks —
# change notifications are HMAC-SHA256-signed with it (intuit-signature). Unset = webhooks refused; the
# five-minute pull still brings every change over.
# INTUIT_WEBHOOK_VERIFIER=

# Phase 99 — server-side secret used to HMAC kiosk PINs. Defaults to
# PAYOUT_ENCRYPTION_KEY in dev so we don't bloat .env; production
# should set its own (rotation invalidates all existing PINs).
# KIOSK_PIN_SECRET=

# Phase 109 — pulse survey responder hash secret. Defaults to
# PAYOUT_ENCRYPTION_KEY if unset.
# PULSE_HASH_SECRET=

# Brief 2-5 step 2 — the bank-account fingerprint's own HMAC secret
# (lib/financialChanges.ts). Defaults to PAYOUT_ENCRYPTION_KEY, which it
# used until now, so every stored fingerprint still matches; set it to
# that same value in production, then the field key can rotate alone.
# ACCOUNT_FINGERPRINT_SECRET=

# Brief 2-4: signs /v1 access tokens (15-minute JWTs for API clients), apart
# from session signing. Unset, it falls back like every per-job secret.
# API_TOKEN_SECRET=

# Brief 2-4: encrypts webhook signing secrets at rest (never the payout key's job once set).
# WEBHOOK_SECRET_KEY=

# Brief 2-5 step 2 — once every per-job secret is set (lib/jobSecrets.ts),
# '1' makes boot refuse to start without them. Off by default so a deploy
# never fails on a variable Railway does not have yet.
# REQUIRE_SPLIT_SECRETS=

# HMAC secret used to mint per-associate iCal feed URLs. The token
# embedded in /scheduling/calendar/:token.ics is HMAC(secret, associateId);
# rotating this secret revokes every outstanding subscription. Defaults
# to JWT_SECRET so dev environments don't need a second key.
# CALENDAR_FEED_SECRET=

# ASN Nexus — Walmart-shift compliance metrics source. ASN Nexus is a
# separate service (built on Replit) that owns the source-of-truth
# shift data. The compliance scorecard's Tile 3 (shift compliance)
# pulls live metrics from there. When either var is unset, Tile 3
# falls back to its built-in fill-rate query against our local Shift
# table and shows "Coming soon" for everything else.
# ASN_NEXUS_BASE_URL=

# Bearer for the ASN Nexus shift-compliance metrics (Tile 3 of the scorecard).
# ASN_NEXUS_API_KEY=

# Phase 9 storage root — overrides `apps/api/uploads/` so a Railway
# Volume (or any mounted disk) can hold the document blobs across
# redeploys. When unset, falls back to the colocated default which
# is fine for local dev but ephemeral on Railway. On Railway, attach
# a Volume to this service and set UPLOAD_DIR to its mount path
# (e.g. /data/uploads). See apps/api/STORAGE.md.
# UPLOAD_DIR=

# Blob storage driver for document/photo/PDF blobs. `local` (default)
# keeps today's behavior: files under UPLOAD_ROOT on the filesystem.
# `s3` stores blobs in an S3-compatible bucket (AWS S3, Backblaze B2,
# Cloudflare R2) — object keys map 1:1 to the relative keys already in
# DocumentRecord.s3Key, optionally under STORAGE_S3_PREFIX. Run
# scripts/migrate-blobs-to-s3.ts BEFORE flipping this to `s3` on an
# existing deployment. See apps/api/STORAGE.md.
STORAGE_DRIVER=local

# Every tenant table is narrowed to the caller's tenant (lib/tenantGuard). `observe` is the
# emergency fallback; the cross-tenant and site-scope suites pass under enforce.
TENANCY_MODE=enforce

# Required when STORAGE_DRIVER=s3 (fail-loud guard below); ignored for
# local. ENDPOINT only for non-AWS providers. Credentials are optional —
# when unset, the SDK default provider chain (IAM role / env) applies;
# when set, both halves must be set together.
# STORAGE_S3_BUCKET=

# S3 region (required with STORAGE_DRIVER=s3).
# STORAGE_S3_REGION=

# S3 endpoint for non-AWS providers (B2, R2).
# STORAGE_S3_ENDPOINT=

# S3 access key; omit both keys to use the SDK default chain.
# STORAGE_S3_ACCESS_KEY_ID=

# S3 secret key.
# STORAGE_S3_SECRET_ACCESS_KEY=

# Optional key prefix inside the bucket ("alto-uploads" stores objects
# as "alto-uploads/<s3Key>"). Leading/trailing slashes are stripped.
# STORAGE_S3_PREFIX=

# Path-style addressing ("https://endpoint/bucket/key"). Unset defaults
# to true when STORAGE_S3_ENDPOINT is set (B2/R2 need it), false for
# plain AWS. Accepts 1/0/true/false — explicit string parse because
# z.coerce.boolean() would treat the string "false" as true.
# STORAGE_S3_FORCE_PATH_STYLE=

# Nightly off-site backup of UPLOAD_ROOT to any S3-compatible bucket
# (AWS S3, Backblaze B2, Cloudflare R2). The Railway Volume protects
# files against REDEPLOYS, not against deletion/corruption — Neon has
# point-in-time recovery for the database; this is the equivalent for
# the document blobs. All four BACKUP_S3_* must be set or the job
# stays off (no half-configured surprises). ENDPOINT only for non-AWS
# providers. See apps/api/BACKUPS.md.
# BACKUP_S3_BUCKET=

# Backup bucket region (scripts/db-backup.ts, uploads backup).
# BACKUP_S3_REGION=

# Backup bucket access key.
# BACKUP_S3_ACCESS_KEY_ID=

# Backup bucket secret key.
# BACKUP_S3_SECRET_ACCESS_KEY=

# Backup bucket endpoint for non-AWS providers.
# BACKUP_S3_ENDPOINT=

# Uploads backup cadence in hours.
BACKUP_INTERVAL_HOURS=24

# Days of uploads backups kept.
BACKUP_RETENTION_DAYS=30

# Enterprise SSO — OIDC authorization-code + PKCE login (Microsoft
# Entra ID-ready, but any spec-compliant IdP works). All three core
# vars unset = the feature is fully off: the login page hides the SSO
# button and /auth/oidc/start 404s. https is required — discovery and
# the token exchange carry the client secret, and the ID token is
# bearer material. Partial configuration is a boot error (see the
# cross-field guard at the bottom of this file).
# OIDC_ISSUER_URL=

# Enterprise SSO: the OIDC client id (all three OIDC_* or none).
# OIDC_CLIENT_ID=

# Enterprise SSO: the OIDC client secret.
# OIDC_CLIENT_SECRET=

# Login-page button copy, e.g. "Sign in with Contoso". Served by
# GET /auth/oidc/config; never a secret.
OIDC_BUTTON_LABEL=Sign in with SSO

# Sentry DSN. When set, unhandled errors from the request pipeline +
# any error reaching the global error handler get reported. Unset =>
# no reporting, no SDK init, zero network calls. Reasonable default
# for dev and CI; production should set it via Railway.
# SENTRY_DSN=

# 0 -> off, 1 -> 100% sampling. Defaults to 0.1 (10%) which keeps
# free-tier quotas reasonable while still capturing the long tail.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Reading Sentry back (the reliability dashboard and the weekly
# summary): an auth token with project:read + event:read, the org slug,
# and the project slugs to count — comma-separated, falling back to
# SENTRY_PROJECT, which the web build already uses for sourcemaps. All
# optional: unset, the dashboard shows the rollup's own 5xx count and
# says Sentry is not connected. The DSN above is write-only and never
# enough to read.
# SENTRY_AUTH_TOKEN=

# Sentry org slug for the reliability page issue links.
# SENTRY_ORG=

# Sentry project slug (the API).
# SENTRY_PROJECT=

# Comma-separated Sentry projects the reliability page reads.
# SENTRY_PROJECTS=

# US SaaS by default; EU orgs are at https://de.sentry.io, self-hosted
# wherever it is.
# SENTRY_API_URL=

# WhatsApp (Meta Cloud API, Brief 1C-4). All optional: unset, sends are
# recorded as stubs and the webhook answers 503. The access token is a
# System User token with whatsapp_business_messaging; the phone number
# id is the sender; the verify token is the string Meta echoes on
# webhook setup; the app secret signs every webhook payload.
# WHATSAPP_ACCESS_TOKEN=

# WhatsApp Cloud API sender phone number id.
# WHATSAPP_PHONE_NUMBER_ID=

# The string Meta echoes on webhook setup (min 8 chars).
# WHATSAPP_VERIFY_TOKEN=

# Signs every WhatsApp webhook payload.
# WHATSAPP_APP_SECRET=

# Brief 2-6 step 4: Stripe, TEST MODE until the owner approves live (decision 4). A live key
# is refused unless STRIPE_LIVE_APPROVED=yes. Unset: invoices wait as drafts.
# STRIPE_SECRET_KEY=

# Signs Stripe billing webhooks at /billing/stripe/webhook.
# STRIPE_WEBHOOK_SECRET=

# Set to yes to allow a live Stripe key (the owner approves live billing).
# STRIPE_LIVE_APPROVED=

# Brief 2-6 step 5 (decision 9): the hosted status page, linked from the help menu and the sign-in page.
# STATUS_PAGE_URL=

# Brief 2-5 step 3: the field-encryption keyring. Key 0 is always PAYOUT_ENCRYPTION_KEY; these add
# keys ("1:<base64>,2:<base64>") and pick the one new writes use. Unset: key 0, as before.
# FIELD_KEYS=

# Which keyring key new writes use (0 = PAYOUT_ENCRYPTION_KEY). Must be in the ring or boot fails.
# FIELD_KEY_ACTIVE=

# Brief 2-5 step 7: CI posts the dependency scan (and later backups) as evidence with this bearer.
# EVIDENCE_INGEST_TOKEN=

# Meta Graph API version for WhatsApp calls.
WHATSAPP_API_VERSION=v21.0

# Request throttles (middleware/rateLimit): sign-ins per minute per IP
# and per email on /auth/login, whole-roster PII exports per actor per
# hour, and requests per minute per signed-in user across the API. The
# overrides exist for test stacks (the E2E runner signs every persona in
# from one address; the load test plays thousands of people a minute);
# production never sets them. A blank or non-numeric value keeps the default.
LOGIN_IP_LIMIT=20

# Sign-ins per minute per email on /auth/login (test stacks only).
LOGIN_EMAIL_LIMIT=5

# Whole-roster PII exports per actor per hour.
BULK_PII_EXPORTS_PER_HOUR=5

# Requests per minute per signed-in user across the API (load-test stacks raise it).
DEFAULT_API_LIMIT=600

# Robots (lib/fleet): the fleet the platform talks to. SIMULATED needs no
# keys; BEAR and PUDU need both FLEET_API_BASE and FLEET_API_KEY and fall
# back to the simulated fleet without them. Any other value is SIMULATED.
FLEET_PROVIDER=SIMULATED

# Robot fleet API base URL (BEAR or PUDU).
# FLEET_API_BASE=

# Robot fleet API key.
# FLEET_API_KEY=

# Paper checks (lib/checkPrintPdf): the path to a licensed E-13B MICR
# font. Without one the MICR line prints as a placeholder (lib/paperChecks).
# MICR_FONT_PATH=

# Railway injects the deploy's git SHA; GET /health/version serves it so a
# wall-mounted kiosk reloads once per deploy. Unset: the process start time.
# RAILWAY_GIT_COMMIT_SHA=
