model OshaIncident {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String               @db.Uuid
  // Which store it happened at. A store manager's safety card counts only
  // their own building; without this the count was every location on the
  // account. Nullable for rows predating the column at multi-store
  // clients, where it can't be inferred after the fact.
  locationId     String?              @db.Uuid
  associateId    String?              @db.Uuid
  occurredAt     DateTime             @db.Timestamptz(6)
  reportedAt     DateTime             @default(now()) @db.Timestamptz(6)
  reportedById   String?              @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  location       String?
  description    String
  bodyPart       String?
  severity       OshaIncidentSeverity
  daysAway       Int                  @default(0)
  daysRestricted Int                  @default(0)
  isRecordable   Boolean              @default(true)
  status         OshaIncidentStatus   @default(REPORTED)
  resolutionNote String?
  resolvedAt     DateTime?            @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  /// Agent families step 5 (incident.loop): the HR case opened for it on a person's approval.
  hrCaseId       String?              @db.Uuid
  /// incident.loop's chase: 1 = told at 3 days open, 2 = at 7, 3 = at 14.
  chaseStage     Int                  @default(0)
  lastChasedAt   DateTime?            @db.Timestamptz(6)
  /// The floor (field roles, 2026-10): the photo a supervisor took when filing it, as a blob key.
  photoKey       String?

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hrCase         HrCase?         @relation(fields: [hrCaseId], references: [id], onDelete: SetNull)
  store          Site?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  associate      Associate?      @relation(fields: [associateId], references: [id], onDelete: SetNull)
  reportedBy     User?           @relation("OshaIncidentReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  robotIncidents RobotIncident[]

  @@index([clientId, occurredAt(sort: Desc)])
  @@index([locationId, occurredAt(sort: Desc)])
  @@index([status])
  @@index([tenantId])
}

