  tenantId    String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  locationId  String         @db.Uuid
  associateId String         @db.Uuid
  readiness   BenchReadiness
  notes       String?        @db.VarChar(1000)
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  location  Site      @relation("LeadBenchLocation", fields: [locationId], references: [id], onDelete: Cascade)
  associate Associate @relation("LeadBenchAssociate", fields: [associateId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("LeadBenchCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([locationId, associateId])
  @@index([associateId])
  @@index([tenantId])
}

/// The 9-box's potential axis (1 low – 3 high), rated by HR. Performance
/// comes from the latest review.
model TalentRating {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId String   @unique @db.Uuid
  potential   Int
  notes       String?  @db.VarChar(1000)
  ratedById   String?  @db.Uuid
  ratedAt     DateTime @default(now()) @db.Timestamptz(6)

  associate Associate @relation("TalentRatingAssociate", fields: [associateId], references: [id], onDelete: Cascade)
  ratedBy   User?     @relation("TalentRater", fields: [ratedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// ===== Phase 116 — Probation period tracking ===============================
//
// One ACTIVE probation per associate at any time (partial unique index in the
// migration enforces it). Decisions are forward-only: ACTIVE → PASSED |
// EXTENDED (endDate moves forward, status returns to ACTIVE in a new row) |
// FAILED. The "extend" route closes the current row as EXTENDED and opens a
// new ACTIVE one with the new end date; the partial unique index makes the
// transaction safe.
enum ProbationStatus {
  ACTIVE
  PASSED
  EXTENDED
  FAILED
}

model ProbationPeriod {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String          @db.Uuid
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  status      ProbationStatus @default(ACTIVE)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  decision    String?
  decidedById String?         @db.Uuid
  decidedAt   DateTime?       @db.Timestamptz(6)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("ProbationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdBy User?     @relation("ProbationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([associateId])
  @@index([endDate])
  @@index([tenantId])
}

// ===== Phase 117 — Holiday calendar ========================================
//
// clientId NULL → company-wide. The unique index in the migration uses
// COALESCE on clientId so company-wide rows (NULL clientId) still
// de-duplicate against (date, name). Federal holidays are typically seeded
// company-wide; state holidays carry a 2-letter state code; client-specific
// holidays carry a clientId.
enum HolidayType {
  FEDERAL
  STATE
  COMPANY
  CLIENT_SPECIFIC
}

model Holiday {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?     @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name        String
  date        DateTime    @db.Date
  type        HolidayType
  state       String?     @db.VarChar(2)
  paid        Boolean     @default(true)
  notes       String?
  createdById String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([clientId])
  @@index([tenantId])
}

// ===== Phase 118 — Disciplinary action log =================================
//
// Distinct from Pip (which is a forward-looking improvement plan). This is
// the corrective record: each row is one incident on the formal warning
// ladder. Acknowledgment captures associate awareness; rescind unwinds an
// action that was issued in error or later overturned.
enum DisciplineKind {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
  TERMINATION
}

enum DisciplineStatus {
  ACTIVE
  ACKNOWLEDGED
  RESCINDED
}

model DisciplinaryAction {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId     String           @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind            DisciplineKind
  status          DisciplineStatus @default(ACTIVE)
  incidentDate    DateTime         @db.Date
  effectiveDate   DateTime         @db.Date
  suspensionDays  Int?
  description     String
  expectedAction  String?
  issuedById      String?          @db.Uuid
  acknowledgedAt  DateTime?        @db.Timestamptz(6)
  acknowledgedSig String?
  /// F500 G5: the employee's own side, written under the notice (acknowledging is not agreeing). Up to 2,000 characters.
  employeeResponse    String?
  employeeRespondedAt DateTime?        @db.Timestamptz(6)
  rescindedAt     DateTime?        @db.Timestamptz(6)
  rescindedReason String?
  rescindedById   String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  issuedBy    User?     @relation("DisciplineIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  rescindedBy User?     @relation("DisciplineRescinder", fields: [rescindedById], references: [id], onDelete: SetNull)

  @@index([associateId])
  @@index([status])
  @@index([effectiveDate])
  @@index([tenantId])
}

// ===== Phase 119 — Separations + exit interviews ===========================
//
// One in-flight separation per associate at a time (partial unique index in
// the migration). PLANNED is "we know they're leaving", IN_PROGRESS is "last
// day has come and we're processing", COMPLETE is "all done, off the books".
// Exit-interview fields can be filled at any point but typically during
// IN_PROGRESS. Re-hires get a brand new Separation row when they leave again.
enum SeparationReason {
  VOLUNTARY_OTHER_OPPORTUNITY
  VOLUNTARY_PERSONAL
  VOLUNTARY_RELOCATION
  VOLUNTARY_RETIREMENT
  INVOLUNTARY_PERFORMANCE
  INVOLUNTARY_LAYOFF
  INVOLUNTARY_MISCONDUCT
  END_OF_CONTRACT
  DECEASED
  OTHER
}

enum SeparationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
}

model Separation {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId              String           @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId                 String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  reason                   SeparationReason
  status                   SeparationStatus @default(PLANNED)
  noticeDate               DateTime?        @db.Date
  lastDayWorked            DateTime         @db.Date
  finalPaycheckDate        DateTime?        @db.Date
  rating                   Int?
  reasonNotes              String?
  feedbackPositive         String?
  feedbackImprovement      String?
  wouldRecommend           Boolean?
  wouldReturn              Boolean?
  exitInterviewCompletedAt DateTime?        @db.Timestamptz(6)
  exitInterviewByUserId    String?          @db.Uuid
  initiatedById            String?          @db.Uuid
  completedById            String?          @db.Uuid
  completedAt              DateTime?        @db.Timestamptz(6)
  /// Asset return (HR pack 2026-10): completion needs every assigned asset back, or this waiver.
  assetsWaivedAt           DateTime?        @db.Timestamptz(6)
  assetsWaivedById         String?          @db.Uuid
  assetsWaiveReason        String?
  /// The final-pay preview as last computed: unpaid hours, leave payout, the state deadline.
  finalPaySnapshot         Json?
  createdAt                DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(6)

  associate       Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  initiatedBy     User?     @relation("SeparationInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  completedBy     User?     @relation("SeparationCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  exitInterviewBy User?     @relation("SeparationExitInterviewer", fields: [exitInterviewByUserId], references: [id], onDelete: SetNull)

  @@index([associateId])
  @@index([status])
  @@index([lastDayWorked])
  @@index([tenantId])
}

// ===== Phase 120 — Internal mobility =======================================
//
// Lets current associates apply to internal JobPostings. Distinct from
// external Candidate-driven recruiting (Phase 25/90) — these applicants are
// already in the workforce. Reviewer marches the row through the funnel via
// status updates; (postingId, associateId) is unique so an associate can't
// double-apply to the same posting without withdrawing first.
enum InternalApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

model InternalJobApplication {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postingId     String                    @db.Uuid
  associateId   String                    @db.Uuid
  status        InternalApplicationStatus @default(SUBMITTED)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String                    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  coverLetter   String?
  resumeUrl     String?
  reviewerNotes String?
  reviewedById  String?                   @db.Uuid
  reviewedAt    DateTime?                 @db.Timestamptz(6)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(6)

  posting    JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  associate  Associate  @relation(fields: [associateId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("InternalApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([postingId, associateId])
  @@index([associateId])
  @@index([postingId, status])
  @@index([tenantId])
}

// ===== Phase 121 — Vaccination + medical records ===========================
//
// Each row is one shot or test. Multi-dose vaccines (Hep B, COVID) get one
// row per dose with doseNumber and totalDoses to track completion.
// expiresOn drives the expirations dashboard for renewals (TB tests, flu).
enum VaccinationKind {
  COVID19
  INFLUENZA_FLU
  HEPATITIS_B
  TDAP
  MMR
  TB_TEST
  OTHER
}

model VaccinationRecord {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId    String          @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind           VaccinationKind
  customLabel    String?
  doseNumber     Int             @default(1)
  totalDoses     Int?
  administeredOn DateTime        @db.Date
  administeredBy String?
  manufacturer   String?
  lotNumber      String?
  documentUrl    String?
  expiresOn      DateTime?       @db.Date
  notes          String?
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([associateId])
  @@index([kind])
  @@index([expiresOn])
  @@index([tenantId])
}

// ===== Phase 122 — Per-associate legal agreements ==========================
//
// One-off agreements (NDA, non-compete, IP assignment, arbitration, equity
// grants) that are signed by the individual associate. Distinct from
// PolicyAck (company-wide policies). supersedesId points at an older
// agreement the new one replaces — useful when an NDA is updated mid-tenure.
enum AgreementKind {
  NDA
  NON_COMPETE
  IP_ASSIGNMENT
  ARBITRATION
  EMPLOYMENT_OFFER
  SEPARATION_AGREEMENT
  EQUITY_GRANT
  OTHER
}

enum AgreementStatus {
  PENDING_SIGNATURE
  SIGNED
  EXPIRED
  SUPERSEDED
}

model Agreement {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId    String          @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind           AgreementKind
  customLabel    String?
  status         AgreementStatus @default(PENDING_SIGNATURE)
  documentUrl    String?
  effectiveDate  DateTime?       @db.Date
  expiresOn      DateTime?       @db.Date
  signedAt       DateTime?       @db.Timestamptz(6)
  signature      String?
  supersedesId   String?         @db.Uuid
  notes          String?
  issuedById     String?         @db.Uuid
  /// Last unsigned-agreement reminder sent by the daily sweep.
  reminderSentAt DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  /// Soft delete — a legal record is never hard-deleted.
  deletedAt      DateTime?       @db.Timestamptz(6)

  associate    Associate   @relation(fields: [associateId], references: [id], onDelete: Cascade)
  supersedes   Agreement?  @relation("AgreementSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Agreement[] @relation("AgreementSupersedes")
  issuedBy     User?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([associateId])
  @@index([status])
  @@index([expiresOn])
  @@index([tenantId])
}

// ===== Phase 123 — HR cases (ticketing) =====================================
//
// Associates file cases against HR — benefits questions, payroll discrepancies,
// workplace concerns, etc. HR routes via assignedToId, advances status, leaves
// public replies and internalNote breadcrumbs (hidden from the associate). The
// model deliberately distinguishes user-author vs associate-author so HR
// replies and associate replies can both be threaded into the same comment
// stream without identity confusion.
enum CaseCategory {
  BENEFITS
  PAYROLL
  TIME_OFF
  PERSONAL_INFO
  WORKPLACE_CONCERN
  HARASSMENT
  PERFORMANCE
  OTHER
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_ASSOCIATE
  RESOLVED
  CLOSED
}

model HrCase {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId      String       @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  category         CaseCategory
  subject          String
  description      String
  priority         CasePriority @default(MEDIUM)
  status           CaseStatus   @default(OPEN)
  assignedToId     String?      @db.Uuid
  resolvedAt       DateTime?    @db.Timestamptz(6)
  resolution       String?
  /// SLA (HR pack 2026-10): when a first resolution is due, from the category × priority target.
  dueAt            DateTime?    @db.Timestamptz(6)
  /// The clock stops while the case waits on the associate; resumes when they reply.
  slaPausedAt      DateTime?    @db.Timestamptz(6)
  slaPausedMinutes Int          @default(0)
  slaBreachedAt    DateTime?    @db.Timestamptz(6)
  slaEscalatedAt   DateTime?    @db.Timestamptz(6)
  /// HR walk 13: how a case HR filed for the person came in — PHONE | WALK_IN | EMAIL. Null when self-filed.
  channel          String?      @db.VarChar(12)
  /// The HR user who filed it on the associate's behalf; null when the associate filed it.
  filedByUserId    String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  associate     Associate       @relation(fields: [associateId], references: [id], onDelete: Cascade)
  assignedTo    User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  filedBy       User?           @relation("HrCaseFiledBy", fields: [filedByUserId], references: [id], onDelete: SetNull)
  /// The safety incidents this case was opened for (incident.loop).
  oshaIncidents OshaIncident[]
  comments      HrCaseComment[]

  @@index([associateId])
  @@index([status])
  @@index([category])
  @@index([assignedToId])
  @@index([tenantId])
}

model HrCaseComment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId            String   @db.Uuid
  authorUserId      String?  @db.Uuid
  authorAssociateId String?  @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId          String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  body              String
  internalNote      Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  case            HrCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorUser      User?      @relation("HrCaseCommentUserAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAssociate Associate? @relation("HrCaseCommentAssociateAuthor", fields: [authorAssociateId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([tenantId])
}

// ===== HR pack (2026-10) — case SLAs, policy campaigns, letters, retention, mass update

/// The resolution target for one category × priority of HR case, per tenant.
/// No row = the built-in default (lib/hrCaseSla.ts).
model HrCaseSlaPolicy {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  category    CaseCategory
  priority    CasePriority
  targetHours Int
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, category, priority])
}

enum PolicyCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum PolicyCampaignRecipientStatus {
  PENDING
  SIGNED
  WAIVED
}

/// A policy sent to an audience at once: one template version, a due date,
/// a reminder cadence, and a signature per person (typed name + audit panel).
model PolicyCampaign {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name              String
  templateId        String               @db.Uuid
  versionId         String               @db.Uuid
  /// { kind: 'ALL' | 'DEPARTMENT' | 'CLIENT' | 'SITE' | 'ROLE', ids?: string[], roles?: string[] }
  audience          Json
  dueOn             DateTime             @db.Date
  reminderEveryDays Int                  @default(3)
  status            PolicyCampaignStatus @default(DRAFT)
  createdById       String?              @db.Uuid
  launchedAt        DateTime?            @db.Timestamptz(6)
  closedAt          DateTime?            @db.Timestamptz(6)
  lastReminderAt    DateTime?            @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)

  template   DocumentTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version    DocumentTemplateVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  recipients PolicyCampaignRecipient[]

  @@index([tenantId, status])
}

model PolicyCampaignRecipient {
  id              String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId      String                        @db.Uuid
  associateId     String                        @db.Uuid
  tenantId        String                        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  status          PolicyCampaignRecipientStatus @default(PENDING)
  /// The policy as this person saw it (tokens rendered), frozen at launch.
  renderedBody    String
  signature       String?
  signedAt        DateTime?                     @db.Timestamptz(6)
  signerIp        String?
  signerUserAgent String?
  /// SHA-256 of the rendered body + signature line — the audit panel's hash.
  contentSha256   String?
  remindedAt      DateTime?                     @db.Timestamptz(6)
  waivedById      String?                       @db.Uuid
  waiveReason     String?
  createdAt       DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                      @updatedAt @db.Timestamptz(6)

  campaign  PolicyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  associate Associate      @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([campaignId, associateId])
  @@index([associateId, status])
  @@index([tenantId])
}

enum VerificationLetterKind {
  EMPLOYMENT
  INCOME
}

enum VerificationLetterStatus {
  REQUESTED
  APPROVED
  DECLINED
}

/// A verification-of-employment or income letter: requested by the person,
/// approved by HR, rendered from a snapshot taken at approval.
model VerificationLetter {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId       String                   @db.Uuid
  kind              VerificationLetterKind
  status            VerificationLetterStatus @default(REQUESTED)
  addressedTo       String?
  purpose           String?
  requestedByUserId String?                  @db.Uuid
  decidedById       String?                  @db.Uuid
  decidedAt         DateTime?                @db.Timestamptz(6)
  declineReason     String?
  /// What the letter says, frozen at approval: employer, title, dates, pay.
  snapshot          Json?
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([associateId])
  @@index([tenantId, status])
}

/// How long a kind of document is kept after the person separates; then the
/// file is purged (the row stays, with purgedAt) and an audit row is written.
model DocumentRetentionPolicy {
  id                         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind                       DocumentKind
  retainYearsAfterSeparation Int
  createdAt                  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, kind])
}

/// One mass update: the filter, the changes, and each person's "before" so
/// the batch can be undone inside its window.
model MassUpdateBatch {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  actorUserId   String?   @db.Uuid
  filter        Json
  changes       Json
  affected      Json
  affectedCount Int
  appliedAt     DateTime  @default(now()) @db.Timestamptz(6)
  undoneAt      DateTime? @db.Timestamptz(6)
  undoneById    String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenantId, appliedAt(sort: Desc)])
}

// ===== Phase 124 — Knowledge base / FAQ ===================================
//
// Per-client OR company-wide (clientId NULL) self-service articles.
// View counts and helpful/notHelpful tallies are denormalized on the
// row and updated via dedicated endpoints to dodge contention. KbFeedback
// is the per-associate vote — unique on (articleId, associateId) so each
// person can vote at most once.
enum KbStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KbArticle {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  title       String
  slug        String
  body        String
  category    String
