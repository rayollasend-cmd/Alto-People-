// Singleton org-wide branding settings (Phase: settings audit row #8).
// Enforced single-row by a CHECK on the literal id 'singleton'. Logo is
// stored as a Buffer (small assets only, capped at 1MB at the route layer
// to keep the row from getting silly). Everything is nullable + falls back
// to the hard-coded brand defaults baked into emailTemplates.ts so the
// system still ships emails even if HR never visits this page.
model OrgSetting {
  id                     String                 @id @default(dbgenerated("substr(md5((gen_random_uuid())::text), 1, 16)")) @db.VarChar(16)
  orgName                String                 @default("Alto HR") @db.VarChar(120)
  /// What this tenant's team calls Hugo, the assistant (product taxonomy 2026-10-13).
  assistantName          String                 @default("Hugo") @db.VarChar(60)
  /// A multistate employer reports every new hire to this one state (42 USC 653a(b)(1)(B)); null = each hire's work state.
  newHireMultistateState String?                @db.VarChar(2)
  /// Brief 1A-2: the one definition of active counts work in this many trailing days.
  activeWindowDays       Int                    @default(14)
  /// Brief 1A-2: the company workweek — the day it starts (0 = Sunday … 6 = Saturday) in the company time zone. Sites keep their own zone on Location.timezone.
  weekStartsOn           Int                    @default(6)
  timezone               String                 @default("America/New_York") @db.VarChar(64)
  /// Brief 2-5 step 7: who hears the security alerts (sign-in anomalies, privilege changes, exports) by email.
  securityContactEmail   String?                @db.VarChar(254)
  /// The date an auditor issued the SOC 2 report, set by the operator (PUT /trust/soc2). Null until one
  /// exists: the Trust Center then says "preparing" or "in observation" from the controls, never "audited".
  soc2ReportIssuedOn     DateTime?              @db.Date
  // The display name in the From: header — combined at send time as
  // "{senderName} <{RESEND_FROM bare email}>". When null, the env's
  // RESEND_FROM is used verbatim.
  senderName             String?                @db.VarChar(120)
  // Replaces the hard-coded info@altohr.com support address shown in the
  // email footer. RESEND_REPLY_TO env still controls the actual Reply-To
  // header — this is for the displayed address only.
  supportEmail           String?                @db.VarChar(254)
  // Hex like "#0F2A44". Validated at the API + UI layer.
  primaryColor           String?                @db.VarChar(7)
  // PNG/JPEG/WebP/SVG, ≤1MB. Embedded as data: URI in HTML emails so we
  // don't depend on a CDN being reachable.
  /// One row per tenant (unique): the assistant's name and the rest of the branding are each tenant's own. Alto HR's row keeps id 'singleton'.
  tenantId               String                 @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  logoBytes              Bytes?
  logoContentType        String?                @db.VarChar(64)
  logoUpdatedAt          DateTime?              @db.Timestamptz(6)
  // Gap 10 — IRS standard mileage rate, snapshot-copied onto every new
  // mileage ExpenseLine at submit time so a rate change can't silently
  // re-price already-approved rows. IRS announces the next-year rate in
  // December; HR updates this column at year start.
  mileageRatePerMile     Decimal                @default(0.6700) @db.Decimal(8, 4)
  // Org-enforced MFA policy. OFF = opt-in only. ADMINS = admin-class roles
  // (derived from capabilities — see isMfaAdminRole in packages/shared)
  // must enroll in TOTP before a password sign-in completes. ALL = every
  // human role. Passkey sign-in is exempt (it is already strong auth).
  mfaRequirement         MfaRequirement         @default(OFF)
  /// Finance's shared mailbox. Every financial-change alert is also sent
  /// here when set, so an alert is never lost to one person's inbox.
  financeMailbox         String?                @db.VarChar(254)
  /// What payroll does with a bank change Finance has not verified by the
  /// cutoff: pay the previous verified account, or hold the pay.
  unverifiedPayoutPolicy UnverifiedPayoutPolicy @default(PREVIOUS_VERIFIED)
  /// Earned-wage access: on/off, the share of earned net a person may draw
  /// before payday, the fee per advance, and the most per pay period.
  ewaEnabled             Boolean                @default(true)
  ewaCapPct              Int                    @default(50)
  ewaFeeCents            Int                    @default(0)
  ewaMaxPerPeriodCents   Int                    @default(100000)
  // When the automatic recruiting clean-up first ran here. Nothing it
  // closes closes before a grace period after this — see recruitingCleanup.
  recruitingCleanupSince DateTime?              @db.Timestamptz(6)
  // Approval engine (2026-10): the maker-checker switches. A second person
  // is required only where one exists — a one-admin tenant is never locked out.
  /// A pay-rate change this far (percent) from the current rate needs a second person. 0 = every change.
  payChangeApprovalPct   Int                    @default(10)
  payChangeAlwaysApprove Boolean                @default(false)
  billRateApproval       Boolean                @default(true)
  separationSecondPerson Boolean                @default(true)
  selfServiceApproval    Boolean                @default(false)
  roleChangeApproval     Boolean                @default(true)
  requisitionApproval    Boolean                @default(true)
  /// Before a run pays out, someone signs off on its review report (a second person where one exists).
  payrollReviewRequired  Boolean                @default(true)
  /// Overtime offered fewest-overtime-first (lib/overtimeRotation).
  otEqualization         Boolean                @default(false)
  /// Finance walk (2026-10-21): the remit-to printed on every invoice and statement — the
  /// name checks are payable to, the address lines (newline-separated) and how to pay (ACH
  /// details). Null = the employer-of-record's legal name and address.
  remitToName            String?                @db.VarChar(255)
  remitToAddress         String?                @db.VarChar(500)
  remitToInstructions    String?                @db.VarChar(500)
  /// The cash floor the forecast draws as a band; null = no floor set.
  cashMinimum            Decimal?               @db.Decimal(14, 2)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)
}

// IRS payroll-tax constants that change yearly. One row per calendar year.
// The withholding engine in lib/payrollTax.ts loads the row matching the
// pay-date year at boot, caches it in-process, and uses it for the life
// of the process. SUTA per-state tables and state income brackets stay
// as code constants — they're not affected by federal annual updates and
// the org is Florida-only anyway. See seed-of-record at the bottom of
// the add_payroll_config migration.
model PayrollConfig {
  id                         String   @id @default(uuid()) @db.Uuid
  year                       Int      @unique
  // IRS Pub 15-T Worksheet 1A annual percentage method, "Standard
  // Withholding Rate Schedules" (W-4 Step 2 box NOT checked). Each value
  // is a JSON array of { over, flat, rate } objects, ascending by `over`.
  fedBracketsSingle          Json
  fedBracketsMfj             Json
  fedBracketsHoh             Json
  // SSA wage base for the year. Wages above this in YTD are not subject
  // to the 6.2% Social Security tax.
  ssWageBase                 Decimal  @db.Decimal(12, 2)
  // Additional 0.9% Medicare surcharge YTD threshold (IRC §3101(b)(2)).
  // Has held at $200,000 since 2013; lives here so the engine reads
  // every parameter from one source.
  medicareSurchargeThreshold Decimal  @db.Decimal(12, 2)
  // Tier-2 — {"HI": 0.045, ...}: flat withholding rates for states not
  // covered by the code tables. Consulted before the 4% blanket
  // fallback, so finance can tune the long tail without a deploy.
  stateFlatRates             Json?
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(6)

  @@map("payroll_config")
}

// Tier-2 — city/county income tax rules (Philadelphia wage tax, Ohio
// municipal, NYC resident, Indiana counties). Flat-rate on gross;
// assigned per-associate. Kept minimal — a locality with a wage base or
// progressive schedule needs a code table like the states.
model LocalTaxRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state     String   @db.VarChar(2)
  name      String
  rate      Decimal  @db.Decimal(6, 5)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  associates Associate[]

  @@index([state, isActive])
}

// Gap 1 — Singleton row carrying the SSA BSO submitter block used at the
// top of every EFW2 e-file we generate. HR fills this in once during BSO
// enrollment; subsequent filings read from here so finance never has to
// re-enter the User ID. Same fixed-id-of-'singleton' pattern as OrgSetting.
model SubmitterProfile {
  id              String   @id @default(dbgenerated("substr(md5((gen_random_uuid())::text), 1, 16)")) @db.VarChar(16)
  // 9-digit EIN, no dashes (validated by CHECK in the migration).
  ein             String   @db.VarChar(9)
  // BSO User ID — assigned by SSA when the company registers for the
  // Business Services Online portal. Required to file electronically.
  userId          String   @db.VarChar(17)
  name            String   @db.VarChar(57)
  addressLine1    String   @db.VarChar(22)
  addressLine2    String?  @db.VarChar(22)
  city            String   @db.VarChar(22)
  state           String   @db.VarChar(2)
  zip5            String   @db.VarChar(5)
  zip4            String?  @db.VarChar(4)
  contactName     String   @db.VarChar(57)
  contactPhone    String   @db.VarChar(20)
  contactEmail    String   @db.VarChar(40)
  // Gap 11 — IRS FIRE Transmitter Control Code (5 chars, IRS-assigned).
  // Required for 1099-NEC e-file via FIRE; null when the transmitter
  // only does W-2 SSA filings.
  irsTcc          String?  @db.VarChar(5)
  // Tier-1 — the employer's IRS 941 deposit schedule, from the lookback
  // rule (Pub 15 §11): MONTHLY (≤$50k liability in the lookback period,
  // deposits due the 15th of the following month) or SEMIWEEKLY
  // (Wed–Fri paydays due next Wednesday, Sat–Tue due next Friday).
  depositSchedule String   @default("MONTHLY") @db.VarChar(12)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String  @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

}

// Tier-1 — federal tax deposit ledger. Every disbursed run accrues a
// FED_941 deposit obligation (FIT + employee & employer FICA/Medicare)
// with a due date computed from the employer's deposit schedule; FUTA
// accrues per quarter (due end of month after quarter once > $500).
// The system tracks and reminds — the actual EFTPS payment is made by
// finance (worksheet PDF) and marked paid here with the EFTPS
// acknowledgment number.
enum TaxDepositKind {
  FED_941
  FUTA
}

enum TaxDepositStatus {
  PENDING
  PAID
}

model TaxDeposit {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId           String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind               TaxDepositKind
  // Deposit schedule in force when this obligation was computed.
  scheduleUsed       String           @db.VarChar(12)
  // Human label: the payday for FED_941 ("2026-07-18 payday"), the
  // quarter for FUTA ("2026-Q3").
  periodLabel        String
  // FED_941 deposits tie to the run whose disbursement created the
  // liability; unique so re-disbursement can't double-accrue.
  payrollRunId       String?          @unique @db.Uuid
  liabilityDate      DateTime         @db.Date
  dueDate            DateTime         @db.Date
  amount             Decimal          @db.Decimal(12, 2)
  // {fit, ssEmployee, ssEmployer, medEmployee, medEmployer} or {futa}.
  breakdown          Json
  status             TaxDepositStatus @default(PENDING)
  paidAt             DateTime?        @db.Timestamptz(6)
  paidById           String?          @db.Uuid
  // EFTPS acknowledgment number keyed in by finance when marking paid.
  confirmationNumber String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)
  payrollRun         PayrollRun?      @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  paidBy             User?            @relation("TaxDepositPayer", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([kind, periodLabel])
  @@index([tenantId])
}

// Status of OUR processing of a Branch webhook delivery — distinct from
// the Branch payment lifecycle status carried in the payload.
enum BranchWebhookStatus {
  PROCESSED // applied to PayrollItem / PayrollRun as expected
  IGNORED // valid signature, but no matching PayrollItem (cross-env, race)
  DUPLICATE // event ID already processed — short-circuited
  ERROR // exception during processing; admin needs to investigate
}

// Audit log of every inbound Branch webhook delivery + idempotency mechanism.
// branchEventId is UNIQUE so a duplicate POST collapses at INSERT and the
// handler skips reprocessing. Full raw payload is preserved so finance can
// reconcile even if PayrollItem / PayrollDisbursementAttempt rows are
// edited later.
model BranchWebhookEvent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchEventId String              @unique
  // payment.completed, payment.failed, payment.returned, etc.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  eventType     String
  payload       Json
  status        BranchWebhookStatus @default(PROCESSED)
  // Matched PayrollItem when applicable; null for IGNORED/DUPLICATE.
  payrollItemId String?             @db.Uuid
  // Free-text "why" for non-PROCESSED rows (unknown payment, parse error).
  notes         String?
  receivedAt    DateTime            @default(now()) @db.Timestamptz(6)
  processedAt   DateTime?           @db.Timestamptz(6)

  payrollItem PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  @@index([eventType, receivedAt])
  @@index([status, receivedAt])
  @@index([tenantId])
}

enum ResendWebhookStatus {
  PROCESSED // matched a Notification row and applied the status change
  IGNORED // valid signature but unhandled event type / unknown message id
  ERROR // exception during processing; admin needs to investigate
}

// Audit log of every inbound Resend email-event webhook delivery + the
// idempotency mechanism (mirrors BranchWebhookEvent). svixId — Svix's
// per-delivery message id — is UNIQUE so a duplicate POST collapses at
// INSERT and the handler skips reprocessing.
model ResendWebhookEvent {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  svixId         String              @unique
  // email.delivered, email.bounced, email.complained, etc.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  eventType      String
  payload        Json
  status         ResendWebhookStatus @default(PROCESSED)
  // Matched Notification when applicable; null for IGNORED rows.
  notificationId String?             @db.Uuid
  // Free-text "why" for non-PROCESSED rows (unknown message id, parse error).
  notes          String?
  receivedAt     DateTime            @default(now()) @db.Timestamptz(6)
  processedAt    DateTime?           @db.Timestamptz(6)

  @@index([eventType, receivedAt])
  @@index([status, receivedAt])
  @@index([tenantId])
}

enum EmailSuppressionReason {
  BOUNCED // hard bounce reported by the provider
  COMPLAINED // recipient marked a message as spam
  MANUAL // admin added the address by hand
}

// Do-not-email list. Before any real EMAIL send, lib/notifications.ts
// checks this table and short-circuits to a SUPPRESSED delivery status —
// continuing to mail hard-bounced or complaining addresses tanks sender
// reputation for everyone. Rows are upserted by the /resend/webhook
// handler on hard bounce / complaint and removable by admins (audited)
// via /communications/admin/suppressions.
model EmailSuppression {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Always stored lowercased; lookups lowercase the candidate first.
  email     String                 @unique
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String                 @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  reason    EmailSuppressionReason
  notes     String?
  createdAt DateTime               @default(now()) @db.Timestamptz(6)

  @@index([tenantId])
}

/// A phone number that texted STOP (or was opted out by hand): no SMS goes to it
/// until START / a manual clear. Keyed by the E.164 number, platform-wide — the
/// carrier opt-out applies to the number, whichever tenant texted it.
model SmsOptOut {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @unique
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// STOP (the carrier keyword), MANUAL (an admin), or the keyword as received.
  reason    String   @db.VarChar(40)
  source    String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId])
}

// Manual compliance attestation — used for billing/invoicing scorecard
// signals where the actual action happens outside Alto (Fieldglass,
// Walmart vendor portal, QBO) and the only thing we track is "did HR
// confirm they did it for this period?". One attestation row per
// (key, periodStart) — re-attesting the same period overwrites via
// upsert at the route layer. Attestation is read-mostly: HR clicks
// the row, confirms outcome + when the action was taken, and the
// scorecard tile flips green.
enum ManualAttestationOutcome {
  YES // action was taken
  NO // action was missed / skipped
  NOT_APPLICABLE // not applicable for this period (e.g. holiday week)
}

model ManualComplianceAttestation {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stable identifier from the in-code config map (e.g. MONTHLY_REPORT,
  // INVOICE_FORFEITURE, FIELDGLASS_TIMESHEET). Not a Prisma enum so new
  // signals can ship without a migration.
  key                String                   @db.VarChar(64)
  // Period the attestation covers. periodStart is the canonical key —
  // periodEnd is denormalized for query convenience. Both stored as
  // UTC dates; cadence (weekly/monthly) lives in code.
  periodStart        DateTime                 @db.Date
  periodEnd          DateTime                 @db.Date
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId           String                   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  outcome            ManualAttestationOutcome
  // When HR actually performed the action (in Fieldglass / portal).
  // Nullable for NOT_APPLICABLE attestations.
  actionTakenAt      DateTime?                @db.Timestamptz(6)
  attestedById       String                   @db.Uuid
  attestedAt         DateTime                 @default(now()) @db.Timestamptz(6)
  notes              String?
  // Optional pointer to a screenshot/PDF the operator uploaded as
  // evidence. References DocumentRecord so it lives in the same
  // /documents vault and benefits from the same fileAvailable check.
  evidenceDocumentId String?                  @db.Uuid

  attestedBy       User            @relation("AttestationAttester", fields: [attestedById], references: [id], onDelete: Restrict)
  evidenceDocument DocumentRecord? @relation("AttestationEvidence", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key, periodStart])
  @@index([key, periodEnd])
  @@index([tenantId])
}

/// HR put off one attestation's reminders until a date — the daily digest
/// leaves it out until then. One row per (tenant, signal, period).
model AttestationSnooze {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  key          String   @db.VarChar(64)
  periodStart  DateTime @db.Date
  snoozedUntil DateTime @db.Timestamptz(6)
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, key, periodStart])
  @@index([tenantId])
}

// Daily posture snapshot — the scorecard's memory. One row per day
// org-wide (clientId NULL) plus one per client, written by the
// complianceSnapshot cron. Never updated in place after the day closes:
// the history doubles as audit evidence of past compliance posture.
model ComplianceScoreSnapshot {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day                  DateTime @db.Date
  // NULL = org-wide rollup. Non-null = that client's slice.
  clientId             String?  @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  score                Int
  criticalCount        Int
  warnCount            Int
  activeAssociateCount Int
  fullyCompliantCount  Int
  // Per-tile severities at snapshot time, e.g. {"onboarding":"warn",...}.
  tileSeverities       Json
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([day, clientId])
  @@index([clientId, day(sort: Desc)])
  @@index([tenantId])
}

// Remediation state for a scorecard action. The action rows themselves
// are DERIVED (regenerated from live data every load) with stable ids —
// this table pins human workflow onto those ids: who owns it, snoozed
// until when, done. Rows for gaps that self-heal (the underlying data
// gets fixed) simply stop matching any generated action.
model ComplianceActionState {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The derived ScorecardAction.id (e.g. "onb:I9_BOTH_SECTIONS:<uuid>").
  actionKey      String    @db.VarChar(300)
  status         String    @default("OPEN") @db.VarChar(16) // OPEN | SNOOZED | DONE
  assigneeUserId String?   @db.Uuid
  snoozedUntil   DateTime? @db.Timestamptz(6)
  updatedById    String?   @db.Uuid
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  assignee  User?   @relation("ComplianceActionAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("ComplianceActionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([assigneeUserId])
  @@index([status])
  @@unique([tenantId, actionKey])
  @@index([tenantId])
}

/// A recorded Fieldglass filing for one Sat→Fri week (optionally one client).
/// Snapshots the per-worker hours + total at filing time so later edits to
/// the underlying time entries surface as drift on the Timesheets page.
model TimesheetFiling {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekStart  DateTime @db.Date // the Saturday that starts the week (store-local)
  clientId   String?  @db.Uuid // null = all-clients filing
  filedById  String?  @db.Uuid // no relation — resolved by lookup like other actor ids
  filedAt    DateTime @default(now()) @db.Timestamptz(6)
  totalHours Decimal  @db.Decimal(10, 2)
  snapshot   Json // { [associateId]: { worker: string, hours: number } }
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  // NOTE: this compound unique does NOT constrain clientId=NULL rows —
  // Postgres treats NULLs as distinct. The org-wide filing's uniqueness is
  // enforced by a hand-managed partial index (migration 20260730180000):
  //   CREATE UNIQUE INDEX ... ON "TimesheetFiling"("weekStart")
  //     WHERE "clientId" IS NULL;
  // Same pattern as TimeEntry's one-ACTIVE-per-associate partial unique.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  @@unique([weekStart, clientId])
  @@index([weekStart])
  @@index([tenantId])
}

/// One remembered response per (user, method, path, Idempotency-Key).
/// Backs the optional Idempotency-Key request header on money-moving /
/// bulk-send POST endpoints: a network-level retry with the same key
/// replays the stored response instead of re-executing the mutation.
/// responseStatus NULL marks an in-flight original (claims the key);
/// rows expire after 24h and are swept hourly.
model IdempotencyRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(512)
  key            String   @db.VarChar(200)
  requestHash    String   @db.VarChar(64)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, method, path, key])
  @@index([createdAt])
  @@index([tenantId])
}

// A supervisor's shift — which of a store's named shift windows they lead,
// the way they're assigned a client. Keyed by (store, window LABEL), not a
// StaffingTarget row: targets are effective-dated, and a new headcount for
// "Overnight" is a new row — the lead stays the lead. The window's hours
// come from the store's current target for that label. Focus, not a lock:
// it shapes a supervisor's default views and routes their alerts; it never
// narrows what they may see.
// A shift supervisor hands their shift to one of their floor supervisors
// for a day or a run of days (a day off, time off). On those days the
// floor supervisor's clock-in opens the store shift's SOP for THEM — they
// read the incoming handover, run it, hand over, and can't clock out until
// it's submitted. Dates are the store-local day each shift occurrence
// STARTS (an overnight that starts Sep 20 at 10p is Sep 20's), inclusive.
// Cancelling keeps the row (cancelledAt) — the record of who covered.
model ShiftCover {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadUserId  String    @db.Uuid
  coverUserId String    @db.Uuid
  fromDate    String    @db.VarChar(10)
  toDate      String    @db.VarChar(10)
  note        String?   @db.VarChar(500)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  lead      User    @relation("ShiftCoverLead", fields: [leadUserId], references: [id], onDelete: Cascade)
  cover     User    @relation("ShiftCoverCover", fields: [coverUserId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ShiftCoverCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([leadUserId, toDate])
  @@index([coverUserId, toDate])
  @@index([tenantId])
}

model SupervisorShiftWindow {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  locationId String   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId   String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  label      String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user     User @relation("SupervisorWindows", fields: [userId], references: [id], onDelete: Cascade)
  location Site @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId, label])
  @@index([locationId, label])
  @@index([tenantId])
}

// ===== Transportation — the Alto vans ======================================
//
// Associates book a seat on an Alto van to or from work — independent of
// the schedule (people come in without a shift too). The Transportation
// Director dispatches the bookings onto van runs (a van, a driver, a
// departure, the pickups in order); the driver marks each rider on board
// or no-show; the fare ($5 a ride) or the no-show fee ($1) is taken from
// the paycheck of the pay period the ride was in.

enum RideDirection {
  TO_WORK
  FROM_WORK
}

enum RideStatus {
  REQUESTED // booked, waiting for a van
  SCHEDULED // on a van run, with a pickup time
  BOARDED // the driver has them on board
  COMPLETED // dropped off
  NO_SHOW // wasn't there at pickup
  CANCELLED
}

enum RideRunStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransportIssueCategory {
  LATE_VAN
  MISSED_PICKUP
  CHARGE_DISPUTE
  SAFETY
  VEHICLE
  CONDUCT
  OTHER
}

enum TransportIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// A fixed pickup point — a housing complex, a meeting spot.
model TransportStop {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @db.VarChar(120)
  address    String       @db.VarChar(300)
  lat        Decimal?     @db.Decimal(9, 6)
  lng        Decimal?     @db.Decimal(9, 6)
  notes      String?      @db.VarChar(500)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId   String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  rides      Ride[]
  rideSeries RideSeries[]

  @@index([tenantId])
}

model Van {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String              @db.VarChar(60)
  plate                 String?             @db.VarChar(20)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId              String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  capacity              Int
  isActive              Boolean             @default(true)
  notes                 String?             @db.VarChar(500)
  // What riders look for at the curb: "White Ford Transit 2023 · ALT 101".
  make                  String?             @db.VarChar(40)
  model                 String?             @db.VarChar(40)
  color                 String?             @db.VarChar(30)
  year                  Int?
  /// The van's driver — the one who accepts seat requests in it. One van
  /// per driver; the director assigns and unassigns.
  driverUserId          String?             @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)
  // The fleet record: what the registration, the insurer and the state
  // inspection say about this van, and how far it has gone. The odometer
  // is written by each pre-trip check. A van out of service is skipped by
  // auto-plan and refused by dispatch until it is put back.
  vin                   String?             @db.VarChar(17)
  registrationExpiresAt DateTime?           @db.Date
  insuranceExpiresAt    DateTime?           @db.Date
  inspectionDueAt       DateTime?           @db.Date
  odometerMiles         Int?
  outOfServiceAt        DateTime?           @db.Timestamptz(6)
  outOfServiceReason    String?             @db.VarChar(300)
  runs                  RideRun[]
  driver                User?               @relation("VanDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  serviceLog            VanServiceEntry[]
  preTripChecks         PreTripCheck[]
  incidents             TransportIncident[]

  @@index([driverUserId])
  @@index([tenantId])
}

enum VanServiceKind {
  FUEL
  OIL_CHANGE
  TIRES
  BRAKES
  INSPECTION
  REPAIR
  CLEANING
  OTHER
}

/// One line of a van's service log — fuel, an oil change, the state
/// inspection, a repair — with what it cost. Fuel and maintenance are the
/// van's side of cost per seat.
model VanServiceEntry {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vanId         String         @db.Uuid
  tenantId      String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind          VanServiceKind
  occurredAt    DateTime       @db.Date
  odometerMiles Int?
  costCents     Int            @default(0)
  vendor        String?        @db.VarChar(120)
  notes         String?        @db.VarChar(500)
  /// The receipt photo (a transport blob key, served at /transport/photos/:key) — the driver's fuel receipt.
  photoS3Key    String?        @db.VarChar(300)
  createdById   String?        @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  van           Van            @relation(fields: [vanId], references: [id], onDelete: Cascade)

  @@index([vanId, occurredAt])
  @@index([tenantId])
}

/// The driver's walk around the van before a run leaves: each item passed
/// or failed, the odometer, a photo. A failed safety item keeps the run
/// from starting and opens a VEHICLE issue for the director.
model PreTripCheck {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId         String   @unique @db.Uuid
  vanId         String   @db.Uuid
  driverUserId  String   @db.Uuid
  tenantId      String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// [{ key, ok, note? }] over PRE_TRIP_ITEMS (lib/transportDrivers).
  items         Json
  passed        Boolean
  odometerMiles Int?
  photoS3Key    String?  @db.VarChar(300)
  notes         String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  run           RideRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  van           Van      @relation(fields: [vanId], references: [id], onDelete: Cascade)
  driver        User     @relation("PreTripDriver", fields: [driverUserId], references: [id], onDelete: Cascade)

  @@index([vanId, createdAt])
  @@index([tenantId])
}

enum TransportIncidentKind {
  COLLISION
  INJURY
  BREAKDOWN
  NEAR_MISS
  PROPERTY_DAMAGE
  OTHER
}

enum TransportIncidentStatus {
  OPEN
  REVIEWED
  CLOSED
}

/// An accident or incident on the road, written up in the structured form
/// the insurer and the safety log both need. An injury to a person also
/// opens an OSHA incident; a collision or breakdown parks the van.
model TransportIncident {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind                TransportIncidentKind
  status              TransportIncidentStatus @default(OPEN)
  runId               String?                 @db.Uuid
  vanId               String?                 @db.Uuid
  reportedById        String                  @db.Uuid
  occurredAt          DateTime                @db.Timestamptz(6)
  lat                 Decimal?                @db.Decimal(9, 6)
  lng                 Decimal?                @db.Decimal(9, 6)
  description         String                  @db.VarChar(4000)
  injuries            Boolean                 @default(false)
  /// Associate ids of the people hurt; each gets an OSHA incident.
  injuredAssociateIds Json                    @default("[]")
  /// Other parties: [{ name, phone?, plate?, insurer?, note? }].
  parties             Json                    @default("[]")
  policeReportNumber  String?                 @db.VarChar(60)
  photoKeys           Json                    @default("[]")
  oshaIncidentIds     Json                    @default("[]")
  vanParked           Boolean                 @default(false)
  reviewNote          String?                 @db.VarChar(2000)
  reviewedAt          DateTime?               @db.Timestamptz(6)
  reviewedById        String?                 @db.Uuid
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(6)
  run                 RideRun?                @relation(fields: [runId], references: [id], onDelete: SetNull)
  van                 Van?                    @relation(fields: [vanId], references: [id], onDelete: SetNull)
  reportedBy          User                    @relation("TransportIncidentReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([status, occurredAt])
  @@index([vanId])
  @@index([tenantId])
}

/// A rider's word on a finished ride — a thumb, and why. Never a public
/// score: the director reads the trend by driver and by route.
model RideFeedback {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId      String    @unique @db.Uuid
  associateId String    @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  thumbsUp    Boolean
  /// LATE | DRIVING | VEHICLE | CONDUCT | ROUTE | GREAT | OTHER
  reason      String?   @db.VarChar(20)
  note        String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  ride        Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId])
}

/// A rider's standing booking: the same way, store and pickup on the days
/// of the week they work, booked once. Instances are generated ahead as
/// ordinary rides under the cutoff and waitlist rules; cancelling the
/// series stops the generator and lets the rider cancel instances already
/// made one by one.
model RideSeries {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId      String         @db.Uuid
  tenantId         String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  direction        RideDirection
  locationId       String         @db.Uuid
  stopId           String?        @db.Uuid
  address          String?        @db.VarChar(300)
  lat              Decimal?       @db.Decimal(9, 6)
  lng              Decimal?       @db.Decimal(9, 6)
  /// Booked by store shift ("Morning") — the ride's time is the shift's.
  windowLabel      String?        @db.VarChar(80)
  /// Or a fixed store-local time, HH:MM.
  timeOfDay        String?        @db.VarChar(5)
  /// 0 = Sunday … 6 = Saturday.
  daysOfWeek       Int[]
  startsOn         DateTime       @db.Date
  endsOn           DateTime?      @db.Date
  note             String?        @db.VarChar(300)
  /// The last service date the generator booked through.
  generatedThrough DateTime?      @db.Date
  cancelledAt      DateTime?      @db.Timestamptz(6)
  createdById      String         @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  associate        Associate      @relation(fields: [associateId], references: [id], onDelete: Cascade)
  location         Site           @relation("RideSeriesStore", fields: [locationId], references: [id], onDelete: Cascade)
  stop             TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
  rides            Ride[]

  @@index([associateId, cancelledAt])
  @@index([tenantId])
}

enum NavApp {
  GOOGLE
  APPLE
  WAZE
}

/// What the desk must know about a driver before they take a run: the
/// licence, the DOT medical card where it applies, the last MVR pull —
/// and how they like to navigate. Mirrored into AssociateQualification
/// rows for drivers who are also people on file, so the expirations desk
/// and the Compliance agent see them with everything else.
model DriverProfile {
  userId              String    @id @db.Uuid
  tenantId            String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  navApp              NavApp    @default(GOOGLE)
  licenceNumber       String?   @db.VarChar(40)
  licenceState        String?   @db.VarChar(2)
  licenceClass        String?   @db.VarChar(10)
  licenceExpiresAt    DateTime? @db.Date
  dotMedicalRequired  Boolean   @default(false)
  dotMedicalExpiresAt DateTime? @db.Date
  mvrCheckedAt        DateTime? @db.Date
  /// Driver safety training: when its renewal date is on file, a lapse refuses runs.
  trainingCompletedAt DateTime? @db.Date
  trainingExpiresAt   DateTime? @db.Date
  notes               String?   @db.VarChar(500)
  updatedById         String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  user                User      @relation("DriverProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A driver turned down a seat request — it stays open for the others, and
/// the director hears when every driver has.
model RideRejection {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId       String   @db.Uuid
  driverUserId String   @db.Uuid
  reason       String?  @db.VarChar(200)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  ride         Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver       User     @relation("RideRejectionDriver", fields: [driverUserId], references: [id], onDelete: Cascade)

  @@unique([rideId, driverUserId])
  @@index([driverUserId])
  @@index([tenantId])
}

/// An associate's saved pickup address ("Home").
model RidePlace {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String    @db.Uuid
  label       String    @db.VarChar(40)
  address     String    @db.VarChar(300)
  lat         Decimal?  @db.Decimal(9, 6)
  lng         Decimal?  @db.Decimal(9, 6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([associateId])
  @@index([tenantId])
}

/// The associate's authorization to take ride charges from their pay —
/// given once, in the Ride tab, before their first booking.
model RideConsent {
  associateId    String    @id @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  fareCents      Int
  noShowFeeCents Int
  acceptedAt     DateTime  @default(now()) @db.Timestamptz(6)
  ip             String?   @db.VarChar(64)
  /// Brief 1A-3: a charge needs a SIGNED written authorization. These are
  /// set by the e-sign flow; a row without signatureId is a legacy one-click
  /// consent and authorizes nothing.
  signatureId    String?   @db.Uuid
  documentId     String?   @db.Uuid
  /// RIDE_AUTHORIZATION_VERSION the words were signed at.
  version        Int?
  signedName     String?   @db.VarChar(200)
  /// The TransportRate the signed words name.
  rateId         String?   @db.Uuid
  withdrawnAt    DateTime? @db.Timestamptz(6)
  associate      Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Brief 1A-3: the ride fare and no-show fee, effective-dated. A change
/// never reprices a past ride and asks every rider to sign again.
model TransportRate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  fareCents      Int
  noShowFeeCents Int
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([effectiveFrom])
  @@index([tenantId])
}

model Ride {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId           String        @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId              String        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  direction             RideDirection
  /// The store: where a TO_WORK ride goes, where a FROM_WORK ride starts.
  locationId            String        @db.Uuid
  /// The home end — a stop, or an address (snapshotted at booking).
  stopId                String?       @db.Uuid
  address               String?       @db.VarChar(300)
  lat                   Decimal?      @db.Decimal(9, 6)
  lng                   Decimal?      @db.Decimal(9, 6)
  /// TO_WORK: arrive at the store by. FROM_WORK: picked up at the store at.
  targetAt              DateTime      @db.Timestamptz(6)
  /// The store-local day of targetAt — the board's day and the pay period.
  serviceDate           String        @db.VarChar(10)
  status                RideStatus    @default(REQUESTED)
  /// Informational only — rides never depend on the schedule.
  shiftId               String?       @db.Uuid
  /// The store shift this seat is for ("Morning") — booked by shift, the
  /// ride's time is the shift's start (to work) or end (home). Riders on
  /// the same store shift, way and day share its vans' seats; when they're
  /// full the rest wait in line. Null: booked at an "other time".
  windowLabel           String?       @db.VarChar(80)
  note                  String?       @db.VarChar(300)
  /// Requested inside the planning cutoff — a driver has to take it.
  shortNotice           Boolean       @default(false)
  // Dispatch: the run, the pickup order and time.
  runId                 String?       @db.Uuid
  pickupOrder           Int?
  pickupAt              DateTime?     @db.Timestamptz(6)
  // Charges, snapshotted at booking; chargeCents is what's owed (the fare
  // once on board, the fee on a no-show). chargedRunId stamps the payroll
  // run that took it — the same apply/un-apply rule as clawbacks.
  fareCents             Int
  noShowFeeCents        Int
  chargeCents           Int           @default(0)
  waivedAt              DateTime?     @db.Timestamptz(6)
  waivedById            String?       @db.Uuid
  waiveReason           String?       @db.VarChar(300)
  /// MANAGER (waived on purpose) | NOT_AUTHORIZED (no current signed authorization when marked)
  waiveKind             String?       @db.VarChar(16)
  /// What the ride would have cost when it went uncharged for want of an authorization.
  uncollectedCents      Int           @default(0)
  chargedRunId          String?       @db.Uuid
  chargedItemId         String?       @db.Uuid
  chargedAt             DateTime?     @db.Timestamptz(6)
  /// Brief 1A-3: the Signature that authorized this charge, stamped when
  /// the charge is set (boarding / no-show). Payroll never takes a charge
  /// without it.
  authorizedSignatureId String?       @db.Uuid
  boardedAt             DateTime?     @db.Timestamptz(6)
  completedAt           DateTime?     @db.Timestamptz(6)
  noShowAt              DateTime?     @db.Timestamptz(6)
  cancelledAt           DateTime?     @db.Timestamptz(6)
  cancelledById         String?       @db.Uuid
  cancelReason          String?       @db.VarChar(300)
  /// The rider heard "your van is about 10 minutes away" (once).
  nearNotifiedAt        DateTime?     @db.Timestamptz(6)
  /// The driver tapped "Arrived" at this rider's pickup — the rider hears
  /// "your van is here", and a no-show can only be marked 3 minutes later.
  vanArrivedAt          DateTime?     @db.Timestamptz(6)
  // Where the driver's phone was at Arrived and at No-show, and how far
  // that is from the stop — the evidence behind a disputed no-show fee.
  arrivedLat            Decimal?      @db.Decimal(9, 6)
  arrivedLng            Decimal?      @db.Decimal(9, 6)
  arrivedAccuracyM      Int?
  arrivedDistanceM      Int?
  noShowLat             Decimal?      @db.Decimal(9, 6)
  noShowLng             Decimal?      @db.Decimal(9, 6)
  noShowAccuracyM       Int?
  noShowDistanceM       Int?
  /// The rider told the driver "I'm outside" (OUTSIDE) or "running a few
  /// minutes late" (LATE).
  riderSignal           String?       @db.VarChar(20)
  riderSignalAt         DateTime?     @db.Timestamptz(6)
  /// Who put the seat on a van: a driver accepting the request, or the
  /// director dispatching it (their word overrides).
  acceptedAt            DateTime?     @db.Timestamptz(6)
  acceptedById          String?       @db.Uuid
  /// Every driver has declined — the director has been told (once).
  allDeclinedAt         DateTime?     @db.Timestamptz(6)
  /// An evacuation seat booked from an emergency check-in: fare zero,
  /// pickup at the address on file, bound for the emergency's destination.
  emergencyId           String?       @db.Uuid
  /// Booked by a standing series (RideSeries) rather than by hand.
  seriesId              String?       @db.Uuid
  /// The rider heard they were dropped off / the van finished (once).
  droppedNotifiedAt     DateTime?     @db.Timestamptz(6)
  createdById           String        @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(6)

  associate         Associate          @relation(fields: [associateId], references: [id], onDelete: Cascade)
  location          Site               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stop              TransportStop?     @relation(fields: [stopId], references: [id], onDelete: SetNull)
  run               RideRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  series            RideSeries?        @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  feedback          RideFeedback?
  issues            TransportIssue[]
  rejections        RideRejection[]
  emergency         Emergency?         @relation(fields: [emergencyId], references: [id], onDelete: SetNull)
  emergencyCheckIns EmergencyCheckIn[]

  @@index([seriesId])
  @@index([serviceDate, status])
  @@index([associateId, targetAt])
  @@index([runId])
  @@index([chargedRunId])
  @@index([locationId, direction, windowLabel, targetAt])
  @@index([tenantId])
}

/// One van trip: a van, a driver, a direction, a departure, the riders.
model RideRun {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vanId            String        @db.Uuid
  driverUserId     String        @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  direction        RideDirection
  serviceDate      String        @db.VarChar(10)
  departAt         DateTime      @db.Timestamptz(6)
  status           RideRunStatus @default(PLANNED)
  startedAt        DateTime?     @db.Timestamptz(6)
  endedAt          DateTime?     @db.Timestamptz(6)
  notes            String?       @db.VarChar(500)
  createdById      String        @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  // The van right now — the driver's phone, while the run is on the road.
  lastLat          Decimal?      @db.Decimal(9, 6)
  lastLng          Decimal?      @db.Decimal(9, 6)
  lastHeading      Int?
  lastSpeedMps     Float?
  lastAccuracyM    Int?
  lastLocationAt   DateTime?     @db.Timestamptz(6)
  /// The store supervisors heard this run is running late (once per run).
  lateAlertedAt    DateTime?     @db.Timestamptz(6)
  // Safety (lib/transportSafety): the van sat still off the plan, or drifted
  // off its way — the driver was asked "everything OK?", then the desk was
  // told; the driver's SOS and the desk's acknowledgement.
  stallAlertedAt   DateTime?     @db.Timestamptz(6)
  stallEscalatedAt DateTime?     @db.Timestamptz(6)
  driverOkAt       DateTime?     @db.Timestamptz(6)
  /// The closest the van has come to its next stop, in metres — drift is
  /// measured against it.
  minDistToNextM   Int?
  sosAt            DateTime?     @db.Timestamptz(6)
  sosNote          String?       @db.VarChar(300)
  sosAckAt         DateTime?     @db.Timestamptz(6)
  sosAckById       String?       @db.Uuid
  /// The driver shift (a Shift with position Driver) this run sits in.
  shiftId          String?       @db.Uuid
  /// Closed by the stuck-run sweep (lib/transportStuckRuns), not by a
  /// driver or the desk: left ACTIVE hours past its last stop. Riders
  /// never marked stay SCHEDULED for review — nobody is charged a guess.
  autoClosedAt     DateTime?     @db.Timestamptz(6)

  van          Van                 @relation(fields: [vanId], references: [id], onDelete: Restrict)
  driver       User                @relation("RideRunDriver", fields: [driverUserId], references: [id], onDelete: Restrict)
  rides        Ride[]
  issues       TransportIssue[]
  pings        RideRunPing[]
  preTripCheck PreTripCheck?
  incidents    TransportIncident[]

  @@index([serviceDate])
  @@index([driverUserId, serviceDate])
  @@index([tenantId])
}

/// A rider's, driver's or supervisor's problem with a ride — the
/// Transportation Director's queue.
model TransportIssue {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportedById String                 @db.Uuid
  rideId       String?                @db.Uuid
  runId        String?                @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String                 @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  category     TransportIssueCategory
  body         String                 @db.VarChar(2000)
  status       TransportIssueStatus   @default(OPEN)
  resolution   String?                @db.VarChar(2000)
  resolvedAt   DateTime?              @db.Timestamptz(6)
  resolvedById String?                @db.Uuid
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(6)
  // A driver's report from the road: photos (transport photo keys), where
  // the phone was, and — when the van can't run safely — the van it took
  // off the road (vanParked), which opens the out-of-service record.
  photoKeys    Json                   @default("[]")
  lat          Decimal?               @db.Decimal(9, 6)
  lng          Decimal?               @db.Decimal(9, 6)
  vanId        String?                @db.Uuid
  vanParked    Boolean                @default(false)

  reportedBy User     @relation("TransportIssueReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  ride       Ride?    @relation(fields: [rideId], references: [id], onDelete: SetNull)
  run        RideRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([tenantId])
}

/// The van's trail — one row per location the driver's phone sent while
/// the run was on the road. Kept 30 days (a late-van dispute), then pruned.
model RideRunPing {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String   @db.Uuid
  lat       Decimal  @db.Decimal(9, 6)
  lng       Decimal  @db.Decimal(9, 6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  heading   Int?
  speedMps  Float?
  accuracyM Int?
  at        DateTime @db.Timestamptz(6)
  run       RideRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
  @@index([at])
  @@index([tenantId])
}

/// Address → coordinates, looked up once. `found` false remembers a miss
/// so a bad address isn't looked up on every map refresh.
model GeoCache {
  key       String   @id @db.VarChar(300)
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  found     Boolean
  provider  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

/// The fares and the booking cutoff — one row, the director's to set.
model TransportSettings {
  id                    String   @id @default(dbgenerated("substr(md5((gen_random_uuid())::text), 1, 16)")) @db.VarChar(20)
  fareCents             Int      @default(500)
  noShowFeeCents        Int      @default(100)
  /// Planned rides book this far ahead, so the vans can be planned.
  cutoffHours           Int      @default(10)
  /// Inside the cutoff a seat can still be requested on short notice, down
  /// to this many minutes before the time — flagged for the drivers and
  /// the desk, and real only once a driver takes it. 0 turns it off.
  shortNoticeMinutes    Int      @default(90)
  /// Shown to riders when a ride can't be requested in time.
  dispatchPhone         String?  @db.VarChar(40)
  updatedById           String?  @db.Uuid
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)
  // Drivers' hours of service: the most a driver may drive in a day and
  // the rest between two shifts. Enforced where runs and driver shifts are
  // assigned. The pre-trip check can be switched off for a fleet that does
  // it on paper.
  driverMaxHoursPerDay  Int      @default(10)
  driverMinRestHours    Int      @default(8)
  preTripRequired       Boolean  @default(true)
  /// Where driver shifts are scheduled (the yard); null uses no site.
  driverShiftLocationId String?  @db.Uuid

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String  @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

}

// ===== Product analytics ==================================================
//
// Three small rollups, written by lib/usageTracker, read by routes/
// productAnalytics. Nothing here is queried from the raw AuditLog: that
// table has 209 action types, no retention sweep, and indexes built for
// entity timelines rather than aggregates — a DAU query over it would
// scan forever and fight the write path every mutation depends on.
//
// None of these tables stores a URL, a body, or an entity id. Route keys
// are Express PATTERNS ("/rides/:id"), so an analytics row can never
// become a way to read who looked at whom.

/// One row per user per day they made an authenticated request. DAU is a
/// COUNT on an indexed day; WAU/MAU are a COUNT DISTINCT over 7 or 30 of
/// them. `role` is denormalised deliberately — it is the role they held
/// that day, and re-deriving it later from the User row would silently
/// rewrite history when somebody changes job.
model UserActivityDay {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @db.Uuid
  day      DateTime @db.Date
  role     String   @db.VarChar(40)
  firstAt  DateTime @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@index([day, role])
  @@index([userId, day(sort: Desc)])
  @@index([tenantId])
}

/// Per-day traffic and health, keyed by Express route pattern. Accumulated
/// in memory and flushed on an interval, so a busy endpoint costs one UPDATE
/// a minute rather than one per request.
model RouteUsageDaily {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day         DateTime @db.Date
  method      String   @db.VarChar(10)
  /// Express pattern, never a resolved path — "/rides/:id", not "/rides/9f2…".
  route       String   @db.VarChar(200)
  ok          Int      @default(0)
  clientError Int      @default(0)
  serverError Int      @default(0)
  /// Summed response time; divide by the three counters for a mean.
  totalMs     BigInt   @default(0)
  /// Response-time histogram over the fixed edges lib/usageTracker.ts owns
  /// (LATENCY_EDGES, milliseconds). p95 is a walk over ~23 integers, so
  /// the slowest-route question is answered without keeping a sample.
  /// Empty on rows written before the column existed: those days have a
  /// mean and no percentile.
  histogram   Int[]    @default([])

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String? @db.Uuid

  @@unique([day, method, route])
  @@index([day])
  @@index([tenantId])
}

/// One row per API process start. A container OOM kill is a SIGKILL with
/// no exit handler, so restarts were only ever visible in Railway; this
/// makes "how many times did the API come up this week" a query.
model ApiBoot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bootAt      DateTime @default(now()) @db.Timestamptz(6)
  /// Git SHA on Railway, "boot-<ms>" elsewhere (see routes/health.ts).
  version     String   @db.VarChar(80)
  nodeVersion String   @db.VarChar(40)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String? @db.Uuid

  @@index([bootAt])
  @@index([tenantId])
}

/// The reliability scorecard for one closed org week (Saturday 00:00 to
/// Friday 24:00, Florida-local), written by the weekly digest so the
/// error-budget streak survives Sentry's retention and a dashboard reload.
model ReliabilityWeek {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// UTC instant of the org week's start; one row per week.
  weekStart     DateTime @unique @db.Timestamptz(6)
  /// Error events Sentry accepted that week across the configured
  /// projects. Null when Sentry is not connected.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String?  @db.Uuid
  sentryErrors  Int?
  /// 5xx responses counted by the route rollup.
  serverErrors  Int      @default(0)
  requests      Int      @default(0)
  /// [{ method, route, requests, p95Ms }] for the ten busiest routes.
  p95TopRoutes  Json     @default("[]")
  punchTotal    Int      @default(0)
  punchAccepted Int      @default(0)
  rideTotal     Int      @default(0)
  rideCompleted Int      @default(0)
  restarts      Int      @default(0)
  /// Weekly errors at or under the budget (10).
  underBudget   Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId])
}

/// Real-user web vitals (LCP, INP, CLS, TTFB), rolled up per SPA route and
/// UTC day. Values live in a fixed log-spaced histogram whose edges
/// lib/webVitals.ts owns, so p75 is a walk over ~25 integers and a day of
/// a route costs one row however busy it was. The route is a path
/// pattern ("/clients/:id"), never a resolved id.
model WebVitalDaily {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day       DateTime @db.Date
  route     String   @db.VarChar(200)
  metric    String   @db.VarChar(8)
  count     Int      @default(0)
  sum       Float    @default(0)
  good      Int      @default(0)
  needsWork Int      @default(0)
  poor      Int      @default(0)
  histogram Int[]    @default([])

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String? @db.Uuid

  @@unique([day, route, metric])
  @@index([day])
  @@index([tenantId])
}

/// "What's new" — one note per release, written by an admin and served to
/// the app, so a release note ships without a deploy. `items` is a list of
/// { audience, en, es } bullets (routes/releaseNotes.ts validates it);
/// each reader sees only the bullets for their audience, in their
/// language. A note with no publishedAt is a draft only admins can see.
model ReleaseNote {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day         DateTime  @db.Date
  /// Brief 2-1: the tenant this row belongs to. Stays nullable (migration C): a null tenant is a platform note every tenant reads.
  tenantId    String?   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  items       Json
  publishedAt DateTime? @db.Timestamptz(6)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@index([publishedAt, day])
  @@index([tenantId])
}

/// Out-of-office cover for a manager's team inbox. While active, `to`
/// sees and may act on `from`'s direct reports exactly as `from` would,
/// and is copied on the notifications `from` would have received. One
/// level, one direction; the cover never inherits other delegations.
model TeamDelegation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromUserId String   @db.Uuid
  toUserId   String   @db.Uuid
  startsOn   DateTime @db.Date
  endsOn     DateTime @db.Date
  note       String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId   String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  from       User     @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, endsOn])
  @@index([fromUserId, endsOn])
  @@index([tenantId])
}

/// Every IP an account has successfully signed in from. Small by nature —
/// people have few networks — and it exists so "is this sign-in from
/// somewhere new?" is an indexed lookup instead of a scan of the audit log.
model UserKnownIp {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  ip          String   @db.VarChar(64)
  /// IANA zone the browser reported at sign-in, when it offered one.
  timezone    String?  @db.VarChar(64)
  firstSeenAt DateTime @default(now()) @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(6)
  logins      Int      @default(1)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ip])
  @@index([userId, lastSeenAt(sort: Desc)])
  @@index([tenantId])
}

/// The ready-to-work handoff: the moment an associate's clock-in number was
/// issued, the store it was issued for, and the shift supervisors who were
/// told. One row per associate — re-issuing the number (a transfer) re-runs
/// the handoff and rewrites the row. Closure is not stored: it is the
/// associate's first assigned shift or first kiosk punch after issuedAt.
model ReadyToWorkHandoff {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId           String    @unique @db.Uuid
  clientId              String    @db.Uuid
  locationId            String?   @db.Uuid
  issuedById            String?   @db.Uuid
  issuedAt              DateTime  @default(now()) @db.Timestamptz(6)
  /// SHIFT_SUPERVISOR user ids the handoff reached.
  supervisorUserIds     String[]  @default([])
  /// No supervisor leads this store: every supervisor at the client was paged instead.
  fallbackToClient      Boolean   @default(false)
  associateNotifiedAt   DateTime? @db.Timestamptz(6)
  supervisorsNotifiedAt DateTime? @db.Timestamptz(6)
  nudgedAt              DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location  Site?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  issuedBy  User?     @relation("ReadyToWorkIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([clientId, locationId, issuedAt(sort: Desc)])
  @@index([nudgedAt, supervisorsNotifiedAt])
  @@index([tenantId])
}

/// Every change to how or to whom an associate is paid, and to the identity
/// payroll files under. One row per change, written in the same transaction
/// as the change itself. The Finance queue, the associate confirmation, the
/// packet's "Changes since last packet" section and verify-before-pay all
/// read this table; the email retry queue is delivery, this is the truth.
model FinancialChange {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId            String                @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId               String                @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind                   FinancialChangeKind
  /// Who made it: the associate, an administrator on their behalf, or the
  /// onboarding flow (the applicant, before they have an account).
  source                 FinancialChangeSource
  actorUserId            String?               @db.Uuid
  actorRole              String?               @db.VarChar(40)
  onBehalf               Boolean               @default(false)
  ip                     String?               @db.VarChar(64)
  userAgent              String?               @db.VarChar(512)
  /// How the actor was signed in: PASSWORD, MFA, PASSKEY or UNKNOWN.
  authStrength           String                @default("UNKNOWN") @db.VarChar(16)
  /// Masked, safe-to-email descriptions: "Chase · checking · ending 4821".
  /// Never a full account number, never an SSN.
  oldSummary             String?               @db.VarChar(200)
  newSummary             String?               @db.VarChar(200)
  oldPayoutMethodId      String?               @db.Uuid
  newPayoutMethodId      String?               @db.Uuid
  riskFlags              String[]              @default([])
  riskScore              Int                   @default(0)
  highRisk               Boolean               @default(false)
  status                 FinancialChangeStatus @default(PENDING)
  /// The phone number on file BEFORE this change, masked (last 4). Finance
  /// verifies by calling this number — never one that was just added.
  verifyPhoneLast4       String?               @db.VarChar(4)
  verifiedById           String?               @db.Uuid
  verifiedAt             DateTime?             @db.Timestamptz(6)
  verifiedVia            String?               @db.VarChar(32)
  verificationNote       String?               @db.VarChar(1000)
  financeNotifiedAt      DateTime?             @db.Timestamptz(6)
  associateNotifiedAt    DateTime?             @db.Timestamptz(6)
  priorContactNotifiedAt DateTime?             @db.Timestamptz(6)
  /// Set when a packet download recorded an acknowledgment of this change
  /// while it was still unverified.
  acknowledgedAt         DateTime?             @db.Timestamptz(6)
  acknowledgedById       String?               @db.Uuid
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)

  associate  Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  actorUser  User?     @relation("FinancialChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  verifiedBy User?     @relation("FinancialChangeVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([associateId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([tenantId])
}

enum FinancialChangeKind {
  BANK_ACCOUNT
  PAY_CARD
  PAY_METHOD
  W4
  LEGAL_NAME
  SSN
  HOME_ADDRESS
}

enum FinancialChangeSource {
  SELF
  ADMIN
  ONBOARDING
}

enum FinancialChangeStatus {
  PENDING
  VERIFIED
  REJECTED
  HELD
}

enum UnverifiedPayoutPolicy {
  PREVIOUS_VERIFIED
  HOLD
}

/// Every download of the external payroll packet (the sheet that carries
/// SSNs and bank accounts). Who, when, from where, what it covered, which
/// unverified changes they acknowledged, and the watermark stamped on it.
model PacketDownload {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @db.Uuid
  format                String   @db.VarChar(8)
  from                  DateTime @db.Timestamptz(6)
  to                    DateTime @db.Timestamptz(6)
  clientId              String?  @db.Uuid
  locationId            String?  @db.Uuid
  associateId           String?  @db.Uuid
  rowCount              Int      @default(0)
  associateCount        Int      @default(0)
  changeCount           Int      @default(0)
  unverifiedCount       Int      @default(0)
  acknowledgedChangeIds String[] @default([])
  ip                    String?  @db.VarChar(64)
  userAgent             String?  @db.VarChar(512)
  /// The text stamped on every page / sheet: who, when, download id.
  watermark             String   @db.VarChar(200)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId])
}

/// Which clients a driver picks up for. A driver asks (all clients — a null
/// client — or the ones they want), the Transportation Director approves or
/// denies, and the driver sees seat requests from approved clients only.
/// The director can also grant or revoke directly.
model DriverClientAccess {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverUserId String             @db.Uuid
  clientId     String?            @db.Uuid
  status       DriverAccessStatus @default(REQUESTED)
  /// The driver's note with the request.
  note         String?            @db.VarChar(300)
  /// The director's reason, shown to the driver.
  decisionNote String?            @db.VarChar(300)
  requestedAt  DateTime           @default(now()) @db.Timestamptz(6)
  decidedAt    DateTime?          @db.Timestamptz(6)
  decidedById  String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  driver    User    @relation("DriverAccessDriver", fields: [driverUserId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("DriverAccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([driverUserId, clientId])
  @@index([status, requestedAt])
  @@index([clientId])
  @@index([tenantId])
}

enum DriverAccessStatus {
  REQUESTED
  APPROVED
  DENIED
}

// ===== Emergency Mode (Brief 1C-1) =========================================
// One switch that protects the workforce during a storm. Declaring suspends
// the shifts in scope, tells every associate in their language, opens the
// "I'm safe" check-in, and books evacuation seats for whoever asks; stand
// down puts the schedule back from the next shift on. Every step is in the
// audit log with who, when, and the scope.

enum EmergencyStatus {
  ACTIVE
  STOOD_DOWN
}

enum EmergencyCheckInStatus {
  SAFE
  NEEDS_HELP
}

model Emergency {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String          @db.VarChar(120)
  /// The declarer's words, English. The Spanish and Turkish renderings
  /// are stored so what was sent is what the record shows.
  messageEn             String          @db.VarChar(2000)
  messageEs             String          @db.VarChar(2000)
  messageTr             String          @db.VarChar(2000)
  /// Every site, or the ones listed in EmergencySite.
  allSites              Boolean         @default(false)
  /// Shifts ending after this are suspended.
  startsAt              DateTime        @db.Timestamptz(6)
  /// Evacuation vans leave around this time; null means no transport mode.
  pickupAt              DateTime?       @db.Timestamptz(6)
  /// Where the evacuation vans go. Null: the rider's own store.
  destinationLocationId String?         @db.Uuid
  /// Minutes without a check-in before someone is on the escalation list.
  escalationMinutes     Int             @default(60)
  status                EmergencyStatus @default(ACTIVE)
  declaredById          String?         @db.Uuid
  declaredAt            DateTime        @default(now()) @db.Timestamptz(6)
  stoodDownById         String?         @db.Uuid
  stoodDownAt           DateTime?       @db.Timestamptz(6)
  /// Counts at declare time, for the record.
  shiftsSuspended       Int             @default(0)
  associatesNotified    Int             @default(0)
  shiftsRestored        Int             @default(0)
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId            String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  declaredBy          User?              @relation("EmergencyDeclarer", fields: [declaredById], references: [id], onDelete: SetNull)
  stoodDownBy         User?              @relation("EmergencyStandDown", fields: [stoodDownById], references: [id], onDelete: SetNull)
  destinationLocation Site?              @relation("EmergencyDestination", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  sites               EmergencySite[]
  checkIns            EmergencyCheckIn[]
  shifts              Shift[]
  rides               Ride[]

  @@index([status, declaredAt(sort: Desc)])
  @@index([tenantId])
}

model EmergencySite {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emergencyId String @db.Uuid
  locationId  String @db.Uuid

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  location  Site      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([emergencyId, locationId])
  @@index([locationId])
  @@index([tenantId])
}

/// One tap from the associate app: safe, or needs help; optionally a seat
/// on an evacuation van. One row per person per emergency; a second tap
/// updates it.
model EmergencyCheckIn {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emergencyId String                 @db.Uuid
  associateId String                 @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String                 @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  status      EmergencyCheckInStatus
  needsRide   Boolean                @default(false)
  note        String?                @db.VarChar(300)
  rideId      String?                @db.Uuid
  respondedAt DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(6)

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  ride      Ride?     @relation(fields: [rideId], references: [id], onDelete: SetNull)

  @@unique([emergencyId, associateId])
  @@index([emergencyId, status])
  @@index([tenantId])
}

// ===== Program Lifecycle (Brief 1C-2) ======================================
// One record per season per associate: the visa program they are here on
// (J-1 Summer Work Travel, H-2B, or domestic), its sponsor, the dates
// everything turns on, and — for H-2B — the client the petition was
// certified for, which is the only client they may be scheduled at.

enum ProgramType {
  J1_SWT
  H2B
  DOMESTIC
}

enum SecondJobStatus {
  NOT_REQUESTED
  REQUESTED
  APPROVED
  DENIED
}

/// A J-1 sponsor organisation or an H-2B agent: who to call, what they
/// require of us, and how often they want to hear from us.
model Sponsor {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String      @db.VarChar(160)
  /// J1_SWT or H2B — what kind of programs this sponsor runs.
  programType         ProgramType @default(J1_SWT)
  contactName         String?     @db.VarChar(120)
  contactEmail        String?     @db.VarChar(254)
  contactPhone        String?     @db.VarChar(40)
  website             String?     @db.VarChar(300)
  /// How often the sponsor expects a check-in on each participant, in days
  /// (J-1 regulation: at least monthly). Drives the check-in alert.
  checkInCadenceDays  Int         @default(30)
  /// What a check-in has to cover, in the sponsor's words.
  checkInRequirements String?     @db.VarChar(2000)
  /// What they want reported and when ("monthly placement report by the 5th").
  reportingCadence    String?     @db.VarChar(500)
  notes               String?     @db.VarChar(2000)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  programs Program[]

  @@index([isActive, name])
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Program {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId          String          @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  type                 ProgramType
  sponsorId            String?         @db.Uuid
  /// J-1: the DS-2019 form number and its validity.
  ds2019Number         String?         @db.VarChar(80)
  ds2019IssuedOn       DateTime?       @db.Date
  ds2019ExpiresOn      DateTime?       @db.Date
  /// Visa stamp expiry (J-1 or H-2B).
  visaExpiresOn        DateTime?       @db.Date
  sevisId              String?         @db.VarChar(80)
  country              String?         @db.VarChar(80)
  programStart         DateTime        @db.Date
  programEnd           DateTime        @db.Date
  /// Days after programEnd the participant may legally remain (J-1: 30).
  gracePeriodDays      Int             @default(30)
  secondJobStatus      SecondJobStatus @default(NOT_REQUESTED)
  /// H-2B: the petition and the client it was certified for.
  h2bPetitionNumber    String?         @db.VarChar(60)
  petitionClientId     String?         @db.Uuid
  petitionValidFrom    DateTime?       @db.Date
  petitionValidTo      DateTime?       @db.Date
  /// The area of intended employment on the certification ("Destin–Fort Walton Beach, FL").
  worksiteArea         String?         @db.VarChar(160)
  /// The last sponsor check-in we completed; the next one is due cadence days later.
  lastSponsorCheckInOn DateTime?       @db.Date
  notes                String?         @db.VarChar(2000)
  /// Set when the participant left early or the program was closed by hand.
  closedAt             DateTime?       @db.Timestamptz(6)
  closedReason         String?         @db.VarChar(300)
  createdById          String?         @db.Uuid
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)

  associate      Associate         @relation(fields: [associateId], references: [id], onDelete: Cascade)
  sponsor        Sponsor?          @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  petitionClient Client?           @relation("PetitionClient", fields: [petitionClientId], references: [id], onDelete: SetNull)
  documents      ProgramDocument[]

  @@index([associateId, programEnd(sort: Desc)])
  @@index([type, programEnd])
  @@index([sponsorId])
  @@index([petitionClientId])
  @@index([tenantId])
}

/// Which files in the encrypted document store belong to this program
/// (DS-2019, visa, petition approval). The file stays where it is.
model ProgramDocument {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId  String @db.Uuid
  documentId String @db.Uuid

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  program  Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  document DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([programId, documentId])
  @@index([tenantId])
}

/// Lead times, in days, for the program alerts. One row.
model ProgramAlertSetting {
  id                 String   @id @default(dbgenerated("substr(md5((gen_random_uuid())::text), 1, 16)")) @db.VarChar(16)
  programEndDays     Int[]    @default([60, 30, 14, 7])
  visaExpiryDays     Int[]    @default([60, 30])
  i9ReverifyDays     Int[]    @default([90, 30, 7])
  sponsorCheckInDays Int[]    @default([7, 0])
  petitionEndDays    Int[]    @default([60, 30])
  updatedById        String?  @db.Uuid
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String  @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

}

// ===== Season Planner (Brief 1C-3) =========================================
// Demand by store, shift and week becomes associates, beds, van seats and
// recruiting targets by channel. A plan is a scenario: save several, compare
// them side by side. Everything derived is computed on read from the inputs
// here; nothing downstream depends on a plan.

model SeasonPlan {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String    @db.VarChar(120)
  /// Null: a company-wide plan across clients.
  clientId           String?   @db.Uuid
  seasonStart        DateTime  @db.Date
  seasonEnd          DateTime  @db.Date
  targetHoursPerWeek Int       @default(40)
  /// Hours one shift slot represents, for turning headcount into hours.
  shiftHours         Int       @default(8)
  /// Extra associates over the arithmetic need, for call-outs and churn.
  reservePct         Int       @default(10)
  /// Percent of associates by recruiting channel: { LOCAL, J1_NORTH, J1_SOUTH, H2B }. Sums to 100.
  channelMix         Json      @default("{\"LOCAL\":25,\"J1_NORTH\":35,\"J1_SOUTH\":15,\"H2B\":25}")
  /// Weeks before season start a channel's people must be recruited, by channel.
  arrivalLeadWeeks   Json      @default("{\"LOCAL\":3,\"J1_NORTH\":10,\"J1_SOUTH\":12,\"H2B\":20}")
  /// Percent of each channel that needs a bed, by channel.
  housingShare       Json      @default("{\"LOCAL\":0,\"J1_NORTH\":100,\"J1_SOUTH\":100,\"H2B\":100}")
  /// Percent of each channel that rides the vans, by channel.
  rideShare          Json      @default("{\"LOCAL\":10,\"J1_NORTH\":100,\"J1_SOUTH\":100,\"H2B\":100}")
  notes              String?   @db.VarChar(2000)
  createdById        String?   @db.Uuid
  archivedAt         DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  client   Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sites    SeasonPlanSite[]

  @@index([clientId, seasonStart])
  @@index([archivedAt, updatedAt(sort: Desc)])
  @@index([tenantId])
}

model SeasonPlanSite {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId         String @db.Uuid
  locationId     String @db.Uuid
  /// Beds this site's people can use (Helios capacity by hand until a link exists).
  bedsAvailable  Int    @default(0)
  /// Seats one van run carries to this site, and runs per shift.
  vanSeatsPerRun Int    @default(14)
  runsPerShift   Int    @default(1)
  routeMinutes   Int    @default(45)
  /// [{ week: 'YYYY-MM-DD' (org week start), day, evening, overnight }] — headcount on the floor per shift per day.
  demand         Json   @default("[]")
  /// Brief 3-3: [{ week, tasks: [{ capability, count, minutes, risk }] }] — the week's work as tasks; the planner proposes the people-robot mix from it.
  taskDemand     Json   @default("[]")

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String     @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  plan     SeasonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  location Site       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([planId, locationId])
  @@index([tenantId])
}

// ===== WhatsApp (Brief 1C-4) ==============================================
// A delivery channel, not a new inbox: every associate-facing notification
// also goes to WhatsApp when the associate opted in, in their language,
// through Meta's Cloud API. Receipts come back by webhook. Inbound text
// goes to a small assistant that answers three routine questions from the
// associate's own data and hands everything else to their supervisor.

enum WhatsAppConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum WhatsAppDirection {
  OUTBOUND
  INBOUND
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum WhatsAppMessageKind {
  TEMPLATE
  TEXT
  QUESTION
  ANSWER
  HANDOFF
  SYSTEM
}

model WhatsAppConsent {
  associateId   String                @id @db.Uuid
  /// E.164 digits without the plus, the way Meta addresses a handset.
  phone         String                @db.VarChar(20)
  status        WhatsAppConsentStatus @default(OPTED_IN)
  /// 'app' (Settings), 'reply' (they texted START/STOP), 'admin'.
  source        String                @default("app") @db.VarChar(20)
  optedInAt     DateTime              @default(now()) @db.Timestamptz(6)
  optedOutAt    DateTime?             @db.Timestamptz(6)
  /// The last message they sent us — inside 24 hours we may send free text.
  lastInboundAt DateTime?             @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([tenantId])
}

/// The message record: what went out and what came in, with the receipt.
model WhatsAppMessage {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId    String?               @db.Uuid
  phone          String                @db.VarChar(20)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String                @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  direction      WhatsAppDirection
  kind           WhatsAppMessageKind
  /// Meta's message id — unique, so a replayed webhook is a no-op.
  waMessageId    String?               @unique @db.VarChar(120)
  templateName   String?               @db.VarChar(80)
  language       String                @default("en") @db.VarChar(2)
  body           String                @db.VarChar(4000)
  category       String?               @db.VarChar(80)
  status         WhatsAppMessageStatus @default(QUEUED)
  statusAt       DateTime?             @db.Timestamptz(6)
  failureReason  String?               @db.VarChar(500)
  /// The Notification row this delivery belongs to, when it came from one.
  notificationId String?               @db.Uuid
  /// The thread an unanswered question was handed to.
  conversationId String?               @db.Uuid
  /// The inbound message an ANSWER or HANDOFF replies to.
  replyToId      String?               @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)

  associate Associate? @relation(fields: [associateId], references: [id], onDelete: SetNull)

  @@index([associateId, createdAt(sort: Desc)])
  @@index([phone, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([tenantId])
}

// ===== Workers (Brief 1D-1) ================================================
// A worker is not assumed to be a person. Every associate is a PERSON worker
// (made by the migration and kept so by ensurePersonWorkers); agents and
// robots are workers of their own type. Every worker has an accountable
// owner — a user — and that is the rule the hybrid model rests on.

enum WorkerType {
  PERSON
  AGENT
  ROBOT
}

enum WorkerStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

model Worker {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  type         WorkerType
  /// PERSON workers point at their associate; the person-specific tables
  /// keep their own foreign keys to Associate.
  associateId  String?      @unique @db.Uuid
  name         String       @db.VarChar(160)
  /// The human accountable for this worker. Required, always.
  ownerUserId  String       @db.Uuid
  status       WorkerStatus @default(ONBOARDING)
  /// Certified task types, from the shared catalog (WORKER_CAPABILITIES).
  capabilities String[]     @default([])
  notes        String?      @db.VarChar(2000)
  createdById  String?      @db.Uuid
  offboardedAt DateTime?    @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  associate           Associate?           @relation(fields: [associateId], references: [id], onDelete: SetNull)
  owner               User                 @relation("WorkerOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  assignments         WorkerAssignment[]
  shifts              Shift[]
  agent               AgentProfile?
  workTaskAssignments WorkTaskAssignment[]
  robot               RobotProfile?
  robotCommissionings RobotCommissioning[]
  robotChecklistRuns  RobotChecklistRun[]
  robotSamples        RobotStatusSample[]
  robotEvents         RobotEvent[]
  robotMaintenance    RobotMaintenance[]
  robotIncidents      RobotIncident[]

  @@index([type, status])
  @@index([ownerUserId])
  @@index([tenantId])
}

/// Where a non-person worker works. PERSON workers keep AssociateAssignment;
/// lib/workers.ts reads both as one.
model WorkerAssignment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId   String    @db.Uuid
  locationId String    @db.Uuid
  startedAt  DateTime  @db.Date
  endedAt    DateTime? @db.Date
  notes      String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  worker   Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  location Site    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([workerId, endedAt])
  @@index([locationId, endedAt])
  @@index([tenantId])
}

// ===== Brief 1D-2 — Agent registry, permissions and audit trail =============
//
// An AI agent is a Worker of type AGENT. The profile below holds what the
// registry needs beyond the worker row: purpose, vendor and model, scopes
// drawn from the RBAC capability list, limits, and the credentials it calls
// the API with. Everything an agent does through /agent/v1 lands in
// AuditLog with its workerId; the AuditLog table is append-only at the
// database (trigger audit_log_immutable).

enum AgentEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum AgentGatedAction {
  PAY_CHANGE
  SEPARATION
  CLIENT_MESSAGE
  DATA_EXPORT
  /// Agent families step 0: a shift assignment the agent proposes; executable once approved.
  SHIFT_ASSIGN
  /// Agent families step 0: an HR case the agent proposes to open; executable once approved.
  CASE_OPEN
  /// Brief 2-6 step 2: a capability the platform does not gate, gated by the customer's own policy.
  POLICY_GATE
}

enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CONSUMED
  EXPIRED
}

model AgentProfile {
  workerId              String           @id @db.Uuid
  purpose               String           @db.VarChar(500)
  vendor                String           @db.VarChar(80)
  model                 String           @db.VarChar(120)
  modelVersion          String           @db.VarChar(80)
  environment           AgentEnvironment @default(PRODUCTION)
  /// RBAC capabilities this agent may use (AGENT_SCOPES in shared contracts).
  scopes                String[]         @default([])
  /// Calendar-month spend cap; null = no cap.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId              String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  spendCapCents         Int?
  rateLimitPerMinute    Int              @default(60)
  /// Hours of operation, org-local 0..23; both null = any hour.
  allowedHoursStart     Int?
  allowedHoursEnd       Int?
  /// Product taxonomy: the agent family (AGENT_FAMILIES) and the capability it performs.
  family                String?          @db.VarChar(40)
  capability            String?          @db.VarChar(120)
  /// Set for the agents Alto already runs, so the boot sweep finds them.
  /// Agent families step 0: unique per tenant (partial indexes in migration 20261123090000_agent_capabilities).
  builtInKey            String?          @db.VarChar(60)
  lastActiveAt          DateTime?        @db.Timestamptz(6)
  /// Brief 1D-3. Certified for certifiedModelVersion; a different modelVersion sends the agent back to onboarding.
  certifiedAt           DateTime?        @db.Timestamptz(6)
  certifiedModelVersion String?          @db.VarChar(80)
  suspendedAt           DateTime?        @db.Timestamptz(6)
  suspendedById         String?          @db.Uuid
  suspendReason         String?          @db.VarChar(300)
  /// Drift thresholds over the trailing seven days; null = not watched.
  driftErrorRatePct     Int?             @default(25)
  driftCostPerTaskCents Int?
  lastDriftAlertAt      DateTime?        @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(6)

  worker            Worker                 @relation(fields: [workerId], references: [id], onDelete: Cascade)
  credentials       AgentCredential[]
  approvals         AgentApprovalRequest[]
  spend             AgentSpend[]
  scenarios         AgentScenario[]
  agentCapabilities AgentCapability[]
  proposals         AgentProposal[]

  @@index([tenantId])
}

model AgentCredential {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId      String    @db.Uuid
  /// sha256 of the plaintext token; the plaintext is shown once and never stored.
  tokenHash     String    @unique @db.VarChar(64)
  last4         String    @db.VarChar(4)
  /// Null when the agent rotated it itself.
  issuedById    String?   @db.Uuid
  rotatedFromId String?   @unique @db.Uuid
  issuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  lastUsedAt    DateTime? @db.Timestamptz(6)
  /// A revocation in the future is a rotation grace period.
  revokedAt     DateTime? @db.Timestamptz(6)
  revokedReason String?   @db.VarChar(200)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  agent    AgentProfile @relation(fields: [workerId], references: [workerId], onDelete: Cascade)
  issuedBy User?        @relation("AgentCredentialIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([workerId, revokedAt])
  @@index([tenantId])
}

model AgentApprovalRequest {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId       String              @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  action         AgentGatedAction
  summary        String              @db.VarChar(500)
  payload        Json
  payloadHash    String              @db.VarChar(64)
  status         AgentApprovalStatus @default(PENDING)
  requestedAt    DateTime            @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime            @db.Timestamptz(6)
  decidedById    String?             @db.Uuid
  decidedAt      DateTime?           @db.Timestamptz(6)
  decisionNote   String?             @db.VarChar(500)
  consumedAt     DateTime?           @db.Timestamptz(6)
  /// Brief 2-6 step 2: who must decide, from the customer's gate policy in force when it was filed (null: today's rule).
  gatePolicyId   String?             @db.Uuid
  /// OWNER | ROLE | DESK | USER
  approverKind   String?             @db.VarChar(10)
  approverRole   Role?
  approverUserId String?             @db.Uuid

  agent     AgentProfile   @relation(fields: [workerId], references: [workerId], onDelete: Cascade)
  decidedBy User?          @relation("AgentApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  proposal  AgentProposal?

  @@index([status, requestedAt])
  @@index([workerId, requestedAt(sort: Desc)])
  @@index([tenantId])
}

model AgentSpend {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId     String   @db.Uuid
  occurredAt   DateTime @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  amountCents  Int
  taskRef      String?  @db.VarChar(120)
  note         String?  @db.VarChar(300)
  /// Null when the agent reported it itself.
  recordedById String?  @db.Uuid

  agent AgentProfile @relation(fields: [workerId], references: [workerId], onDelete: Cascade)

  @@index([workerId, occurredAt(sort: Desc)])
  @@index([tenantId])
}

// ===== Brief 1D-3 — Kill switch, certification and the agent scorecard =====

/// One row. When allSuspendedAt is set no agent credential works.
model AgentControl {
  id             String    @id @default("singleton") @db.VarChar(16)
  allSuspendedAt DateTime? @db.Timestamptz(6)
  suspendedById  String?   @db.Uuid
  reason         String?   @db.VarChar(300)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  @@index([tenantId])
}

/// A test an agent must pass before it is active: an input and either the
/// exact output expected or the set of actions it is allowed to take.
model AgentScenario {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId    String   @db.Uuid
  name        String   @db.VarChar(160)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  input       Json
  expected    Json
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  agent AgentProfile       @relation(fields: [workerId], references: [workerId], onDelete: Cascade)
  runs  AgentScenarioRun[]

  @@index([workerId])
  @@index([tenantId])
}

model AgentScenarioRun {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scenarioId   String   @db.Uuid
  workerId     String   @db.Uuid
  /// The version under test; a certification counts only for the current one.
  modelVersion String   @db.VarChar(80)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  passed       Boolean
  actual       Json?
  reason       String?  @db.VarChar(500)
  /// Null when the agent answered through /agent/v1.
  ranById      String?  @db.Uuid
  ranAt        DateTime @default(now()) @db.Timestamptz(6)

  scenario AgentScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, ranAt(sort: Desc)])
  @@index([workerId, modelVersion])
  @@index([tenantId])
}

// ===== Agent families step 0 — capabilities, proposals, the tenant's switch =====
// docs/agent-families-investigation.md §8. The capability is the unit of
// governance: its own switch and drift threshold on the agent. A proposal
// is the outcome record a capability's scorecard reads. The tenant's kill
// switch sits beside the AgentControl singleton, which stays the platform
// switch (converting it is 2-1 Migration C); an agent stops when either is set.

enum AgentProposalStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
  SUPERSEDED
}

model AgentCapability {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId          String    @db.Uuid
  /// From AGENT_CAPABILITIES in the shared catalog.
  key               String    @db.VarChar(60)
  enabled           Boolean   @default(true)
  suspendedAt       DateTime? @db.Timestamptz(6)
  suspendedById     String?   @db.Uuid
  suspendReason     String?   @db.VarChar(300)
  driftErrorRatePct Int?      @default(25)
  lastDriftAlertAt  DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId          String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  agent AgentProfile @relation(fields: [workerId], references: [workerId], onDelete: Cascade)

  @@unique([workerId, key])
  @@index([tenantId])
}

model AgentProposal {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId      String              @db.Uuid
  capabilityKey String              @db.VarChar(60)
  /// What the proposal is about: Shift, HrCase, Document…
  subjectType   String              @db.VarChar(40)
  subjectId     String?             @db.Uuid
  payload       Json
  approvalId    String?             @unique @db.Uuid
  status        AgentProposalStatus @default(PROPOSED)
  statusAt      DateTime            @default(now()) @db.Timestamptz(6)
  outcome       Json?
  outcomeAt     DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// The case for the proposal, for the person deciding (shared ProposalEvidence): why, alternatives, impact, who it touches. Null: generic on read.
  evidence      Json?

  agent    AgentProfile          @relation(fields: [workerId], references: [workerId], onDelete: Cascade)
  approval AgentApprovalRequest? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([workerId, capabilityKey, createdAt(sort: Desc)])
  @@index([subjectType, subjectId])
  @@index([tenantId])
}

/// Agent families step 2 (lib/attendanceConfirm): the Workforce agent asked the
/// shift's holder, the day before, whether they are coming. One per shift. A NO,
/// or silence past cutoffAt, files a backup proposal (SHIFT_ASSIGN).
model AttendanceConfirmation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shiftId          String    @unique @db.Uuid
  associateId      String    @db.Uuid
  /// The agent that asked (AgentProfile.workerId).
  workerId         String    @db.Uuid
  /// WHATSAPP (opted in) or IN_APP.
  channel          String    @db.VarChar(20)
  sentAt           DateTime  @db.Timestamptz(6)
  /// Twelve hours before the shift starts (owner, 2026-10-15): silence past it files a backup.
  cutoffAt         DateTime  @db.Timestamptz(6)
  /// YES | NO; null until they answer.
  answer           String?   @db.VarChar(10)
  answeredAt       DateTime? @db.Timestamptz(6)
  /// APP | WHATSAPP
  answeredVia      String?   @db.VarChar(20)
  /// The backup proposal filed for a NO or for silence.
  backupProposalId String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([associateId, sentAt])
  @@index([tenantId])
}

/// Agent families step 3 (lib/coverageForecast): one site's coverage for one day,
/// as the Workforce agent saw it on forecastOn (site-local dates). Written once a
/// day and never updated: the forecast-error metrics compare what was forecast
/// 7 and 1 days ahead with the lead-0 row of the same day.
model CoverageForecastDay {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @db.Uuid
  /// The site-local day the forecast was made.
  forecastOn DateTime @db.Date
  /// The site-local day it is about.
  targetDay  DateTime @db.Date
  /// targetDay − forecastOn, 0..7.
  leadDays   Int
  /// Headcount the site's staffing targets call for that day.
  demand     Int
  /// Distinct people on assigned, published shifts that day.
  assigned   Int
  /// Published shifts still open that day.
  openShifts Int
  /// People on the site's bench, employed and with no shift that day.
  bench      Int
  /// max(0, demand − assigned)
  gap        Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId   String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  location Site @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, forecastOn, targetDay])
  @@index([tenantId, forecastOn])
}

/// Agent families step 4 (lib/complianceAgent): one expiring document or
/// authorization the Compliance agent chases with its person. itemKey is the
/// compliance scorecard's action key (exp:<kind>:<associateId>:<expiresAt>), so
/// a waiver or snooze set there is read here and the item is never chased.
model DocumentChase {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemKey     String    @unique @db.VarChar(300)
  associateId String    @db.Uuid
  /// The agent chasing (AgentProfile.workerId).
  workerId    String    @db.Uuid
  /// DOCUMENT | I9_WORK_AUTH | VACCINATION (the scorecard's kinds)
  kind        String    @db.VarChar(30)
  label       String    @db.VarChar(200)
  expiresAt   DateTime  @db.Timestamptz(6)
  /// The last reminder sent: 1 = 30 days out, 2 = 14, 3 = 3.
  stage       Int       @default(0)
  lastSentAt  DateTime? @db.Timestamptz(6)
  /// Expired unresolved: on HR's desk from here.
  escalatedAt DateTime? @db.Timestamptz(6)
  resolvedAt  DateTime? @db.Timestamptz(6)
  /// RENEWED | WAIVED | LEFT
  resolution  String?   @db.VarChar(20)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([associateId, resolvedAt])
  @@index([tenantId, resolvedAt])
}

/// Agent families step 5 (lib/credentialCoverage): a credential everyone placed
/// at a site (or at every site of a client) must hold. Exactly one target, by
/// kind: a vaccination kind, a training by compliance tag, or a qualification.
/// Soft-deleted so the weekly coverage rows keep their meaning.
model CredentialRequirement {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId      String?          @db.Uuid
  clientId        String?          @db.Uuid
  /// VACCINATION | TRAINING | QUALIFICATION
  kind            String           @db.VarChar(20)
  vaccinationKind VaccinationKind?
  complianceTag   ComplianceTag?
  qualificationId String?          @db.Uuid
  /// What the desk and the person read ("TB test", "Food handler card").
  label           String           @db.VarChar(120)
  createdById     String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  deletedAt       DateTime?        @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  location      Site?                    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  client        Client?                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  qualification Qualification?           @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  weeks         CredentialCoverageWeek[]

  @@index([tenantId, deletedAt])
  @@index([locationId])
  @@index([clientId])
}

/// One requirement's coverage as the Compliance agent measured it that week
/// (org week start). Written once, never updated: gapsClosed compares weeks.
model CredentialCoverageWeek {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requirementId String   @db.Uuid
  weekOf        DateTime @db.Date
  /// People placed in scope.
  population    Int
  /// Of them, without a current credential.
  missing       Int
  missingIds    Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  requirement CredentialRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, weekOf])
  @@index([tenantId, weekOf])
}

/// Brief 2-4 (lib/apiClients): an OAuth 2 client-credentials client of the
/// public /v1 API. One tenant, named scopes, a named accountable owner (as for
/// every agent and robot). The secret is shown once and stored hashed; a
/// rotation keeps the previous secret valid for five minutes.
model ApiClient {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The public client id: altc_ + 24 characters.
  clientId           String    @unique @db.VarChar(40)
  secretHash         String
  previousSecretHash String?
  previousValidUntil DateTime? @db.Timestamptz(6)
  name               String    @db.VarChar(120)
  scopes             String[]
  ownerUserId        String    @db.Uuid
  /// ACTIVE | REVOKED
  status             String    @default("ACTIVE") @db.VarChar(10)
  lastUsedAt         DateTime? @db.Timestamptz(6)
  expiresAt          DateTime? @db.Timestamptz(6)
  revokedAt          DateTime? @db.Timestamptz(6)
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId           String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  owner User @relation("ApiClientOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
}

/// The tenant's own kill switch; one row per tenant. The AgentControl singleton is the platform's.
model AgentTenantControl {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to; one row each.
  tenantId       String    @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  allSuspendedAt DateTime? @db.Timestamptz(6)
  suspendedById  String?   @db.Uuid
  reason         String?   @db.VarChar(300)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
}

// ===== Brief 2-1 — Tenants ==================================================
//
// One customer organization. Every tenant-scoped table carries a required
// tenantId (migration C, 20270128190000) that defaults to Alto HR (tenant 1)
// at the database, and row-level security reads it (20270128190100,
// docs/runbooks/tenancy-rls-cutover.md). Reference data (PayrollConfig,
// LocalTaxRule, GeoCache) stays global; platform telemetry, the audit chain,
// platform release notes and shipped labor packs carry a null tenant
// (lib/tenantGuard NULLABLE_TENANT_MODELS).

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Brief 2-1b: sets a tenant's defaults at creation; otherwise informational.
enum BusinessModel {
  DIRECT_EMPLOYER
  WORKFORCE_PROVIDER
  MANAGED_PROGRAM
  HYBRID
}

/// Brief 2-1b, step 4: who legally employs a person. The tenant itself,
/// a client whose legal facts moved here, or a third-party employer of
/// record. The W-2/1099 employer comes from the Employment record's
/// employer, never from a Client row (the owner's decision 3).
enum EmployerKind {
  TENANT
  CLIENT
  THIRD_PARTY
}

model EmployerOrganization {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind                 EmployerKind
  legalName            String       @db.VarChar(255)
  ein                  String?      @db.VarChar(20)
  addressLine1         String?      @db.VarChar(255)
  addressLine2         String?      @db.VarChar(255)
  city                 String?      @db.VarChar(120)
  state                String?      @db.VarChar(2)
  zip                  String?      @db.VarChar(10)
  /// Employer telephone — NY Labor Law §195(1),(3) wage statement and pay notice.
  phone                String?      @db.VarChar(32)
  /// Workers' comp carrier — CA Labor Code §2810.5 notice.
  wcCarrierName        String?      @db.VarChar(255)
  wcCarrierAddress     String?      @db.VarChar(500)
  wcCarrierPhone       String?      @db.VarChar(32)
  wcPolicyNumber       String?      @db.VarChar(64)
  sutaRateOverride     Decimal?     @db.Decimal(6, 5)
  sutaWageBaseOverride Decimal?     @db.Decimal(12, 2)
  /// When kind = CLIENT: the Client whose facts this row carries.
  clientId             String?      @unique @db.Uuid
  /// The tenant's own row: the employer when nothing else says otherwise.
  isDefault            Boolean      @default(false)
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  client      Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  employments Employment[]
  taxAccounts TaxAgencyAccount[]

  @@index([tenantId, isDefault])
}

/// One employment spell: this person, employed by this organization, from
/// hireDate to endDate. Opened at approval, ended at separation.
model Employment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId    String         @db.Uuid
  employerOrgId  String         @db.Uuid
  employmentType EmploymentType @default(W2_EMPLOYEE)
  hireDate       DateTime       @db.Date
  endDate        DateTime?      @db.Date
  /// The approved application that opened the spell, when one did.
  applicationId  String?        @unique @db.Uuid
  siteId         String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  associate   Associate            @relation(fields: [associateId], references: [id], onDelete: Cascade)
  employer    EmployerOrganization @relation(fields: [employerOrgId], references: [id], onDelete: Restrict)
  application Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  site        Site?                @relation("EmploymentSite", fields: [siteId], references: [id], onDelete: SetNull)

  @@index([associateId, endDate])
  @@index([employerOrgId])
  @@index([tenantId])
}

/// Brief 2-1b, step 5: the organizational hierarchy — division, region,
/// business unit, cost center — one tree per tenant, used by direct
/// employers (hotel chain → region → property) and by staffing tenants
/// (their own regions and cost centers; a client-specific unit carries
/// clientId). Region and CostCenter rows are mirrored here (legacy ids)
/// until they are dropped; permissions scope at any level by path.
enum OrgUnitType {
  DIVISION
  REGION
  BUSINESS_UNIT
  COST_CENTER
}

model OrgUnit {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  type               OrgUnitType
  parentId           String?     @db.Uuid
  name               String      @db.VarChar(160)
  /// The unit's own code.
  code               String?     @db.VarChar(40)
  /// The ledger account it posts to.
  glCode             String?     @db.VarChar(40)
  /// Materialized ancestry: "/<root id>/<child id>/…/<this id>", so "under X" is one prefix match.
  path               String      @db.VarChar(2000)
  /// A staffing tenant's client-specific unit.
  clientId           String?     @db.Uuid
  legacyRegionId     String?     @unique @db.Uuid
  legacyCostCenterId String?     @unique @db.Uuid
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?   @db.Timestamptz(6)

  parent     OrgUnit?    @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   OrgUnit[]   @relation("OrgUnitTree")
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  region     Region?     @relation(fields: [legacyRegionId], references: [id], onDelete: SetNull)
  costCenter CostCenter? @relation(fields: [legacyCostCenterId], references: [id], onDelete: SetNull)
  locations  Site[]      @relation("OrgUnitSites")
  users      User[]      @relation("UserOrgUnitScope")
  associates Associate[] @relation("OrgUnitAssociates")
  positions  Position[]  @relation("OrgUnitPositions")

  @@index([tenantId, type])
  @@index([parentId])
  @@index([path])
  @@index([deletedAt])
}

/// Brief 2-1b, step 7: the kind of site. "Store" is the staffing default; a direct employer's sites are properties, offices, warehouses.
enum SiteType {
  STORE
  PROPERTY
  OFFICE
  WAREHOUSE
  OTHER
}

model Tenant {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String        @unique @db.VarChar(60)
  name                String        @db.VarChar(160)
  plan                String        @default("internal") @db.VarChar(40)
  status              TenantStatus  @default(ACTIVE)
  /// Feature flags per tenant, read by the application.
  features            Json          @default("{}")
  /// Brief 2-1b: the profile. modules and terminology are validated JSON
  /// (packages/shared/src/tenantProfile.ts); {} means the model's defaults.
  businessModel       BusinessModel @default(WORKFORCE_PROVIDER)
  modules             Json          @default("{}")
  terminology         Json          @default("{}")
  /// Brief 2-3 step 4: how long audit rows are kept before they are archived (never below 7 years).
  auditRetentionYears Int           @default(7)
  /// Brief 2-6 (billing): the invoice's legal name and billing contact, and the Stripe
  /// customer once one is made (so it is never re-found by metadata search).
  billingName         String?       @db.VarChar(160)
  billingEmail        String?       @db.VarChar(254)
  stripeCustomerId    String?       @db.VarChar(120)
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)
}
/// Brief 2-1 migration C: a counter per tenant (pay-check numbers today, key
/// 'pay_check_number'). The PayCheck insert trigger allocates the next value in
/// the inserting transaction, so every tenant numbers its own checks from 1 and
/// Alto HR carries on from its last check number (nothing is renumbered).
model TenantCounter {
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  key       String   @db.VarChar(60)
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@id([tenantId, key])
}


// ===== Brief 1A-2 — the reconciliation snapshot ==============================
//
// One row per run of scripts/reconcile-payroll.ts --persist: the totals and
// the variance the Headcount screen shows beside today's numbers.

model ReconciliationSnapshot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date
  ranAt           DateTime @default(now()) @db.Timestamptz(6)
  windowDays      Int
  platformActive  Int
  platformPaid    Int
  payrollPaid     Int?
  platformHours   Decimal  @db.Decimal(12, 2)
  payrollHours    Decimal? @db.Decimal(12, 2)
  platformGross   Decimal  @db.Decimal(14, 2)
  payrollGross    Decimal? @db.Decimal(14, 2)
  varianceLines   Int?
  payrollProvided Boolean  @default(false)
  notes           String?  @db.VarChar(1000)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  @@index([periodEnd(sort: Desc)])
  @@index([tenantId])
}

/// Brief 2-5 — SOC 2 evidence. One row per collection of one control
/// (lib/evidence.ts; the catalog is COMPLIANCE_CONTROLS in packages/shared).
/// Platform-level (owner's decision 1): Alto People is the service
/// organization, so tenantId stays null. Append-only at the database.
model ComplianceEvidence {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: platform-wide (never a tenant's); nullable with no default.
  tenantId    String?                     @db.Uuid
  control     String                      @db.VarChar(80)
  status      EvidenceStatus
  summary     String                      @db.VarChar(500)
  details     Json                        @default("{}")
  /// A stored artifact (a dump manifest, a CSV), when there is one.
  artifactKey String?                     @db.VarChar(500)
  /// The job or script name, or the user id for an attestation.
  collectedBy String                      @db.VarChar(120)
  collectedAt DateTime                    @default(now()) @db.Timestamptz(6)
  periodStart DateTime?                   @db.Timestamptz(6)
  periodEnd   DateTime?                   @db.Timestamptz(6)
  signoffs    ComplianceEvidenceSignoff[]

  @@index([control, collectedAt(sort: Desc)])
  @@index([tenantId])
}

/// Brief 2-5 — a person's sign-off on one evidence row. A separate
/// append-only row, so signing never edits the evidence.
model ComplianceEvidenceSignoff {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: platform-wide (never a tenant's); nullable with no default.
  tenantId      String?            @db.Uuid
  evidenceId    String             @db.Uuid
  evidence      ComplianceEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  signedOffById String             @db.Uuid
  note          String?            @db.VarChar(1000)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)

  @@index([evidenceId])
  @@index([tenantId])
}

enum EvidenceStatus {
  PASS
  FAIL
  WARN
}

/// Brief 2-2 step 2 — labor rule sets (docs/labor-rules-investigation.md §4.1).
/// A shipped pack has no tenant (seeded by migration from lib/laborRules/packs.ts,
/// read-only to every tenant); a tenant- or site-level override has one. The
/// engine refuses a DRAFT set for pay: a pack turns ACTIVE only with counsel's
/// sign-off recorded here (owner's decision 10).
model LaborRuleSet {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL: a shipped pack. Deliberately NOT defaulted to Alto HR like other tenant columns.
  tenantId         String?   @db.Uuid
  /// FEDERAL, US-FL, US-NY-NYC…; TENANT or SITE for an override.
  jurisdiction     String    @db.VarChar(60)
  /// FEDERAL | STATE | CITY | TENANT | SITE
  level            String    @db.VarChar(10)
  siteId           String?   @db.Uuid
  effectiveFrom    DateTime  @db.Date
  version          Int
  /// The family blocks this set names (RuleParamsSchema).
  params           Json
  source           String    @db.VarChar(1000)
  sourceDate       DateTime  @db.Date
  /// DRAFT | ACTIVE | RETIRED
  status           String    @default("DRAFT") @db.VarChar(10)
  approvedByUserId String?   @db.Uuid
  approvedAt       DateTime? @db.Timestamptz(6)
  /// Counsel's sign-off reference (memo, ticket, date).
  approvalNote     String?   @db.VarChar(500)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  site       Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("LaborRuleSetApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([jurisdiction, effectiveFrom])
}

/// Brief 2-2 step 3 — the engine in shadow: each finalized payroll run is
/// recomputed through the labor rules engine beside what it paid. Nothing is
/// paid from here; the differences are the evidence for the switch (step 4).
model LaborShadowRun {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  payrollRunId     String   @unique @db.Uuid
  periodStart      DateTime @db.Date
  periodEnd        DateTime @db.Date
  associates       Int
  differences      Int
  /// What the engine would have paid minus what was paid, across the run (penalties excluded).
  amountDifference Decimal  @db.Decimal(12, 2)
  /// Premium hours the engine computes (meal, rest, rest between shifts): shown, never paid until signed.
  penaltyHours     Decimal  @db.Decimal(10, 2)
  ranAt            DateTime @default(now()) @db.Timestamptz(6)

  payrollRun PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  diffs      LaborShadowDiff[]

  @@index([tenantId, ranAt])
}

/// One associate whose engine result differs from what the run paid.
model LaborShadowDiff {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  shadowRunId      String   @db.Uuid
  associateId      String   @db.Uuid
  paidRegular      Decimal  @db.Decimal(10, 2)
  paidOvertime     Decimal  @db.Decimal(10, 2)
  engineRegular    Decimal  @db.Decimal(10, 2)
  engineOvertime   Decimal  @db.Decimal(10, 2)
  engineDouble     Decimal  @db.Decimal(10, 2)
  hourlyRate       Decimal  @db.Decimal(10, 2)
  amountDifference Decimal  @db.Decimal(12, 2)
  penaltyHours     Decimal  @db.Decimal(10, 2)
  /// The engine's reason lines.
  reasons          Json
  fingerprints     String[]

  shadowRun LaborShadowRun @relation(fields: [shadowRunId], references: [id], onDelete: Cascade)
  associate Associate      @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([shadowRunId])
  @@index([associateId])
}

/// Brief 2-3 step 2 — a tenant's own sign-in (docs/identity-rbac-audit-investigation.md §4.1).
/// OIDC today; SAML fields arrive with step 5. The client secret is sealed with the
/// payout key machinery (lib/crypto), never stored or returned in clear. The
/// environment IdP became Alto HR's first row at boot (lib/identity.ensureEnvIdentity).
model IdentityConnection {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// OIDC | SAML
  kind                String   @default("OIDC") @db.VarChar(10)
  displayName         String   @db.VarChar(120)
  /// The sign-in button's words ("Continue with Okta").
  buttonLabel         String?  @db.VarChar(80)
  issuerUrl           String   @db.VarChar(500)
  clientId            String   @db.VarChar(300)
  clientSecretEnc     Bytes
  /// NONE: SSO never activates anyone; INVITED_ONLY: an invited account becomes active on first SSO (today's rule).
  jitPolicy           String   @default("INVITED_ONLY") @db.VarChar(20)
  /// Password sign-in is refused for this tenant's staff (non-associate roles); passkeys still work (decision 4).
  ssoRequiredForStaff Boolean  @default(false)
  enabled             Boolean  @default(true)
  /// Brief 2-3 step 5 (SAML): the IdP's signing certificate (PEM). For SAML, issuerUrl is the IdP's single sign-on URL and clientId its entity id; clientSecretEnc is empty.
  samlIdpCert         String?  @db.Text
  /// Decision 6: IdP-initiated SAML (an unsolicited response) is refused unless turned on per connection.
  allowIdpInitiated   Boolean  @default(false)
  /// The connection made from the environment variables at boot.
  fromEnvironment     Boolean  @default(false)
  createdById         String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  identities UserIdentity[]

  @@index([tenantId, enabled])
}

/// A tenant's email domain, proven by a DNS TXT record; the login page discovers a
/// tenant's sign-in from a verified domain only (decision 1). One tenant per domain.
model TenantDomain {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  domain            String    @unique @db.VarChar(253)
  verificationToken String    @db.VarChar(80)
  verifiedAt        DateTime? @db.Timestamptz(6)
  lastCheckedAt     DateTime? @db.Timestamptz(6)
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenantId])
}

/// Access pack: a tenant's sign-in posture beyond the IdP — where sessions
/// may come from (CIDR allowlists per role class), how long they live
/// (idle and absolute), whether a device is remembered, and whether the
/// break-glass path is open at all. One row per tenant; absent = no limits.
model TenantSecurityPolicy {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// Minutes without a request before a session ends; null = never.
  sessionIdleMinutes    Int?
  /// Hours after sign-in when a session ends regardless; null = the token's own life.
  sessionAbsoluteHours  Int?
  /// CIDRs (v4 or v6) that may hold a session, per role class; empty = anywhere.
  allowedCidrsInternal  String[] @default([])
  allowedCidrsClient    String[] @default([])
  allowedCidrsAssociate String[] @default([])
  /// Remember a device after a two-step sign-in; a new device is challenged again.
  deviceTrustEnabled    Boolean  @default(false)
  deviceTrustDays       Int      @default(30)
  /// Break-glass owners may use password + two-step while SSO is required.
  breakGlassEnabled     Boolean  @default(true)
  updatedById           String?  @db.Uuid
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
}

/// Access pack: a device a person completed two-step sign-in on. The cookie
/// holds a random token; only its hash is here. Revoked from Settings.
model TrustedDevice {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  label      String    @db.VarChar(200)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([tenantId])
}

/// Access pack: an access certification campaign a tenant admin runs —
/// every account in scope is reviewed by its manager (or the campaign's
/// owner), each with a decision and a note; closing records evidence.
model AccessCertification {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name           String                    @db.VarChar(160)
  scope          AccessCertificationScope  @default(ALL)
  status         AccessCertificationStatus @default(OPEN)
  dueAt          DateTime                  @db.Timestamptz(6)
  createdById    String                    @db.Uuid
  closedById     String?                   @db.Uuid
  closedAt       DateTime?                 @db.Timestamptz(6)
  lastReminderAt DateTime?                 @db.Timestamptz(6)
  evidenceId     String?                   @db.Uuid
  createdAt      DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(6)

  items AccessCertificationItem[]

  @@index([tenantId, status])
}

model AccessCertificationItem {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  certificationId String                       @db.Uuid
  subjectUserId   String                       @db.Uuid
  /// What the account held when the campaign opened (role, scope) — the thing certified.
  snapshot        Json                         @default("{}")
  reviewerUserId  String                       @db.Uuid
  decision        AccessCertificationDecision?
  note            String?                      @db.VarChar(500)
  decidedById     String?                      @db.Uuid
  decidedAt       DateTime?                    @db.Timestamptz(6)
  createdAt       DateTime                     @default(now()) @db.Timestamptz(6)

  certification AccessCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([certificationId, subjectUserId])
  @@index([reviewerUserId, decision])
  @@index([tenantId])
}

/// Access pack: a notification held back by quiet hours or a digest
/// preference, delivered later by the digest job as one message per
/// person and channel. The bell row already landed; this is the outside
/// channel only.
model DeferredNotification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId    String    @db.Uuid
  /// EMAIL | PUSH | WHATSAPP
  channel   String    @db.VarChar(16)
  /// QUIET_HOURS | DIGEST
  reason    String    @db.VarChar(16)
  subject   String?   @db.VarChar(300)
  body      String
  linkUrl   String?   @db.VarChar(500)
  category  String?   @db.VarChar(64)
  dueAt     DateTime  @db.Timestamptz(6)
  sentAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([sentAt, dueAt])
  @@index([userId])
  @@index([tenantId])
}

/// A person bound to their IdP subject (decision 2): the first SSO sign-in links by
/// email inside the tenant; every later one matches the subject, never the email.
model UserIdentity {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId       String    @db.Uuid
  connectionId String    @db.Uuid
  subject      String    @db.VarChar(255)
  emailAtLink  String    @db.VarChar(254)
  linkedAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastLoginAt  DateTime? @db.Timestamptz(6)

  user       User               @relation("UserIdentities", fields: [userId], references: [id], onDelete: Cascade)
  connection IdentityConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, subject])
  @@unique([userId, connectionId])
  @@index([tenantId])
}

/// A tenant's SCIM bearer (§4.2): stored hashed, shown once; the token decides the
/// tenant every provisioned account lands in. The environment SCIM_TOKEN became
/// Alto HR's first row at boot.
model ScimToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name         String    @db.VarChar(120)
  /// SHA-256 of the token, hex.
  hashedSecret String    @unique @db.VarChar(64)
  last4        String    @db.VarChar(4)
  lastUsedAt   DateTime? @db.Timestamptz(6)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)

  @@index([tenantId])
}

/// Brief 2-6 step 2 — a customer's own gate (docs/agent-product-billing-investigation.md §4.2).
/// The most specific policy wins (AGENT over CAPABILITY over FAMILY over TENANT) on top of
/// the platform floor, which a policy can never lower: a platform-gated action stays
/// required whatever a policy says; a policy can add a requirement or name who decides.
model AgentGatePolicy {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// TENANT | FAMILY | CAPABILITY | AGENT
  scope          String    @db.VarChar(12)
  /// The family code, capability key or agent worker id; null for TENANT.
  scopeKey       String?   @db.VarChar(120)
  /// A gated action (SHIFT_ASSIGN…), a capability key, or * for every action in scope.
  action         String    @db.VarChar(60)
  /// REQUIRED | NOT_REQUIRED
  requirement    String    @db.VarChar(14)
  /// OWNER | ROLE | DESK | USER
  approver       String    @default("OWNER") @db.VarChar(10)
  approverRole   Role?
  approverUserId String?   @db.Uuid
  ttlHours       Int       @default(72)
  effectiveFrom  DateTime  @default(now()) @db.Timestamptz(6)
  effectiveTo    DateTime? @db.Timestamptz(6)
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([tenantId, scope])
}

/// Brief 2-6 step 3 — what an agent capability decides about people
/// (docs/agent-product-billing-investigation.md §4.3). One row per agent and
/// capability ('*' for the whole agent); a catalog capability ships defaults
/// in lib/decisionRecord. Fields and notice texts are reviewed by counsel
/// before notices go out (decision 6).
model AgentDecisionProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId          String    @db.Uuid
  capabilityKey     String    @db.VarChar(80)
  /// SCREENING | HIRING | PROMOTION | SCHEDULING | COMPENSATION | DISCIPLINE | TERMINATION | OTHER
  decisionTypes     String[]
  /// NYC_LL144 | CO_ADMT
  jurisdictions     String[]
  /// What the tool evaluates, in words (the NYC notice states it).
  assesses          String    @db.VarChar(1000)
  dataSources       String    @db.VarChar(1000)
  retentionPolicy   String    @db.VarChar(300)
  /// ALWAYS | ON_REQUEST
  humanReview       String    @default("ALWAYS") @db.VarChar(12)
  /// When notices began (the NYC hold counts 10 business days from it).
  noticeStartedAt   DateTime? @db.Timestamptz(6)
  noticeTextVersion Int       @default(1)
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([workerId, capabilityKey])
  @@index([tenantId])
}

/// An independent bias audit of an agent (NYC LL144 §5.1): in force for a year from when it was conducted.
model AgentBiasAudit {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId             String    @db.Uuid
  auditorName          String    @db.VarChar(200)
  independenceAttested Boolean
  independenceText     String    @db.VarChar(1000)
  conductedAt          DateTime  @db.Date
  validUntil           DateTime  @db.Date
  distributionDate     DateTime? @db.Date
  summaryUrl           String?   @db.VarChar(1000)
  /// Selection or scoring rates and impact ratios by sex, race/ethnicity and intersectional categories.
  results              Json
  /// HISTORICAL | TEST
  dataKind             String    @db.VarChar(12)
  testDataReason       String?   @db.VarChar(1000)
  createdById          String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenantId, workerId])
}

/// One decision about a person by an agent capability, append-only (a database trigger
/// refuses edits and deletes; the lifecycle dates are set once). A correction appends a
/// row that points at the old one. Kept at least three years (Colorado).
model AutomatedDecisionRecord {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId           String    @db.Uuid
  capabilityKey      String    @db.VarChar(80)
  decisionType       String    @db.VarChar(20)
  subjectAssociateId String?   @db.Uuid
  /// An applicant or other subject without an associate record.
  subjectRef         String?   @db.VarChar(120)
  jurisdictionTags   String[]
  proposalId         String?   @db.Uuid
  approvalId         String?   @db.Uuid
  humanReviewerId    String?   @db.Uuid
  humanDecidedAt     DateTime? @db.Timestamptz(6)
  /// FAVORABLE | ADVERSE | NONE
  outcome            String    @db.VarChar(10)
  /// What the decision was, in words (no reason text a person did not write).
  summary            String    @db.VarChar(500)
  noticeGivenAt      DateTime? @db.Timestamptz(6)
  noticeChannel      String?   @db.VarChar(20)
  noticeTextVersion  Int?
  auditId            String?   @db.Uuid
  explanationSentAt  DateTime? @db.Timestamptz(6)
  reviewRequestedAt  DateTime? @db.Timestamptz(6)
  reviewResolvedAt   DateTime? @db.Timestamptz(6)
  dataRequestAt      DateTime? @db.Timestamptz(6)
  dataSentAt         DateTime? @db.Timestamptz(6)
  correctsId         String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenantId, workerId, createdAt(sort: Desc)])
  @@index([subjectAssociateId])
}

/// Brief 2-6 step 4 — who was active on a day, by worker type, per tenant
/// (lib/activeDefinition.activeWorkersOn). The ids are evidence, never sent to Stripe.
model UsageSnapshot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  day       DateTime @db.Date
  /// PERSON (associate ids) | AGENT | ROBOT (worker ids)
  type      String   @db.VarChar(8)
  count     Int
  ids       String[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, day, type])
}

/// A month's billable count by type: distinct workers active on at least one day (decision 1).
model UsageRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// YYYY-MM
  month         String   @db.VarChar(7)
  type          String   @db.VarChar(8)
  billableCount Int
  /// SHA-256 of the sorted ids: the count can be re-proved from the snapshots.
  evidenceHash  String   @db.VarChar(64)
  computedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, month, type])
}

/// A price per worker per month, by plan and type, effective-dated. Set by the platform
/// operator once the owner gives the prices (decision 3); none ships.
model BillingPrice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan           String   @db.VarChar(40)
  type           String   @db.VarChar(8)
  unitPriceCents Int
  effectiveFrom  DateTime @db.Date
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([plan, type, effectiveFrom])
}

/// A tenant's monthly invoice: counts and prices only (never a worker's name or id).
model BillingInvoice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  month            String    @db.VarChar(7)
  plan             String    @db.VarChar(40)
  /// [{ type, quantity, unitPriceCents, amountCents }]
  lines            Json
  totalCents       Int
  /// DRAFT | OPEN | PAID | VOID
  status           String    @default("DRAFT") @db.VarChar(8)
  /// Why a draft is still a draft (prices_missing, stripe_not_configured…).
  holdReason       String?   @db.VarChar(120)
  stripeInvoiceId  String?   @db.VarChar(120)
  hostedUrl        String?   @db.VarChar(1000)
  lastPaymentError String?   @db.VarChar(500)
  paidAt           DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, month])
  @@index([stripeInvoiceId])
}

/// Brief 2-6 step 5 — "Contact Alto People support" from the help menu. It reaches the
/// platform inbox (Alto staff, under the platform scope); the requester follows its status
/// in the bell. No worker data is attached automatically.
model SupportRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  requesterUserId String    @db.Uuid
  /// QUESTION | PROBLEM | BILLING | ACCOUNT | OTHER
  category        String    @db.VarChar(10)
  subject         String    @db.VarChar(160)
  body            String    @db.VarChar(5000)
  pageUrl         String?   @db.VarChar(500)
  appVersion      String?   @db.VarChar(60)
  /// OPEN | IN_PROGRESS | RESOLVED
  status          String    @default("OPEN") @db.VarChar(12)
  /// The platform's answer, shown to the requester.
  reply           String?   @db.VarChar(5000)
  resolvedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  requester User @relation("SupportRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, createdAt])
}

/// Brief 2-5 step 3 — one row per field-encryption key id, written when the key first appears.
/// At boot every key in the ring must decrypt its canary, so a changed key stops the deploy
/// instead of surfacing at a read (lib/keyring.verifyKeyring). Platform-level: no tenant.
model EncryptionCanary {
  keyId     Int      @id
  blob      Bytes
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

/// Brief 2-5 step 7 — one security alert raised from the audit trail (lib/securityAlerts):
/// the rule, what it is about (an IP, an account, an actor), the audit rows behind it and
/// who heard it. At most one per rule and key an hour. Platform-level.
model SecurityAlert {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// FAILED_SIGNINS_IP | LOCKED_ACCOUNT | MFA_OFF_ADMIN | PRIVILEGE_CHANGE | EXPORTS
  rule        String   @db.VarChar(24)
  key         String   @db.VarChar(200)
  summary     String   @db.VarChar(500)
  auditLogIds String[]
  deliveredTo String[]
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([rule, key, createdAt])
  @@index([createdAt])
}

/// Brief 2-3 step 3 — a tenant's custom role (docs/identity-rbac-audit-investigation.md §4.3).
/// It behaves as its archetype (boundedness, portal, MFA class: every direct
/// role comparison) and holds a SUBSET of the archetype's capabilities
/// (owner decision 3). The built-in roles are not rows: they are the code's
/// ROLE_CAPABILITIES, so they can never drift from it.
model TenantRole {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name         String    @db.VarChar(80)
  description  String?   @db.VarChar(300)
  archetype    Role
  capabilities String[]
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  users         User[]
  scimGroupMaps ScimGroupRoleMap[]

  @@index([tenantId])
}

/// Brief 2-3 step 3 — a SCIM group as the identity provider pushed it.
model ScimGroup {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  displayName   String   @db.VarChar(200)
  externalId    String?  @db.VarChar(200)
  memberUserIds String[] @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, displayName])
}

/// Brief 2-3 step 3 — group → role: a member of the group holds the role.
model ScimGroupRoleMap {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  groupName    String      @db.VarChar(200)
  archetype    Role
  tenantRoleId String?     @db.Uuid
  tenantRole   TenantRole? @relation(fields: [tenantRoleId], references: [id], onDelete: Cascade)
  /// Several mapped groups: the highest priority wins.
  priority     Int         @default(0)
  createdById  String?     @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, groupName])
}

/// Brief 2-3 step 4 — one run of the chain verifier for one tenant: the head
/// it saw (the next run checks it is still there) and any break.
model AuditChainCheck {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @db.Uuid
  rows      Int
  headSeq   BigInt?
  headHash  String?  @db.VarChar(64)
  ok        Boolean
  breaks    Json     @default("[]")
  checkedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, checkedAt])
}

/// Brief 2-3 step 4 — rows past the tenant's retention, exported encrypted to
/// object storage. Nothing is deleted (decision 8): the rows stay in the table.
model AuditArchive {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @db.Uuid
  fromSeq   BigInt?
  toSeq     BigInt?
  before    DateTime @db.Timestamptz(6)
  rows      Int
  objectKey String   @db.VarChar(300)
  sha256    String   @db.VarChar(64)
  headHash  String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, createdAt])
}

/// Brief 2-3 step 4 — a tenant's SIEM: its audit trail as signed JSON lines,
/// in chain order from a cursor that only moves on a 2xx (decision 9).
model AuditSink {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  url             String    @db.VarChar(500)
  /// The signing secret, sealed like a webhook's (lib/webhookSecrets).
  secretEnc       Bytes
  enabled         Boolean   @default(true)
  cursorSeq       BigInt    @default(0)
  failures        Int       @default(0)
  nextAttemptAt   DateTime? @db.Timestamptz(6)
  lastDeliveredAt DateTime? @db.Timestamptz(6)
  lastError       String?   @db.VarChar(500)
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  deliveries AuditSinkDelivery[]

  @@unique([tenantId])
}

model AuditSinkDelivery {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  sinkId    String    @db.Uuid
  sink      AuditSink @relation(fields: [sinkId], references: [id], onDelete: Cascade)
  fromSeq   BigInt
  toSeq     BigInt
  rows      Int
  status    Int?
  ok        Boolean
  error     String?   @db.VarChar(500)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([sinkId, createdAt])
}

/// Brief 2-3 step 5 — SAML's server-side memory: the AuthnRequest ids we sent
/// (InResponseTo must name one, once) and the assertion ids we accepted (a
/// replayed assertion is refused). Rows expire; a sweep removes them.
model SamlCache {
  key       String   @id @db.VarChar(300)
  value     String   @db.VarChar(300)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// The public status page: incidents the team posts, with their timeline.
// Platform-wide (never a customer's numbers); the public read derives the
// live component states from the reliability rollups.
// ---------------------------------------------------------------------------

enum StatusComponent {
  API
  WEB
  KIOSK
  MESSAGING
  PAYROLL_WEBHOOK
  EMAIL
}

enum StatusImpact {
  DEGRADED
  OUTAGE
}

enum StatusIncidentState {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model StatusIncident {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String                 @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  title           String                 @db.VarChar(160)
  component       StatusComponent
  impact          StatusImpact
  state           StatusIncidentState    @default(INVESTIGATING)
  startedAt       DateTime               @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime?              @db.Timestamptz(6)
  createdByUserId String?                @db.Uuid
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(6)
  updates         StatusIncidentUpdate[]

  @@index([startedAt])
  @@index([state])
}

model StatusIncidentUpdate {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId   String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  incidentId String              @db.Uuid
  state      StatusIncidentState
  note       String              @db.VarChar(2000)
  at         DateTime            @default(now()) @db.Timestamptz(6)
  byUserId   String?             @db.Uuid
  incident   StatusIncident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, at])
}

/// F500 G5: someone who asked the public status page for incident updates by email.
/// Double opt-in: updates go only to a confirmed address, and every one carries an
/// unsubscribe link. The confirm and unsubscribe links are HMAC-signed over the id
/// (lib/statusSubscribers), so no secret is stored here.
model StatusSubscriber {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The platform operator's tenant (the status page is the platform's, not a customer's).
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  email       String    @db.VarChar(254)
  confirmedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ===== Labor-demand forecasting (Brief 3-4) =========================// A transparent forecast per site and org week: last year scaled to the
// site's level, the recent eight weeks and their trend, a holiday table and
// the signals a person typed in. One run per compute; the monthly job
// scores the previous runs against verified hours and tunes the weights.

/// One compute of the 26-week forecast for a tenant (manual, monthly or a back-test).
model ForecastRun {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  method       String   @db.VarChar(60)
  horizonWeeks Int
  /// The first org week the run forecasts (the week after the anchor's history ends).
  anchorWeek   DateTime @db.Date
  trigger      String   @db.VarChar(20)
  /// { lastYearWeight, bandLow, bandHigh, mapePct } — what the run used, tuned by the back-test before it.
  weights      Json     @default("{}")
  createdById  String?  @db.Uuid
  generatedAt  DateTime @default(now()) @db.Timestamptz(6)

  siteWeeks ForecastSiteWeek[]

  @@index([tenantId, generatedAt(sort: Desc)])
}

/// One site-week of a run: the band and why.
model ForecastSiteWeek {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId   String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  runId      String   @db.Uuid
  locationId String   @db.Uuid
  weekStart  DateTime @db.Date
  /// Demand in verified hours for the week.
  p10        Float
  p50        Float
  p90        Float
  /// ForecastDrivers (shared/forecast.ts): the components the number was built from.
  drivers    Json     @default("{}")

  run      ForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  location Site        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([runId, locationId, weekStart])
  @@index([tenantId, locationId, weekStart])
}

/// A client signal a person entered for a site-week: a multiplier on that week's demand.
model ForecastSignal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  locationId  String   @db.Uuid
  weekStart   DateTime @db.Date
  /// TRUCKS | OCCUPANCY | EVENT | OTHER
  kind        String   @db.VarChar(20)
  factor      Float
  source      String?  @db.VarChar(120)
  note        String?  @db.VarChar(500)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  location Site @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, weekStart, kind])
  @@index([tenantId, locationId])
}

/// The monthly scoring: what a run said for a week at a lead, against the verified hours that came.
model ForecastAccuracy {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  locationId  String   @db.Uuid
  weekStart   DateTime @db.Date
  leadWeeks   Int
  forecastP50 Float
  actualHours Float
  /// |forecast − actual| ÷ actual, as a percentage.
  absPctError Float
  runId       String?  @db.Uuid
  recordedAt  DateTime @default(now()) @db.Timestamptz(6)

  location Site @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, weekStart, leadWeeks])
  @@index([tenantId, locationId, weekStart])
}

// ---------------------------------------------------------------------------
// Brief 3-5: HR and VMS integrations. One connection per vendor per tenant,
// behind a common adapter interface; every sync leaves a run with per-record
// outcomes the tenant admin can read. Credentials are encrypted at rest with
// the field-encryption keyring (lib/keyring.ts lists the column).
// ---------------------------------------------------------------------------

enum IntegrationVendor {
  FIELDGLASS
  ADP
  WORKDAY
  UKG
  BEELINE
}

enum IntegrationConnectionStatus {
  CONNECTED
  PAUSED
  ERROR
}

enum IntegrationSyncDirection {
  PULL
  PUSH
}

enum IntegrationSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

/// A service provider the tenant has connected: E-Verify, background
/// checks, drug tests, tax filing or payouts (lib/providers). Credentials
/// and the webhook secret are encrypted under the keyring; settings holds
/// non-secret configuration (packages per client/position, public keys).
enum ProviderKind {
  EVERIFY
  BACKGROUND_CHECK
  DRUG_TEST
  TAX_FILING
  PAYOUT
  TAX_ENGINE
  EMBEDDED_PAYROLL
  ORIGINATION
  BANK_FEED
}

model ProviderConnection {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind             ProviderKind
  /// CHECKR | GENERIC_SCREENING | DHS_EVERIFY | EVERIFY_AGENT | ESCREEN | QUEST_ESP | TAXBANDITS | WISE
  provider         String          @db.VarChar(30)
  name             String          @db.VarChar(120)
  /// SANDBOX | PRODUCTION
  environment      String          @default("SANDBOX") @db.VarChar(12)
  active           Boolean         @default(true)
  credentialsEnc   Bytes?
  webhookSecretEnc Bytes?
  settings         Json            @default("{}")
  lastSuccessAt    DateTime?       @db.Timestamptz(6)
  lastErrorAt      DateTime?       @db.Timestamptz(6)
  lastError        String?         @db.VarChar(500)
  lastTestAt       DateTime?       @db.Timestamptz(6)
  lastTestOk       Boolean?
  createdByUserId  String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)
  events           ProviderEvent[]

  @@index([tenantId, kind])
}

/// How pay moves for a tenant (employerOrgId null) or one employer of record:
/// which rail pays bank accounts, our ACH settings, KYB, and funding limits.
model PayrollBankingProfile {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  employerOrgId            String?   @db.Uuid
  /// PLATFORM | ACH | BRANCH | WISE | CHECK — the rail for bank-account pay.
  bankRail                 String    @default("PLATFORM") @db.VarChar(12)
  /// SAME_DAY | NEXT_DAY | TWO_DAY
  achSpeed                 String    @default("NEXT_DAY") @db.VarChar(12)
  submitCutoffEt           String    @default("16:00") @db.VarChar(5)
  /// PREFUND: the employer's money is pulled a day ahead (a CCD debit) and the credits go from the platform's account.
  /// OWN_ACCOUNT: the credits are drawn on the company's own account at the originating bank — no pull; the file is the money,
  /// and a paycheck reads DISBURSED only when a person marks the file uploaded.
  settlement               String    @default("PREFUND") @db.VarChar(12)
  /// OWN_ACCOUNT only: UNBALANCED (credits alone; the bank books the offset) or BALANCED (the file ends with one debit to the company's account for the total).
  fileFormat               String    @default("UNBALANCED") @db.VarChar(10)
  companyName              String?   @db.VarChar(16)
  companyId                String?   @db.VarChar(10)
  companyEntryDescription  String    @default("PAYROLL") @db.VarChar(10)
  immediateDestination     String?   @db.VarChar(10)
  immediateDestinationName String?   @db.VarChar(23)
  immediateOrigin          String?   @db.VarChar(10)
  immediateOriginName      String?   @db.VarChar(23)
  originatingDfi           String?   @db.VarChar(8)
  /// NOT_STARTED | PENDING | APPROVED | REJECTED
  kybStatus                String    @default("NOT_STARTED") @db.VarChar(12)
  kybCheckedAt             DateTime? @db.Timestamptz(6)
  kybNote                  String?   @db.VarChar(500)
  perRunLimitCents         BigInt?
  perDayLimitCents         BigInt?
  requirePrenote           Boolean   @default(true)
  /// Include the run's taxes / garnishment remittances in the funding debit (we pay them on).
  collectTaxes             Boolean   @default(false)
  collectGarnishments      Boolean   @default(false)
  fundingAccountId         String?   @db.Uuid
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, employerOrgId])
  @@index([tenantId])
}

/// The employer's operating account the funding debit pulls from.
model EmployerBankAccount {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  employerOrgId        String?   @db.Uuid
  label                String    @db.VarChar(80)
  bankName             String?   @db.VarChar(120)
  routingNumber        String    @db.VarChar(9)
  accountNumberEnc     Bytes
  accountLast4         String    @db.VarChar(4)
  accountType          String    @default("CHECKING") @db.VarChar(10)
  /// UNVERIFIED | MICRODEPOSITS_SENT | VERIFIED | FAILED | DISABLED
  status               String    @default("UNVERIFIED") @db.VarChar(20)
  microDepositHash     String?   @db.VarChar(128)
  microDepositSentAt   DateTime? @db.Timestamptz(6)
  microDepositAttempts Int       @default(0)
  verifiedAt           DateTime? @db.Timestamptz(6)
  verifiedById         String?   @db.Uuid
  createdById          String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  @@index([tenantId])
}

/// One NACHA file: what it carried (encrypted), where it went, what came back.
model AchFile {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String     @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// FUNDING | DIRECT_DEPOSIT | PRENOTE | MICRODEPOSIT
  purpose          String     @db.VarChar(16)
  /// IN_HOUSE | MODERN_TREASURY | INCREASE
  provider         String     @db.VarChar(20)
  connectionId     String?    @db.Uuid
  payrollRunId     String?    @db.Uuid
  fileIdModifier   String     @db.VarChar(1)
  effectiveDate    DateTime   @db.Date
  sameDay          Boolean    @default(false)
  entryCount       Int
  totalDebitCents  BigInt     @default(0)
  totalCreditCents BigInt     @default(0)
  contentEnc       Bytes
  sha256           String     @db.VarChar(64)
  /// CREATED | SUBMITTED | ACCEPTED | REJECTED
  status           String     @default("CREATED") @db.VarChar(12)
  externalRef      String?    @db.VarChar(120)
  error            String?    @db.VarChar(500)
  submittedAt      DateTime?  @db.Timestamptz(6)
  createdById      String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  entries          AchEntry[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([payrollRunId])
}

/// One entry: a credit to a person, the employer's debit, a prenote or a micro-deposit.
model AchEntry {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  achFileId       String    @db.Uuid
  traceNumber     String    @db.VarChar(15)
  /// CREDIT | DEBIT | PRENOTE | MICRODEPOSIT
  kind            String    @db.VarChar(16)
  transactionCode String    @db.VarChar(2)
  amountCents     BigInt
  payrollItemId   String?   @db.Uuid
  payoutMethodId  String?   @db.Uuid
  bankAccountId   String?   @db.Uuid
  associateId     String?   @db.Uuid
  individualName  String    @db.VarChar(22)
  accountLast4    String    @db.VarChar(4)
  /// SENT | SETTLED | RETURNED | CORRECTED
  status          String    @default("SENT") @db.VarChar(12)
  returnCode      String?   @db.VarChar(3)
  returnedAt      DateTime? @db.Timestamptz(6)
  nocCode         String?   @db.VarChar(3)
  nocData         String?   @db.VarChar(29)
  nocAppliedAt    DateTime? @db.Timestamptz(6)
  externalRef     String?   @db.VarChar(120)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  file            AchFile   @relation(fields: [achFileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, traceNumber])
  @@index([payrollItemId])
  @@index([payoutMethodId])
  @@index([externalRef])
}

/// The money behind one run, pulled from the employer before anyone is paid.
model PayrollFunding {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  payrollRunId       String    @unique @db.Uuid
  employerOrgId      String?   @db.Uuid
  bankAccountId      String?   @db.Uuid
  amountCents        BigInt
  breakdown          Json      @default("{}")
  payDate            DateTime  @db.Date
  debitEffectiveDate DateTime  @db.Date
  fundingDeadline    DateTime  @db.Timestamptz(6)
  achSpeed           String    @db.VarChar(12)
  /// DRAFT | AWAITING_APPROVAL | SUBMITTED | SETTLED | RETURNED | WIRE_PENDING | WIRE_RECEIVED | CANCELLED
  status             String    @default("DRAFT") @db.VarChar(20)
  achEntryId         String?   @db.Uuid
  approvalRequestId  String?   @db.Uuid
  returnCode         String?   @db.VarChar(3)
  returnReason       String?   @db.VarChar(300)
  submittedAt        DateTime? @db.Timestamptz(6)
  settledAt          DateTime? @db.Timestamptz(6)
  returnedAt         DateTime? @db.Timestamptz(6)
  note               String?   @db.VarChar(500)
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  @@index([tenantId, status])
}

/// A day the tenant's bank is closed beyond the Federal Reserve's holidays (closed=false: open on one).
model BankHolidayOverride {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  date        DateTime @db.Date
  name        String   @db.VarChar(120)
  closed      Boolean  @default(true)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, date])
}

/// One inbound webhook delivery or outbound call, deduplicated on the
/// provider's event id so a retried delivery is applied once.
model ProviderEvent {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  connectionId String             @db.Uuid
  connection   ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kind         ProviderKind
  /// IN (webhook) | OUT (our call)
  direction    String             @db.VarChar(4)
  eventType    String             @db.VarChar(80)
  externalId   String             @db.VarChar(160)
  subjectType  String?            @db.VarChar(40)
  subjectId    String?            @db.Uuid
  /// RECEIVED | PROCESSED | IGNORED | FAILED
  status       String             @default("RECEIVED") @db.VarChar(12)
  error        String?            @db.VarChar(500)
  /// Redacted: never a credential, SSN or report body.
  payload      Json?
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  processedAt  DateTime?          @db.Timestamptz(6)

  @@unique([connectionId, externalId])
  @@index([tenantId, status, createdAt])
  @@index([subjectType, subjectId])
}

model IntegrationConnection {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String                      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  vendor          IntegrationVendor
  name            String                      @db.VarChar(120)
  status          IntegrationConnectionStatus @default(CONNECTED)
  /// Sandbox replays recorded fixtures and never calls the vendor; the sync log is real either way.
  sandbox         Boolean                     @default(true)
  /// AES-256-GCM under the keyring: a JSON object of the vendor's credential fields. Null in sandbox.
  credentialsEnc  Bytes?
  /// Per-tenant field mapping: { group: { altoField: vendorField } }, merged over the vendor's default.
  mapping         Json                        @default("{}")
  /// The capabilities this connection runs (a subset of the adapter's).
  capabilities    String[]                    @default([])
  /// Scheduled sync every N minutes; null = event-driven and manual only.
  scheduleMinutes Int?
  eventDriven     Boolean                     @default(true)
  lastSyncAt      DateTime?                   @db.Timestamptz(6)
  nextSyncAt      DateTime?                   @db.Timestamptz(6)
  lastError       String?                     @db.VarChar(500)
  createdByUserId String?                     @db.Uuid
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(6)
  runs            IntegrationSyncRun[]

  @@index([tenantId, vendor])
  @@index([tenantId, status, nextSyncAt])
}

model IntegrationSyncRun {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  connectionId String                   @db.Uuid
  connection   IntegrationConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  direction    IntegrationSyncDirection
  capability   String                   @db.VarChar(40)
  status       IntegrationSyncStatus    @default(RUNNING)
  /// schedule | event | manual | sandbox-test
  trigger      String                   @db.VarChar(20)
  eventType    String?                  @db.VarChar(60)
  startedAt    DateTime                 @default(now()) @db.Timestamptz(6)
  finishedAt   DateTime?                @db.Timestamptz(6)
  total        Int                      @default(0)
  succeeded    Int                      @default(0)
  failed       Int                      @default(0)
  /// Adapter summary: totals reconciled, vendor batch ids, period bounds. Never a credential or PII.
  summary      Json?
  errors       IntegrationSyncError[]

  @@index([connectionId, startedAt])
  @@index([tenantId, startedAt])
}

model IntegrationSyncError {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  runId     String             @db.Uuid
  run       IntegrationSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Which record: an Alto id or a vendor id, never a name.
  recordRef String             @db.VarChar(120)
  message   String             @db.VarChar(500)
  /// The vendor payload around the failure, redacted of emails, phones and identifiers.
  excerpt   Json?
  createdAt DateTime           @default(now()) @db.Timestamptz(6)

  @@index([runId, createdAt])
}

// ---------------------------------------------------------------------------
// Brief 3-2: tasks and the assignment engine. A Task is one unit of work at a
// site in a time window with a required capability; TaskAssignment records
// who holds it and WHY (the ranking); TaskEvent is its timeline; TaskPolicy
// is the tenant's (or a site's) rules for the engine.
// ---------------------------------------------------------------------------

enum WorkTaskRisk {
  LOW
  MEDIUM
  HIGH
}

enum WorkTaskStatus {
  OPEN
  QUEUED
  ASSIGNED
  IN_PROGRESS
  STALLED
  FAILED
  HANDED_OFF
  DONE
  CANCELLED
}

enum WorkTaskEventKind {
  ASSIGNED
  QUEUED
  STARTED
  STALLED
  FAILED
  HANDED_OFF
  DONE
  CANCELLED
}

enum WorkTaskAssignmentState {
  ACTIVE
  RELEASED
}

enum WorkTaskDecider {
  ENGINE
  PERSON
  HANDOFF
}

enum WorkTaskHighRiskPolicy {
  PERSON_ONLY
  PERSON_OR_SUPERVISED_ROBOT
}

model WorkTask {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  type             String         @db.VarChar(80)
  locationId       String         @db.Uuid
  /// Where inside the site: "Dock 3", "Ballroom B".
  area             String?        @db.VarChar(120)
  windowStart      DateTime       @db.Timestamptz(6)
  windowEnd        DateTime       @db.Timestamptz(6)
  /// A WORKER_CAPABILITIES code.
  capability       String         @db.VarChar(60)
  risk             WorkTaskRisk   @default(LOW)
  estimatedMinutes Int
  /// The client's own reference: a truck, a banquet, a room list.
  reference        String?        @db.VarChar(160)
  notes            String?        @db.VarChar(2000)
  status           WorkTaskStatus @default(OPEN)
  /// Why the engine queued it for a person, in one line.
  queuedReason     String?        @db.VarChar(300)
  createdByUserId  String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  location    Site                 @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assignments WorkTaskAssignment[]
  events      WorkTaskEvent[]

  @@index([tenantId, locationId, windowStart])
  @@index([tenantId, status])
}

model WorkTaskAssignment {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  taskId          String                  @db.Uuid
  workerId        String                  @db.Uuid
  state           WorkTaskAssignmentState @default(ACTIVE)
  decidedBy       WorkTaskDecider
  decidedByUserId String?                 @db.Uuid
  score           Int                     @default(0)
  costCents       Int                     @default(0)
  /// The factors and points behind this assignment (AssignmentReason[]).
  reasons         Json
  /// Every candidate weighed, best first (RankedCandidate[]).
  ranking         Json
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  releasedAt      DateTime?               @db.Timestamptz(6)

  task   WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker Worker   @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@index([taskId, state])
  @@index([workerId, state])
}

model WorkTaskEvent {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  taskId   String            @db.Uuid
  kind     WorkTaskEventKind
  at       DateTime          @default(now()) @db.Timestamptz(6)
  note     String?           @db.VarChar(2000)
  byUserId String?           @db.Uuid
  workerId String?           @db.Uuid

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, at])
}

/// One per tenant (locationId null), optionally one per site that overrides it.
model WorkTaskPolicy {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                 @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  locationId            String?                @db.Uuid
  /// Every rule is nullable: a null on a site's row means "as the company's row says", and a null on the
  /// company's row means the shared default (DEFAULT_WORK_TASK_POLICY). lib/tasks/engine.policyFor merges
  /// them field by field, so a site that only sets its handoff seconds inherits the rest (audit 2026-10-21).
  handoffSeconds        Int?
  /// Null on the company row = no cap. A site cannot lift the company's cap (a null site value inherits it).
  maxAutoAssignCents    Int?
  highRiskPolicy        WorkTaskHighRiskPolicy?
  /// Cents per task for a robot by capability code.
  robotCostPerTaskCents Json?
  robotDefaultCostCents Int?
  agentCostPerTaskCents Int?
  /// Brief 3-3: the span of control the scheduler warns on.
  maxRobotsPerCrewLead  Int?
  /// Brief 3-3: share of a robot's shift spent on tasks (the planner's capacity), and standby people per robot minute, as percents.
  robotUtilizationPct   Int?
  backupCrewRatioPct    Int?
  updatedByUserId       String?                @db.Uuid
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  /**
   * ---------------------------------------------------------------------------
   * Brief 3-1 — Robot registry and fleet connectors.
   * A robot is a Worker of type ROBOT (Brief 1D-1: owner required, status,
   * capabilities). The profile carries what a fleet needs beyond the worker
   * row; the connector writes a status time series; the site holds the
   * commissioning record and its safety zones; a crew lead completes the
   * pre-shift checklist before a robot's shift starts; incidents keep the
   * hour's samples as evidence. tenantId on every row (Brief 2-1).
   * -------------------------------------------------------------------------
   */

  @@index([tenantId, locationId])
}

enum RobotOwnership {
  OWNED
  LEASED
}

/// What the fleet connector reports. STOPPED = an emergency stop is in force.
enum RobotConnectorStatus {
  IDLE
  WORKING
  CHARGING
  ERROR
  OFFLINE
  STOPPED
}

enum RobotEventKind {
  E_STOP
  RESUME
  ERROR
  SHIFT_STARTED
  SHIFT_ENDED
  CHECKLIST_COMPLETED
  COMMISSIONED
  MAINTENANCE
}

enum RobotIncidentKind {
  NEAR_MISS
  INJURY
  PROPERTY_DAMAGE
  MALFUNCTION
}

model RobotProfile {
  workerId            String         @id @db.Uuid
  tenantId            String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  manufacturer        String         @db.VarChar(80)
  model               String         @db.VarChar(80)
  serial              String         @db.VarChar(120)
  firmware            String?        @db.VarChar(60)
  ownership           RobotOwnership @default(OWNED)
  leaseEndsOn         DateTime?      @db.Date
  /// Which FleetConnector answers for this robot (SIMULATED, BEAR, PUDU) and its id on that side.
  connectorProvider   String         @default("SIMULATED") @db.VarChar(40)
  connectorExternalId String?        @db.VarChar(120)
  /// [{ name, issuedOn, expiresOn }]
  certifications      Json           @default("[]")
  notes               String?        @db.VarChar(2000)
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([serial])
}

/// A robot is commissioned at a site: the map, the charging stations and
/// the named safety lead's sign-off. Without a sign-off the robot cannot
/// start a shift there.
model RobotCommissioning {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId         String    @db.Uuid
  locationId       String    @db.Uuid
  mapUrl           String?   @db.VarChar(500)
  mapNotes         String?   @db.VarChar(2000)
  /// [{ label, x, y }] in the site's own map units.
  chargingStations Json      @default("[]")
  safetyLeadUserId String?   @db.Uuid
  signedOffAt      DateTime? @db.Timestamptz(6)
  notes            String?   @db.VarChar(2000)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  worker     Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site       Site   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  safetyLead User?  @relation("RobotSafetyLead", fields: [safetyLeadUserId], references: [id], onDelete: SetNull)

  @@unique([workerId, locationId])
  @@index([locationId])
  @@index([tenantId])
}

/// A geofenced zone on a site's map. While `guestOccupied` is on, no robot
/// operates inside it unless the zone says robots may.
model SiteSafetyZone {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  locationId                String    @db.Uuid
  name                      String    @db.VarChar(120)
  /// { type: 'rect', x, y, w, h } | { type: 'polygon', points: [[x, y], …] }
  shape                     Json
  guestOccupied             Boolean   @default(false)
  robotsAllowedWhenOccupied Boolean   @default(false)
  occupiedSince             DateTime? @db.Timestamptz(6)
  occupiedByUserId          String?   @db.Uuid
  createdAt                 DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @db.Timestamptz(6)

  site Site @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([tenantId])
}

/// The pre-shift checklist a crew lead completes before a robot's shift.
/// locationId null = the tenant's default template.
model RobotChecklistTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  locationId String?  @db.Uuid
  name       String   @db.VarChar(120)
  /// [{ key, label, required }]
  items      Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  site Site?               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  runs RobotChecklistRun[]

  @@index([locationId])
  @@index([tenantId])
}

model RobotChecklistRun {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId          String   @db.Uuid
  shiftId           String?  @db.Uuid
  templateId        String   @db.Uuid
  completedByUserId String   @db.Uuid
  completedAt       DateTime @default(now()) @db.Timestamptz(6)
  /// [{ key, ok, note }]
  answers           Json
  allPassed         Boolean
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  worker      Worker                 @relation(fields: [workerId], references: [id], onDelete: Cascade)
  shift       Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  template    RobotChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  completedBy User                   @relation("RobotChecklistCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@index([workerId, completedAt(sort: Desc)])
  @@index([shiftId])
  @@index([tenantId])
}

/// One reading from the fleet connector. Sampled every minute; kept 90
/// days (an incident copies its hour into evidence before that).
model RobotStatusSample {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId    String               @db.Uuid
  at          DateTime             @db.Timestamptz(6)
  status      RobotConnectorStatus
  batteryPct  Int?
  x           Float?
  y           Float?
  currentTask String?              @db.VarChar(200)
  errorCode   String?              @db.VarChar(80)
  raw         Json?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, at(sort: Desc)])
  @@index([tenantId])
}

/// The emergency-stop log and the rest of a robot's life: who stopped it,
/// who resumed it, every error, every shift start, every checklist.
model RobotEvent {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId String         @db.Uuid
  kind     RobotEventKind
  at       DateTime       @default(now()) @db.Timestamptz(6)
  byUserId String?        @db.Uuid
  shiftId  String?        @db.Uuid
  note     String?        @db.VarChar(500)
  metadata Json?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  by     User?  @relation("RobotEventBy", fields: [byUserId], references: [id], onDelete: SetNull)
  shift  Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([workerId, at(sort: Desc)])
  @@index([kind, at(sort: Desc)])
  @@index([tenantId])
}

model RobotMaintenance {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId    String    @db.Uuid
  performedOn DateTime  @db.Date
  kind        String    @db.VarChar(80)
  description String    @db.VarChar(2000)
  performedBy String?   @db.VarChar(120)
  costCents   Int?
  nextDueOn   DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, performedOn(sort: Desc)])
  @@index([tenantId])
}

/// An incident or near miss involving a robot, with the evidence that
/// hour: the status samples, the events and the people on shift at the
/// site. An injury or damage at a client site also opens an OshaIncident.
model RobotIncident {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  workerId         String            @db.Uuid
  locationId       String?           @db.Uuid
  kind             RobotIncidentKind
  occurredAt       DateTime          @db.Timestamptz(6)
  description      String            @db.VarChar(4000)
  reportedByUserId String?           @db.Uuid
  oshaIncidentId   String?           @db.Uuid
  /// [{ associateId, name, shiftId }] — who was on shift at the site that hour.
  peopleOnShift    Json              @default("[]")
  /// The robot's samples for the hour before the incident, copied at report time.
  samples          Json              @default("[]")
  /// The robot's events for that hour, copied at report time.
  events           Json              @default("[]")
  /// Evidence retention: kept at least until this date.
  retainUntil      DateTime          @db.Date
  /// Set by the retention sweep (lib/robotIncidentRetention) once the hour's samples, events and the
  /// people on shift were removed past retainUntil. The report itself (kind, when, what) stays.
  evidencePurgedAt DateTime?         @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)

  worker       Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site         Site?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reportedBy   User?         @relation("RobotIncidentReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  oshaIncident OshaIncident? @relation(fields: [oshaIncidentId], references: [id], onDelete: SetNull)

  @@index([workerId, occurredAt(sort: Desc)])
  @@index([locationId])
  @@index([tenantId])
}

/// A tenant's decision to pay a jurisdiction (or one site) by the labor-rules
/// engine. PENDING waits on a second person; LIVE pays; ENDED went back to
/// shadow. The rows counsel signed are pinned (signedSetIds): a newer pack
/// version is not paid until it is signed again.
model LaborRuleActivation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  jurisdiction      String    @db.VarChar(60)
  siteId            String?   @db.Uuid
  /// PENDING | LIVE | ENDED | REJECTED
  status            String    @default("PENDING") @db.VarChar(12)
  signedSetIds      String[]  @default([])
  signedLabels      String[]  @default([])
  counselName       String    @db.VarChar(120)
  counselFirm       String    @db.VarChar(160)
  counselSignedOn   DateTime  @db.Date
  attestation       String    @db.VarChar(2000)
  changeReport      Json?
  approvalRequestId String?   @db.Uuid
  requestedById     String?   @db.Uuid
  activatedById     String?   @db.Uuid
  activatedAt       DateTime? @db.Timestamptz(6)
  endedById         String?   @db.Uuid
  endedAt           DateTime? @db.Timestamptz(6)
  endReason         String?   @db.VarChar(500)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenantId, jurisdiction, status])
  @@index([approvalRequestId])
}

/// Predictability pay owed for a schedule change inside the notice window.
model ScheduleChangePremium {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId   String   @db.Uuid
  shiftId       String?  @db.Uuid
  siteId        String?  @db.Uuid
  workDate      DateTime @db.Date
  /// added | reduced | cancelled | moved
  change        String   @db.VarChar(12)
  noticeDays    Decimal  @db.Decimal(6, 2)
  hoursAffected Decimal  @default(0) @db.Decimal(6, 2)
  premiumHours  Decimal  @default(0) @db.Decimal(6, 2)
  premiumCents  Int      @default(0)
  exempt        Boolean  @default(false)
  exemptReason  String?  @db.VarChar(40)
  reasonText    String?  @db.VarChar(500)
  rule          String   @db.VarChar(300)
  /// Whether the jurisdiction was LIVE when the change was made (only live premiums are paid).
  live          Boolean  @default(false)
  payrollRunId  String?  @db.Uuid
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId, associateId, workDate])
  @@index([payrollRunId])
}

/// Punch rounding, applied when pay is computed (never to the raw punch).
/// NONE | NEAREST (the neutral rule: half the increment and under rounds down) | EMPLOYEE_FAVOR.
model PunchRoundingPolicy {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  siteId      String?  @db.Uuid
  mode        String   @default("NONE") @db.VarChar(16)
  increment   Int      @default(15)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, siteId])
}

/// A worker's missed-punch or correction request, with their signed attestation.
model TimeCorrectionRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId      String    @db.Uuid
  timeEntryId      String?   @db.Uuid
  /// MISSED_CLOCK_IN | MISSED_CLOCK_OUT | WRONG_TIME | NEW_ENTRY
  kind             String    @db.VarChar(20)
  /// PROMPTED (the kiosk asked) | SUBMITTED | APPROVED | DENIED | WITHDRAWN
  status           String    @default("SUBMITTED") @db.VarChar(12)
  workDate         DateTime? @db.Date
  siteId           String?   @db.Uuid
  proposedClockIn  DateTime? @db.Timestamptz(6)
  proposedClockOut DateTime? @db.Timestamptz(6)
  reason           String?   @db.VarChar(1000)
  attestationText  String?   @db.VarChar(1000)
  attestedAt       DateTime? @db.Timestamptz(6)
  attestationIp    String?   @db.VarChar(64)
  attestationUa    String?   @db.VarChar(300)
  before           Json?
  after            Json?
  decidedById      String?   @db.Uuid
  decidedAt        DateTime? @db.Timestamptz(6)
  decisionReason   String?   @db.VarChar(1000)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([associateId, status])
}

/// "Did you get your meal break?" answered at clock-out where the state requires one.
model BreakAttestation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  timeEntryId String   @unique @db.Uuid
  associateId String   @db.Uuid
  /// YES | NO | WAIVED
  meal        String   @db.VarChar(8)
  /// YES | NO (where rest periods are required)
  rest        String?  @db.VarChar(8)
  note        String?  @db.VarChar(500)
  /// Raised to the lead (a "no" where the rules aren't paid live yet).
  flagged     Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId, flagged])
}

/// Overtime offered fewest-overtime-first: who was offered an open shift that
/// would put them into overtime, in which order, and what they said.
model OvertimeOffer {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  shiftId               String    @db.Uuid
  associateId           String    @db.Uuid
  rank                  Int
  overtimeHoursInPeriod Decimal   @default(0) @db.Decimal(8, 2)
  wouldAddOvertimeHours Decimal   @default(0) @db.Decimal(8, 2)
  /// OFFERED | ACCEPTED | DECLINED | EXPIRED | SKIPPED
  status                String    @default("OFFERED") @db.VarChar(10)
  offeredById           String?   @db.Uuid
  offeredAt             DateTime  @default(now()) @db.Timestamptz(6)
  respondedAt           DateTime? @db.Timestamptz(6)
  note                  String?   @db.VarChar(500)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([tenantId, offeredAt])
  @@index([shiftId])
}

// ===== Leave of absence & claims (2026-12, CLAIMS pack) =====================
// FMLA / state paid leave / USERRA / ADA / personal leave cases with their
// usage and (restricted) documents; unemployment claims with the offers of
// suitable work behind a contest; workers' comp claims with the FROI and
// modified-duty offers. Medical documents are read only by leave admins.

enum LeaveType {
  FMLA
  STATE_PFML
  MILITARY_USERRA
  ADA_ACCOMMODATION
  PERSONAL
  COMPANY
}

enum LeaveReason {
  OWN_HEALTH
  FAMILY_CARE
  BONDING
  PREGNANCY
  MILITARY_EXIGENCY
  MILITARY_CAREGIVER
  MILITARY_SERVICE
  ACCOMMODATION
  OTHER
}

enum LeaveSchedule {
  CONTINUOUS
  INTERMITTENT
  REDUCED
}

enum LeaveStatus {
  REQUESTED
  PENDING_CERTIFICATION
  APPROVED
  DENIED
  RETURNED
  CLOSED
  CANCELLED
}

enum LeaveDocumentKind {
  MEDICAL_CERTIFICATION
  FITNESS_FOR_DUTY
  MILITARY_ORDERS
  OTHER
}

enum FmlaYearMethod {
  ROLLING_BACKWARD
  ROLLING_FORWARD
  CALENDAR
  FIXED
}

enum UnemploymentClaimStatus {
  NEW
  RESPONDED
  DETERMINED
  HEARING_SCHEDULED
  APPEALED
  CLOSED
}

enum UnemploymentDecision {
  CONTEST
  DO_NOT_CONTEST
}

enum UnemploymentDetermination {
  ALLOWED
  DENIED
}

enum WorkOfferResponse {
  PENDING
  ACCEPTED
  DECLINED
  NO_RESPONSE
}

enum WcClaimStatus {
  OPEN
  SUBMITTED
  ACCEPTED
  DENIED
  CLOSED
}

enum WcClaimType {
  MEDICAL_ONLY
  INDEMNITY
}

/// Per-tenant leave and claims settings: how the FMLA year is counted, the
/// covered-employer and 50-within-75-miles attestations, the SUI impact
/// factor behind the "estimated tax impact" number, the default UI response
/// window and FROI windows by state (defaults; your carrier's rules win).
model LeaveSettings {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String         @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  fmlaYearMethod      FmlaYearMethod @default(ROLLING_BACKWARD)
  fmlaFixedYearStart  String?        @db.VarChar(5)
  fmlaCoveredEmployer Boolean        @default(true)
  worksiteAttestation Json           @default("{}")
  suiImpactFactor     Decimal        @default(1.000) @db.Decimal(6, 3)
  uiResponseDays      Int            @default(10)
  froiDeadlineDays    Json           @default("{}")
  updatedById         String?        @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)
}

model LeaveCase {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId              String          @db.Uuid
  type                     LeaveType
  reason                   LeaveReason
  /// State paid-leave program code (CA_PFL, NY_PFL, …) for STATE_PFML.
  stateProgram             String?         @db.VarChar(20)
  schedule                 LeaveSchedule   @default(CONTINUOUS)
  startDate                DateTime        @db.Date
  endDate                  DateTime?       @db.Date
  intermittentPattern      String?         @db.VarChar(300)
  reducedHoursPerWeek      Decimal?        @db.Decimal(5, 2)
  status                   LeaveStatus     @default(REQUESTED)
  requestedById            String?         @db.Uuid
  requestedBySelf          Boolean         @default(false)
  /// The FMLA eligibility check as it stood when the case was opened.
  eligibility              Json?
  noticeSentAt             DateTime?       @db.Timestamptz(6)
  designationSentAt        DateTime?       @db.Timestamptz(6)
  designatedFmla           Boolean?
  certificationDueAt       DateTime?       @db.Date
  certificationReceivedAt  DateTime?       @db.Timestamptz(6)
  decidedById              String?         @db.Uuid
  decidedAt                DateTime?       @db.Timestamptz(6)
  decisionNote             String?         @db.VarChar(2000)
  fitnessForDutyRequired   Boolean         @default(false)
  fitnessForDutyReceivedAt DateTime?       @db.Timestamptz(6)
  expectedReturnDate       DateTime?       @db.Date
  actualReturnDate         DateTime?       @db.Date
  benefitsNote             String?         @db.VarChar(1000)
  shiftsReleased           Int             @default(0)
  notes                    String?         @db.VarChar(4000)
  createdAt                DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(6)
  associate                Associate       @relation(fields: [associateId], references: [id], onDelete: Cascade)
  usage                    LeaveUsage[]
  documents                LeaveDocument[]

  @@index([tenantId, status])
  @@index([associateId, startDate])
}

model LeaveUsage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  leaveCaseId String    @db.Uuid
  date        DateTime  @db.Date
  hours       Decimal   @db.Decimal(5, 2)
  shiftId     String?   @db.Uuid
  note        String?   @db.VarChar(500)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  leaveCase   LeaveCase @relation(fields: [leaveCaseId], references: [id], onDelete: Cascade)

  @@index([leaveCaseId, date])
  @@index([tenantId])
}

model LeaveDocument {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  leaveCaseId  String            @db.Uuid
  kind         LeaveDocumentKind
  storageKey   String            @db.VarChar(300)
  filename     String            @db.VarChar(255)
  mimeType     String            @db.VarChar(100)
  size         Int
  uploadedById String?           @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  leaveCase    LeaveCase         @relation(fields: [leaveCaseId], references: [id], onDelete: Cascade)

  @@index([leaveCaseId])
  @@index([tenantId])
}

model UnemploymentClaim {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                     @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId      String                     @db.Uuid
  separationId     String?                    @db.Uuid
  clientId         String?                    @db.Uuid
  state            String                     @db.VarChar(2)
  claimDate        DateTime                   @db.Date
  noticeReceivedAt DateTime                   @db.Date
  responseDueAt    DateTime                   @db.Date
  stateClaimNumber String?                    @db.VarChar(60)
  status           UnemploymentClaimStatus    @default(NEW)
  decision         UnemploymentDecision?
  decisionReason   String?                    @db.VarChar(2000)
  respondedAt      DateTime?                  @db.Timestamptz(6)
  respondedById    String?                    @db.Uuid
  determination    UnemploymentDetermination?
  determinationAt  DateTime?                  @db.Date
  chargesAmount    Decimal?                   @db.Decimal(12, 2)
  hearingAt        DateTime?                  @db.Timestamptz(6)
  hearingOutcome   UnemploymentDetermination?
  appealFiledAt    DateTime?                  @db.Date
  appealOutcome    UnemploymentDetermination?
  notes            String?                    @db.VarChar(4000)
  createdById      String?                    @db.Uuid
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(6)
  associate        Associate                  @relation(fields: [associateId], references: [id], onDelete: Cascade)
  client           Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  workOffers       WorkOffer[]

  @@index([tenantId, status])
  @@index([responseDueAt])
  @@index([associateId])
}

/// An offer of suitable work — recorded whether or not a claim exists yet,
/// because many states disqualify a claimant who refused one.
model WorkOffer {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId   String             @db.Uuid
  claimId       String?            @db.Uuid
  offeredAt     DateTime           @db.Timestamptz(6)
  offeredById   String?            @db.Uuid
  description   String             @db.VarChar(1000)
  clientId      String?            @db.Uuid
  locationId    String?            @db.Uuid
  payRate       Decimal?           @db.Decimal(8, 2)
  response      WorkOfferResponse  @default(PENDING)
  respondedAt   DateTime?          @db.Timestamptz(6)
  declineReason String?            @db.VarChar(1000)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  associate     Associate          @relation(fields: [associateId], references: [id], onDelete: Cascade)
  claim         UnemploymentClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([associateId, offeredAt])
  @@index([tenantId])
}

model WcClaim {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  oshaIncidentId       String?               @unique @db.Uuid
  associateId          String                @db.Uuid
  clientId             String?               @db.Uuid
  locationId           String?               @db.Uuid
  jurisdiction         String                @db.VarChar(2)
  injuryDate           DateTime              @db.Timestamptz(6)
  reportedToEmployerAt DateTime              @db.Date
  froiDueAt            DateTime              @db.Date
  /// First Report of Injury fields as entered (employer, employee, injury, wages, witnesses).
  froi                 Json                  @default("{}")
  froiSubmittedAt      DateTime?             @db.Timestamptz(6)
  submittedById        String?               @db.Uuid
  carrierName          String?               @db.VarChar(160)
  carrierClaimNumber   String?               @db.VarChar(80)
  status               WcClaimStatus         @default(OPEN)
  claimType            WcClaimType           @default(MEDICAL_ONLY)
  lostTimeDays         Int                   @default(0)
  restrictedDays       Int                   @default(0)
  reserveMedical       Decimal?              @db.Decimal(12, 2)
  reserveIndemnity     Decimal?              @db.Decimal(12, 2)
  restrictions         String?               @db.VarChar(2000)
  /// { maxHoursPerShift?, liftLimitLbs?, positions?: string[] } — matched against open shifts.
  restrictionRules     Json?
  rtwDate              DateTime?             @db.Date
  notes                String?               @db.VarChar(4000)
  createdById          String?               @db.Uuid
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  associate            Associate             @relation(fields: [associateId], references: [id], onDelete: Cascade)
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  dutyOffers           WcModifiedDutyOffer[]

  @@index([tenantId, status])
  @@index([froiDueAt])
}

model WcModifiedDutyOffer {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  wcClaimId   String            @db.Uuid
  offeredAt   DateTime          @default(now()) @db.Timestamptz(6)
  offeredById String?           @db.Uuid
  shiftId     String?           @db.Uuid
  description String            @db.VarChar(1000)
  response    WorkOfferResponse @default(PENDING)
  respondedAt DateTime?         @db.Timestamptz(6)
  wcClaim     WcClaim           @relation(fields: [wcClaimId], references: [id], onDelete: Cascade)

  @@index([wcClaimId])
  @@index([tenantId])
}

/**
 * ===== Full-service payroll tax (2027-01) =====================================
 * We pay and file for the customer: every finalized run posts its liabilities
 * per agency (lib/payrollTaxLedger), payments settle them (through a connected
 * embedded payroll provider, or in-house with a confirmation), returns are
 * generated per agency and period, and agency notices are worked to resolution.
 */

enum TaxAgencyKind {
  FEDERAL_WITHHOLDING
  FEDERAL_UNEMPLOYMENT
  STATE_WITHHOLDING
  STATE_UNEMPLOYMENT
  LOCAL
}

enum TaxLiabilityStatus {
  OPEN
  SCHEDULED
  PAID
  VOID
}

enum TaxPaymentStatus {
  SCHEDULED
  SUBMITTED
  PAID
  FAILED
  CANCELLED
}

enum TaxReturnStatus {
  DRAFT
  SUBMITTED
  FILED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum AgencyNoticeStatus {
  NEW
  IN_REVIEW
  RESPONDED
  RESOLVED
}

/// One agency account an employer of record holds: the IRS (941/940), a state's
/// withholding and unemployment accounts, a local tax collector.
model TaxAgencyAccount {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  employerOrgId    String?       @db.Uuid
  kind             TaxAgencyKind
  /// "US" for federal, a state code ("CA"), or "PA:<local name>" / "OH:<city>" for a local.
  jurisdiction     String        @db.VarChar(80)
  agencyName       String        @db.VarChar(160)
  accountNumber    String?       @db.VarChar(60)
  /// NEXT_DAY | SEMIWEEKLY | MONTHLY | QUARTERLY | ANNUAL
  depositFrequency String        @default("MONTHLY") @db.VarChar(16)
  /// MONTHLY deposits: the day of the following month they are due.
  dueDayOfMonth    Int           @default(15)
  /// Unemployment: this year's assigned rate and wage base.
  rate             Decimal?      @db.Decimal(7, 5)
  rateYear         Int?
  wageBase         Decimal?      @db.Decimal(12, 2)
  /// ACTIVE | PENDING_REGISTRATION | CLOSED
  status           String        @default("ACTIVE") @db.VarChar(24)
  effectiveFrom    DateTime?     @db.Date
  effectiveTo      DateTime?     @db.Date
  notes            String?       @db.VarChar(500)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  employerOrg EmployerOrganization? @relation(fields: [employerOrgId], references: [id], onDelete: SetNull)
  liabilities TaxLiability[]
  payments    TaxPayment[]
  returns     TaxReturn[]
  notices     AgencyNotice[]

  @@index([tenantId, kind, jurisdiction])
}

/// What one run owes one agency, and by when.
model TaxLiability {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  payrollRunId  String?            @db.Uuid
  employerOrgId String?            @db.Uuid
  accountId     String?            @db.Uuid
  kind          TaxAgencyKind
  jurisdiction  String             @db.VarChar(80)
  /// The quarter the liability falls in: "2026-Q4".
  periodLabel   String             @db.VarChar(16)
  liabilityDate DateTime           @db.Date
  dueDate       DateTime           @db.Date
  amount        Decimal            @db.Decimal(12, 2)
  breakdown     Json               @default("{}")
  status        TaxLiabilityStatus @default(OPEN)
  paymentId     String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  payrollRun PayrollRun?       @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  account    TaxAgencyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payment    TaxPayment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([payrollRunId, kind, jurisdiction])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, periodLabel])
}

/// Money sent to an agency — through the embedded provider, or by the
/// customer (EFTPS / the state's site) and recorded with its confirmation.
model TaxPayment {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  accountId            String?          @db.Uuid
  kind                 TaxAgencyKind
  jurisdiction         String           @db.VarChar(80)
  periodLabel          String           @db.VarChar(16)
  amount               Decimal          @db.Decimal(12, 2)
  dueDate              DateTime         @db.Date
  /// PROVIDER | EFTPS | STATE_PORTAL | LOCAL_PORTAL
  method               String           @db.VarChar(20)
  status               TaxPaymentStatus @default(SCHEDULED)
  providerConnectionId String?          @db.Uuid
  providerRef          String?          @db.VarChar(120)
  confirmationNumber   String?          @db.VarChar(80)
  submittedAt          DateTime?        @db.Timestamptz(6)
  paidAt               DateTime?        @db.Timestamptz(6)
  paidById             String?          @db.Uuid
  failureReason        String?          @db.VarChar(500)
  createdById          String?          @db.Uuid
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6)

  account     TaxAgencyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  liabilities TaxLiability[]

  @@index([tenantId, status, dueDate])
}

/// A return for one agency and period: 941, 940, a state withholding return
/// or annual reconciliation, a state unemployment wage report, a local return,
/// or an amendment of one of those.
model TaxReturn {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  accountId          String?         @db.Uuid
  /// F941 | F940 | STATE_WH_QUARTERLY | STATE_WH_ANNUAL | SUI_WAGE_REPORT | LOCAL_QUARTERLY | F941X | STATE_AMENDED
  kind               String          @db.VarChar(30)
  jurisdiction       String          @db.VarChar(80)
  /// "2026-Q4", or "2026" for an annual return.
  periodLabel        String          @db.VarChar(16)
  periodStart        DateTime        @db.Date
  periodEnd          DateTime        @db.Date
  dueDate            DateTime        @db.Date
  /// The figures and (for wage reports) the per-employee rows, as generated.
  data               Json
  status             TaxReturnStatus @default(DRAFT)
  /// PROVIDER | MANUAL
  method             String?         @db.VarChar(20)
  providerRef        String?         @db.VarChar(120)
  confirmationNumber String?         @db.VarChar(80)
  filedAt            DateTime?       @db.Timestamptz(6)
  filedById          String?         @db.Uuid
  rejectionReason    String?         @db.VarChar(500)
  amendsId           String?         @db.Uuid
  createdById        String?         @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)

  account    TaxAgencyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  amends     TaxReturn?        @relation("TaxReturnAmends", fields: [amendsId], references: [id], onDelete: SetNull)
  amendments TaxReturn[]       @relation("TaxReturnAmends")

  @@index([tenantId, kind, periodLabel])
}

/// A letter from an agency (a balance due, a penalty, a rate notice, a
/// mismatch) worked from intake to resolution.
model AgencyNotice {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  accountId     String?            @db.Uuid
  agencyName    String             @db.VarChar(160)
  jurisdiction  String?            @db.VarChar(80)
  noticeType    String             @db.VarChar(80)
  noticeNumber  String?            @db.VarChar(60)
  noticeDate    DateTime           @db.Date
  periodLabel   String?            @db.VarChar(16)
  amountDue     Decimal?           @db.Decimal(12, 2)
  responseDueAt DateTime?          @db.Date
  status        AgencyNoticeStatus @default(NEW)
  assignedToId  String?            @db.Uuid
  fileKey       String?            @db.VarChar(300)
  fileName      String?            @db.VarChar(200)
  contentType   String?            @db.VarChar(100)
  summary       String?            @db.VarChar(2000)
  response      String?            @db.VarChar(4000)
  respondedAt   DateTime?          @db.Timestamptz(6)
  resolution    String?            @db.VarChar(2000)
  resolvedAt    DateTime?          @db.Timestamptz(6)
  penaltyAmount Decimal?           @db.Decimal(12, 2)
  abatedAmount  Decimal?           @db.Decimal(12, 2)
  /// The timeline: [{ at, by, what }].
  events        Json               @default("[]")
  createdById   String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  account TaxAgencyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, responseDueAt])
}

/// Certified payroll — a prevailing-wage (public works) project: the contract,
/// its wage determination, and the weekly WH-347 / California eCPR reports.
model PrevailingWageProject {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name                    String    @db.VarChar(200)
  contractNumber          String?   @db.VarChar(80)
  agency                  String?   @db.VarChar(200)
  awardingBody            String?   @db.VarChar(200)
  wageDeterminationNumber String?   @db.VarChar(80)
  /// California DIR project id (eCPR); null elsewhere.
  dirProjectId            String?   @db.VarChar(40)
  siteId                  String?   @db.Uuid
  clientId                String?   @db.Uuid
  addressLine1            String?   @db.VarChar(200)
  city                    String?   @db.VarChar(80)
  county                  String?   @db.VarChar(80)
  state                   String?   @db.VarChar(2)
  zip                     String?   @db.VarChar(10)
  startDate               DateTime  @db.Date
  endDate                 DateTime? @db.Date
  /// 0 = Sunday … 6 = Saturday: the last day of the reporting week.
  weekEndsOn              Int       @default(6)
  /// CASH (fringe paid in wages) | PLAN (paid to approved plans) | MIXED.
  fringeMode              String    @default("CASH") @db.VarChar(10)
  payrollOfficerName      String?   @db.VarChar(120)
  payrollOfficerTitle     String?   @db.VarChar(120)
  status                  String    @default("ACTIVE") @db.VarChar(10)
  createdById             String?   @db.Uuid
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  site    Site?                    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  rates   PrevailingWageRate[]
  workers PrevailingWageWorker[]
  tags    PrevailingWageTimeTag[]
  reports CertifiedPayrollReport[]

  @@index([tenantId, status])
  @@index([siteId])
}

model PrevailingWageRate {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  projectId                String    @db.Uuid
  classification           String    @db.VarChar(120)
  baseRate                 Decimal   @db.Decimal(8, 2)
  fringeRate               Decimal   @default(0) @db.Decimal(8, 2)
  /// The most apprentices allowed per journeyworker in this classification (null = no limit set).
  apprenticesPerJourneyman Decimal?  @db.Decimal(5, 2)
  effectiveFrom            DateTime  @db.Date
  effectiveTo              DateTime? @db.Date
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)

  project PrevailingWageProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, classification])
  @@index([tenantId])
}

model PrevailingWageWorker {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  projectId              String    @db.Uuid
  associateId            String    @db.Uuid
  classification         String    @db.VarChar(120)
  isApprentice           Boolean   @default(false)
  apprenticeRegistration String?   @db.VarChar(80)
  /// An apprentice's share of the journeyworker rate, per their registered program.
  apprenticeLevelPercent Decimal?  @db.Decimal(5, 2)
  startedOn              DateTime  @db.Date
  endedOn                DateTime? @db.Date
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)

  project   PrevailingWageProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  associate Associate             @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([associateId])
  @@index([tenantId])
}

/// An explicit project tag on a time entry (otherwise time at the project's site is the project's).
model PrevailingWageTimeTag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  timeEntryId    String   @unique @db.Uuid
  projectId      String   @db.Uuid
  classification String?  @db.VarChar(120)
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  timeEntry TimeEntry             @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  project   PrevailingWageProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tenantId])
}

/// One week's certified payroll (WH-347 + Statement of Compliance) for a project.
model CertifiedPayrollReport {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  projectId       String    @db.Uuid
  weekEnding      DateTime  @db.Date
  payrollNumber   Int
  isFinal         Boolean   @default(false)
  /// DRAFT | SIGNED | SUBMITTED
  status          String    @default("DRAFT") @db.VarChar(10)
  snapshot        Json?
  /// PLANS | CASH | MIXED — box 4(a)/(b) of the Statement of Compliance.
  fringeStatement String?   @db.VarChar(10)
  exceptionsText  String?   @db.VarChar(2000)
  signatureName   String?   @db.VarChar(120)
  signerTitle     String?   @db.VarChar(120)
  signedById      String?   @db.Uuid
  signedAt        DateTime? @db.Timestamptz(6)
  signedIp        String?   @db.VarChar(64)
  pdfHash         String?   @db.VarChar(64)
  submittedAt     DateTime? @db.Timestamptz(6)
  submittedTo     String?   @db.VarChar(200)
  confirmation    String?   @db.VarChar(120)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  project PrevailingWageProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, weekEnding])
  @@index([tenantId, status])
}

/// A contractor's W-9, TIN-matching and backup-withholding record.
model ContractorProfile {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId              String    @unique @db.Uuid
  legalName                String?   @db.VarChar(200)
  businessName             String?   @db.VarChar(200)
  /// INDIVIDUAL | C_CORP | S_CORP | PARTNERSHIP | TRUST | LLC | OTHER (W-9 line 3a)
  taxClassification        String?   @db.VarChar(30)
  /// LLC tax classification: C, S or P.
  llcTaxClass              String?   @db.VarChar(1)
  exemptPayeeCode          String?   @db.VarChar(4)
  fatcaCode                String?   @db.VarChar(4)
  addressLine1             String?   @db.VarChar(200)
  city                     String?   @db.VarChar(80)
  state                    String?   @db.VarChar(2)
  zip                      String?   @db.VarChar(10)
  /// SSN | EIN — the TIN itself is Associate.tinEncrypted.
  tinType                  String?   @db.VarChar(3)
  tinLast4                 String?   @db.VarChar(4)
  /// NONE | REQUESTED | SIGNED
  w9Status                 String    @default("NONE") @db.VarChar(10)
  w9RequestedAt            DateTime? @db.Timestamptz(6)
  w9SignedAt               DateTime? @db.Timestamptz(6)
  w9SignatureName          String?   @db.VarChar(120)
  w9SignedIp               String?   @db.VarChar(64)
  w9Hash                   String?   @db.VarChar(64)
  /// The payee crossed out W-9 item 2 (the IRS told them they're subject to backup withholding).
  subjectToBackupCertified Boolean   @default(false)
  /// NOT_CHECKED | PENDING | MATCHED | MISMATCH | INVALID
  tinMatchStatus           String    @default("NOT_CHECKED") @db.VarChar(12)
  tinMatchCode             Int?
  tinMatchCheckedAt        DateTime? @db.Timestamptz(6)
  backupWithholding        Boolean   @default(false)
  /// NO_TIN | NOT_CERTIFIED | B_NOTICE | IRS_NOTIFIED
  backupReason             String?   @db.VarChar(30)
  backupStartedAt          DateTime? @db.Timestamptz(6)
  backupStoppedAt          DateTime? @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  associate  Associate        @relation(fields: [associateId], references: [id], onDelete: Cascade)
  tinResults TinMatchResult[]
  bNotices   BNotice[]

  @@index([tenantId])
}

model TinMatchBatch {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// BULK (Pub 2108A file) | INTERACTIVE (a provider, one TIN at a time)
  kind            String    @default("BULK") @db.VarChar(12)
  /// GENERATED | RESULTS_LOADED
  status          String    @default("GENERATED") @db.VarChar(16)
  requestedCount  Int       @default(0)
  summary         Json?
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  resultsLoadedAt DateTime? @db.Timestamptz(6)

  results TinMatchResult[]

  @@index([tenantId, createdAt])
}

model TinMatchResult {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  batchId       String   @db.Uuid
  profileId     String   @db.Uuid
  /// Our row reference in the request file (never the TIN).
  accountNumber String   @db.VarChar(20)
  /// 1 = EIN, 2 = SSN, 3 = unknown (Pub 2108A)
  tinType       Int
  resultCode    Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  batch   TinMatchBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  profile ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([batchId, accountNumber])
  @@index([profileId])
  @@index([tenantId])
}

/// An IRS CP2100/972CG mismatch for one payee and the B-notice it requires.
model BNotice {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  profileId           String    @db.Uuid
  /// FIRST | SECOND (a second mismatch within three calendar years)
  kind                String    @db.VarChar(6)
  irsNoticeKind       String    @default("CP2100") @db.VarChar(10)
  irsNoticeReceivedOn DateTime  @db.Date
  nameOnNotice        String?   @db.VarChar(200)
  tinLast4OnNotice    String?   @db.VarChar(4)
  /// 15 business days after the IRS notice arrived.
  sendBy              DateTime  @db.Date
  sentAt              DateTime? @db.Timestamptz(6)
  /// 30 business days after the IRS notice arrived: backup withholding starts if not resolved.
  backupBy            DateTime  @db.Date
  respondedAt         DateTime? @db.Timestamptz(6)
  /// W9_RECEIVED | SSA_VALIDATION | IRS_147C | BACKUP_STARTED
  resolution          String?   @db.VarChar(20)
  letterHash          String?   @db.VarChar(64)
  createdById         String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)

  profile ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([tenantId])
}

/// A batch of contractor payments (invoices, project fees) paid outside the hourly payroll run.
