/// A file sent to (or prepared for) the recordkeeper: CONTRIBUTION, CENSUS, TRUE_UP.
model RetirementFile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  planId       String    @db.Uuid
  kind         String    @db.VarChar(16)
  payrollRunId String?   @db.Uuid
  payDate      DateTime? @db.Date
  format       String    @db.VarChar(24)
  content      String
  rowCount     Int       @default(0)
  totals       Json      @default("{}")
  /// GENERATED | SENT | FAILED
  status       String    @default("GENERATED") @db.VarChar(12)
