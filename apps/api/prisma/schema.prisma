/// what they see in two taps — a no-show, a hazard — and their shift
/// supervisor acknowledges it. No decision is taken here; the flag is the
/// word reaching the person who decides. Scalar ids, no foreign keys: a
/// flag outlives the shift it was about, like an audit row.
model FloorFlag {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  clientId         String          @db.Uuid
  locationId       String?         @db.Uuid
  kind             FloorFlagKind
  associateId      String?         @db.Uuid
  shiftId          String?         @db.Uuid
  note             String          @db.VarChar(500)
  raisedById       String          @db.Uuid
  status           FloorFlagStatus @default(OPEN)
  acknowledgedById String?         @db.Uuid
  acknowledgedAt   DateTime?       @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)

  @@index([tenantId, clientId, status, createdAt(sort: Desc)])
}

enum FloorFlagKind {
  NO_SHOW
  HAZARD
  OTHER
}

enum FloorFlagStatus {
  OPEN
  ACKNOWLEDGED
}

