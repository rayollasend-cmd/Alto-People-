  tenantId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  realmId         String    @db.VarChar(40)
  companyName     String?   @db.VarChar(160)
  accessTokenEnc  Bytes
  refreshTokenEnc Bytes
  expiresAt       DateTime  @db.Timestamptz(6)
  lastRefreshedAt DateTime  @default(now()) @db.Timestamptz(6)
  status          String    @default("CONNECTED") @db.VarChar(16)
  /// Change-data-capture high-water mark: changes at or after this were pulled.
