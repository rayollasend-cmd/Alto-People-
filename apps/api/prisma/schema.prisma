  @@index([associateId])
  @@index([tenantId])
}

// ===== Phase 90 — Interview kits, offers, referrals, careers =============

enum OfferStatus {
  /// Pay outside the client's band — someone other than whoever drafted
  /// it must approve before it can be sent.
  PENDING_APPROVAL
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ReferralStatus {
  OPEN
  INTERVIEWING
  HIRED
  REJECTED
}

enum JobPostingStatus {
  DRAFT
  OPEN
  CLOSED
}

model InterviewKit {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name        String
  description String?
  questions   Json      @default("[]")
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  client     Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation("InterviewKitCreator", fields: [createdById], references: [id], onDelete: SetNull)
  interviews Interview[]

  @@index([clientId])
  @@index([tenantId])
}

model Interview {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId          String    @db.Uuid
  kitId                String?   @db.Uuid
  interviewerUserId    String?   @db.Uuid
  scheduledFor         DateTime  @db.Timestamptz(6)
  /// How long it runs — the calendar invite's end time.
  durationMinutes      Int       @default(30)
  /// Where: a store and its address, a phone number, or a video link.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  location             String?
  /// RFC 5545 SEQUENCE: bumped on every reschedule and on cancel, so a
  /// calendar replaces the invite it already holds instead of adding one.
  inviteSequence       Int       @default(0)
  /// When the candidate tapped "I'll be there" on their own page.
  candidateConfirmedAt DateTime? @db.Timestamptz(6)
  completedAt          DateTime? @db.Timestamptz(6)
  scorecard            Json?
  rating               Int?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  candidate   Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kit         InterviewKit? @relation(fields: [kitId], references: [id], onDelete: SetNull)
  interviewer User?         @relation("Interviewer", fields: [interviewerUserId], references: [id], onDelete: SetNull)
  /// The panel (HR walk 9): everyone doing this interview. interviewerUserId stays as its first member.
  panel       InterviewInterviewer[]

  @@index([candidateId])
  @@index([interviewerUserId])
  @@index([tenantId])
}

/// One seat on an interview panel (HR walk 9): an interview can be done by up
/// to three people — a hiring manager, a recruiter, a store lead — and every
/// one of them gets the calendar invite.
model InterviewInterviewer {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interviewId String    @db.Uuid
  userId      String    @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation("InterviewPanel", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Offer {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId            String      @db.Uuid
  clientId               String?     @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId               String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  jobTitle               String
  startDate              DateTime    @db.Date
  salary                 Decimal?    @db.Decimal(12, 2)
  hourlyRate             Decimal?    @db.Decimal(8, 2)
  currency               String      @default("USD") @db.VarChar(3)
  letterBody             String?
  templateRenderId       String?     @db.Uuid
  status                 OfferStatus @default(DRAFT)
  sentAt                 DateTime?   @db.Timestamptz(6)
  decidedAt              DateTime?   @db.Timestamptz(6)
  expiresAt              DateTime?   @db.Timestamptz(6)
  /// Why it needed approval: the band it fell outside.
  approvalNote           String?
  approvedById           String?     @db.Uuid
  approvedAt             DateTime?   @db.Timestamptz(6)
  approvalDeclinedReason String?
  /// The candidate's private link to read and e-sign — only its sha256 is
  /// kept, like every other emailed token.
  acceptTokenHash        String?     @unique
  signedName             String?
  signedAt               DateTime?   @db.Timestamptz(6)
  signedIp               String?
  signedUserAgent        String?
  /// The signed PDF in the blob store, and its sha256 as rendered.
  signedPdfKey           String?
  signedPdfHash          String?
  /// Why the candidate said no, if they said.
  declineReason          String?
  createdById            String?     @db.Uuid
  createdAt              DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime    @updatedAt @db.Timestamptz(6)

  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateRender DocumentRender? @relation(fields: [templateRenderId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("OfferCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("OfferApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([status])
  @@index([tenantId])
}

model Referral {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerUserId String         @db.Uuid
  candidateId    String?        @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  candidateName  String
  candidateEmail String
  candidatePhone String?
  position       String?
  notes          String?
  status         ReferralStatus @default(OPEN)
  bonusAmount    Decimal?       @db.Decimal(10, 2)
  bonusCurrency  String         @default("USD") @db.VarChar(3)
  bonusPaidAt    DateTime?      @db.Timestamptz(6)
  /// The campaign it was made under (marketing), which sets the bonus.
  campaignId     String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  referrer    User                 @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  candidate   Candidate?           @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  campaign    ReferralCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  bonusPayout ReferralBonusPayout?

  @@index([referrerUserId])
  @@index([status])
  @@index([tenantId])
}

model JobPosting {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?             @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  title       String
  description String
  location    String?
  minSalary   Decimal?            @db.Decimal(12, 2)
  maxSalary   Decimal?            @db.Decimal(12, 2)
  currency    String              @default("USD") @db.VarChar(3)
  slug        String              @unique
  status      JobPostingStatus    @default(DRAFT)
  /// How many people the client asked for. Hires against the posting
  /// out of this is its fill rate.
  openings    Int                 @default(1)
  /// Full-time, part-time, temporary or seasonal — job boards and Google
  /// for Jobs file a posting by it.
  schedule    JobPostingSchedule?
  /// Whether minSalary/maxSalary are hourly or yearly. Null = not said.
  payUnit     JobPayUnit?
  /// Listed in the job-board feeds (Indeed, ZipRecruiter, Glassdoor…)
