// ===== ACA look-back measurement (TAXCOMP 2026-10) =========================
// Variable-hour workers are measured over a standard (or, for new hires,
// initial) measurement period; whoever averages the full-time threshold
// (130 h/month) must be offered coverage for the stability period that
// follows. lib/acaMeasurement.ts computes; AcaMonth rows are written from it.

enum AcaClassification {
  FULL_TIME
  VARIABLE_HOUR
  SEASONAL
  PART_TIME
}

enum AcaOfferResponse {
  PENDING
  ENROLLED
  WAIVED
}

model AcaSettings {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String           @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// Standard measurement period length, 3–12 months.
  measurementMonths        Int              @default(12)
  /// Administrative period between measurement and stability, ≤ 90 days.
  adminDays                Int              @default(60)
  /// Stability period, ≥ the measurement period and ≥ 6 months.
  stabilityMonths          Int              @default(12)
  /// Initial measurement period for new variable-hour / seasonal hires.
  initialMeasurementMonths Int              @default(12)
  /// Where the standard stability period starts each year.
  stabilityStartMonth      Int              @default(1)
  stabilityStartDay        Int              @default(1)
  fullTimeHoursPerMonth    Decimal          @default(130) @db.Decimal(6, 2)
  /// Break in service after which a returning worker is treated as new.
  breakInServiceWeeks      Int              @default(13)
  ruleOfParity             Boolean          @default(true)
  /// Line 14 code written for a month the worker was offered coverage.
  defaultOfferCode         AcaCoverageOffer @default(CODE_1E)
  /// Line 16 affordability safe harbor (2F W-2, 2G FPL, 2H rate of pay).
  affordabilitySafeHarbor  String?          @default("2H") @db.VarChar(3)
  lowestPremiumCents       Int?
  updatedById              String?          @db.Uuid
  createdAt                DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(6)
}

model AcaWorkerClass {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId    String            @db.Uuid
  classification AcaClassification
  effectiveFrom  DateTime          @db.Date
  reason         String?           @db.VarChar(300)
  setById        String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([associateId, effectiveFrom])
  @@index([tenantId])
}

model AcaOffer {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId        String           @db.Uuid
  stabilityStart     DateTime         @db.Date
  stabilityEnd       DateTime         @db.Date
  offeredAt          DateTime         @default(now()) @db.Timestamptz(6)
  offeredById        String?          @db.Uuid
  response           AcaOfferResponse @default(PENDING)
  respondedAt        DateTime?        @db.Timestamptz(6)
  offerCode          AcaCoverageOffer @default(CODE_1E)
  lowestPremiumCents Int?
  note               String?          @db.VarChar(500)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([associateId, stabilityStart])
  @@index([tenantId])
}

// ===== WOTC — Work Opportunity Tax Credit (TAXCOMP 2026-10) =================
// The applicant answers the Form 8850 / ETA 9061 questions on or before the
// job offer; HR completes the employer side and files with the state
// workforce agency within 28 days of the start date (through the state
// portal or a partner — the product does not transmit). lib/wotc.ts.

enum WotcStatus {
  NOT_STARTED
  DECLINED
  NOT_ELIGIBLE
  LIKELY_ELIGIBLE
  SUBMITTED
  CERTIFIED
  DENIED
}

model WotcSettings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// Adds the screening to every new onboarding checklist.
  enabled     Boolean  @default(false)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

model WotcScreening {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String     @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId         String     @db.Uuid
  applicationId       String?    @unique @db.Uuid
  status              WotcStatus @default(NOT_STARTED)
  /// The applicant's answers, keyed by question (lib/wotc.ts WOTC_QUESTIONS).
  answers             Json?
  /// Target groups the answers point to (lib/wotc.ts targetGroupsFor).
  targetGroups        String[]   @default([])
  applicantSignedName String?    @db.VarChar(200)
  applicantSignedAt   DateTime?  @db.Timestamptz(6)
  applicantIp         String?    @db.VarChar(64)
  /// Employer side (Form 8850 page 2 / ETA 9061).
  offerDate           DateTime?  @db.Date
  hireDate            DateTime?  @db.Date
  startDate           DateTime?  @db.Date
  startingWage        Decimal?   @db.Decimal(10, 2)
  position            String?    @db.VarChar(120)
  filingState         String?    @db.VarChar(2)
