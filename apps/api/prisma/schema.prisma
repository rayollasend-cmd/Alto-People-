/// A referral campaign: a bonus, a window, and the roles it is for.
model ReferralCampaign {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name         String    @db.VarChar(120)
  description  String?   @db.VarChar(1000)
  bonusAmount  Decimal   @db.Decimal(10, 2)
  currency     String    @default("USD") @db.VarChar(3)
  /// Paid when the referred person has been on the job this many days.
  payAfterDays Int       @default(30)
  startsOn     DateTime  @db.Date
  endsOn       DateTime? @db.Date
  /// Position titles it applies to; empty = any.
  positions    String[]  @default([])
  /// DRAFT | ACTIVE | CLOSED
  status       String    @default("DRAFT") @db.VarChar(12)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  createdBy User?                 @relation("ReferralCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  referrals Referral[]
  payouts   ReferralBonusPayout[]

  @@index([status, startsOn])
  @@index([tenantId])
}

/// A referral bonus on its way to a paycheck: marketing proposes it when
/// the hire sticks, Finance approves it, and it lands on a payroll run as
/// a BONUS add-on line.
model ReferralBonusPayout {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  referralId        String    @unique @db.Uuid
