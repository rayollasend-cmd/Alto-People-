model MarketWage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  areaCode   String   @db.VarChar(7)
  areaName   String   @db.VarChar(160)
  socCode    String   @db.VarChar(7)
  socTitle   String   @db.VarChar(200)
  year       Int
  p10        Decimal? @db.Decimal(8, 2)
  p25        Decimal? @db.Decimal(8, 2)
  median     Decimal? @db.Decimal(8, 2)
  p75        Decimal? @db.Decimal(8, 2)
  p90        Decimal? @db.Decimal(8, 2)
  mean       Decimal? @db.Decimal(8, 2)
  employment Int?
  source     String   @default("BLS_OEWS") @db.VarChar(20)
  fetchedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([areaCode, socCode, year])
  @@index([socCode])
}

/// A role name — rate-card position, shift position or job profile — and the
/// occupation (SOC) it is benchmarked against.
model PositionSocMap {
