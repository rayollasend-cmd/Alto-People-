  candidates           Candidate[]

  @@index([status])
  @@index([clientId])
  @@index([tenantId])
}

// ===== Candidate portal, recruiter calendar feed, marketing, client NPS (2026-10-17) =====

/// A document the recruiter asked a candidate for, and what came back.
/// The candidate uploads it from their own page (no login); the recruiter
/// reviews it from the candidate's record.
model CandidateDocumentRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  candidateId   String    @db.Uuid
  /// "Driver's licence", "Food handler card" — the recruiter's words.
  label         String    @db.VarChar(120)
  note          String?   @db.VarChar(500)
  /// REQUESTED | UPLOADED | ACCEPTED | REJECTED
  status        String    @default("REQUESTED") @db.VarChar(16)
  s3Key         String?   @db.VarChar(400)
  fileName      String?   @db.VarChar(255)
  contentType   String?   @db.VarChar(120)
  sizeBytes     Int?
  uploadedAt    DateTime? @db.Timestamptz(6)
  reviewNote    String?   @db.VarChar(500)
  reviewedAt    DateTime? @db.Timestamptz(6)
  reviewedById  String?   @db.Uuid
  requestedById String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation("CandidateDocRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  User?     @relation("CandidateDocReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([candidateId, status])
  @@index([tenantId])
}

/// A staff account's iCal feed of interviews (the recruiter's calendar).
/// The URL carries an HMAC of the user id and this version; bumping the
/// version revokes one leaked URL (lib/calendarFeed).
model UserCalendarFeed {
  userId    String   @id @db.Uuid
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// One day's views of the careers site, by posting and by the source the
/// link carried — the top of the funnel that applies and hires sit under.
model CareersPageView {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// The posting viewed; null = the list page.
  slug     String   @default("") @db.VarChar(200)
  /// The ?source= on the link; "" when none.
  source   String   @default("") @db.VarChar(120)
  day      DateTime @db.Date
  count    Int      @default(0)

  @@unique([slug, source, day])
  @@index([day])
  @@index([tenantId])
