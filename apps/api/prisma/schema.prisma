  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@index([tenantId, status, nextAttemptAt])
  @@index([localType, localId])
}

/// The same record changed on both sides since the last sync. status: OPEN | KEPT_SITE | KEPT_QUICKBOOKS | DISMISSED.
