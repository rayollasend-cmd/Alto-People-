  syndicate   Boolean             @default(true)
  openedAt    DateTime?           @db.Timestamptz(6)
  closedAt    DateTime?           @db.Timestamptz(6)
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  client               Client?                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy            User?                    @relation("JobPostingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // Phase 120 — internal applicants on this posting.
