model CandidateEvent {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String             @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind        CandidateEventKind
  fromStage   CandidateStage?
  toStage     CandidateStage?
  /// A note's text, a rejection reason, or a one-line summary.
  body        String?
  metadata    Json?
  actorUserId String?            @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actor     User?     @relation("CandidateEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@index([kind, createdAt])
  @@index([tenantId])
}

model InviteToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // sha256(rawToken) — never store the raw token. The user-facing magic link
  // contains the raw token; the server hashes the lookup key before query.
  tokenHash      String    @unique
  userId         String    @db.Uuid
  expiresAt      DateTime  @db.Timestamptz(6)
  // Single-use: set on accept-invite. Lookups exclude consumedAt != NULL.
  consumedAt     DateTime? @db.Timestamptz(6)
  // Set the first time a reminder email goes out for this token. The 48h
  // sweep skips rows where this is non-null so users get reminded at most
  // once per token. HR-triggered resend always rotates the token (creates
  // a new row), so this never blocks a manual resend.
  reminderSentAt DateTime? @db.Timestamptz(6)
  // True for tokens the 48h reminder sweep rotated in automatically.
  // The onboarding purge sweep's 3-day clock runs from the newest token a
  // HUMAN caused (original invite, HR resend, self-service renew) — sweep-
  // minted tokens must not keep restarting it.
  mintedBySweep  Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  // Sweep query filters by (consumedAt IS NULL, reminderSentAt IS NULL,
  // expiresAt > now, createdAt < threshold). Composite index covers it.
  @@index([consumedAt, reminderSentAt, createdAt])
  @@index([tenantId])
}

// Mirror of InviteToken for self-serve password reset. Reset links carry a
// random ~256-bit token; only its sha256 lives in the DB. Tokens are
// single-use (consumedAt) and short-lived (1 hour) to limit the blast
// radius of a leaked email forward. Consuming a token bumps the user's
// tokenVersion, killing every active session — defending against the
// "attacker stole an old reset link before the user reset" case.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  // IP that requested the reset — useful for forensics if a user reports
  // a reset they didn't initiate.
  requestedIp String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@index([tenantId])
}

// Single-use TOTP recovery codes. The plaintext is shown to the user once
// at enroll time; we only ever persist sha256(code). Used codes are kept
// (with usedAt set) so the audit trail can show when a code was consumed,
// but they cannot be reused. Disabling MFA deletes every row for the user.
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([tenantId])
}

// A registered passkey (WebAuthn credential). Face ID / Touch ID /
// Windows Hello sign-in without a password. Passkeys count as
// possession + biometric, so a passkey login bypasses the TOTP step.
model WebAuthnCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  // base64url credential ID from the authenticator — the lookup key
  // during authentication.
  credentialId String    @unique @db.VarChar(512)
  publicKey    Bytes     @db.ByteA
  // Signature counter — SimpleWebAuthn flags clones when it regresses.
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  // User-facing label ("iPhone", "MacBook") so the settings list is
  // tellable-apart when someone registers several.
  deviceName   String?   @db.VarChar(80)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt   DateTime? @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

// Short-lived WebAuthn ceremony challenges. A row is minted when options
// are generated, consumed (deleted) on verify, and swept by expiry — the
// server never trusts a challenge echoed back by the client.
model WebAuthnChallenge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challenge String   @db.VarChar(512)
  // Null for authentication ceremonies started by email (no session).
  userId    String?  @db.Uuid
  type      String   @db.VarChar(16) // 'registration' | 'authentication'
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid

  @@index([expiresAt])
  @@index([tenantId])
}

// Per-user opt-out for transactional EMAIL by category bucket. Default
// is "send" — a row exists only when the user has actively muted (or
// re-enabled) something. IN_APP delivery is unaffected; the bell is the
// authoritative record. Mandatory categories (discipline, probation,
// security) cannot be muted — the API rejects the PATCH.
model NotificationPreference {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  // Bucket key from NOTIFICATION_CATEGORIES in shared/contracts.
  category     String   @db.VarChar(64)
  emailEnabled Boolean  @default(true)
  // The bell. Muting a category used to stop only the email — the in-app
  // row was written regardless, so Settings turned off half of what it
  // said it turned off. Checked by notifyUser/notifyAllAdmins before the
  // Notification row is created; mandatory categories ignore both flags.
  inAppEnabled Boolean  @default(true)
  // The lock screen (web push and the phone apps). Push used to ride the
  // email switch, so Settings had no way to say "email me, don't buzz me".
  // Checked by isPushMuted (lib/webPush) inside sendPushToUser, the one
  // funnel every push passes; mandatory categories ignore it too.
  pushEnabled  Boolean  @default(true)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([tenantId])
}

// Two-step self-serve email change. Issuing a request mints a single-use
// token, hashes it (sha256), and emails the raw token to the NEW address;
// confirming the link swaps User.email and bumps tokenVersion. Older
// outstanding rows for the same user are invalidated when a new one is
// minted — newest request wins.
model EmailChangeRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  // The address the user wants to move TO. Already lowercased + validated
  // server-side. Collision against any active User.email is checked at
  // request time AND re-checked at confirm time (race cover).
  newEmail    String    @db.VarChar(254)
  expiresAt   DateTime  @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  requestedIp String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@index([tenantId])
}

model PerformanceReview {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId     String                  @db.Uuid
  reviewerUserId  String?                 @db.Uuid
  // Closed PIP that this review is summarising, if any. Surfaces the
