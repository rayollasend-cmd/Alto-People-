// Phase 91 — Garnishments + tax forms.

enum GarnishmentKind {
  CHILD_SUPPORT
  TAX_LEVY
  STUDENT_LOAN
  BANKRUPTCY
  CREDITOR
  OTHER
}

enum GarnishmentStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
  TERMINATED
}

enum TaxFormKind {
  F941
  F940
  W2
  // Gap 1 — W-2 correction (Form W-2c). Carries amendsTaxFormId pointing
  // at the original W-2 it corrects. The DB CHECK enforces the link.
  W2C
  F1099_NEC
  F1099_MISC
  // ACA: one 1095-C per full-time employee for the year, and the 1094-C
  // transmittal that carries them (lib/acaAir.ts builds the AIR XML).
  F1095C
  F1094C
}

enum TaxFormStatus {
  DRAFT
  FILED
  AMENDED
  VOIDED
}

model Garnishment {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId            String            @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId               String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind                   GarnishmentKind
  caseNumber             String?
  agencyName             String?
  amountPerRun           Decimal?          @db.Decimal(10, 2)
  percentOfDisp          Decimal?          @db.Decimal(5, 4)
  totalCap               Decimal?          @db.Decimal(12, 2)
  amountWithheld         Decimal           @default(0) @db.Decimal(12, 2)
  remitTo                String?
  remitAddress           String?
  startDate              DateTime          @db.Date
  endDate                DateTime?         @db.Date
  status                 GarnishmentStatus @default(ACTIVE)
  priority               Int               @default(100)
  notes                  String?
  /// e-IWO / state detail (lib/garnishmentEngine): issuing state, FIPS, the order's ids and amounts.
  state                  String?           @db.VarChar(2)
  fipsCode               String?           @db.VarChar(7)
  orderIdentifier        String?           @db.VarChar(40)
  remittanceIdentifier   String?           @db.VarChar(40)
  /// The frequency the order's amounts are stated in (WEEKLY/BIWEEKLY/SEMIMONTHLY/MONTHLY).
  orderFrequency         String?           @db.VarChar(12)
  currentSupport         Decimal?          @db.Decimal(10, 2)
  pastDueSupport         Decimal?          @db.Decimal(10, 2)
  medicalSupport         Decimal?          @db.Decimal(10, 2)
  arrearsOver12Weeks     Boolean           @default(false)
  supportsSecondFamily   Boolean           @default(false)
  adminFee               Decimal?          @db.Decimal(8, 2)
  levyFilingStatus       String?           @db.VarChar(24)
  levyExemptions         Int?
  levyAdditionalStandard Int               @default(0)
  levyTaxYear            Int?
  /// MANUAL | EIWO
  source                 String            @default("MANUAL") @db.VarChar(10)
  receivedAt             DateTime?         @db.Timestamptz(6)
  /// SDU | IRS | CREDITOR | COURT | TRUSTEE | OTHER
  payeeKind              String?           @db.VarChar(12)
  /// CHECK | ACH | EFT_SDU | PORTAL
  remitMethod            String            @default("CHECK") @db.VarChar(12)
  payeeRoutingEnc        String?
  payeeAccountEnc        String?
  payeeAccountLast4      String?           @db.VarChar(4)
  lumpSumReporting       Boolean           @default(false)
  createdById            String?           @db.Uuid
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?         @db.Timestamptz(6)

  associate  Associate              @relation(fields: [associateId], references: [id], onDelete: Cascade)
  createdBy  User?                  @relation("GarnishmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deductions GarnishmentDeduction[]

  @@index([associateId])
  @@index([status])
  @@index([tenantId])
}

model GarnishmentDeduction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garnishmentId String   @db.Uuid
  payrollRunId  String?  @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  /// The employer's processing fee the state allows (kept, not remitted).
  adminFee      Decimal  @default(0) @db.Decimal(8, 2)
  deductedOn    DateTime @default(now()) @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  // Tier-1 — the remittance batch this deduction was rolled into. Null
  // until the run disburses and remittances accrue.
  remittanceId  String?  @db.Uuid

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String                 @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  garnishment Garnishment            @relation(fields: [garnishmentId], references: [id], onDelete: Cascade)
  payrollRun  PayrollRun?            @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  remittance  GarnishmentRemittance? @relation(fields: [remittanceId], references: [id], onDelete: SetNull)

  @@index([garnishmentId])
  @@index([remittanceId])
  @@index([tenantId])
}

// Tier-1 — money withheld from paychecks under a court/agency order must
// actually reach the payee (state disbursement unit, IRS, creditor).
// One remittance per (run, payee) groups every deduction bound for the
// same address; finance sends the payment out-of-band (check or agency
// portal) and marks it SENT with the payment reference. Deducting
// without remitting is a compliance violation — PENDING rows here are
// the queue that prevents it.
enum GarnishmentRemittanceStatus {
  PENDING
  SENT
}

model GarnishmentRemittance {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRunId String                      @db.Uuid
  // Payee identity — snapshot of Garnishment.remitTo/remitAddress at
  // accrual time (orders can be edited later; the remittance shouldn't
  // drift).
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String                      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  payeeName    String
  payeeAddress String?
  amount       Decimal                     @db.Decimal(12, 2)
  status       GarnishmentRemittanceStatus @default(PENDING)
  sentAt       DateTime?                   @db.Timestamptz(6)
  sentById     String?                     @db.Uuid
  // Check number / agency portal confirmation keyed in at mark-sent.
  reference    String?
  /// CHECK | ACH | EFT_SDU | PORTAL
  method       String                      @default("CHECK") @db.VarChar(12)
  fileId       String?                     @db.Uuid
  advice       String?
  createdAt    DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                    @updatedAt @db.Timestamptz(6)

  payrollRun PayrollRun             @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  sentBy     User?                  @relation("GarnishmentRemittanceSender", fields: [sentById], references: [id], onDelete: SetNull)
  deductions GarnishmentDeduction[]

  @@unique([payrollRunId, payeeName])
  @@index([status])
  @@index([tenantId])
}

model TaxForm {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind                 TaxFormKind
  quarter              Int?
  taxYear              Int
  associateId          String?       @db.Uuid
  amounts              Json
  status               TaxFormStatus @default(DRAFT)
  filedAt              DateTime?     @db.Timestamptz(6)
  filedById            String?       @db.Uuid
  ein                  String?       @db.VarChar(20)
  // Gap 1 — sha256 of the rendered W-2 PDF, stamped on first download.
  // Subsequent renders must produce the same hash (same as Phase 18's
  // PayrollItem.paystubHash pattern). Null until the form is rendered.
  pdfHash              String?       @db.VarChar(64)
  // Gap 1 — when kind=W2C, points at the original W-2 row this form
  // corrects. Required for W2C, forbidden for any other kind (CHECK
  // enforced at the migration). The original is flipped to AMENDED at
  // W-2c create time so the UI hides it from the active list.
  amendsTaxFormId      String?       @db.Uuid
  // Tier-1 — when the recipient copy (employee W-2 Copy B, contractor
  // 1099) was emailed to the associate. Filing isn't done until the
  // worker has their copy; this makes distribution auditable instead of
  // a UI checkbox nobody can verify.
  recipientCopySentAt  DateTime?     @db.Timestamptz(6)
  // The IRS / SSA / filing-partner acknowledgment keyed in when the form is
  // marked filed. Alto renders and packages; transmission happens with the
  // partner or the agency portal, and this is its receipt.
  filingConfirmation   String?       @db.VarChar(80)
  /// E-file through the filing partner: the submission, its status and the agency's answer.
  efileConnectionId    String?       @db.Uuid
  efileSubmissionId    String?       @db.VarChar(80)
  efileRecordId        String?       @db.VarChar(80)
  /// SUBMITTED | SENT_TO_AGENCY | ACCEPTED | REJECTED
  efileStatus          String?       @db.VarChar(20)
  efileSubmittedAt     DateTime?     @db.Timestamptz(6)
  efileStatusAt        DateTime?     @db.Timestamptz(6)
  efileRejectionReason String?       @db.VarChar(500)
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  associate     Associate? @relation(fields: [associateId], references: [id], onDelete: SetNull)
  filedBy       User?      @relation("TaxFormFiler", fields: [filedById], references: [id], onDelete: SetNull)
  amendsTaxForm TaxForm?   @relation("TaxFormAmendments", fields: [amendsTaxFormId], references: [id], onDelete: SetNull)
  amendments    TaxForm[]  @relation("TaxFormAmendments")

  @@index([kind, taxYear])
  @@index([associateId])
  @@index([amendsTaxFormId])
  @@index([tenantId])
  @@index([efileSubmissionId])
}

