/// Whether a kiosk punch must carry a photo (2027-01). scope: COMPANY | CLIENT | SITE | ASSOCIATE —
/// the most specific rule in force wins (lib/punchPhotoPolicy). required=false on a narrower scope
/// exempts it from a broader one. Ended rules stay as history (endedAt).
model PunchPhotoRule {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  scope       String    @db.VarChar(10)
  clientId    String?   @db.Uuid
  siteId      String?   @db.Uuid
  associateId String?   @db.Uuid
  required    Boolean   @default(true)
  /// Why — required for a person-level rule, so singling someone out is on the record.
  reason      String?   @db.VarChar(500)
  startsOn    DateTime  @db.Date
  /// The last day it applies (inclusive); null = until ended.
  endsOn      DateTime? @db.Date
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  endedAt     DateTime? @db.Timestamptz(6)
  endedById   String?   @db.Uuid
  endReason   String?   @db.VarChar(500)

  @@index([tenantId, scope])
  @@index([associateId])
  @@index([siteId])
  @@index([clientId])
}

/// Trust Center gated downloads (audit 2026-10-21, ux-upgrade §5.5): a prospect asks for a
/// report on the public page; the operator approves; a signed, expiring link goes out by email;
/// every download is logged. The documents themselves are uploaded by the operator, one current
/// file per kind, stored under the blob store.
enum TrustDocumentKind {
  SOC2_REPORT
  PEN_TEST_SUMMARY
  SUB_PROCESSOR_LIST
  DPA
}

enum TrustRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model TrustDocument {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind             TrustDocumentKind
  title            String            @db.VarChar(200)
  s3Key            String            @db.VarChar(400)
  contentType      String            @db.VarChar(120)
  bytes            Int
  uploadedByUserId String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, kind])
}

model TrustDownloadRequest {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind             TrustDocumentKind
  name             String             @db.VarChar(160)
  email            String             @db.VarChar(254)
  company          String             @db.VarChar(200)
  note             String?            @db.VarChar(1000)
  status           TrustRequestStatus @default(PENDING)
  requestedAt      DateTime           @default(now()) @db.Timestamptz(6)
  decidedAt        DateTime?          @db.Timestamptz(6)
  decidedByUserId  String?            @db.Uuid
  /// The signed link stops working after this; set on approval (7 days).
  linkExpiresAt    DateTime?          @db.Timestamptz(6)
  downloadCount    Int                @default(0)
  lastDownloadedAt DateTime?          @db.Timestamptz(6)

  @@index([tenantId, status, requestedAt(sort: Desc)])
  @@index([email])
}

/// Product analytics (ux-upgrade §6): the three behaviour events — the time from sign-in to a
/// session's first decision, decisions per session by role, and palette searches that end on a
/// settings page — rolled up per UTC day, role and kind. `sum` carries the milliseconds for
/// first_decision; a session_start row per role makes "per session" a division, not a guess.
model ProductEventDaily {
  id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day   DateTime @db.Date
  role  String   @db.VarChar(40)
  kind  String   @db.VarChar(40)
  count Int      @default(0)
  sum   Float    @default(0)

  /// Brief 2-1: platform telemetry like WebVitalDaily — nullable, no default (the rollup is not any tenant's).
  tenantId String? @db.Uuid

  @@unique([day, role, kind])
  @@index([day])
  @@index([tenantId])
}

/// Hugo works for you (lib/hugoTasks, packages/shared/src/hugoWork.ts): work a person handed
/// the assistant with a tap — watch for a decision, a paycheck or an open shift and say when it
/// comes; ask coworkers to cover a shift one at a time; chase tomorrow's unconfirmed shifts.
/// kind / status / needs are the shared HUGO_TASK_* codes. Only its owner reads it.
model HugoTask {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId      String    @db.Uuid
  kind        String    @db.VarChar(32)
  status      String    @default("WORKING") @db.VarChar(16)
  needs       String?   @db.VarChar(32)
  /// What the person asked for (HugoTaskCreateInput).
  params      Json      @default("{}")
  /// What it is about, captured at the start — the title is built from it.
  subject     Json      @default("{}")
  /// The engine's working memory: who was asked, what was already reported.
  state       Json      @default("{}")
  progress    Json?
  result      Json?
  linkUrl     String?   @db.VarChar(300)
  /// panel | chat | note
  source      String    @default("panel") @db.VarChar(8)
  noteId      String?   @db.Uuid
  /// The sweep picks it up from here; set to now to look again at once.
  nextCheckAt DateTime  @default(now()) @db.Timestamptz(6)
  /// A step in flight (the guarded claim); a stale claim is taken over.
  claimedAt   DateTime? @db.Timestamptz(6)
  /// When the person last looked at it since it finished or needed them.
  seenAt      DateTime? @db.Timestamptz(6)
  expiresAt   DateTime  @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  user   User            @relation("HugoTaskOwner", fields: [userId], references: [id], onDelete: Cascade)
  events HugoTaskEvent[]

  @@index([userId, status])
  @@index([status, nextCheckAt])
  @@index([tenantId])
}

/// A task's trail, one line per step (HUGO_TASK_EVENT_CODES); `data` names what the line names.
model HugoTaskEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  taskId    String   @db.Uuid
  code      String   @db.VarChar(32)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  task HugoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([tenantId])
}

/// Something Hugo noticed in a person's own records, with one thing it could do about it
/// (lib/hugoNotes). One per person, kind and subject: a dismissed note stays dismissed.
model HugoNote {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId     String    @db.Uuid
  kind       String    @db.VarChar(32)
  /// What it is about (a credential and its date, a shift, a payday) — the dedupe key.
  subjectKey String    @db.VarChar(120)
  data       Json      @default("{}")
  /// NEW | SEEN | ACCEPTED | DISMISSED | EXPIRED
  status     String    @default("NEW") @db.VarChar(12)
  /// Sent to the lock screen (at most two a day per person).
  pushedAt   DateTime? @db.Timestamptz(6)
  seenAt     DateTime? @db.Timestamptz(6)
  actedAt    DateTime? @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation("HugoNoteOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, subjectKey])
  @@index([userId, status])
  @@index([tenantId])
}

/// A kind of note the person turned off (Settings › Notifications).
model HugoNoteMute {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId    String   @db.Uuid
  kind      String   @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation("HugoNoteMuter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([tenantId])
}
