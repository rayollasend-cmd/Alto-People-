  programStartDate DateTime  @db.Date
  programEndDate   DateTime  @db.Date
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  ds2019Number     String
  sponsorAgency    String
  visaNumber       String?
  sevisId          String?
  country          String
  associate        Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  @@index([tenantId])
}

model Application {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId          String               @db.Uuid
  clientId             String?              @db.Uuid
  // Phase 131 — initial work-site for the hire. Nullable: legacy apps
  // and apps where HR hasn't picked a site yet have NULL. When set on
  // approval, the AssociateAssignment row created at hire references
  // this location.
  locationId           String?              @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  onboardingTrack      OnboardingTrack
  status               ApplicationStatus    @default(DRAFT)
  position             String?
  startDate            DateTime?            @db.Date
  invitedAt            DateTime             @default(now()) @db.Timestamptz(6)
  submittedAt          DateTime?            @db.Timestamptz(6)
  // Set when the applicant edits anything after the application reached
  // HR (SUBMITTED/IN_REVIEW) — the reviewer sees an "updated after
  // submission" flag so stale data is never approved unnoticed.
  updatedAfterSubmitAt DateTime?            @db.Timestamptz(6)
  // HR review outcome — exactly one of approvedAt / rejectedAt is set
  // once status leaves IN_REVIEW. rejectionReason is required on REJECTED
  // so the audit trail captures the why; approve has no equivalent free-
  // text field by design (the hireDate stamped on Associate IS the
  // outcome record).
  approvedAt           DateTime?            @db.Timestamptz(6)
  rejectedAt           DateTime?            @db.Timestamptz(6)
  rejectionReason      String?
  cancelledAt          DateTime?            @db.Timestamptz(6)
  /// SENT_IN_ERROR, WRONG_PERSON, WRONG_CLIENT, DUPLICATE, NOT_JOINING,
  /// HIRE_UNDONE, EXPIRED or OTHER.
  cancelReason         String?
  cancelNote           String?
  cancelledById        String?              @db.Uuid
  /// Set while the invite email is held back for the Undo window; the
  /// due-invite sweep sends it (with a fresh link) once this passes.
  inviteEmailDueAt     DateTime?            @db.Timestamptz(6)
  // Progress-reminder sweep bookkeeping: when the associate was last
  // nagged about incomplete tasks and how many times (2nd+ escalates
  // to HR).
  progressRemindedAt   DateTime?            @db.Timestamptz(6)
  progressRemindCount  Int                  @default(0)
  // Cohort mode — this hire belongs to a seasonal wave; their relay lane
  // groups under the cohort's banner and counts toward its readiness.
  cohortId             String?              @db.Uuid
  associate            Associate            @relation(fields: [associateId], references: [id], onDelete: Restrict)
  client               Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  employment           Employment?
  location             Site?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  cohort               Cohort?              @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  checklist            OnboardingChecklist?
  esignAgreements      EsignAgreement[]
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?            @db.Timestamptz(6)

  @@index([associateId])
  @@index([clientId, status, associateId])
  @@index([locationId])
  @@index([status])
  @@index([invitedAt])
  // The list orders by invitedAt DESC under a status chip or client scope.
  @@index([status, invitedAt(sort: Desc)])
  @@index([clientId, invitedAt(sort: Desc)])
  // ...and a client-scoped admin filters by BOTH at once, which neither of
  // the two above can serve: one narrows by client then sorts every status,
  // the other narrows by status then sorts every client. This is the list
  // an ops manager actually opens.
  @@index([clientId, status, invitedAt(sort: Desc)])
  @@index([deletedAt])
  @@index([cohortId])
  @@index([tenantId])
}

model OnboardingChecklist {
