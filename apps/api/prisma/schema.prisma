// Phase 97 — Spend management: reimbursements + expense lines.

// Gap 10 — Two-step approval flow:
//   DRAFT → SUBMITTED → MANAGER_APPROVED → SETTLED → PAID
//                            │
//                            └─ rejected from any non-terminal state
//
// Phase 97's old 'APPROVED' is renamed to SETTLED; the migration renames
// in place (Postgres ALTER TYPE RENAME VALUE). MANAGER_APPROVED is the
// new intermediate state between manager approval and HR/Finance settle.
enum ReimbursementStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVED
  SETTLED
  REJECTED
  PAID
}

enum ExpenseLineKind {
  RECEIPT
  MILEAGE
  PER_DIEM
  OTHER
}

model Reimbursement {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String              @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  title       String
  description String?
  totalAmount Decimal             @default(0) @db.Decimal(12, 2)
  currency    String              @default("USD") @db.VarChar(3)
  status      ReimbursementStatus @default(DRAFT)
  submittedAt DateTime?           @db.Timestamptz(6)

  // Gap 10 — manager approval audit (the new intermediate step). Stamped
  // by POST /reimbursements/:id/manager-approve.
  managerApprovedById String?   @db.Uuid
  managerApprovedAt   DateTime? @db.Timestamptz(6)
  managerNote         String?

  // Gap 10 — HR/Finance settlement audit. Stamped by POST
  // /reimbursements/:id/settle. Once SETTLED the row sits in the
  // payroll-fold queue waiting for the next REGULAR run.
  settledById       String?   @db.Uuid
  settledAt         DateTime? @db.Timestamptz(6)
  settleNote        String?
  // HR can override the receipt-required guard at settle time when a
  // receipt is genuinely lost; the waiver note carries the justification.
  receiptWaiverNote String?

  // Phase 97 single-decision audit, repurposed as the rejection audit
  // (rejections come from manager OR HR; both share these columns).
  decidedAt       DateTime? @db.Timestamptz(6)
  decidedById     String?   @db.Uuid
  rejectionReason String?

  // Gap 10 — payroll fold-in link. Stamped at REGULAR run-creation when
  // a SETTLED row drains. paidPayrollRunId stays for back-compat (Phase
  // 97 stored a run-level link); new code reads payrollItemId.
  payrollItemId    String?   @db.Uuid
  paidPayrollRunId String?   @db.Uuid
  paidAt           DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  associate         Associate     @relation(fields: [associateId], references: [id], onDelete: Cascade)
  decidedBy         User?         @relation("ReimbursementDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  managerApprovedBy User?         @relation("ReimbursementManagerApprover", fields: [managerApprovedById], references: [id], onDelete: SetNull)
  settledBy         User?         @relation("ReimbursementSettler", fields: [settledById], references: [id], onDelete: SetNull)
  paidPayrollRun    PayrollRun?   @relation(fields: [paidPayrollRunId], references: [id], onDelete: SetNull)
  payrollItem       PayrollItem?  @relation("ReimbursementPaidItem", fields: [payrollItemId], references: [id], onDelete: SetNull)
  lines             ExpenseLine[]

  @@index([associateId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([tenantId])
}

model ExpenseLine {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reimbursementId String          @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind            ExpenseLineKind
  description     String
  incurredOn      DateTime        @db.Date
  amount          Decimal         @db.Decimal(10, 2)
  miles           Decimal?        @db.Decimal(8, 2)
  ratePerMile     Decimal?        @db.Decimal(6, 4)
  receiptUrl      String?
  merchant        String?
  category        String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)

  reimbursement Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@index([reimbursementId])
  @@index([tenantId])
}

