/// A 401(k) plan and its recordkeeper (lib/retirement, lib/recordkeepers).
model RetirementPlan {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  employerId             String?   @db.Uuid
  name                   String    @db.VarChar(120)
  /// The 401(k) benefits plan whose enrollments are the deferral elections.
  benefitsPlanId         String?   @db.Uuid
  planNumber             String?   @db.VarChar(40)
  /// GUIDELINE | VESTWELL | EMPOWER_SFTP | GENERIC_SFTP
  recordkeeper           String    @db.VarChar(20)
  connectionEnc          String?
  status                 String    @default("ACTIVE") @db.VarChar(12)
  establishedOn          DateTime? @db.Date
  eligibilityMinAge      Int       @default(21)
  eligibilityServiceDays Int       @default(0)
  /// IMMEDIATE | MONTHLY | QUARTERLY
  entryTiming            String    @default("IMMEDIATE") @db.VarChar(12)
  autoEnroll             Boolean   @default(false)
  autoEnrollPercent      Decimal   @default(0) @db.Decimal(5, 2)
  autoEscalatePercent    Decimal   @default(0) @db.Decimal(5, 2)
  autoEscalateMax        Decimal   @default(0) @db.Decimal(5, 2)
  optOutDays             Int       @default(90)
  /// [{ upToPercent, matchPercent }] tiers of the deferral rate.
  matchFormula           Json      @default("[]")
  /// NONE | BASIC | ENHANCED | NONELECTIVE_3
  safeHarbor             String    @default("NONE") @db.VarChar(16)
  rothEnabled            Boolean   @default(true)
  catchUpEnabled         Boolean   @default(true)
  createdById            String?   @db.Uuid
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  elections     RetirementElection[]
  loans         RetirementLoan[]
  contributions RetirementContribution[]
  files         RetirementFile[]

  @@index([tenantId])
}

model RetirementElection {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  planId           String    @db.Uuid
  associateId      String    @db.Uuid
  /// NOT_ELIGIBLE | ELIGIBLE | ENROLLED | AUTO_ENROLLED | OPTED_OUT
  status           String    @db.VarChar(16)
  eligibleOn       DateTime? @db.Date
  enrolledOn       DateTime? @db.Date
  optOutDeadline   DateTime? @db.Date
  nextEscalationOn DateTime? @db.Date
  /// EMPLOYEE | AUTO | RECORDKEEPER | HR
  source           String    @default("EMPLOYEE") @db.VarChar(16)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  plan      RetirementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  associate Associate      @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([planId, associateId])
  @@index([tenantId])
}

model RetirementLoan {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  planId       String    @db.Uuid
  associateId  String    @db.Uuid
  loanNumber   String    @db.VarChar(40)
  perPayAmount Decimal   @db.Decimal(10, 2)
