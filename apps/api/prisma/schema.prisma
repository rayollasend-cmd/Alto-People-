  @@index([associateId])
  @@index([tenantId])
}

// ===== Phase 115 — Succession planning =====================================
//
// Per-position bench. Each row designates an Associate as a successor for a
// Position with a readiness band. Forward-only data — readiness can be edited
// or the candidate removed. Listing the same person twice on a position is
// blocked by the unique index.
enum SuccessionReadiness {
  READY_NOW
  READY_1_2_YEARS
  READY_3_PLUS_YEARS
  EMERGENCY_COVER
}

model SuccessionCandidate {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  positionId  String              @db.Uuid
  associateId String              @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  readiness   SuccessionReadiness
  notes       String?
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  position  Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([positionId, associateId])
  @@index([associateId])
  @@index([positionId])
  @@index([tenantId])
}

/// Readiness for a store lead seat: now, in six months, in a year.
