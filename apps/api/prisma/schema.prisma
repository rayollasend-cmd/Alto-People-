model DocumentRecord {
  id                  String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId         String                        @db.Uuid
  clientId            String?                       @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId            String                        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind                DocumentKind
  s3Key               String?
  filename            String
  mimeType            String
  size                Int
  status              DocumentStatus                @default(UPLOADED)
  // I-9 document catalog (2026-08). The specific federal document this file
  // is ("U.S. Passport", "Driver's license", …) and the list it satisfies —
  // the associate declares it at upload, so HR verification stops guessing
  // from image.jpg thumbnails. All three NULLABLE by design: legacy uploads
  // and non-I-9 documents carry NULLs and are never reclassified.
  i9DocTitle          String?                       @db.VarChar(80)
  i9List              I9DocList?
  side                DocSide?
  expiresAt           DateTime?                     @db.Timestamptz(6)
  rejectionReason     String?
  verifiedById        String?                       @db.Uuid
  verifiedAt          DateTime?                     @db.Timestamptz(6)
  /// Retention (HR pack 2026-10): when the file was purged under a retention policy; the row stays.
  purgedAt            DateTime?                     @db.Timestamptz(6)
  associate           Associate                     @relation(fields: [associateId], references: [id], onDelete: Restrict)
  verifiedBy          User?                         @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  signatures          Signature[]
  tasks               OnboardingTask[]
  attestationEvidence ManualComplianceAttestation[] @relation("AttestationEvidence")
  programLinks        ProgramDocument[]
  // 2026-08 — set when this file is evidence for an externally-processed
  // pay period (kind=PAYSTUB). SetNull so deleting the payment record never
  // destroys the audit artifact — the file stays in the vault.
  externalPaymentId   String?                       @db.Uuid
  externalPayment     ExternalPayment?              @relation("ExternalPaymentEvidence", fields: [externalPaymentId], references: [id], onDelete: SetNull)
  createdAt           DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                      @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?                     @db.Timestamptz(6)

  @@index([associateId, kind])
  @@index([status, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([clientId])
  @@index([deletedAt])
  @@index([externalPaymentId])
  @@index([tenantId])
}

// 2026-08 — audit documentation for externally-run payroll. Payroll is
// currently processed outside Alto, so HR records each pay period here and
// attaches evidence (paystub PDF, cleared check, processor report) as
// PAYSTUB DocumentRecords. Deliberately NOT derived from PayrollRun — these
// rows document payments Alto never computed. When payroll moves in-house,
// PayrollItem becomes the source of truth for new periods and this table
// remains the historical record.
model ExternalPayment {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String                @db.Uuid
  // Calendar dates (@db.Date) — cross the wire as YYYY-MM-DD, never
  // timestamps.
  periodStart DateTime              @db.Date
  periodEnd   DateTime              @db.Date
  payDate     DateTime?             @db.Date
  grossAmount Decimal?              @db.Decimal(12, 2)
  netAmount   Decimal?              @db.Decimal(12, 2)
  method      ExternalPaymentMethod @default(OTHER)
  // Check number, ACH trace, or the external processor's document ID.
  reference   String?               @db.VarChar(120)
  note        String?               @db.VarChar(500)
  createdById String?               @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String                @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associate   Associate             @relation(fields: [associateId], references: [id], onDelete: Restrict)
  createdBy   User?                 @relation("ExternalPaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  evidence    DocumentRecord[]      @relation("ExternalPaymentEvidence")
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?             @db.Timestamptz(6)

  @@index([associateId, periodEnd(sort: Desc)])
  @@index([deletedAt])
  @@index([tenantId])
}

enum ExternalPaymentMethod {
  DIRECT_DEPOSIT
  CHECK
  CASH
  PAYROLL_PROVIDER
  OTHER
}

// ===== Store Operations (SOPs, ops shifts, handover) =====================

enum OpsPeriod {
  MORNING
  EVENING
  CLOSING
  OVERNIGHT
}

enum OpsShiftStatus {
  ACTIVE
  CLOSED
  /// Opened by mistake and voided by HR — the afternoon supervisor who
  /// picked the morning SOP. Not a completed shift and not an open one:
  /// the clock-out gate lifts, and the occurrence can be opened again
  /// with the right standard.
  CANCELLED
}

enum OpsResponseType {
  CHECK
  YES_NO
  YES_NO_PARTIAL
  TEXT
  NUMBER
  TEMPERATURE
  PHOTO
}

enum OpsTaskSource {
  SOP
  ADHOC
  CARRYOVER
  FOLLOWUP
}

// When a task's answer triggers the closed loop (detect → explain →
// correct → verify): a corrective child task spawns on the same shift.
enum OpsFollowUpOn {
  NO
  NO_OR_PARTIAL
  OUT_OF_RANGE
}

enum OpsTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  BLOCKED
}

enum OpsPriority {
  HIGH
  MEDIUM
  LOW
}

enum OpsHandoverKind {
  NOTE
  UNFINISHED_TASK
  SPECIAL_ORDER
  COACH_COMPLAINT
  EQUIPMENT
  STOCKING
}

enum OpsHandoverStatus {
  PENDING
  CARRIED
  DISMISSED
  REVIEWED
}

// A reusable department+period checklist standard. "Delete" = retire:
// running shifts snapshot their tasks (OpsTask rows carry full content),
// so history never changes when the library does.
model OpsSopTemplate {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name        String
  department  String               @db.VarChar(80)
  period      OpsPeriod
  description String?              @db.VarChar(500)
  active      Boolean              @default(true)
  retiredAt   DateTime?            @db.Timestamptz(6)
  createdById String?              @db.Uuid
  createdBy   User?                @relation("OpsSopTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks       OpsSopTemplateTask[]
  storeShifts StoreShiftSop[]
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)

  @@index([department, period, active])
  @@index([tenantId])
}

model OpsSopTemplateTask {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId           String          @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  template             OpsSopTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section              String          @db.VarChar(80)
  order                Int
  title                String          @db.VarChar(300)
  instructions         String?         @db.VarChar(1000)
  responseType         OpsResponseType @default(CHECK)
  required             Boolean         @default(true)
  photoRequired        Boolean         @default(false)
  tempLabel            String?         @db.VarChar(80)
  tempMin              Decimal?        @db.Decimal(6, 1)
  tempMax              Decimal?        @db.Decimal(6, 1)
  // Metric identity for NUMBER answers — "84" means nothing until it's
  // cases_stocked in cases. Powers real production aggregation.
  metricKey            String?         @db.VarChar(60)
  unit                 String?         @db.VarChar(30)
  // Closed-loop rule: what answer triggers a corrective child task.
  followUpOn           OpsFollowUpOn?
  followUpRequirePhoto Boolean         @default(false)
  followUpTaskTitle    String?         @db.VarChar(300)
  /// "HH:MM" store time the task's block is due by ("by 9:00 AM"); each
  /// run turns it into a real deadline on that shift's clock.
  dueTime              String?         @db.VarChar(5)

  @@index([templateId, order])
  @@index([tenantId])
}

// One supervisor-run operational shift: "Frozen & Dairy · Store 101 ·
// Morning · 2026-08-29". Header facts auto-populate from scheduling and
// the kiosk; the checklist snapshots from the SOP library at open.
model OpsShift {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String            @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId           String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  client             Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // The primary department — what the shift is filed and displayed under.
  department         String            @db.VarChar(80)
  /// EVERY department this shift actually carried. A supervisor covering
  /// Grocery, Front End and Overnight Stocking runs ONE shift across all
  /// three; until this existed, that fact lived only in their memory.
  /// Read it to answer "who is carrying how much, how often" — a staffing
  /// question, a labor-cost question and a liability question at once.
  departments        String[]
  period             OpsPeriod
  position           String            @db.VarChar(120)
  dateKey            String            @db.VarChar(10)
  status             OpsShiftStatus    @default(ACTIVE)
  openedById         String            @db.Uuid
  openedBy           User              @relation("OpsShiftOpener", fields: [openedById], references: [id], onDelete: Restrict)
  openedAt           DateTime          @default(now()) @db.Timestamptz(6)
  closedById         String?           @db.Uuid
  closedBy           User?             @relation("OpsShiftCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt           DateTime?         @db.Timestamptz(6)
  /// Why HR voided this SOP, and who did. Kept on the row rather than
  /// only in the audit log so the shift can say for itself why it does
  /// not count — the ops board reads it beside the record.
  cancelledReason    String?           @db.VarChar(500)
  cancelledById      String?           @db.Uuid
  cancelledBy        User?             @relation("OpsShiftCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  scheduledHeadcount Int               @default(0)
  actualHeadcount    Int               @default(0)
  templateId         String?           @db.Uuid
  templateName       String?           @db.VarChar(200)
  // Stamped at close so scorecards never recount task rows.
  sopTotal           Int               @default(0)
  sopDone            Int               @default(0)
  taskTotal          Int               @default(0)
  taskDone           Int               @default(0)
  closedIncomplete   Boolean           @default(false)
  tempAlerts         Int               @default(0)
  closingSummary     String?           @db.VarChar(2000)
  // Store-shift SOP — opened automatically at a supervisor's clock-in for
  // the store and named shift window they're working (null on shifts
  // opened by hand from the position picker).
  locationId         String?           @db.Uuid
  location           Site?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  windowLabel        String?           @db.VarChar(80)
  /// The clock-in that opened it.
  timeEntryId        String?           @db.Uuid
  /// When the store shift window ends — reminders and escalation key off it.
  dueAt              DateTime?         @db.Timestamptz(6)
  /// Required when it's submitted with required items still open.
  incompleteReason   String?           @db.VarChar(1000)
  /// Submitted with an explicit "nothing to hand over" instead of a note.
  handoverNone       Boolean           @default(false)
  /// Reminder sent before the shift ends / escalated after it ended.
  remindedAt         DateTime?         @db.Timestamptz(6)
  escalatedAt        DateTime?         @db.Timestamptz(6)
  /// openedById is whoever RUNS it — must submit it, can't clock out
  /// until they do. When that's a floor supervisor covering for their
  /// shift supervisor (handed the shift, or the lead wasn't on the clock),
  /// this is the lead they're covering for. The lead's own clock-in takes
  /// the SOP back: openedById returns to them and this clears.
  coveringForId      String?           @db.Uuid
  coveringFor        User?             @relation("OpsShiftCoveredFor", fields: [coveringForId], references: [id], onDelete: SetNull)
  tasks              OpsTask[]
  handoverOut        OpsHandoverItem[] @relation("HandoverFrom")
  handoverDecided    OpsHandoverItem[] @relation("HandoverDecidedIn")

  @@index([clientId, dateKey])
  @@index([clientId, department, status])
  @@index([status, openedAt])
  @@index([openedById, status])
  @@index([locationId, status])
  @@index([locationId, windowLabel, dueAt])
  @@index([tenantId])
}

// The SOP a store runs on one of its named shift windows ("Front Beach 218 ·
// Overnight → Overnight Standard"). Keyed by (store, window LABEL) like a
// supervisor's shift, so a new headcount for the window doesn't unassign it.
// A supervisor's clock-in opens this template's checklist automatically.
model StoreShiftSop {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId  String   @db.Uuid
  label       String   @db.VarChar(80)
  templateId  String   @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  location Site           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template OpsSopTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // One SOP PER DEPARTMENT on a window, not one SOP per window. Alto
  // staffs several departments in the same store, and a supervisor works
  // one shift across all of them — the old @@unique([locationId, label])
  // made the second department's SOP impossible to attach at all, so it
  // silently never ran.
  @@unique([locationId, label, templateId])
  @@index([locationId, label])
  @@index([templateId])
  @@index([tenantId])
}

model OpsTask {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opsShiftId           String            @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  opsShift             OpsShift          @relation(fields: [opsShiftId], references: [id], onDelete: Cascade)
  source               OpsTaskSource     @default(SOP)
  templateTaskId       String?           @db.Uuid
  section              String?           @db.VarChar(80)
  order                Int               @default(0)
  title                String            @db.VarChar(300)
  instructions         String?           @db.VarChar(1000)
  priority             OpsPriority       @default(MEDIUM)
  status               OpsTaskStatus     @default(OPEN)
  responseType         OpsResponseType   @default(CHECK)
  required             Boolean           @default(true)
  photoRequired        Boolean           @default(false)
  tempLabel            String?           @db.VarChar(80)
  tempMin              Decimal?          @db.Decimal(6, 1)
  tempMax              Decimal?          @db.Decimal(6, 1)
  metricKey            String?           @db.VarChar(60)
  unit                 String?           @db.VarChar(30)
  followUpOn           OpsFollowUpOn?
  followUpRequirePhoto Boolean           @default(false)
  followUpTaskTitle    String?           @db.VarChar(300)
  /// When this item is due — its block's due time on this shift's clock.
  /// Open past it = overdue, on the runner and the store's dashboard.
  dueAt                DateTime?         @db.Timestamptz(6)
  // Corrective child ← the parent whose answer spawned it.
  parentTaskId         String?           @db.Uuid
  parentTask           OpsTask?          @relation("OpsTaskFollowUp", fields: [parentTaskId], references: [id], onDelete: SetNull)
  followUps            OpsTask[]         @relation("OpsTaskFollowUp")
  answerChoice         String?           @db.VarChar(10)
  answerNumber         Decimal?          @db.Decimal(12, 2)
  answerText           String?           @db.VarChar(2000)
  tempOutOfRange       Boolean           @default(false)
  note                 String?           @db.VarChar(1000)
  blockedReason        String?           @db.VarChar(500)
  // Who did the PHYSICAL work (associates never log in here) — tagged by
  // the supervisor from the clocked-in list.
  doneAssociateId      String?           @db.Uuid
  doneAssociate        Associate?        @relation("OpsTaskDoneBy", fields: [doneAssociateId], references: [id], onDelete: SetNull)
  completedById        String?           @db.Uuid
  completedBy          User?             @relation("OpsTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt          DateTime?         @db.Timestamptz(6)
  createdById          String?           @db.Uuid
  createdBy            User?             @relation("OpsTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  photos               OpsTaskPhoto[]
  carriedFrom          OpsHandoverItem[] @relation("HandoverCarriedTask")

  @@index([opsShiftId, order])
  @@index([tempOutOfRange])
  @@index([tenantId])
}

model OpsTaskPhoto {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  task         OpsTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  s3Key        String
  filename     String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation("OpsPhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([taskId])
  @@index([tenantId])
}

// What one shift tells the next. PENDING items surface as the FIRST
// screen when the next supervisor opens the same department — each must
// be explicitly Carried, Dismissed, or Reviewed, on the record.
model OpsHandoverItem {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromShiftId      String            @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  fromShift        OpsShift          @relation("HandoverFrom", fields: [fromShiftId], references: [id], onDelete: Cascade)
  kind             OpsHandoverKind   @default(NOTE)
  body             String            @db.VarChar(1000)
  priority         OpsPriority       @default(MEDIUM)
  status           OpsHandoverStatus @default(PENDING)
  decidedById      String?           @db.Uuid
  decidedBy        User?             @relation("OpsHandoverDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?         @db.Timestamptz(6)
  decidedInShiftId String?           @db.Uuid
  decidedInShift   OpsShift?         @relation("HandoverDecidedIn", fields: [decidedInShiftId], references: [id], onDelete: SetNull)
  carriedTaskId    String?           @db.Uuid
  carriedTask      OpsTask?          @relation("HandoverCarriedTask", fields: [carriedTaskId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)

  @@index([fromShiftId, status])
  @@index([tenantId])
}

model Signature {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String                 @db.Uuid
  signerUserId   String?                @db.Uuid
  associateId    String?                @db.Uuid
  signedAt       DateTime               @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String                 @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  ipAddress      String?
  userAgent      String?
  signatureS3Key String
  // Phase 19 — when this Signature row was produced by the typed-name
  // e-sign flow (rather than uploaded out-of-band), agreementId points at
  // the EsignAgreement that was signed. typedName is exactly what the
  // signer typed (immutable proof). pdfHash is sha256 of the rendered
  // signed PDF — a future re-render must hash to the same value.
  agreementId    String?                @db.Uuid
  typedName      String?
  pdfHash        String?
  agreement      EsignAgreement?        @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  document       DocumentRecord         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  signerUser     User?                  @relation("UserSignatures", fields: [signerUserId], references: [id], onDelete: SetNull)
  associate      Associate?             @relation("AssociateSignatures", fields: [associateId], references: [id], onDelete: SetNull)
  policyAcks     PolicyAcknowledgment[]

  @@index([documentId])
  @@index([signerUserId])
  @@index([associateId])
  @@index([agreementId])
  @@index([tenantId])
}

// Phase 19 — server-side typed-name e-signature.
//
// HR creates an EsignAgreement attached to an Application (and optionally
// the OnboardingTask of kind E_SIGN that triggers it). The body is plain
// text that gets rendered into a PDF at sign time, with a signature block
// (typed name + IP + UA + signedAt + sha256 of the rendered bytes) so the
// signed PDF carries its own audit trail. Each successful signing creates
// exactly one Signature row; duplicate sign attempts return 409. The
// agreement itself is immutable once signed.
model EsignAgreement {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String          @db.Uuid
  // Optional link to the onboarding checklist task — when set, signing
  // this agreement marks that task DONE.
  taskId        String?         @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  title         String
  // Plain-text agreement body (markdown-light: \n linebreaks). Renderer
  // wraps it into the PDF as paragraphs; no HTML/script execution.
  body          String
  createdById   String          @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  // Once signed, signedAt mirrors the Signature row for fast dashboard
  // queries. Null = unsigned.
  signedAt      DateTime?       @db.Timestamptz(6)
  signatureId   String?         @db.Uuid
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  task          OnboardingTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy     User            @relation("EsignAgreementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signatures    Signature[]

  @@index([applicationId])
  @@index([taskId])
  @@index([signedAt])
  @@index([tenantId])
}

model BackgroundCheck {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId         String        @db.Uuid
  clientId            String?       @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId            String        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  provider            String
  externalId          String?
  status              BgCheckStatus @default(INITIATED)
  initiatedAt         DateTime      @default(now()) @db.Timestamptz(6)
  completedAt         DateTime?     @db.Timestamptz(6)
  connectionId        String?       @db.Uuid
  packageCode         String?       @db.VarChar(80)
  externalCandidateId String?       @db.VarChar(80)
  invitationUrl       String?       @db.VarChar(500)
  rawStatus           String?       @db.VarChar(40)
  /// clear | consider (provider result before adjudication)
  result              String?       @db.VarChar(20)
  /// ENGAGED | PRE_ADVERSE | ADVERSE (FCRA adjudication)
  adjudication        String?       @db.VarChar(20)
  preAdverseSentAt    DateTime?     @db.Timestamptz(6)
  adverseWaitUntil    DateTime?     @db.Timestamptz(6)
  adverseSentAt       DateTime?     @db.Timestamptz(6)
  adverseActionId     String?       @db.VarChar(80)
  lastSyncAt          DateTime?     @db.Timestamptz(6)
  lastError           String?       @db.VarChar(500)
  associate           Associate     @relation(fields: [associateId], references: [id], onDelete: Restrict)

  @@index([associateId])
  @@index([status])
  @@index([clientId])
  @@index([tenantId])
  @@index([externalId])
}

// Drug-screen ledger — mirrors BackgroundCheck. The key difference lives
// OUTSIDE this table: the Walmart SOW requires a result within 60 DAYS, so
// drug testing recurs — the "needs a test" roster is driven by the recency
// of DRUG_TEST_RESULT documents (which the scorecard signal also reads),
// not by whether a row ever existed here. Rows record orders and outcomes.
model DrugTest {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId        String         @db.Uuid
  clientId           String?        @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId           String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  provider           String
  externalId         String?
  status             DrugTestStatus @default(INITIATED)
  initiatedAt        DateTime       @default(now()) @db.Timestamptz(6)
  completedAt        DateTime?      @db.Timestamptz(6)
  connectionId       String?        @db.Uuid
  panelCode          String?        @db.VarChar(40)
  reason             String?        @db.VarChar(30)
  donorPassUrl       String?        @db.VarChar(500)
  donorPassExpiresAt DateTime?      @db.Timestamptz(6)
  collectionSite     String?        @db.VarChar(300)
  rawStatus          String?        @db.VarChar(40)
  /// NEGATIVE | POSITIVE | DILUTE | CANCELLED (MRO-verified when mroVerifiedAt is set)
  resultCode         String?        @db.VarChar(20)
  mroVerifiedAt      DateTime?      @db.Timestamptz(6)
  lastSyncAt         DateTime?      @db.Timestamptz(6)
  lastError          String?        @db.VarChar(500)
  associate          Associate      @relation(fields: [associateId], references: [id], onDelete: Restrict)

  @@index([associateId])
  @@index([status])
  @@index([clientId])
  @@index([tenantId])
  @@index([externalId])
}

model I9Verification {
  id                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId                String               @unique @db.Uuid
  section1CompletedAt        DateTime?            @db.Timestamptz(6)
  // Phase 20 — Section 1 employee self-attestation fields. citizenshipStatus
  // is the exclusive choice the employee picks. alienRegistrationNumberEnc
  // is encrypted at rest (same key as W-4 SSN); workAuthExpiresAt applies
  // only to ALIEN_AUTHORIZED_TO_WORK (or LAWFUL_PERMANENT_RESIDENT with an
  // expiring USCIS number). section1TypedName + IP + userAgent capture the
  // typed-name e-signature exactly per Phase 19's pattern.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId                   String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  citizenshipStatus          I9CitizenshipStatus?
  alienRegistrationNumberEnc Bytes?
  workAuthExpiresAt          DateTime?            @db.Date
  section1TypedName          String?
  section1Ip                 String?
  section1UserAgent          String?
  // Set when the associate clicks "Submit for HR review" after signing
  // Section 1 and uploading documents. Distinct from section1CompletedAt:
  // a signed Section 1 with no documents is not yet ready for HR. Drives
  // the I9_VERIFICATION task transition PENDING → IN_PROGRESS so the
  // associate gets visible confirmation that the ball is in HR's court.
  documentsSubmittedAt       DateTime?            @db.Timestamptz(6)
  section2VerifierUserId     String?              @db.Uuid
  section2CompletedAt        DateTime?            @db.Timestamptz(6)
  documentList               I9DocumentList?
  supportingDocIds           Json?
  // Phase add-on — E-Verify (the federal portal HR runs separately after
  // Section 2). The case number is opaque (assigned by USCIS); status is
  // the rolled-up outcome. eVerifyClosedAt stamps when the case left
  // PENDING. Compliance scorecard's onboarding tile counts an associate
  // as fully E-Verified only when status = EMPLOYMENT_AUTHORIZED.
  eVerifyCaseNumber          String?
  eVerifyStatus              EVerifyStatus?
  // When the case was created in the federal portal. E-Verify must be run
  // within 3 business days of the employee's first day worked, so without
  // an opened-at stamp the queue can't say what's overdue — which is most
  // of the point of having a queue.
  eVerifyCaseOpenedAt        DateTime?            @db.Timestamptz(6)
  eVerifyClosedAt            DateTime?            @db.Timestamptz(6)
  /// Provider connection (ProviderConnection) that holds the case; null = recorded by hand.
  eVerifyConnectionId        String?              @db.Uuid
  /// First day worked + 3 business days.
  eVerifyDueBy               DateTime?            @db.Date
  eVerifyRawStatus           String?              @db.VarChar(80)
  /// Tentative Nonconfirmation: when the employee was given the notice, and what they chose.
  eVerifyTncNotifiedAt       DateTime?            @db.Timestamptz(6)
  eVerifyTncDecision         String?              @db.VarChar(12)
  eVerifyReferredAt          DateTime?            @db.Timestamptz(6)
  /// 8 federal working days after referral for the employee to contact SSA/DHS.
  eVerifyReferralDeadline    DateTime?            @db.Date
  eVerifyClosureReason       String?              @db.VarChar(60)
  eVerifyLastSyncAt          DateTime?            @db.Timestamptz(6)
  eVerifyLastError           String?              @db.VarChar(500)
  associate                  Associate            @relation(fields: [associateId], references: [id], onDelete: Cascade)
  section2Verifier           User?                @relation("I9Verifier", fields: [section2VerifierUserId], references: [id], onDelete: SetNull)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(6)

  @@index([tenantId])
}

/// Voluntary applicant EEO self-identification (audit 2026-10-21 #14). Kept
/// apart from the candidate and the application on purpose: no candidate or
/// application read ever joins it, and the only reader is the aggregate
/// report in routes/compliance.ts, which suppresses buckets under five.
/// Values are plain strings (gender FEMALE|MALE|NONBINARY|DECLINE; ethnicity
/// the EEO-1 categories or DECLINE; veteran PROTECTED|NOT_PROTECTED|DECLINE;
/// disability YES|NO|DECLINE); `declined` is the whole-form opt-out.
model EeoSelfIdentification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  candidateId      String?   @unique @db.Uuid
  associateId      String?   @unique @db.Uuid
  gender           String?   @db.VarChar(20)
  ethnicity        String?   @db.VarChar(40)
  veteranStatus    String?   @db.VarChar(30)
  disabilityStatus String?   @db.VarChar(30)
  declined         Boolean   @default(false)
  submittedAt      DateTime  @default(now()) @db.Timestamptz(6)

  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  associate Associate? @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId, submittedAt])
}

model W4Submission {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId         String          @unique @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId            String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  filingStatus        W4FilingStatus
  multipleJobs        Boolean         @default(false)
  dependentsAmount    Decimal         @default(0) @db.Decimal(12, 2)
  otherIncome         Decimal         @default(0) @db.Decimal(12, 2)
  deductions          Decimal         @default(0) @db.Decimal(12, 2)
  extraWithholding    Decimal         @default(0) @db.Decimal(12, 2)
  /// An "Exempt" W-4 and the tax year it covers (good through February 15 of the next).
  exempt              Boolean         @default(false)
  exemptTaxYear       Int?
  /// Nonresident alien employee: Pub 15-T Tables 1/2 add-on to wages for the calculation.
  nonresidentAlien    Boolean         @default(false)
  /// Allowances on a 2019-or-earlier W-4 that was never replaced (null = 2020-or-later form).
  pre2020Allowances   Int?
  /// IRS lock-in letter (Letter 2800C): the filing status and Step 2 it fixes, from this date.
  lockInFilingStatus  W4FilingStatus?
  lockInMultipleJobs  Boolean?
  lockInEffectiveDate DateTime?       @db.Date
  lockInReceivedAt    DateTime?       @db.Timestamptz(6)
  /// The letter itself: a DocumentRecord in the person's vault (routes/federalW4 upload).
  lockInLetterDocumentId String?      @db.Uuid
  ssnEncrypted        Bytes?
  signedDocumentId    String?         @db.Uuid
  signedAt            DateTime?       @db.Timestamptz(6)
  associate           Associate       @relation(fields: [associateId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)

  @@index([tenantId])
}

model PayoutMethod {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId          String     @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String     @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  type                 PayoutType
  // Despite the name, routingNumberEnc holds PLAIN UTF-8 bytes — routing
  // numbers are public (printed on every cheque) so they're stored
  // unencrypted. Only accountNumberEnc is real ciphertext. Read routing
  // with toString('utf8'), not decryptString.
  routingNumberEnc     Bytes?
  accountNumberEnc     Bytes?
  accountType          String?
  // Free-text institution name ("Chase", "Bank of America"). Collected at
  // direct-deposit setup because nothing derives it: there's no ABA routing
  // directory in the product, and external payroll providers expect the
  // column on their intake file. Nullable — every row predating this and
  // every Branch-card method leaves it empty.
  bankName             String?
  branchCardId         String?
  isPrimary            Boolean    @default(false)
  verifiedAt           DateTime?  @db.Timestamptz(6)
  /// Set when a newer method replaced this one. A replaced account is kept
  /// (never overwritten) so payroll can fall back to the last verified one
  /// and Finance can see what changed.
  retiredAt            DateTime?  @db.Timestamptz(6)
  verifiedById         String?    @db.Uuid
  /// Last four digits of the account (or card id), so alerts, the Finance
  /// queue and the associate's confirmation can name the account without
  /// decrypting it. Null on rows written before this column existed.
  accountLast4         String?    @db.VarChar(4)
  /// Keyed hash of routing + account. Lets the same bank account on two
  /// associates be spotted without decrypting anything.
  accountFingerprint   String?    @db.VarChar(64)
  /// Split deposits: null = the remainder account; AMOUNT or PERCENT take their share first, in splitOrder.
  splitKind            String?    @db.VarChar(10)
  splitAmountCents     Int?
  splitPercent         Decimal?   @db.Decimal(5, 2)
  splitOrder           Int        @default(0)
  /// The zero-dollar prenote that tests a new account on our own ACH: SENT | CLEARED | RETURNED.
  prenoteStatus        String?    @db.VarChar(10)
  prenoteSentAt        DateTime?  @db.Timestamptz(6)
  prenoteEffectiveDate DateTime?  @db.Date
  associate            Associate  @relation(fields: [associateId], references: [id], onDelete: Cascade)
  createdAt            DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(6)

  @@index([associateId])
  @@index([associateId, isPrimary, retiredAt])
  @@index([accountFingerprint])
  @@index([tenantId])
}

model TimeEntry {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId     String          @db.Uuid
  // Denormalized clientId so HR can scope/filter by client without joining.
  // Captured from the Associate's currently-assigned client at clock-in.
  clientId        String?         @db.Uuid
  // Phase 131 — denormalized locationId, same snapshotting pattern as
  // clientId. Captured from the Shift's location (when entry is shift-
  // tied), or the kiosk device's location (when entry is kiosk-tied),
  // or the associate's current AssociateAssignment.locationId. NULL on
  // historical entries that pre-date this column.
  locationId      String?         @db.Uuid
  // Optional Job for cost-coding. Null means generic / undifferentiated time.
  jobId           String?         @db.Uuid
  clockInAt       DateTime        @db.Timestamptz(6)
  clockOutAt      DateTime?       @db.Timestamptz(6)
  // GPS coords captured from the associate's device at each transition.
  // Used for geofence audit; nullable so the partial-unique still works
  // and so older entries (pre-geofence) aren't broken.
  clockInLat      Decimal?        @db.Decimal(10, 7)
  clockInLng      Decimal?        @db.Decimal(10, 7)
  clockOutLat     Decimal?        @db.Decimal(10, 7)
  clockOutLng     Decimal?        @db.Decimal(10, 7)
  // Snapshotted pay rate at clock-in time for payroll repeatability.
  payRate         Decimal?        @db.Decimal(8, 2)
  status          TimeEntryStatus @default(ACTIVE)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  notes           String?
  // Tags surfaced in the HR queue: NO_BREAK, OVERTIME_UNAPPROVED,
  // GEOFENCE_VIOLATION, FORGOT_CLOCKOUT, MEAL_BREAK_TOO_SHORT, etc.
  // Computed at clock-out and re-computed on edit.
  anomalies       Json?
  rejectionReason String?
  approvedById    String?         @db.Uuid
  approvedAt      DateTime?       @db.Timestamptz(6)
  // Phase 86 — optional project tag for cost coding.
  projectId       String?         @db.Uuid
  // Punch↔shift link — the scheduled shift this entry fulfills. Matched
  // automatically at clock-in (kiosk + web) to the associate's nearest
  // assigned shift whose window covers the punch; NULL for unscheduled
  // punches and entries that pre-date the link.
  shiftId         String?         @db.Uuid

  associate            Associate            @relation(fields: [associateId], references: [id], onDelete: Cascade)
  shift                Shift?               @relation("ShiftTimeEntries", fields: [shiftId], references: [id], onDelete: SetNull)
  approvedBy           User?                @relation("TimeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  job                  Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  project              Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  location             Site?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  breaks               BreakEntry[]
  timeOffLedgerEntries TimeOffLedgerEntry[]
  // Phase 99 — kiosk punches that opened/closed this entry.
  kioskPunches         KioskPunch[]
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)

  // At most one ACTIVE row per associate at any time. Postgres treats this
  // as a partial unique via the where clause below.
  prevailingWageTag PrevailingWageTimeTag?
  dailyPaid         DailyPaidTimeEntry?

  @@index([associateId, clockInAt])
  @@index([clientId, status, clockInAt])
  @@index([locationId, status])
  @@index([status, clockInAt])
  @@index([jobId])
  @@index([projectId])
  @@index([shiftId])
  @@index([tenantId])
  @@index([tenantId, clockInAt])
}

model Shift {
  id                     String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId               String?                         @db.Uuid
  // Phase 131 — physical work site for this shift. Still nullable
  // until the legacy free-text `location` column below is migrated
  // out; a follow-up PR will make this required after updating the
  // 17 writers/readers in one pass.
  locationId             String?                         @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId               String                          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  position               String
  startsAt               DateTime                        @db.Timestamptz(6)
  endsAt                 DateTime                        @db.Timestamptz(6)
  location               String?
  // What the client is billed (revenue side).
  hourlyRate             Decimal?                        @db.Decimal(8, 2)
  // What the associate is paid (cost side). null = use Job.payRate or default.
  payRate                Decimal?                        @db.Decimal(8, 2)
  status                 ShiftStatus                     @default(DRAFT)
  notes                  String?
  assignedAssociateId    String?                         @db.Uuid
  assignedAt             DateTime?                       @db.Timestamptz(6)
  createdById            String?                         @db.Uuid
  cancelledAt            DateTime?                       @db.Timestamptz(6)
  cancellationReason     String?
  // Phase 25 — stamped the first time the shift transitions out of DRAFT
  // (= "schedule was published"). Combined with startsAt, this is the
  // notice window every fair-workweek law audits against.
  publishedAt            DateTime?                       @db.Timestamptz(6)
  // Documented justification when a shift in a fair-workweek state was
  // published inside the 14-day notice window (mutual agreement,
  // emergency call-out cover, etc.). Required by the API for those cases.
  lateNoticeReason       String?
  // Associate tapped "I'll be there" on this published shift. Null = not
  // yet acknowledged; admins can chase unconfirmed shifts before the day.
  acknowledgedAt         DateTime?                       @db.Timestamptz(6)
  // "Please confirm" chase (manual nudge-all button + hourly auto-nudge).
  // Stamped when a confirm reminder went out so neither path re-pesters;
  // distinct from reminderSentAt (the day-before "shift tomorrow" note).
  confirmNudgedAt        DateTime?                       @db.Timestamptz(6)
  // Day-before reminder dedupe stamp — the reminder cron claims a shift by
  // setting this (guarded update), so overlapping sweeps can't double-send.
  reminderSentAt         DateTime?                       @db.Timestamptz(6)
  // No-show alert dedupe stamp — the sweep claims a shift whose start
  // passed with no linked punch by setting this (guarded update) before
  // notifying admins, so each shift alerts at most once.
  noShowNotifiedAt       DateTime?                       @db.Timestamptz(6)
  // Attendance-record stamp, deliberately separate from the alert above.
  // The 15-minute alert asks a supervisor to go look; the attendance
  // event is only written once the shift has ENDED with no punch, so a
  // late arrival is never filed as a no-call no-show.
  noShowRecordedAt       DateTime?                       @db.Timestamptz(6)
  // Emergency Mode (Brief 1C-1): a declared emergency suspends the shift —
  // status CANCELLED with reason EMERGENCY, which every sweep and roster
  // already treats as "not a shift" (no attendance penalty, no reminder,
  // no pay). The status it had is kept so stand-down can put it back.
  emergencyId            String?                         @db.Uuid
  emergencyPriorStatus   ShiftStatus?
  // Brief 1D-1: the Worker on this shift — a person (kept in step with
  // assignedAssociateId by the client extension in db.ts), an agent, or a
  // robot. Scheduling reads this from now on; the associate column stays
  // for every screen that already knows it.
  workerId               String?                         @db.Uuid
  client                 Client?                         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  emergency              Emergency?                      @relation(fields: [emergencyId], references: [id], onDelete: SetNull)
  worker                 Worker?                         @relation(fields: [workerId], references: [id], onDelete: SetNull)
  robotChecklistRuns     RobotChecklistRun[]
  robotEvents            RobotEvent[]
  locationRel            Site?                           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assignedAssociate      Associate?                      @relation(fields: [assignedAssociateId], references: [id], onDelete: SetNull)
  createdBy              User?                           @relation("ShiftCreator", fields: [createdById], references: [id], onDelete: SetNull)
  swapRequests           ShiftSwapRequest[]
  // Time entries auto-matched to this shift at punch time.
  timeEntries            TimeEntry[]                     @relation("ShiftTimeEntries")
  /// Agent families step 2: the Workforce agent's attendance.confirm ask for this shift.
  attendanceConfirmation AttendanceConfirmation?
  // Trades: swaps where THIS shift is what the requester takes in exchange.
  tradeSwapRequests      ShiftSwapRequest[]              @relation("SwapCounterpartShift")
  // Phase 85 — qualification gates + open-shift claims.
  qualReqs               ShiftQualificationRequirement[]
  claims                 OpenShiftClaim[]
  invites                OpenShiftInvite[]
  createdAt              DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(6)

  overtimeOffers OvertimeOffer[]
  callOuts       CallOut[]

  @@index([clientId, startsAt])
  @@index([locationId, startsAt])
  @@index([assignedAssociateId, startsAt])
  @@index([status, startsAt])
  @@index([workerId, startsAt])
  @@index([tenantId])
}

// Phase 51 — reusable shift template ("Friday closer", "weekend
// opener"). Apply-template stamps a DRAFT shift onto the configured
// dayOfWeek of a target week. Times are minute-of-day (0..1439) so
// templates are timezone-agnostic — they instantiate against the
// browser-local week start.
model ShiftTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // null clientId = global template usable across every client.
  clientId    String?   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name        String
  position    String
  dayOfWeek   Int // 0 = Sunday … 6 = Saturday (matches JS Date.getDay).
  startMinute Int // minutes from local midnight, 0..1439.
  endMinute   Int // minutes from local midnight, 0..1439. May be < startMinute for overnight.
  location    String?
  hourlyRate  Decimal?  @db.Decimal(8, 2)
  payRate     Decimal?  @db.Decimal(8, 2)
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, dayOfWeek])
  @@index([deletedAt])
  @@index([tenantId])
}

model Job {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String      @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name        String
  // Default rates if a Shift doesn't override. Bill = revenue, pay = cost.
  billRate    Decimal?    @db.Decimal(8, 2)
  payRate     Decimal?    @db.Decimal(8, 2)
  isActive    Boolean     @default(true)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?   @db.Timestamptz(6)

  @@unique([clientId, name])
  @@index([clientId, isActive])
  @@index([tenantId])
}

model BreakEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timeEntryId String    @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  type        BreakType
  startedAt   DateTime  @db.Timestamptz(6)
  endedAt     DateTime? @db.Timestamptz(6)
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId])
  @@index([tenantId])
}

// Phase 26 — time-off categories. Sick is the only one accruing
// automatically today (driven by StateLaborPolicy.paidSickLeaveAccrualPerHour
// when a TimeEntry is approved). VACATION/PTO/etc. exist in the enum so the
// later request-flow phase doesn't need a schema migration.
enum TimeOffCategory {
  SICK
  VACATION
  PTO
  BEREAVEMENT
  JURY_DUTY
  OTHER
}

// Source of a ledger entry. ACCRUAL = automatic from worked time.
// USE = consumed by an approved time-off request. ADJUSTMENT = HR
// manually credited or debited (carryover at year boundary, dispute fix,
// etc.). PAYOUT = associate cashed out at termination.
enum TimeOffLedgerReason {
  ACCRUAL
  USE
  ADJUSTMENT
  PAYOUT
  // Phase 43 — at the annual reset boundary, balance above
  // carryoverMaxMinutes is forfeited. Negative deltaMinutes.
  CARRYOVER_FORFEIT
  // Phase 43 — annual lump-sum grant for entitlements like VACATION /
  // PTO. Positive deltaMinutes.
  ANNUAL_GRANT
}

// Phase 43 — annual entitlements for VACATION / PTO / etc. SICK accrual
// is per-worked-hour (Phase 26) and doesn't need this model. The reset
// pattern: at the start of each entitlement year, current balance is
// capped at carryoverMaxMinutes, then annualMinutes is granted on top.
// `lastGrantedAt` makes the grant idempotent — running the helper twice
// in the same window is a no-op. `policyAnchorDate` lets HR pick the
// reset month (e.g. Jan 1 vs hire-anniversary).
model TimeOffEntitlement {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId         String          @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId            String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  category            TimeOffCategory
  annualMinutes       Int
  carryoverMaxMinutes Int             @default(0)
  // Anchor for the annual reset. Resets happen on the same MM-DD each
  // year. Default = Jan 1.
  policyAnchorDate    DateTime        @default(dbgenerated("DATE '2000-01-01'")) @db.Date
  lastGrantedAt       DateTime?       @db.Date
  // The policy this grant came from, when it did (lib/timeOffPolicy.ts);
  // a hand-set grant has none.
  policyId            String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)
  associate           Associate       @relation(fields: [associateId], references: [id], onDelete: Cascade)
  policy              TimeOffPolicy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@unique([associateId, category])
  @@index([associateId])
  @@index([policyId])
  @@index([tenantId])
}

// A time-off policy: how a category of leave is earned (per hour worked,
// per month, or as an annual grant), its cap and carryover, the waiting
// period before accrual starts, and tenure tiers that raise the rate. It is
// assigned to groups — everyone, a client, a site, a department, a job
// profile — and the most specific assignment wins (lib/timeOffPolicy.ts).
enum TimeOffAccrualMode {
  PER_HOUR_WORKED
  PER_PERIOD
  ANNUAL_GRANT
}

enum TimeOffPolicyScope {
  ALL
  CLIENT
  SITE
  DEPARTMENT
  JOB_PROFILE
}

model TimeOffPolicy {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name                String             @db.VarChar(120)
  category            TimeOffCategory
  accrualMode         TimeOffAccrualMode
  // PER_HOUR_WORKED: hours of leave earned per hour worked (1 per 30 = 0.0333).
  accrualPerHour      Decimal?           @db.Decimal(8, 5)
  // PER_PERIOD: minutes granted each calendar month.
  minutesPerPeriod    Int?
  // ANNUAL_GRANT: minutes granted on the anchor date each year.
  annualMinutes       Int?
  policyAnchorDate    DateTime           @default(dbgenerated("DATE '2000-01-01'")) @db.Date
  // Balance never accrues past this (null = no cap).
  capMinutes          Int?
  carryoverMaxMinutes Int                @default(0)
  // Days after hire before accrual starts.
  waitingPeriodDays   Int                @default(0)
  // [{afterMonths, accrualPerHour?, minutesPerPeriod?, annualMinutes?}] —
  // the first tier whose afterMonths the person has passed, highest first.
  tenureTiers         Json               @default("[]")
  isActive            Boolean            @default(true)
  notes               String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?          @db.Timestamptz(6)

  assignments  TimeOffPolicyAssignment[]
  entitlements TimeOffEntitlement[]

  @@index([tenantId, category])
}

model TimeOffPolicyAssignment {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  policyId  String             @db.Uuid
  scopeKind TimeOffPolicyScope
  // The client / site / department / job profile id; null for ALL.
  scopeId   String?            @db.Uuid
  createdAt DateTime           @default(now()) @db.Timestamptz(6)

  policy TimeOffPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([scopeKind, scopeId])
  @@index([tenantId])
}

model TimeOffBalance {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId    String          @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  category       TimeOffCategory
  // Stored in MINUTES so we don't lose precision on fractional accrual
  // (CA: 1hr per 30hrs = 2 min per worked hour). Convert to hours at the
  // edge for display.
  balanceMinutes Int             @default(0)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  associate      Associate       @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([associateId, category])
  @@index([associateId])
  @@index([tenantId])
}

model TimeOffLedgerEntry {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId       String              @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId          String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  category          TimeOffCategory
  reason            TimeOffLedgerReason
  // Signed: +N for accrual/credit, -N for use/payout.
  deltaMinutes      Int
  // Optional foreign keys so we can audit-trail back to the source.
  // sourceTimeEntryId is the worked entry that drove an ACCRUAL row.
  sourceTimeEntryId String?             @db.Uuid
  // Phase 30 — the request that drove a USE row. One USE entry per request.
  sourceRequestId   String?             @unique @db.Uuid
  sourceUserId      String?             @db.Uuid
  // The policy that accrued this row and, for a per-period grant, the
  // month it covers ("2026-10") — one grant per policy per month.
  sourcePolicyId    String?             @db.Uuid
  periodKey         String?             @db.VarChar(7)
  notes             String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  associate         Associate           @relation(fields: [associateId], references: [id], onDelete: Cascade)
  sourceTimeEntry   TimeEntry?          @relation(fields: [sourceTimeEntryId], references: [id], onDelete: SetNull)
  sourceRequest     TimeOffRequest?     @relation(fields: [sourceRequestId], references: [id], onDelete: SetNull)
  sourceUser        User?               @relation(fields: [sourceUserId], references: [id], onDelete: SetNull)

  // Idempotency guard for the accrual hook: one accrual row per (entry,
  // category). If the approve handler runs twice we no-op.
  @@unique([sourceTimeEntryId, category, reason], name: "uniq_accrual_per_entry")
  @@unique([associateId, sourcePolicyId, periodKey], name: "uniq_period_grant")
  @@index([associateId, createdAt])
  @@index([tenantId])
}

// Phase 30 — associate-submitted time-off request and its approval state.
// Approval is the single point that debits the balance ledger; denial /
// cancellation never touches the ledger. The unique sourceRequestId on
// TimeOffLedgerEntry guarantees at-most-one USE entry per request even if
// the approve handler is retried.
enum TimeOffRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

model TimeOffRequest {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId      String               @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  category         TimeOffCategory
  // Inclusive day range. We store dates (not timestamps) because requests
  // are scheduled at day granularity; the UI picks days, not minutes.
  startDate        DateTime             @db.Date
  endDate          DateTime             @db.Date
  // Hours requested in MINUTES so the unit matches the ledger and balance.
  // We store minutes (not days) because part-days are valid (a half-day off
  // = 240 min for an 8h schedule) and we'd lose precision converting twice.
  requestedMinutes Int
  reason           String?
  status           TimeOffRequestStatus @default(PENDING)
  reviewerUserId   String?              @db.Uuid
  reviewerNote     String?
  decidedAt        DateTime?            @db.Timestamptz(6)
  cancelledAt      DateTime?            @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(6)

  associate   Associate           @relation(fields: [associateId], references: [id], onDelete: Cascade)
  reviewer    User?               @relation("TimeOffReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  ledgerEntry TimeOffLedgerEntry?

  @@index([associateId, status])
  @@index([status, createdAt])
  @@index([tenantId])
}

model AssociateAvailability {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String    @db.Uuid
  // 0 = Sunday … 6 = Saturday
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  dayOfWeek   Int
  // Minutes since midnight: 480 = 08:00, 1080 = 18:00.
  startMinute Int
  endMinute   Int
  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@index([associateId, dayOfWeek])
  @@index([tenantId])
}

// Web-push subscription — one row per (user, browser/device). The endpoint
// is the delivery address minted by the browser's push service; p256dh/auth
// encrypt each payload to exactly this device. Dead endpoints (404/410 on
// send) are pruned by the sender. Cascade with the user account.
model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String   @db.VarChar(300)
  auth      String   @db.VarChar(100)
  userAgent String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

enum NativePlatform {
  IOS
  ANDROID
}

/// A phone a person has the native app on (iOS / Android). Holds the push
/// token (APNs or FCM) and a refresh credential kept in the phone's
/// Keychain / Keystore — only its hash lives here.
model NativeDevice {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId              String         @db.Uuid
  platform            NativePlatform
  pushToken           String?        @unique @db.VarChar(400)
  deviceName          String?        @db.VarChar(120)
  deviceModel         String?        @db.VarChar(120)
  osVersion           String?        @db.VarChar(40)
  appVersion          String?        @db.VarChar(40)
  credentialHash      Bytes?
  credentialExpiresAt DateTime?      @db.Timestamptz(6)
  tokenVersion        Int            @default(0)
  biometricLock       Boolean        @default(false)
  /// How the person signed in when the credential was issued ('password' | 'mfa' | 'passkey' | 'sso').
  authMethod          String?        @db.VarChar(20)
  lastSeenAt          DateTime       @default(now()) @db.Timestamptz(6)
  revokedAt           DateTime?      @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tenantId])
}

/// A one-time code that carries a sign-in finished in the system browser
/// (SSO, passkeys) back into the app's web view. Two minutes, single use.
model NativeHandoffCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId    String    @db.Uuid
  codeHash  Bytes     @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([tenantId])
}

// One-off "can't work this day" exception, layered over the weekly
// recurring AssociateAvailability windows. Date-granular (like time off)
// because that's how people think about it; consumed by swap busy-flags,
// open-shift eligibility, and the auto-scheduler.
model AvailabilityException {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String    @db.Uuid
  date        DateTime  @db.Date
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  note        String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([associateId, date])
  @@index([date])
  @@index([tenantId])
}

model ShiftSwapRequest {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shiftId                 String          @db.Uuid
  requesterAssociateId    String          @db.Uuid
  // Counterparty associate the requester proposes the swap to. They must
  // accept before HR/Ops sees it for final approval.
  counterpartyAssociateId String          @db.Uuid
  status                  ShiftSwapStatus @default(PENDING_PEER)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId                String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  note                    String?
  // True trade: a shift of the COUNTERPARTY the requester takes in
  // exchange. Null = plain give-away (the original swap shape). SetNull
  // so cancelling/deleting the exchange shift degrades the request to a
  // give-away instead of breaking it.
  counterpartShiftId      String?         @db.Uuid
  decidedById             String?         @db.Uuid
  decidedAt               DateTime?       @db.Timestamptz(6)
  shift                   Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  counterpartShift        Shift?          @relation("SwapCounterpartShift", fields: [counterpartShiftId], references: [id], onDelete: SetNull)
  requester               Associate       @relation("SwapRequester", fields: [requesterAssociateId], references: [id], onDelete: Cascade)
  counterparty            Associate       @relation("SwapCounterparty", fields: [counterpartyAssociateId], references: [id], onDelete: Cascade)
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(6)

  @@index([shiftId])
  @@index([status, createdAt(sort: Desc)])
  @@index([counterpartyAssociateId, status])
  @@index([requesterAssociateId, status])
  @@index([tenantId])
}

model PayrollRun {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // clientId is nullable so a run can span all clients (Alto-internal payroll).
  clientId                    String?                   @db.Uuid
  periodStart                 DateTime                  @db.Date
  periodEnd                   DateTime                  @db.Date
  status                      PayrollRunStatus          @default(DRAFT)
  // Gap 3 — REGULAR (default), OFF_CYCLE (bonuses, terminal pay), or
  // AMENDMENT (correction of a prior disbursed run; pairs with amendsRunId
  // and amendmentReason, both required when kind=AMENDMENT, enforced by
  // CHECK constraints in the migration).
  kind                        PayrollRunKind            @default(REGULAR)
  totalGross                  Decimal                   @default(0) @db.Decimal(12, 2)
  totalTax                    Decimal                   @default(0) @db.Decimal(12, 2)
  totalNet                    Decimal                   @default(0) @db.Decimal(12, 2)
  // Phase 18 — employer-side total (FICA match + Medicare match + FUTA + SUTA)
  // is the company's true cost on top of totalGross. Used in finance reports.
  totalEmployerTax            Decimal                   @default(0) @db.Decimal(12, 2)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId                    String                    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  notes                       String?
  createdById                 String?                   @db.Uuid
  finalizedAt                 DateTime?                 @db.Timestamptz(6)
  // Tier-3 — four-eyes approval: a second person (not the run creator)
  // signs off between FINALIZED and disbursement. Enforced only when
  // PAYROLL_REQUIRE_SECOND_APPROVAL is on.
  approvedById                String?                   @db.Uuid
  approvedAt                  DateTime?                 @db.Timestamptz(6)
  disbursedAt                 DateTime?                 @db.Timestamptz(6)
  cancelledAt                 DateTime?                 @db.Timestamptz(6)
  // Gap 3 — void metadata. cancelledById = HR Admin who voided. cancelReason
  // is the mandatory free-text justification (CHECK enforces non-empty when
  // status=CANCELLED).
  cancelledById               String?                   @db.Uuid
  cancelReason                String?
  // Gap 3 — amendment metadata. amendsRunId points to the run this run
  // corrects (required + non-self when kind=AMENDMENT). amendmentReason is
  // the mandatory free-text justification (CHECK enforces non-empty when
  // kind=AMENDMENT) — rendered on the amendment paystub PDF.
  amendsRunId                 String?                   @db.Uuid
  amendmentReason             String?
  client                      Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy                   User?                     @relation("PayrollRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy                  User?                     @relation("PayrollRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy                 User?                     @relation("PayrollRunCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  amendsRun                   PayrollRun?               @relation("PayrollRunAmendments", fields: [amendsRunId], references: [id], onDelete: Restrict)
  amendments                  PayrollRun[]              @relation("PayrollRunAmendments")
  items                       PayrollItem[]
  // Phase 91 — garnishment deductions sourced from this run.
  garnishmentDeductions       GarnishmentDeduction[]
  // Phase 97 — reimbursements paid in this run.
  reimbursementsPaid          Reimbursement[]
  // Gap 3 — pending deductions consumed by this run (overpayment clawbacks).
  pendingDeductionsApplied    PendingPayrollDeduction[] @relation("PendingDeductionAppliedRun")
  // Tier-1 — the FED_941 deposit obligation this run's disbursement accrued.
  taxDeposit                  TaxDeposit?
  taxLiabilities              TaxLiability[]
  // Tier-1 — per-payee garnishment remittances accrued at disbursement.
  garnishmentRemittances      GarnishmentRemittance[]
  // Tier-2 — manual earning lines (bonus/commission/tips/holiday/PTO
  // payout) attached to a DRAFT run; folded into items at aggregation.
  addOns                      PayrollRunAddOn[]
  retroPaid                   RetroPayAdjustment[]
  earnedWageAdvancesRecovered EarnedWageAdvance[]
  createdAt                   DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                  @updatedAt @db.Timestamptz(6)
  laborShadowRun              LaborShadowRun?
  reviews                     PayrollRunReview[]
  /// The pay schedule this run pays (lib/payScheduleMembership): only its people, for their days on it.
  payrollScheduleId           String?                   @db.Uuid
  payrollSchedule             PayrollSchedule?          @relation(fields: [payrollScheduleId], references: [id], onDelete: SetNull)
  /// An off-cycle run made from a missed payday: it pays the period's approved time, not add-ons alone (lib/payrollPeriodLedger).
  includesApprovedTime        Boolean                   @default(false)
  readinessRequests           PayrollReadinessRequest[] @relation("ReadinessRequestRun")

  @@index([clientId, periodStart])
  @@index([status, disbursedAt])
  @@index([kind])
  @@index([amendsRunId])
  @@index([tenantId])
  @@index([payrollScheduleId, periodStart])
}

/// Payroll asked a person for what a paycheck needs (a W-4, a pay account, an address) — finance walk 4.
/// One row per request; the readiness grid shows "Requested <date>" until the item is on file.
model PayrollReadinessRequest {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId   String      @db.Uuid
  /// w4 | payout | address
  items         String[]    @default([])
  requestedById String?     @db.Uuid
  requestedAt   DateTime    @default(now()) @db.Timestamptz(6)
  /// The off-cycle run this request was made for, when one was.
  payrollRunId  String?     @db.Uuid
  associate     Associate   @relation(fields: [associateId], references: [id], onDelete: Cascade)
  requestedBy   User?       @relation("ReadinessRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  payrollRun    PayrollRun? @relation("ReadinessRequestRun", fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([associateId, requestedAt(sort: Desc)])
  @@index([tenantId])
}

model PayrollItem {
  id                          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRunId                String               @db.Uuid
  associateId                 String               @db.Uuid
  // Snapshot of inputs at the time of aggregation. Source TimeEntries /
  // Shifts can change later (e.g. a bug-fix amendment), but the paystub
  // record is immutable.
  hoursWorked                 Decimal              @db.Decimal(8, 2)
  hourlyRate                  Decimal              @db.Decimal(8, 2)
  grossPay                    Decimal              @db.Decimal(12, 2)
  // Phase 18 employee-side tax breakdown. federalWithholding is now FIT
  // alone — it used to absorb the placeholder flat tax. fica =
  // 6.2% Social Security (capped at SS wage base), medicare = 1.45% +
  // 0.9% surcharge over $200k YTD, stateWithholding = per-state SIT.
  federalWithholding          Decimal              @db.Decimal(12, 2)
  fica                        Decimal              @default(0) @db.Decimal(12, 2)
  medicare                    Decimal              @default(0) @db.Decimal(12, 2)
  stateWithholding            Decimal              @default(0) @db.Decimal(12, 2)
  // Phase 18 employer-side. The company owes these on top of gross.
  employerFica                Decimal              @default(0) @db.Decimal(12, 2)
  employerMedicare            Decimal              @default(0) @db.Decimal(12, 2)
  employerFuta                Decimal              @default(0) @db.Decimal(12, 2)
  employerSuta                Decimal              @default(0) @db.Decimal(12, 2)
  // YTD snapshots at the moment this paystub was computed. Required for
  // SS-cap and Medicare-surcharge math; preserved for paystub display.
  ytdWages                    Decimal              @default(0) @db.Decimal(12, 2)
  ytdMedicareWages            Decimal              @default(0) @db.Decimal(12, 2)
  // Phase 42 — pre-tax benefit deductions taken this period. Reduced
  // from gross before federal/FICA/Medicare/state are computed; also
  // subtracted again from net to land on take-home. Stored as a sum
  // here; per-plan breakdown lives in BenefitsEnrollment + the period.
  preTaxDeductions            Decimal              @default(0) @db.Decimal(12, 2)
  // Wave 4.2 — post-tax deductions taken this period (garnishments,
  // Roth 401k, etc.). Subtracted AFTER taxes to land on take-home; does
  // NOT affect FIT/FICA/Medicare/SIT bases. Per-deduction breakdown for
  // garnishments lives in GarnishmentDeduction rows tied to the run.
  postTaxDeductions           Decimal              @default(0) @db.Decimal(12, 2)
  /// Brief 1A-3: van ride charges taken from this check (inside
  /// postTaxDeductions), the charges that were owed but deferred by the
  /// minimum-wage guard, and the guard's arithmetic for the statement.
  rideChargesCents            Int                  @default(0)
  rideChargesDeferredCents    Int                  @default(0)
  rideChargeGuard             Json?
  // Gap 1 — sub-bucket of preTaxDeductions that reduces FIT base only,
  // NOT FICA / Medicare base (traditional 401(k) / 403(b)). Section-125
  // pre-tax = preTaxDeductions - preTaxRetirement. CHECK enforces
  // preTaxRetirement <= preTaxDeductions at the DB layer.
  preTaxRetirement            Decimal              @default(0) @db.Decimal(12, 2)
  /// 2026 W-2 Box 12 TP: cash tips reported to the employer on this check.
  qualifiedTips               Decimal              @default(0) @db.Decimal(12, 2)
  /// 2026 W-2 Box 12 TT: the FLSA overtime premium portion (half the regular rate × hours over 40 in a workweek).
  qualifiedOvertime           Decimal              @default(0) @db.Decimal(12, 2)
  /// W-2 Box 14b: the tipped occupation code in force on this check.
  tippedOccupationCode        String?              @db.VarChar(4)
  /// Retirement/HSA/FSA split: { pre401k, pre403b, roth401k, roth403b, catchUp, catchUpRoth, hsa, fsa, dcap, limitStopped }.
  deferrals                   Json?
  // Gap 10 — sum of folded reimbursement amounts on this item. Added to
  // netPay after taxes / deductions; never affects grossPay or any wage
  // base (accountable-plan rule). Per-row breakdown lives on PayrollItem-
  // Earning rows with kind=REIMBURSEMENT, isTaxable=false.
  reimbursementsTotal         Decimal              @default(0) @db.Decimal(10, 2)
  netPay                      Decimal              @db.Decimal(12, 2)
  // The state used for SIT lookup (snapshot of associate.state at compute
  // time). Lets the paystub label the SIT line and the auditor see why a
  // CA-rate was applied to someone who later moved to TX.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId                    String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  taxState                    String?
  // Tier-2 — city/county withholding (W-2 Box 19). Zero unless the
  // associate carries a LocalTaxRule.
  localWithholding            Decimal              @default(0) @db.Decimal(12, 2)
  status                      PayrollItemStatus    @default(PENDING)
  // sha256 of the rendered paystub PDF the FIRST time it was downloaded.
  // Subsequent downloads must produce the same hash; verifies immutability.
  paystubHash                 String?
  // Stub for now; in production this is the Wise transfer ID or Branch txn ID.
  disbursementRef             String?
  disbursedAt                 DateTime?            @db.Timestamptz(6)
  // Wave 8 — when the paystub PDF was emailed to the associate. Set the
  // first time email-on-disburse fires successfully; lets the disburse
  // hook stay idempotent if a webhook ever delivers the SUCCESS event
  // twice, and lets HR see "did the associate get their stub?" at a
  // glance. Null means never emailed (e.g. associate has no email on
  // file, or the item is from before this column existed).
  paystubEmailedAt            DateTime?            @db.Timestamptz(6)
  failureReason               String?
  // Gap 3 — set when the parent run is voided; mirrors the run's
  // cancelledAt at void time. Lets the paystub PDF render a "VOID"
  // watermark dated to this timestamp.
  voidedAt                    DateTime?            @db.Timestamptz(6)
  // Gap 3 — points to the original PayrollItem this row corrects.
  // Required when the parent run is kind=AMENDMENT (route handler
  // enforces; cross-row CHECK is awkward in Postgres). The live YTD
  // recalc joins on this column to sum original + amendment items.
  amendsItemId                String?              @db.Uuid
  // A deposit the bank sent back (ACH return) and what happened next: the
  // item was re-paid to the person's verified fallback account or a paper
  // check, by lib/payoutReroute.ts. rerouteDetail keeps the chain for the
  // paystub ("returned R03 on …; re-sent to Chase ····1234 on …").
  returnedAt                  DateTime?            @db.Timestamptz(6)
  reroutedAt                  DateTime?            @db.Timestamptz(6)
  rerouteDetail               Json?
  payrollRun                  PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  associate                   Associate            @relation(fields: [associateId], references: [id], onDelete: Restrict)
  amendsItem                  PayrollItem?         @relation("PayrollItemAmendments", fields: [amendsItemId], references: [id], onDelete: Restrict)
  amendments                  PayrollItem[]        @relation("PayrollItemAmendments")
  // Retroactive pay settled on this item, and retro owed because of this item.
  retroPaid                   RetroPayAdjustment[] @relation("RetroPaidItem")
  retroOwed                   RetroPayAdjustment[] @relation("RetroSourceItem")
  // Earned-wage advances recovered from this check.
  earnedWageAdvancesRecovered EarnedWageAdvance[]  @relation("EwaRecoveredItem")
  createdAt                   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime             @updatedAt @db.Timestamptz(6)

  // Phase 22 — every disbursement call (success or fail) appends a row
  // here, even retries. PayrollItem.disbursementRef stores the latest
  // SUCCESS ref; this table preserves the full attempt history for audit.
  disbursementAttempts PayrollDisbursementAttempt[]

  // Wave 1.2 — per-kind earning breakdown that sums to grossPay. The legacy
  // hoursWorked / hourlyRate / grossPay columns are kept for back-compat
  // with paystub PDFs and aggregate reports — earnings is the canonical
  // breakdown going forward.
  earnings PayrollItemEarning[]
  taxLines PayrollItemTaxLine[]

  // Inbound Branch webhook deliveries that referenced this item. Audit trail
  // for "what state did Branch tell us about this payment, and when".
  branchWebhookEvents BranchWebhookEvent[]

  // Gap 3 — pending deductions sourced from this item (when an AMENDMENT
  // item carries a negative net) and pending deductions applied on this
  // item (when it's a regular run absorbing a clawback).
  pendingDeductionsCreated PendingPayrollDeduction[] @relation("PendingDeductionSource")
  pendingDeductionsApplied PendingPayrollDeduction[] @relation("PendingDeductionAppliedItem")

  // Gap 10 — reimbursement rows folded into this item via the next-payroll-
  // run drain. Stamped on Reimbursement.payrollItemId at run-creation time
  // so the row can't be double-folded.
  reimbursementsPaid Reimbursement[] @relation("ReimbursementPaidItem")

  // Tier-1 — paper check issued for this item (CHECK rail or electronic
  // fallback). One check per item; reissue voids and re-creates.
  /// Every deduction on this check, itemized (PayrollItemDeduction).
  deductions       PayrollItemDeduction[]
  payChecks        PayCheck[]
  payoutOverride   PayrollItemPayoutOverride?
  dailyPaidEntries DailyPaidTimeEntry[]

  // One paystub per (run, associate) — re-aggregating updates in place
  // rather than duplicating.
  @@unique([payrollRunId, associateId])
  @@index([associateId])
  @@index([status])
  @@index([amendsItemId])
  @@index([tenantId])
}

// Tier-2 — manual earning lines on a DRAFT run. The aggregator folds
// these into the associate's item as PayrollItemEarning rows of the
// stated kind: BONUS / COMMISSION are supplemental wages (22% flat FIT,
// Pub 15 §7); TIPS / HOLIDAY / SICK / VACATION are regular wages taxed
// by the percentage method. An associate with add-ons but no hours
// still gets an item — which is exactly how an OFF_CYCLE bonus run
// works: empty period + add-ons.
/// PAYEXP — daily / next-day pay for an organization. Off until Finance
/// asks and a second person approves; the approval stands for the nightly
/// runs it governs (each run is still checked and audited).
model DailyPayPolicy {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// OFF | PENDING | ACTIVE
  status        String    @default("OFF") @db.VarChar(12)
  /// SAME_DAY | NEXT_DAY
  timing        String    @default("NEXT_DAY") @db.VarChar(12)
  /// ENROLLED (opted-in people and DAILY schedules) | EVERYONE
  eligibility   String    @default("ENROLLED") @db.VarChar(12)
  feeCents      Int       @default(0)
  dailyCapCents Int       @default(50000)
  /// The change waiting on its approval.
  pending       Json?
  approvalId    String?   @db.Uuid
  requestedById String?   @db.Uuid
  approvedById  String?   @db.Uuid
  approvedAt    DateTime? @db.Timestamptz(6)
  lastRunAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
}

/// PAYEXP — a person opted into daily pay.
model DailyPayEnrollment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId  String    @unique @db.Uuid
  enrolledById String?   @db.Uuid
  enrolledAt   DateTime  @default(now()) @db.Timestamptz(6)
  endedAt      DateTime? @db.Timestamptz(6)
  associate    Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// PAYEXP — one time entry paid ahead by daily pay, with its share of the
/// taxes; the regular check subtracts exactly this, once (reconciledRunId).
model DailyPaidTimeEntry {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  timeEntryId      String      @unique @db.Uuid
  payrollItemId    String      @db.Uuid
  associateId      String      @db.Uuid
  workDate         DateTime    @db.Date
  hours            Decimal     @default(0) @db.Decimal(8, 2)
  gross            Decimal     @default(0) @db.Decimal(12, 2)
  federal          Decimal     @default(0) @db.Decimal(12, 2)
  fica             Decimal     @default(0) @db.Decimal(12, 2)
  medicare         Decimal     @default(0) @db.Decimal(12, 2)
  state            Decimal     @default(0) @db.Decimal(12, 2)
  local            Decimal     @default(0) @db.Decimal(12, 2)
  employerFica     Decimal     @default(0) @db.Decimal(12, 2)
  employerMedicare Decimal     @default(0) @db.Decimal(12, 2)
  employerFuta     Decimal     @default(0) @db.Decimal(12, 2)
  employerSuta     Decimal     @default(0) @db.Decimal(12, 2)
  net              Decimal     @default(0) @db.Decimal(12, 2)
  reconciledRunId  String?     @db.Uuid
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  timeEntry        TimeEntry   @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  payrollItem      PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([associateId, workDate])
  @@index([payrollItemId])
  @@index([tenantId])
}

/// PAYEXP — sick pay an insurer paid (third-party sick pay), recorded for the W-2.
model ThirdPartySickPay {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId            String    @db.Uuid
  payerName              String    @db.VarChar(200)
  payDate                DateTime  @db.Date
  grossAmount            Decimal   @db.Decimal(12, 2)
  /// The share bought with the employee's after-tax premiums: W-2 Box 12 code J.
  nontaxableAmount       Decimal   @default(0) @db.Decimal(12, 2)
  federalWithheld        Decimal   @default(0) @db.Decimal(12, 2)
  socialSecurityWithheld Decimal   @default(0) @db.Decimal(12, 2)
  medicareWithheld       Decimal   @default(0) @db.Decimal(12, 2)
  stateWithheld          Decimal   @default(0) @db.Decimal(12, 2)
  /// EMPLOYER (the insurer passed liability back) | INSURER — who owes the employer FICA/FUTA.
  employerTaxesBy        String    @default("EMPLOYER") @db.VarChar(12)
  /// EMPLOYER | INSURER — who puts it on the W-2.
  w2ReportedBy           String    @default("EMPLOYER") @db.VarChar(12)
  notes                  String?   @db.VarChar(500)
  recordedById           String?   @db.Uuid
  voidedAt               DateTime? @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  associate              Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([associateId, payDate])
  @@index([tenantId])
}

/// PAYEXP — "check my pay before payday": what the worker said about a paycheck preview.
model PayPreviewCheck {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId String    @db.Uuid
  payDate     DateTime  @db.Date
  periodStart DateTime  @db.Date
  periodEnd   DateTime  @db.Date
  /// CONFIRMED | FLAGGED
  status      String    @db.VarChar(12)
  estimateNet Decimal   @default(0) @db.Decimal(12, 2)
  /// [{ line, kind, note, caseId?, correctionId? }]
  flags       Json      @default("[]")
  resolvedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([associateId, payDate])
  @@index([tenantId, payDate])
}

model PayrollRunAddOn {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRunId String             @db.Uuid
  associateId  String             @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind         PayrollEarningKind
  amount       Decimal            @db.Decimal(12, 2)
  hours        Decimal?           @db.Decimal(8, 2)
  note         String?
  /// PAYEXP gross-up: the take-home this line was solved for, and the breakdown shown.
  targetNet    Decimal?           @db.Decimal(12, 2)
  grossUp      Json?
  createdById  String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  associate  Associate  @relation(fields: [associateId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("PayrollRunAddOnCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([payrollRunId])
  @@index([associateId])
  @@index([tenantId])
}

// Tier-1 — the paper-check register. checkNumber is a global SERIAL so
// numbers are strictly increasing across runs (what a physical checkbook
// does). Items paid by check reference their entry here; the register PDF
// for a run is rendered from these rows.
model PayCheck {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkNumber       Int         @default(dbgenerated())
  /// One live (unvoided) check per paycheck — a partial unique index in the migration.
  payrollItemId     String      @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId          String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  payeeName         String
  amount            Decimal     @db.Decimal(12, 2)
  memo              String?
  issuedAt          DateTime    @default(now()) @db.Timestamptz(6)
  voidedAt          DateTime?   @db.Timestamptz(6)
  /// The mailing address printed in the envelope window, as it was when the check was issued.
  payeeAddress      Json?
  printedAt         DateTime?   @db.Timestamptz(6)
  printedById       String?     @db.Uuid
  printCount        Int         @default(0)
  voidReason        String?     @db.VarChar(500)
  voidedById        String?     @db.Uuid
  /// The voided check this one replaces.
  reissuedFromId    String?     @db.Uuid
  stopPaymentAt     DateTime?   @db.Timestamptz(6)
  stopPaymentById   String?     @db.Uuid
  stopPaymentReason String?     @db.VarChar(500)
  stopPaymentRef    String?     @db.VarChar(80)
  /// Sent to the bank's positive-pay file as issued / as void.
  positivePayAt     DateTime?   @db.Timestamptz(6)
  positivePayVoidAt DateTime?   @db.Timestamptz(6)
  payrollItem       PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@unique([tenantId, checkNumber])
  @@index([tenantId])
  @@index([payrollItemId])
}

/// "Pay this paycheck by paper check this time" — payroll's decision, or an associate's request payroll approved.
model PayrollItemPayoutOverride {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  payrollItemId     String      @unique @db.Uuid
  /// CHECK
  method            String      @default("CHECK") @db.VarChar(10)
  reason            String      @db.VarChar(500)
  /// PAYROLL | ASSOCIATE
  source            String      @default("PAYROLL") @db.VarChar(12)
  requestedById     String?     @db.Uuid
  approvalRequestId String?     @db.Uuid
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)
  clearedAt         DateTime?   @db.Timestamptz(6)
  clearedById       String?     @db.Uuid
  clearReason       String?     @db.VarChar(500)
  payrollItem       PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// How this tenant's paper checks print: the account they're drawn on, calibration, signature.
model CheckSettings {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  /// The EmployerBankAccount checks are drawn on (its routing / account print in the MICR line).
  bankAccountId         String?  @db.Uuid
  bankName              String?  @db.VarChar(120)
  bankAddress           String?  @db.VarChar(200)
  /// The ABA fraction printed top right, e.g. "63-1234/631".
  fractionalRouting     String?  @db.VarChar(20)
  /// Printer calibration: shifts everything by this many points (±36).
  offsetXPt             Float    @default(0)
  offsetYPt             Float    @default(0)
  signatureImage        Bytes?
  signatureContentType  String?  @db.VarChar(40)
  signatureSignerName   String?  @db.VarChar(120)
  /// Checks above this need two signatures (the facsimile never prints on them).
  twoSignatureOverCents BigInt?
  voidAfterDays         Int      @default(90)
  updatedById           String?  @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)
}

// Wave 1.2 — One row per earning line on a paystub. The sum of all
// `amount` rows for a PayrollItem equals its grossPay (re-aggregation
// invariant). Hours/rate are nullable because non-hourly earnings (BONUS,
// REIMBURSEMENT, TIPS) are flat amounts. REIMBURSEMENT is non-taxable —
// we still surface it on the stub but it doesn't roll into taxable wages
// (the run-creation code excludes it from the FIT/FICA/Medicare base).
model PayrollItemEarning {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollItemId String             @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind          PayrollEarningKind
  hours         Decimal?           @db.Decimal(8, 2)
  rate          Decimal?           @db.Decimal(8, 2)
  amount        Decimal            @db.Decimal(12, 2)
  // True for REIMBURSEMENT and any future fringe benefits we surface as
  // non-taxable. The run aggregator excludes these from taxable wages.
  isTaxable     Boolean            @default(true)
  notes         String?
  payrollItem   PayrollItem        @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)

  @@index([payrollItemId])
  @@index([tenantId])
}

// Gap 3 — Overpayment clawback queue. When an AMENDMENT run finalizes with
// a negative-net item (HR is taking back money that was overpaid), we don't
// touch the rail — instead we enqueue a row here. The next REGULAR run for
// the same associate drains open rows and applies them as a post-tax
// deduction line. If the associate's net pay is too small to absorb the
// full amount, the consumer marks this row applied and inserts a residual
// row so the remainder rolls forward until fully recovered.
model PendingPayrollDeduction {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId           String       @db.Uuid
  // The AMENDMENT PayrollItem that created this pending deduction. Lets
  // the associate-facing copy explain "this $X comes from your amended
  // pay for period {original}".
  sourceAmendmentItemId String       @db.Uuid
  // Always positive — magnitude to deduct. Original signed delta on the
  // amendment item is negative (overpayment clawback), but we store the
  // absolute value here for readability and CHECK > 0 enforcement.
  amount                Decimal      @db.Decimal(12, 2)
  // Wizard-supplied explanation; surfaces verbatim on the deduction line
  // ("Correction for missed-clock punch on 2026-04-29").
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId              String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  note                  String
  // Set when this row is consumed by a regular run. Until then, the
  // partial index `(associateId) WHERE appliedRunId IS NULL` keeps the
  // open-deductions query fast.
  appliedRunId          String?      @db.Uuid
  appliedItemId         String?      @db.Uuid
  appliedAt             DateTime?    @db.Timestamptz(6)
  associate             Associate    @relation(fields: [associateId], references: [id], onDelete: Restrict)
  sourceAmendmentItem   PayrollItem  @relation("PendingDeductionSource", fields: [sourceAmendmentItemId], references: [id], onDelete: Restrict)
  appliedRun            PayrollRun?  @relation("PendingDeductionAppliedRun", fields: [appliedRunId], references: [id], onDelete: SetNull)
  appliedItem           PayrollItem? @relation("PendingDeductionAppliedItem", fields: [appliedItemId], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(6)

  // No @@index([associateId]) here — the migration creates a partial
  // index `WHERE appliedRunId IS NULL` instead, which Prisma can't yet
  // express in schema. The full B-tree would be redundant.
  @@index([sourceAmendmentItemId])
  @@index([tenantId])
}

// Phase 22 — disbursement attempt log. One row per provider call, regardless
// of outcome. Lets finance reconstruct "who got paid when, by which provider,
// for which run" without trusting that PayrollItem.disbursementRef is
// authoritative (it isn't — retries overwrite it).
model PayrollDisbursementAttempt {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollItemId String      @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  provider      String
  status        String // SUCCESS | PENDING | FAILED (mirrors DisbursementResult.status)
  externalRef   String?
  failureReason String?
  attemptedAt   DateTime    @default(now()) @db.Timestamptz(6)
  attemptedById String?     @db.Uuid
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  attemptedBy   User?       @relation("PayrollDisbursementAttemptActor", fields: [attemptedById], references: [id], onDelete: SetNull)

  @@index([payrollItemId, attemptedAt])
  @@index([status])
  @@index([tenantId])
  @@index([externalRef])
}

// Retroactive pay. A compensation record dated into a period that was
// already paid owes the person the difference on every hour paid at the
// old rate since the effective date. lib/retroPay.ts finds those pairs
// (comp record × paid item), the aggregator adds one RETRO earning per
// person on the next regular run, and this row keeps the arithmetic and
// the fact that it was settled — so a pair is never paid twice.
enum RetroPayStatus {
  PENDING
  PAID
}

model RetroPayAdjustment {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to.
  tenantId             String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId          String         @db.Uuid
  compensationRecordId String         @db.Uuid
  sourcePayrollItemId  String         @db.Uuid
  // Hours paid at the old rate on or after the effective date, split as the
  // source item split them (overtime carries the 1.5x on the delta).
  regularHours         Decimal        @db.Decimal(8, 2)
  overtimeHours        Decimal        @default(0) @db.Decimal(8, 2)
  oldRate              Decimal        @db.Decimal(8, 2)
  newRate              Decimal        @db.Decimal(8, 2)
  amount               Decimal        @db.Decimal(12, 2)
  status               RetroPayStatus @default(PENDING)
  paidRunId            String?        @db.Uuid
  paidItemId           String?        @db.Uuid
  paidAt               DateTime?      @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)

  associate          Associate          @relation(fields: [associateId], references: [id], onDelete: Cascade)
  compensationRecord CompensationRecord @relation(fields: [compensationRecordId], references: [id], onDelete: Cascade)
  sourceItem         PayrollItem        @relation("RetroSourceItem", fields: [sourcePayrollItemId], references: [id], onDelete: Cascade)
  paidRun            PayrollRun?        @relation(fields: [paidRunId], references: [id], onDelete: SetNull)
  paidItem           PayrollItem?       @relation("RetroPaidItem", fields: [paidItemId], references: [id], onDelete: SetNull)

  @@unique([compensationRecordId, sourcePayrollItemId])
  @@index([associateId, status])
  @@index([paidRunId])
  @@index([tenantId])
}

// Earned-wage access. An associate draws part of what they have already
// earned this period before payday; it goes out on the normal payout rail
// and comes back as a post-tax deduction on the next regular check
// (lib/earnedWage.ts). The cap, fee and per-period limit are OrgSetting.
enum EarnedWageAdvanceStatus {
  REQUESTED
  PAID
  FAILED
  RECOVERED
  CANCELLED
}

model EarnedWageAdvance {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to.
  tenantId        String                  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId     String                  @db.Uuid
  // The pay period the advance draws on; recovery happens on its run.
  periodStart     DateTime                @db.Date
  periodEnd       DateTime                @db.Date
  amountCents     Int
  feeCents        Int                     @default(0)
  // What the person had earned (estimated net) and could draw when they asked.
  earnedNetCents  Int
  availableCents  Int
  status          EarnedWageAdvanceStatus @default(REQUESTED)
  provider        String?
  disbursementRef String?
  failureReason   String?
  requestedAt     DateTime                @default(now()) @db.Timestamptz(6)
  paidAt          DateTime?               @db.Timestamptz(6)
  // Recovery: the run/item that took it back, and how much so far (a thin
  // check recovers part and the rest rolls to the next one).
  recoveredCents  Int                     @default(0)
  // [{runId, cents}] — what each run took, so re-aggregating a draft can
  // give back exactly its own share.
  recoveryLog     Json                    @default("[]")
  recoveredRunId  String?                 @db.Uuid
  recoveredItemId String?                 @db.Uuid
  recoveredAt     DateTime?               @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)

  associate     Associate    @relation(fields: [associateId], references: [id], onDelete: Cascade)
  recoveredRun  PayrollRun?  @relation(fields: [recoveredRunId], references: [id], onDelete: SetNull)
  recoveredItem PayrollItem? @relation("EwaRecoveredItem", fields: [recoveredItemId], references: [id], onDelete: SetNull)

  @@index([associateId, status])
  @@index([status, requestedAt])
  @@index([tenantId])
}

// Wave 1.1 — Pay schedules. A named cadence + anchor date that drives the
// payroll run wizard's "next period to run" computation. Mirrors QuickBooks
// Online Payroll's "Pay schedules" concept: clients have one or more (e.g.
// "Hourly biweekly" + "Salaried monthly") and each Associate is assigned to
// exactly one. clientId is nullable so Alto can define org-wide defaults.
//
// anchorDate is the reference point for cadence math:
//   WEEKLY      → period = Mon..Sun of the week containing anchorDate
//                 (subsequent periods = +7d each)
//   BIWEEKLY    → period = anchorDate..anchorDate+13d (subsequent = +14d)
//   SEMIMONTHLY → periods = 1st..15th and 16th..end-of-month every month
//                 (anchorDate's month determines first period)
//   MONTHLY     → period = 1st..last-day of anchorDate's month, then +1mo
//
// payDateOffsetDays = days after periodEnd that funds disburse (default 5
// = "pay on Friday for a Mon..Sun period"). Used by the wizard to display
// "next pay date" and to schedule QBO journal-entry post date.
model PayrollSchedule {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String?          @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId          String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name              String
  frequency         PayrollFrequency
  anchorDate        DateTime         @db.Date
  // Days from periodEnd to actual pay date. Most US employers use 3–7 days
  // (Friday-after-Sun cutoff = 5). Allow 0 if a client cuts cheques same-day.
  payDateOffsetDays Int              @default(5)
  isActive          Boolean          @default(true)
  /// The company default: anyone no rule covers lands here (at most one per tenant).
  isDefault         Boolean          @default(false)
  notes             String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?        @db.Timestamptz(6)

  client      Client?                     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  associates  Associate[]
  rules       PayrollScheduleRule[]
  assignments PayrollScheduleAssignment[]
  versions    PayrollScheduleVersion[]
  runs        PayrollRun[]

  @@index([clientId, isActive])
  @@index([deletedAt])
  @@index([tenantId])
}

model Candidate {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  firstName            String
  lastName             String
  email                String
  phone                String?
  position             String?
  source               String? // referral, indeed, careers-page, etc.
  stage                CandidateStage @default(APPLIED)
  /// The candidate's own page: only the sha256 of the link's token is kept,
  /// like every other emailed token; the link is rotated on every send.
  portalTokenHash      String?        @unique @db.VarChar(64)
  portalTokenExpiresAt DateTime?      @db.Timestamptz(6)
  portalLastSeenAt     DateTime?      @db.Timestamptz(6)
  notes                String?
  // External-careers applicants paste links rather than uploading files
  // (Railway filesystem is ephemeral; direct upload waits for the S3/Volume
  // migration). Both fields are optional and free-form.
  resumeUrl            String?
  linkedinUrl          String?
  // When HIRED, populated with the new Associate's id (and clientId).
  hiredAssociateId     String?        @unique @db.Uuid
  hiredClientId        String?        @db.Uuid
  hiredAt              DateTime?      @db.Timestamptz(6)
  rejectedReason       String?
  withdrawnReason      String?
  // When the candidate entered their current stage. "Days in stage" and
  // the stuck-candidate alerts read this; createdAt only says how long
  // ago they applied.
  stageChangedAt       DateTime       @default(now()) @db.Timestamptz(6)
  /// The posting they applied to or are being hired against — what a hire
  /// fills, for time-to-fill and each client's fill rate.
  jobPostingId         String?        @db.Uuid
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?      @db.Timestamptz(6)

  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  // Phase 90 — recruiting back-relations.
  interviews       Interview[]
  offers           Offer[]
  referrals        Referral[]
  events           CandidateEvent[]
  submittals       CandidateSubmittal[]
  documentRequests CandidateDocumentRequest[]
  eeoSelfId        EeoSelfIdentification?

  @@index([stage])
  @@index([deletedAt])
  @@index([jobPostingId])
  @@index([createdAt])
  @@index([stage, stageChangedAt])
  @@unique([tenantId, email])
  @@index([tenantId])
}

/// What happened to a candidate, and when, and who did it — the
/// candidate's timeline. Stage moves are what time-to-hire and funnel
/// conversion are computed from; notes and interview / offer steps are
/// the recruiter's working record. The AuditLog carries the same actions
/// for compliance; this is the product surface.
enum CandidateEventKind {
  CREATED
  APPLIED_AGAIN
  EDITED
  STAGE_CHANGED
  NOTE
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_SCORED
  INTERVIEW_CANCELLED
  OFFER_CREATED
  OFFER_APPROVAL_REQUESTED
  OFFER_APPROVED
  OFFER_APPROVAL_DECLINED
  OFFER_SENT
  OFFER_DECIDED
  SUBMITTED_TO_CLIENT
  CLIENT_FEEDBACK
  HIRED
  /// A hire taken back before the person started.
  HIRE_UNDONE
  /// Taken off the pipeline (a duplicate, a test, spam) — restorable.
  REMOVED
  RESTORED
  /// The candidate's own page (routes/candidatePortal): the link went out,
  /// they confirmed an interview, a document was asked for, arrived, or was reviewed.
  PORTAL_LINK_SENT
  INTERVIEW_CONFIRMED
  DOCUMENT_REQUESTED
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
}

enum CandidateSubmittalStatus {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

/// A candidate put in front of a client for review — the client's store
/// manager says yes or no, with a word on why, from their portal.
enum JobPostingSchedule {
  FULL_TIME
  PART_TIME
  TEMPORARY
  SEASONAL
}

enum JobPayUnit {
  HOUR
  YEAR
}

/// A named set of filters on a list — "Stuck in screening", "Walmart
/// cashiers" — kept by its owner, or shared with everyone who can see
/// that list.
model SavedView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String   @db.Uuid
  /// Which list it filters, e.g. "recruiting.candidates".
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  scope     String
  name      String
  /// The list's own filter params, as it puts them in its URL.
  query     Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  owner User @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([scope, ownerId])
  @@index([scope, shared])
  @@index([tenantId])
}

/// What a recruiting source cost in a month — job-board fees, sponsored
/// posts, agency invoices, referral bonuses — for cost per hire by source.
model RecruitingSourceSpend {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The Candidate.source key it pays for ("indeed", "referral", …).
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  source      String
  /// The first of the month it was spent in.
  month       DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  updatedById String?  @db.Uuid
