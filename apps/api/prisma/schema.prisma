  @@unique([tenantId, positionKey])
  @@index([tenantId])
}

model ShiftPosition {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String?   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name      String
  // Controls dropdown order so it isn't alphabetical chaos.
  sortOrder Int       @default(0)
  // Supervisor/lead position (e.g. "Shift Lead") — drives the labor-cost
  // report's lead-vs-associate headcount and cost split. Position-based on
  // purpose: the position carries the pay rate, so the split can't drift
  // from what the person is actually scheduled (and paid) as.
  isLead    Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, deletedAt])
  @@index([tenantId])
}

model JobProfile {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String?   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId             String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  code                 String
  title                String
  /// W-2 Box 14b: the Treasury Tipped Occupation Code for this job (OBBBA, TY2026+).
  tippedOccupationCode String?   @db.VarChar(4)
  family               String?
  level                String?
  // FLSA exemption flag — exempt salaried employees aren't entitled to
  // overtime under federal rules; surfaced in payroll OT calc later.
  isExempt             Boolean   @default(false)
  description          String?
  // Phase 88 — Workers' Comp NCCI / state-specific class code lookup.
  wcClassCode          String?   @db.VarChar(10)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime? @db.Timestamptz(6)

  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  associates   Associate[]
  positions    Position[]
  compBands    CompBand[]
  // Phase 126 — career-ladder rungs that point at this profile.
  careerLevels CareerLevel[]

  @@index([clientId, family])
  @@index([clientId, deletedAt])
  @@index([tenantId])
}

// ===== Phase 78 — Position ================================================
//
// A seat in the org. May be vacant or filled. Headcount budgeting,
// requisition-driven hiring, and attrition reporting all operate on
// Position, not Associate.
model Position {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId              String?        @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId              String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  code                  String
  title                 String
  jobProfileId          String?        @db.Uuid
  departmentId          String?        @db.Uuid
  costCenterId          String?        @db.Uuid
  orgUnitId             String?        @db.Uuid
  managerAssociateId    String?        @db.Uuid
  fteAuthorized         Decimal        @default(1.00) @db.Decimal(4, 2)
  status                PositionStatus @default(PLANNED)
  filledByAssociateId   String?        @db.Uuid
  filledAt              DateTime?      @db.Timestamptz(6)
  targetStartDate       DateTime?      @db.Date
  minHourlyRate         Decimal?       @db.Decimal(8, 2)
  maxHourlyRate         Decimal?       @db.Decimal(8, 2)
  /// Headcount plan (HR pack 2026-10): the money set aside for this seat, per period.
  budgetAmount          Decimal?       @db.Decimal(12, 2)
  /// 'ANNUAL' | 'MONTHLY' — validated at the API.
  budgetPeriod          String?        @db.VarChar(16)
  /// Approval engine: the requisition that must be approved before this seat opens.
  requisitionApprovalId String?        @db.Uuid
  notes                 String?
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?      @db.Timestamptz(6)

  client         Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobProfile     JobProfile?           @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  department     Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenter     CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  orgUnit        OrgUnit?              @relation("OrgUnitPositions", fields: [orgUnitId], references: [id], onDelete: SetNull)
  manager        Associate?            @relation("PositionManager", fields: [managerAssociateId], references: [id], onDelete: SetNull)
  filledBy       Associate?            @relation("PositionFilledBy", fields: [filledByAssociateId], references: [id], onDelete: SetNull)
  // Phase 115 — designated successors.
  successionPlan SuccessionCandidate[]

  @@index([clientId, status])
  @@index([filledByAssociateId])
  @@index([departmentId])
  @@index([costCenterId])
  @@index([managerAssociateId])
  @@index([deletedAt])
  @@index([tenantId])
}

// ===== Phase 77 — Effective-dated AssociateHistory ========================
//
// One row per change to any tracked field. Each row is the snapshot
// from effectiveFrom until effectiveTo (NULL = current). The current row
// mirrors Associate's denormalized current values; this table is the
// audit + as-of source of truth.
model AssociateHistory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId   String    @db.Uuid
  effectiveFrom DateTime  @db.Timestamptz(6)
  effectiveTo   DateTime? @db.Timestamptz(6)
  managerId     String?   @db.Uuid
  departmentId  String?   @db.Uuid
  costCenterId  String?   @db.Uuid
  jobProfileId  String?   @db.Uuid
  state         String?   @db.VarChar(2)
  hourlyRate    Decimal?  @db.Decimal(8, 2)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  reason        String?
  actorUserId   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AssociateHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([associateId, effectiveFrom(sort: Desc)])
  @@index([tenantId])
}

// ===== Phase 80 — Workflow engine =========================================

enum WorkflowTrigger {
  ASSOCIATE_HIRED
  ASSOCIATE_TERMINATED
  TIME_OFF_REQUESTED
  TIME_OFF_APPROVED
  TIME_OFF_DENIED
  POSITION_OPENED
  POSITION_FILLED
  PAYROLL_FINALIZED
  ONBOARDING_COMPLETED
  COMPLIANCE_EXPIRING
}

enum WorkflowActionKind {
  SEND_NOTIFICATION
  SET_FIELD
  ASSIGN_TASK
  CREATE_AUDIT_LOG
  WEBHOOK
  /// Approval engine (2026-10): the run pauses here until the named person or role decides.
  REQUIRE_APPROVAL
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  /// Paused on a REQUIRE_APPROVAL step.
  WAITING
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  /// A REQUIRE_APPROVAL step with its decision still open.
  WAITING
}

// ===== Approval engine (2026-10) ==========================================
//
// One record for every change that needs a second person before it lands:
// a pay-rate change over the threshold, a bill-rate change, completing a
// separation, a promotion, a requisition, a role elevation, a self-service
// change the tenant chose to gate, and a workflow's REQUIRE_APPROVAL step.
// The proposed change is kept whole; on approval the engine applies it
// (lib/approvalRequests applyApproved) under the decider's name, so the
// maker and the checker are always two different people on the record.
enum ApprovalRequestKind {
  PAY_RATE_CHANGE
  BILL_RATE_CHANGE
  SEPARATION_COMPLETE
  SELF_SERVICE_CHANGE
  PROMOTION
  REQUISITION
  ROLE_CHANGE
  WORKFLOW_GATE
  LABOR_RULES_LIVE
  PAYROLL_FUNDING_LIMIT
  TAX_PAYMENT
  DAILY_PAY_POLICY
  BILLING_ADJUSTMENT
  GARNISHMENT_PAYEE_BANK
  PAY_BY_CHECK
  BILL_APPROVAL
  VENDOR_BANK
  PERIOD_REOPEN
  /// One second-person approval for a mass pay change (finance walk 13, POST /compensation/batch).
  PAY_RATE_BATCH
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind               ApprovalRequestKind
  status             ApprovalRequestStatus @default(PENDING)
  /// What the request is about: "Associate", "Position", "User", "Separation", "ShiftRateDefault", "WorkflowRun".
  subjectType        String                @db.VarChar(60)
  subjectId          String                @db.Uuid
  /// One sentence a decider reads first.
  title              String                @db.VarChar(200)
  summary            String?               @db.VarChar(2000)
  /// The change exactly as it will be applied, and what it replaces.
  proposed           Json
  before             Json?
  requesterUserId    String?               @db.Uuid
  /// The rule that names the decider: a capability (any holder other than the requester), a person, or a role.
  approverCapability String?               @db.VarChar(60)
  approverUserId     String?               @db.Uuid
  approverRole       Role?
  clientId           String?               @db.Uuid
  associateId        String?               @db.Uuid
