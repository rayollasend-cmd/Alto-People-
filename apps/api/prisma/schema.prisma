}

// Org-enforced MFA policy (OrgSetting.mfaRequirement). OFF = opt-in only,
// ADMINS = every admin-class role (see isMfaAdminRole in packages/shared)
// must have TOTP enrolled to sign in with a password, ALL = every human
// role. Passkey sign-in counts as strong auth and is exempt.
enum MfaRequirement {
  OFF
  ADMINS
  ALL
}

/// Access pack: how a channel reaches a person — as it happens, or batched.
enum DeliveryMode {
  REALTIME
  DIGEST
}

enum AccessCertificationScope {
  ALL
  INTERNAL
  CLIENT
  ASSOCIATE
}

enum AccessCertificationStatus {
  OPEN
  CLOSED
}

enum AccessCertificationDecision {
  KEEP
  REVOKE
  CHANGE
}

enum OnboardingTrack {
  STANDARD
  J1
  CLIENT_SPECIFIC
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  /// Called off by us — sent by mistake, a hire undone, or an invite that
  /// expired unanswered. Not a decision about the person: no "declined"
  /// email goes out, and their link stops working.
  CANCELLED
}

enum TaskKind {
  PROFILE_INFO
  DOCUMENT_UPLOAD
  E_SIGN
  BACKGROUND_CHECK
  W4
  DIRECT_DEPOSIT
  POLICY_ACK
  J1_DOCS
  I9_VERIFICATION
  // Live headshot taken in the onboarding flow (camera-only for the
  // associate; HR can set one from the People drawer as the escape hatch).
  PROFILE_PHOTO
  // WOTC pre-screening (IRS Form 8850 + ETA 9061 applicant questions).
  // Voluntary for the applicant: "prefer not to answer" completes it.
  WOTC_SCREENING
  // When they can work, with presets (role walk supervisor 11): a new hire
  // used to default to "fully unavailable" and never got asked.
  AVAILABILITY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum DocumentKind {
  ID
  SSN_CARD
  I9_SUPPORTING
  W4_PDF
  OFFER_LETTER
  POLICY
  HOUSING_AGREEMENT
  TRANSPORT_AGREEMENT
  J1_DS2019
  J1_VISA
  // Phase 19 — server-rendered signed agreement PDF (typed-name e-sign).
  SIGNED_AGREEMENT
  // HR-uploaded result PDFs from external providers (Checkr, drug-test
  // lab, E-Verify). The associate-facing tasks collect the info; HR runs
  // the check externally and uploads the result here so everything lives
  // under one auditable Documents tab on the profile.
  BACKGROUND_CHECK_RESULT
  DRUG_TEST_RESULT
  I9_VERIFICATION_RESULT
  // 2026-08 — evidence of an externally-processed payment (paystub, cleared
  // check, processor report) attached to an ExternalPayment pay period.
  PAYSTUB
  OTHER
}

// Which federal I-9 list a document satisfies. A = identity AND work
// authorization (sufficient alone); B = identity only; C = work
// authorization only (B must pair with C). NULL on non-I-9 documents and
// on everything uploaded before the catalog existed — legacy uploads are
// never reclassified or invalidated.
enum I9DocList {
  A
  B
  C
}

// Which face of a card a file shows. NULL = single-sided/unknown (legacy
// uploads keep the old filename-based inference as a fallback).
enum DocSide {
  FRONT
  BACK
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED
}

enum BgCheckStatus {
  INITIATED
  IN_PROGRESS
  PASSED
  FAILED
  NEEDS_REVIEW
  /// Consent recorded, no screening provider connected — the check never ran (audit 2026-10-21 #3).
  NOT_RUN
}

// Same lifecycle as BgCheckStatus, separate type: the two ledgers evolve
// independently (e.g. MRO-review states are drug-specific).
enum DrugTestStatus {
  INITIATED
  IN_PROGRESS
  PASSED
  FAILED
  NEEDS_REVIEW
}

// Phase add-on — Walmart Contract Compliance Scorecard. Tags Course rows
// so the scorecard's training-completeness tile can count completions per
// regulatory category (EEO/harassment, OSHA safety, Walmart CADE, food
// handler) without scanning free-text titles.
enum ComplianceTag {
  EEO_HARASSMENT
  OSHA_SAFETY
  WALMART_CADE
  FOOD_HANDLER
}

// Phase add-on — E-Verify case state from the federal portal. HR records
// the case number + outcome after submitting Section 2 docs through the
// E-Verify website. PENDING covers cases that haven't returned a final
// status yet (TNC review window).
enum EVerifyStatus {
  PENDING
  EMPLOYMENT_AUTHORIZED
  TENTATIVE_NONCONFIRMATION
  FINAL_NONCONFIRMATION
  CLOSE_CASE_AND_RESUBMIT
}

enum PayoutType {
  BANK_ACCOUNT
  BRANCH_CARD
}

enum W4FilingStatus {
  SINGLE
  MARRIED_FILING_JOINTLY
  HEAD_OF_HOUSEHOLD
}

// Phase 41 — distinguishes W-2 employees (subject to W-4, FICA, Medicare,
// FUTA/SUTA, federal/state withholding) from 1099 contractors (paid gross,
// no withholding, no employer-side payroll tax). Drives onboarding
// checklist (1099s skip W-4) and payroll computation (1099 line items
// have all tax fields zeroed; gross == net).
enum EmploymentType {
  W2_EMPLOYEE
  CONTRACTOR_1099_INDIVIDUAL
  CONTRACTOR_1099_BUSINESS
}

enum I9DocumentList {
  LIST_A
  LIST_B_AND_C
}

// USCIS Form I-9 Section 1 citizenship attestation. The employee picks
// exactly one — Phase 20 self-attest endpoint enforces that.
enum I9CitizenshipStatus {
  US_CITIZEN
  NON_CITIZEN_NATIONAL
  LAWFUL_PERMANENT_RESIDENT
  ALIEN_AUTHORIZED_TO_WORK
}

enum TimeEntryStatus {
  ACTIVE // clocked in, not yet out
  COMPLETED // clocked out, awaiting review
  APPROVED // HR/Ops approved for payroll
  REJECTED // HR/Ops rejected (associate must edit + resubmit)
}

enum ShiftStatus {
  DRAFT // HR scratch pad, not yet open for assignment
  OPEN // published, no one assigned
  ASSIGNED // associate accepted (or HR assigned)
  COMPLETED // worked
  CANCELLED // pulled
}

enum PayrollRunStatus {
  DRAFT // newly created, items aggregated, can be edited
  FINALIZED // locked for review, ready to disburse
  DISBURSED // funds sent (real or stubbed)
  CANCELLED // voided after disbursement (Gap 3)
}

// Gap 3 — distinguishes regular periodic runs from off-cycle bonus/terminal-pay
// runs and from amendment runs that correct a prior disbursed run.
enum PayrollRunKind {
  REGULAR
  OFF_CYCLE
  AMENDMENT
  DAILY // PAYEXP: a daily settlement (paid ahead, reconciled on the regular check)
  MANUAL // PAYEXP: a handwritten / manual check recorded into payroll history
}

enum PayrollItemStatus {
  PENDING // computed, not yet sent
  DISBURSED // sent (with disbursementRef)
  FAILED // disbursement attempt failed
  HELD // HR put a hold on this single item
  VOIDED // Gap 3 — set when the parent run is voided
}

// Wave 1.1 — Pay schedule cadence. Mirrors QuickBooks Online Payroll's four
// frequencies. Drives the run wizard's "next period" computation, the federal
// weekly OT split (>40h = 1.5x is week-bounded), and tax annualization
// multipliers (52 / 26 / 24 / 12) used by IRS Pub 15-T.
enum PayrollFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  DAILY // PAYEXP: paid each day; a weekly true-up settles overtime and deductions
}

// Wave 1.2 — Earning line types on a paystub. Mirrors QuickBooks Online
// Payroll's "earnings" picker: each PayrollItem may have multiple earning
// lines that sum to grossPay. REGULAR + OVERTIME are auto-split from
// approved time entries (federal weekly rule: hours over 40 in a Mon–Sun
// week pay at 1.5x). The remaining kinds are manual entries the run-wizard
// surfaces as add-on lines.
enum PayrollEarningKind {
  REGULAR
  OVERTIME
  DOUBLE_TIME
  HOLIDAY
  SICK
  VACATION
  BONUS
  COMMISSION
  TIPS
  REIMBURSEMENT
  // Retroactive pay: a rate change dated into a period already paid, settled
  // as the delta on the next regular run (lib/retroPay.ts). Regular wages.
  RETRO
  // A labor-law premium paid under a LIVE rule pack (meal, rest, rest
  // between shifts, predictability pay); the note cites the rule.
  PREMIUM
  DAILY_SETTLED // PAYEXP: what daily pay already paid this period (negative, on the true-up)
  // Non-cash taxable income: group-term life over $50,000 (IRS Pub 15-B Table I). Taxed, never paid out; W-2 Box 12 C.
  IMPUTED_INCOME
}

enum NotificationChannel {
  SMS // Twilio (Phase 12 stubbed)
  PUSH // FCM (Phase 12 stubbed)
  EMAIL // SES / Resend (Phase 12 stubbed)
  IN_APP // delivered via the web inbox; no external service
  WHATSAPP // Meta Cloud API (Brief 1C-4); receipts arrive by webhook
}

enum NotificationStatus {
  QUEUED // accepted, not yet sent
  SENT // delivered to provider (or in-app written)
  FAILED // provider returned an error
  READ // IN_APP only — recipient opened it
  BOUNCED // EMAIL only — provider reported a bounce (async via Resend webhook)
  COMPLAINED // EMAIL only — recipient marked it as spam (async via Resend webhook)
  DELIVERED // WHATSAPP — the handset took it (read is READ)
  SUPPRESSED // EMAIL only — send short-circuited because the address is on the suppression list
  NOT_CONFIGURED // SMS / PUSH — no provider is configured, so nothing left the building (never reported as SENT)
}

enum PerformanceReviewStatus {
  DRAFT // HR is still composing — not visible to associate
  SUBMITTED // visible to associate, awaiting acknowledgement
  ACKNOWLEDGED // associate has read + signed off
}

enum CandidateStage {
  APPLIED // record exists, hasn't been screened yet
  SCREENING // recruiter is reviewing
  INTERVIEW // interview scheduled / in progress
  OFFER // offer extended, awaiting response
  HIRED // accepted; converted to Associate
  WITHDRAWN // candidate pulled out
  REJECTED // we passed
}

enum BreakType {
  MEAL // 30+ min unpaid (state-dependent)
  REST // 10-15 min paid
}

enum ShiftSwapStatus {
  PENDING_PEER // sent to counterparty associate
  PEER_ACCEPTED // counterparty agreed; awaiting manager approval
  PEER_DECLINED // counterparty refused
  MANAGER_APPROVED // executed — shift assignment swapped
  MANAGER_REJECTED // manager refused after peer accepted
  CANCELLED // requester pulled it
}

// Phase 78 — Position is a seat-in-the-org concept distinct from a
// person. A Position can be planned/open/filled/frozen/closed; only
// a FILLED position has a filledByAssociateId.
enum PositionStatus {
  PLANNED
  OPEN
  FILLED
  FROZEN
  CLOSED
}

// =============================================================================
// Models
// =============================================================================

model User {
  payrollReviewsSigned   PayrollRunReview[] @relation("PayrollReviewSigner")
  /// Brief 2-4: the /v1 API clients this person is accountable for.
  ownedApiClients        ApiClient[]        @relation("ApiClientOwner")
  /// The new-business prospects this person owns (the Clients pipeline).
  ownedProspects         ClientProspect[]   @relation("ClientProspectOwner")
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String             @unique
  passwordHash           String?            @db.VarChar(255)
  /// The account's PRIMARY role — the one it falls back to and the one an
  /// administrator manages it as.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId               String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  role                   Role
  /// Brief 2-3 step 3: a custom role narrowing `role` (its archetype must
  /// equal `role`). Null = the built-in role, which is almost everyone.
  tenantRoleId           String?            @db.Uuid
  tenantRole             TenantRole?        @relation(fields: [tenantRoleId], references: [id], onDelete: SetNull)
  /// The other roles this one account may act as. A shift supervisor who
  /// also drives an Alto van holds DRIVER here rather than keeping a
  /// second login. Empty for almost every account; see
  /// additionalRoleRefusal() in shared/roles.ts for what may be combined.
  additionalRoles        Role[]             @default([])
  /// Which granted role the account is wearing right now. Null means the
  /// primary role. Always one of {role} ∪ additionalRoles — a value that
  /// is no longer granted stops applying rather than continuing to
  /// authorize anything (effectiveRoleOf fails closed to `role`).
  activeRole             Role?
  status                 UserStatus         @default(INVITED)
  tokenVersion           Int                @default(0)
  /// Preferred language for the emails Alto sends this person: en, es or tr.
  /// Null means English. Set from the app's language toggle and Settings;
  /// every associate-facing email reads it and falls back to English.
  language               String?            @db.VarChar(2)
  // SCIM 2.0 externalId passthrough — the identity provider's (Entra ID /
  // Okta) own identifier for this account. Opaque to us; stored so we can
  // echo it back on every SCIM read and the IdP can correlate resources.
  scimExternalId         String?            @db.VarChar(255)
  // Account lockout — persistent brute-force defense (complements the
  // in-memory per-email rate limiter, which resets on deploy).
  // failedLoginCount increments on every wrong-password attempt; when it
  // reaches 10 the account locks for 15 minutes via lockedUntil. Both are
  // reset on a successful password verification. Passkey (WebAuthn)
  // sign-in ignores both fields — see /auth/webauthn/login/verify.
  failedLoginCount       Int                @default(0)
  lockedUntil            DateTime?          @db.Timestamptz(6)
  // IANA timezone preference for date display in /settings, login history,
  // and (later) email templates. Nullable — when null, the UI falls back
  // to the browser's locale, the email layer falls back to UTC.
  timezone               String?            @db.VarChar(64)
  // Sidebar pins (module keys). Server-side so favorites follow the user
  // across devices — localStorage pins were wiped by the sign-out sweep
  // and by iOS storage eviction, and never synced anywhere.
  pinnedModules          String[]           @default([])
  // TOTP MFA. The secret is encrypted with AES-256-GCM keyed off
  // MFA_SECRET_ENCRYPTION_KEY (falls back to PAYOUT_ENCRYPTION_KEY in dev).
  // mfaEnabledAt is the canonical "MFA is on" flag — set only after the
  // user proves they can produce a valid 6-digit code from their app.
  // mfaSecretEncrypted may exist while mfaEnabledAt is null = enrollment
  // in flight (the user got a QR but hasn't confirmed yet).
  mfaSecretEncrypted     Bytes?             @db.ByteA
  mfaEnabledAt           DateTime?          @db.Timestamptz(6)
  associateId            String?            @unique @db.Uuid
  // Last authenticated request, stamped at most once per user per day per
  // process (lib/usageTracker) — a "who has gone quiet" read, not a
  // precise clock. Never on the request's critical path.
  lastSeenAt             DateTime?          @db.Timestamptz(6)
  clientId               String?            @db.Uuid
  // Store scope for CLIENT_PORTAL accounts: a store manager is ONE
  // Location under the client; null = the whole client (a market or
  // district manager sees every store rolled up). Must belong to
  // clientId — the users PATCH validates that and clears it whenever the
  // client changes.
  locationId             String?            @db.Uuid
  // Region scope for a CLIENT_PORTAL account with NO client: the command
  // center for every store in the region (Manager, Business Operations
  // Support). Mutually exclusive with clientId.
  regionId               String?            @db.Uuid
  /// Brief 2-1b step 5: permission scope at any level of the organizational tree.
  orgUnitId              String?            @db.Uuid
  // The name an invite addressed (portal accounts carry no associate).
  displayName            String?            @db.VarChar(120)
  // Profile photo for a login with no associate record (HR, recruiters,
  // managers). An associate-linked login keeps theirs on the Associate;
  // lib/profilePhotoUrl.accountPhotoUrlFor picks whichever is on file.
  photoS3Key             String?
  photoUpdatedAt         DateTime?          @db.Timestamptz(6)
  /// Brief 1A-4: a deactivation is reversible for 30 days (purgeAfter =
  /// the day the sweep soft-deletes the account); Region scope on a
  /// portal account carries the named approver.
  deactivatedAt          DateTime?          @db.Timestamptz(6)
  deactivationReason     String?            @db.VarChar(300)
  deactivatedById        String?            @db.Uuid
  purgeAfter             DateTime?          @db.Timestamptz(6)
  regionApprovedById     String?            @db.Uuid
  regionApprovedAt       DateTime?          @db.Timestamptz(6)
  /// Access pack: an INTERNAL role narrowed to these sites and/or regions
  /// (a regional Ops lead, a site HR admin). Empty = the whole tenant, as
  /// before. Lists, counts and writes clamp through lib/scope (internalBounds).
  /// A binding carries a named approver, like a region binding does.
  scopeSiteIds           String[]           @default([])
  scopeRegionIds         String[]           @default([])
  /// Org chart: who this staff account reports to (an associate's manager is Associate.managerId).
  reportsToUserId        String?            @db.Uuid
  reportsTo              User?              @relation("UserReportsTo", fields: [reportsToUserId], references: [id], onDelete: SetNull)
  directReportUsers      User[]             @relation("UserReportsTo")
  scopeApprovedById      String?            @db.Uuid
  scopeApprovedAt        DateTime?          @db.Timestamptz(6)
  /// Access pack: a break-glass owner may sign in with password + two-step
  /// while the tenant requires its SSO (an IdP outage must not lock every
  /// admin out). Every use is a critical audit row and a security alert.
  breakGlass             Boolean            @default(false)
  breakGlassApprovedById String?            @db.Uuid
  breakGlassApprovedAt   DateTime?          @db.Timestamptz(6)
  /// Access pack: quiet hours (minutes from local midnight, in the account's
  /// time zone) and how each channel reaches them — now, or in a digest.
  quietHoursStart        Int?
  quietHoursEnd          Int?
  deliveryEmail          DeliveryMode       @default(REALTIME)
  deliveryPush           DeliveryMode       @default(REALTIME)
  deliverySms            DeliveryMode       @default(REALTIME)
  associate              Associate?         @relation(fields: [associateId], references: [id], onDelete: SetNull)
  delegationsGiven       TeamDelegation[]   @relation("DelegationFrom")
  delegationsReceived    TeamDelegation[]   @relation("DelegationTo")
  client                 Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// The client accounts this person owns (Client.accountOwnerUserId).
  ownedClientAccounts    Client[]           @relation("ClientAccountOwner")
  location               Site?              @relation("UserStoreScope", fields: [locationId], references: [id], onDelete: SetNull)
  region                 Region?            @relation("UserRegionScope", fields: [regionId], references: [id], onDelete: SetNull)
  orgUnit                OrgUnit?           @relation("UserOrgUnitScope", fields: [orgUnitId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?          @db.Timestamptz(6)

  activityDays                      UserActivityDay[]
  knownIps                          UserKnownIp[]
  signaturesGiven                   Signature[]                   @relation("UserSignatures")
  // The store shift windows a supervisor leads ("Overnight 10p–6a").
  supervisorShiftWindows            SupervisorShiftWindow[]       @relation("SupervisorWindows")
  // A FLOOR_SUPERVISOR's shift supervisor — the one in charge of them.
  // Only ever a SHIFT_SUPERVISOR at the same client; a link that stops
  // meeting that (disabled, demoted, moved) reads as "no shift supervisor"
  // everywhere (lib/floorLeads validLead) and is cleared on the next edit.
  leadUserId                        String?                       @db.Uuid
  lead                              User?                         @relation("FloorLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  floorSupervisors                  User[]                        @relation("FloorLead")
  shiftCoversLed                    ShiftCover[]                  @relation("ShiftCoverLead")
  shiftCoversTaken                  ShiftCover[]                  @relation("ShiftCoverCover")
  shiftCoversCreated                ShiftCover[]                  @relation("ShiftCoverCreator")
  opsShiftsCoveredFor               OpsShift[]                    @relation("OpsShiftCoveredFor")
  // Transportation — the Alto vans.
  rideRunsDriven                    RideRun[]                     @relation("RideRunDriver")
  transportIssuesReported           TransportIssue[]              @relation("TransportIssueReporter")
  assignedVans                      Van[]                         @relation("VanDriver")
  rideRejections                    RideRejection[]               @relation("RideRejectionDriver")
  driverClientAccess                DriverClientAccess[]          @relation("DriverAccessDriver")
  driverAccessDecided               DriverClientAccess[]          @relation("DriverAccessDecider")
  driverProfile                     DriverProfile?                @relation("DriverProfileUser")
  preTripChecks                     PreTripCheck[]                @relation("PreTripDriver")
  transportIncidentsReported        TransportIncident[]           @relation("TransportIncidentReporter")
  i9VerificationsAsRep              I9Verification[]              @relation("I9Verifier")
  auditLogActions                   AuditLog[]                    @relation("AuditActor")
  timeApprovals                     TimeEntry[]                   @relation("TimeApprover")
  createdShifts                     Shift[]                       @relation("ShiftCreator")
  createdPayrollRuns                PayrollRun[]                  @relation("PayrollRunCreator")
  readinessRequestsMade             PayrollReadinessRequest[]     @relation("ReadinessRequestedBy")
  cancelledPayrollRuns              PayrollRun[]                  @relation("PayrollRunCanceller")
  verifiedDocuments                 DocumentRecord[]              @relation("DocumentVerifier")
  externalPaymentsCreated           ExternalPayment[]             @relation("ExternalPaymentCreator")
  sentNotifications                 Notification[]                @relation("NotificationSender")
  receivedNotifications             Notification[]                @relation("NotificationRecipient")
  authoredReviews                   PerformanceReview[]           @relation("PerformanceReviewer")
  reviewsCalibrated                 PerformanceReview[]           @relation("PerformanceReviewCalibrator")
  inviteTokens                      InviteToken[]
  // Store-ops back-relations.
  opsSopTemplatesCreated            OpsSopTemplate[]              @relation("OpsSopTemplateCreator")
  opsShiftsOpened                   OpsShift[]                    @relation("OpsShiftOpener")
  opsShiftsClosed                   OpsShift[]                    @relation("OpsShiftCloser")
  opsShiftsCancelled                OpsShift[]                    @relation("OpsShiftCanceller")
  opsTasksCompleted                 OpsTask[]                     @relation("OpsTaskCompleter")
  opsTasksCreated                   OpsTask[]                     @relation("OpsTaskCreator")
  opsPhotosUploaded                 OpsTaskPhoto[]                @relation("OpsPhotoUploader")
  opsHandoverDecisions              OpsHandoverItem[]             @relation("OpsHandoverDecider")
  passwordResetTokens               PasswordResetToken[]
  mfaRecoveryCodes                  MfaRecoveryCode[]
  webauthnCredentials               WebAuthnCredential[]
  pushSubscriptions                 PushSubscription[]
  nativeDevices                     NativeDevice[]
  nativeHandoffCodes                NativeHandoffCode[]
  notificationPreferences           NotificationPreference[]
  emailChangeRequests               EmailChangeRequest[]
  createdEsignAgreements            EsignAgreement[]              @relation("EsignAgreementCreator")
  payrollDisbursementAttempts       PayrollDisbursementAttempt[]  @relation("PayrollDisbursementAttemptActor")
  taxDepositsPaid                   TaxDeposit[]                  @relation("TaxDepositPayer")
  garnishmentRemittancesSent        GarnishmentRemittance[]       @relation("GarnishmentRemittanceSender")
  payrollRunAddOnsCreated           PayrollRunAddOn[]             @relation("PayrollRunAddOnCreator")
  approvedPayrollRuns               PayrollRun[]                  @relation("PayrollRunApprover")
  timeOffLedgerEntriesAuthored      TimeOffLedgerEntry[]
  timeOffReviews                    TimeOffRequest[]              @relation("TimeOffReviewer")
  associateHistoryEntries           AssociateHistory[]            @relation("AssociateHistoryActor")
  workflowDefinitions               WorkflowDefinition[]          @relation("WorkflowDefinitionCreator")
  reviewedLifeEvents                LifeEvent[]                   @relation("LifeEventReviewer")
  // Phase 83 — compensation back-relations.
  compRecordsActed                  CompensationRecord[]          @relation("CompRecordActor")
  meritProposalsProposed            MeritProposal[]               @relation("MeritProposalProposer")
  meritProposalsDecided             MeritProposal[]               @relation("MeritProposalDecider")
