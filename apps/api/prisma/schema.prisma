}

model OnboardingTask {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistId     String              @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind            TaskKind
  status          TaskStatus          @default(PENDING)
  title           String
  description     String?
  order           Int
  /// Days before the application's start date this task is due (null =
  /// no deadline). Snapshot from the template at instantiation.
  dueOffsetDays   Int?
  documentId      String?             @db.Uuid
  completedAt     DateTime?           @db.Timestamptz(6)
