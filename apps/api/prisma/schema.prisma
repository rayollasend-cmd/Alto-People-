  sentAt       DateTime? @db.Timestamptz(6)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  plan RetirementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@index([tenantId])
}

/// A benefits carrier that takes an EDI 834 feed (lib/edi834).
model BenefitCarrier {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name              String   @db.VarChar(120)
  receiverId        String   @db.VarChar(15)
  receiverQualifier String   @default("ZZ") @db.VarChar(2)
  senderId          String   @db.VarChar(15)
  senderQualifier   String   @default("ZZ") @db.VarChar(2)
  sponsorTaxId      String?  @db.VarChar(9)
  policyNumber      String?  @db.VarChar(50)
  /// ISA15: T (test) or P (production)
  usageIndicator    String   @default("T") @db.VarChar(1)
  /// DOWNLOAD | SFTP
  transport         String   @default("DOWNLOAD") @db.VarChar(12)
  connectionEnc     String?
  lastControlNumber Int      @default(0)
  active            Boolean  @default(true)
  /// The last look in the carrier's SFTP folder for its answers (lib/carrierAcks), and why it failed.
  ackCheckedAt      DateTime? @db.Timestamptz(6)
  ackCheckError     String?   @db.VarChar(500)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  files Edi834File[]
  acks  Edi834Ack[]

  @@index([tenantId])
}

model Edi834File {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  carrierId     String    @db.Uuid
  /// FULL | CHANGE
  mode          String    @db.VarChar(8)
  controlNumber Int
  content       String
  memberCount   Int       @default(0)
  /// GENERATED | SENT | FAILED
  status        String    @default("GENERATED") @db.VarChar(12)
  error         String?   @db.VarChar(1000)
  sentAt        DateTime? @db.Timestamptz(6)
  /// The carrier's answer (Edi834Ack): ACCEPTED | ACCEPTED_WITH_ERRORS | REJECTED | PARTIAL; null = none yet
  ackStatus     String?   @db.VarChar(24)
  ackedAt       DateTime? @db.Timestamptz(6)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  carrier BenefitCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  acks    Edi834Ack[]

  @@index([carrierId, createdAt])
  @@index([tenantId])
}

/// A carrier's answer to an enrollment file (lib/ediAck): a TA1 for the
/// interchange or a 999 for the group and its transaction sets, uploaded on
/// Carrier feeds or picked up from the carrier's SFTP folder. Matched to
/// the file by carrier + control number; one that matches nothing is kept.
model Edi834Ack {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  carrierId     String    @db.Uuid
  /// The file it answers; null when it didn't match a file we sent.
  fileId        String?   @db.Uuid
  /// TA1 | 999 | 997 | UNKNOWN (a picked-up file that wasn't an acknowledgment)
  kind          String    @db.VarChar(8)
  /// ACCEPTED | ACCEPTED_WITH_ERRORS | REJECTED | PARTIAL | UNREADABLE
  status        String    @db.VarChar(24)
  /// The control number it answers: TA101 (ISA13) or AK102 (GS06).
  controlNumber Int?
  /// The errors in plain words: [{ message, code, segment?, position?, element?, member? }]
  errors        Json      @default("[]")
  errorCount    Int       @default(0)
  /// The file as received, encrypted (an IK4 can echo a member's SSN).
  content       String
  /// UPLOAD | SFTP
  source        String    @db.VarChar(8)
  /// What makes it the same answer twice: the upload's sha256, or the SFTP file's name|size|time.
  sourceRef     String?   @db.VarChar(600)
  receivedAt    DateTime  @default(now()) @db.Timestamptz(6)
  receivedById  String?   @db.Uuid

  carrier BenefitCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  file    Edi834File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([tenantId, carrierId, sourceRef])
  @@index([carrierId, receivedAt])
  @@index([fileId])
  @@index([tenantId])
}

/// A state pay notice owed to a worker — NY Labor Law §195 (LS 54/LS 59), CA
/// Labor Code §2810.5 and the like — at hire or a rate change, and its signed
/// acknowledgment (lib/payNotices).
model WagePayNotice {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId        String    @db.Uuid
  state              String    @db.VarChar(2)
  /// NY_LS54 | NY_LS59 | CA_2810_5 | IL_WPCA | WA_PAY …
  form               String    @db.VarChar(24)
  /// HIRE | RATE_CHANGE
  trigger            String    @db.VarChar(16)
  language           String    @default("en") @db.VarChar(8)
  /// The facts the notice states (rates, pay day, employer, allowances), frozen at issue.
  facts              Json
  /// SENT | ACKNOWLEDGED
  status             String    @default("SENT") @db.VarChar(16)
  sentAt             DateTime  @default(now()) @db.Timestamptz(6)
  acknowledgedAt     DateTime? @db.Timestamptz(6)
  signedName         String?   @db.VarChar(200)
  signatureIp        String?   @db.VarChar(64)
  signatureUserAgent String?   @db.VarChar(300)
  documentHash       String?   @db.VarChar(64)
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([associateId])
}

/// One new-hire report owed per hire and reporting state (42 USC 653a), with its deadline.
model NewHireReport {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId   String    @db.Uuid
  state         String    @db.VarChar(2)
  hireDate      DateTime  @db.Date
  dueDate       DateTime  @db.Date
  /// DUE | SUBMITTED
  status        String    @default("DUE") @db.VarChar(16)
  /// FILE | PROVIDER | PORTAL
  method        String?   @db.VarChar(16)
  confirmation  String?   @db.VarChar(120)
  submittedAt   DateTime? @db.Timestamptz(6)
  submittedById String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([associateId, state, hireDate])
  @@index([tenantId, status, dueDate])
}

/// Per-client contract terms, effective-dated (BEYOND — the pay ↔ bill link).
/// retroRebill: AUTO | REVIEW | NEVER. overtimeBilling: MULTIPLIED | STRAIGHT.
/// premiumRules: { DOUBLE_TIME | MEAL_REST | PREDICTABILITY | HOLIDAY |
/// SHIFT_DIFFERENTIAL: { mode: NOT_BILLABLE | AT_COST | BILL_MARKUP, markupPct? } }.
model ClientBillingTerms {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  clientId         String   @db.Uuid
  effectiveFrom    DateTime @db.Date
  retroRebill      String   @default("REVIEW") @db.VarChar(12)
  overtimeBilling  String   @default("MULTIPLIED") @db.VarChar(12)
  premiumRules     Json     @default("{}")
  defaultMarkupPct Decimal? @db.Decimal(6, 2)
  notes            String?  @db.VarChar(500)
  updatedById      String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, effectiveFrom])
  @@index([tenantId])
}

/// A line payroll owes a client's bill (BEYOND): retro pay rebilled, or a
/// premium billed by contract. kind: RETRO | PREMIUM | REVERSAL. status:
/// PENDING_REVIEW | READY | BILLED | VOID. It rides on the client's next
/// statement and is claimed by the statement that finalizes it.
model BillingAdjustment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  clientId             String    @db.Uuid
  kind                 String    @db.VarChar(12)
  status               String    @default("READY") @db.VarChar(16)
  ruleKey              String?   @db.VarChar(24)
  label                String    @db.VarChar(300)
  basis                String?   @db.VarChar(300)
  hours                Decimal   @default(0) @db.Decimal(10, 2)
  payAmount            Decimal   @default(0) @db.Decimal(12, 2)
  amount               Decimal   @db.Decimal(12, 2)
  workFrom             DateTime? @db.Date
  workTo               DateTime? @db.Date
  associateId          String?   @db.Uuid
  payrollRunId         String?   @db.Uuid
  payrollItemId        String?   @db.Uuid
  sourceKey            String    @unique @db.VarChar(160)
  originalStatementIds String[]  @default([]) @db.Uuid
  billedStatementId    String?   @db.Uuid
  billedAt             DateTime? @db.Timestamptz(6)
  approvalId           String?   @db.Uuid
  reason               String?   @db.VarChar(500)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([payrollRunId])
  @@index([tenantId])
}

/// A sign-off on a payroll run's review report, pinned to the paychecks' amounts by fingerprint.
model PayrollRunReview {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  payrollRunId String     @db.Uuid
  fingerprint  String     @db.VarChar(64)
  signedById   String?    @db.Uuid
  signedAt     DateTime   @default(now()) @db.Timestamptz(6)
  note         String?    @db.VarChar(1000)
  /// No one else who processes payroll existed, so the run's creator signed.
  soleReviewer Boolean    @default(false)
  /// What the signer saw: people, gross, net, cash required.
  totals       Json       @default("{}")
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  signedBy     User?      @relation("PayrollReviewSigner", fields: [signedById], references: [id], onDelete: SetNull)

  @@index([payrollRunId, signedAt])
  @@index([tenantId])
}

/// One deduction on one paycheck: what it was, whose money, and which wage bases it lowered.
model PayrollItemDeduction {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  payrollItemId  String      @db.Uuid
  /// MEDICAL | DENTAL | VISION | HSA | HEALTH_FSA | DCAP | RET_401K | RET_403B | ROTH_401K | ROTH_403B | RET_LOAN | GARNISHMENT | EWA_RECOVERY | RIDES | LIFE | DISABILITY | UNION_DUES | AFTER_TAX_OTHER | ER_401K_MATCH | ER_HEALTH | ER_HSA …
  code           String      @db.VarChar(40)
  /// PRE_TAX | POST_TAX | EMPLOYER (an employer-paid amount, never taken from the check)
  category       String      @db.VarChar(12)
  label          String      @db.VarChar(160)
  employeeAmount Decimal     @default(0) @db.Decimal(12, 2)
  employerAmount Decimal     @default(0) @db.Decimal(12, 2)
  /// BenefitEnrollment | RetirementElection | Garnishment | RetirementLoan | EarnedWageAdvance | RideCharge | PendingPayrollDeduction …
  sourceType     String?     @db.VarChar(40)
  sourceId       String?     @db.Uuid
  /// Wage bases this deduction lowered when the check was cut: FIT, SS, MEDICARE, FUTA, "SIT:PA", "SUI:CA", "PGM:CA_SDI", "LOCAL".
  exemptFrom     String[]    @default([])
  w2Box12Code    String?     @db.VarChar(4)
  w2Box14Label   String?     @db.VarChar(40)
  w2Box10        Boolean     @default(false)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  payrollItem    PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([payrollItemId])
  @@index([tenantId, code])
  @@index([sourceType, sourceId])
}

/// Who belongs on a pay schedule, from a date: a whole client, a site, a department, a pay type, an individual, or an exclusion.
model PayrollScheduleRule {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  scheduleId    String          @db.Uuid
  /// INDIVIDUAL | SITE | DEPARTMENT | CLIENT | PAY_TYPE | EXCLUDE
  kind          String          @db.VarChar(16)
  clientId      String?         @db.Uuid
  siteId        String?         @db.Uuid
  departmentId  String?         @db.Uuid
  /// HOURLY | SALARY
  payType       String?         @db.VarChar(8)
  associateId   String?         @db.Uuid
  effectiveFrom DateTime        @db.Date
  effectiveTo   DateTime?       @db.Date
  note          String?         @db.VarChar(500)
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  schedule      PayrollSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([tenantId, kind])
  @@index([associateId])
}

/// One person on one pay schedule over a date range. Never overlapping per person (an exclusion constraint holds it).
model PayrollScheduleAssignment {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId   String          @db.Uuid
  scheduleId    String          @db.Uuid
  effectiveFrom DateTime        @db.Date
  effectiveTo   DateTime?       @db.Date
  /// RULE | INDIVIDUAL | TRANSFER | DEFAULT | MIGRATION | MOVE
  source        String          @db.VarChar(16)
  ruleId        String?         @db.Uuid
  reason        String?         @db.VarChar(300)
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  associate     Associate       @relation(fields: [associateId], references: [id], onDelete: Cascade)
  schedule      PayrollSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([associateId, effectiveFrom])
  @@index([scheduleId])
  @@index([tenantId])
}

/// A pay schedule's pattern from a date: a change starts with a future period and never reframes past ones.
model PayrollScheduleVersion {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  scheduleId        String           @db.Uuid
  effectiveFrom     DateTime         @db.Date
  frequency         PayrollFrequency
  anchorDate        DateTime         @db.Date
  payDateOffsetDays Int
  createdById       String?          @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  schedule          PayrollSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, effectiveFrom])
  @@index([tenantId])
}

// ===== The books: the company's own finance engine (2027-01) ===============
//
// A double-entry general ledger the platform posts to on its own (payroll,
// client statements and payments, tax deposits, reimbursements,
// garnishments, vendor bills, bank activity, depreciation), plus payables,
// bank and card reconciliation, the month-end close, budgets, fixed assets,
// and a two-way sync with the company's QuickBooks Online. lib/books/*.
//
// Dimensions (client, site, department, cost center) are plain ids — no
// relations into the operational models, so the books never block a delete
// there and the operational schema stays untouched.

/// The chart of accounts. type: ASSET | LIABILITY | EQUITY | INCOME | EXPENSE.
/// systemKey names the accounts the automatic posting uses ("AR", "CASH_OPERATING", "WAGES_DIRECT" …).
model LedgerAccount {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(160)
  type        String   @db.VarChar(12)
  /// BANK | CREDIT_CARD | AR | AP | CURRENT_ASSET | FIXED_ASSET | ACCUMULATED_DEPRECIATION | OTHER_ASSET |
  /// CURRENT_LIABILITY | PAYROLL_LIABILITY | TAX_LIABILITY | LONG_TERM_LIABILITY | EQUITY | RETAINED_EARNINGS |
  /// INCOME | OTHER_INCOME | COST_OF_SERVICES | EXPENSE | OTHER_EXPENSE
  subtype     String   @db.VarChar(32)
  systemKey   String?  @db.VarChar(48)
  parentId    String?  @db.Uuid
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  parent   LedgerAccount?  @relation("LedgerAccountParent", fields: [parentId], references: [id], onDelete: SetNull)
  children LedgerAccount[] @relation("LedgerAccountParent")
  lines    JournalLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, systemKey])
  @@index([tenantId, type])
}

/// One balanced journal entry. sourceKey makes automatic posting idempotent ("payroll-run:<id>:accrue").
/// status: POSTED | VOID. origin: SITE | QUICKBOOKS.
model JournalEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  number      Int
  entryDate   DateTime  @db.Date
  /// YYYY-MM of entryDate — the fiscal period it lands in.
  periodKey   String    @db.VarChar(7)
  memo        String?   @db.VarChar(500)
  /// MANUAL | PAYROLL | PAYROLL_DISBURSEMENT | STATEMENT | CLIENT_PAYMENT | TAX_PAYMENT | REIMBURSEMENT | GARNISHMENT |
  /// BILL | BILL_PAYMENT | BANK | DEPRECIATION | ACCRUAL | REVERSAL | QUICKBOOKS | OPENING | ASSET_DISPOSAL
  source      String    @db.VarChar(24)
  sourceType  String?   @db.VarChar(40)
  sourceId    String?   @db.VarChar(64)
  sourceKey   String?   @db.VarChar(160)
  status      String    @default("POSTED") @db.VarChar(8)
  origin      String    @default("SITE") @db.VarChar(12)
  /// An accrual reverses itself on this date (lib/books/close).
  reverseOn   DateTime? @db.Date
  reversesId  String?   @db.Uuid
  totalDebit  Decimal   @db.Decimal(14, 2)
  createdById String?   @db.Uuid
  postedAt    DateTime  @default(now()) @db.Timestamptz(6)
  voidedAt    DateTime? @db.Timestamptz(6)
  voidedById  String?   @db.Uuid
  voidReason  String?   @db.VarChar(300)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  lines    JournalLine[]
  reverses JournalEntry?  @relation("JournalReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversal JournalEntry[] @relation("JournalReversal")

  @@unique([tenantId, number])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, periodKey])
  @@index([tenantId, entryDate])
  @@index([tenantId, source])
  @@index([sourceType, sourceId])
}

/// One side of an entry. Exactly one of debit / credit is non-zero.
model JournalLine {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  entryId          String    @db.Uuid
  lineNo           Int
  accountId        String    @db.Uuid
  debit            Decimal   @default(0) @db.Decimal(14, 2)
  credit           Decimal   @default(0) @db.Decimal(14, 2)
  memo             String?   @db.VarChar(300)
  clientId         String?   @db.Uuid
  siteId           String?   @db.Uuid
  departmentId     String?   @db.Uuid
  costCenterId     String?   @db.Uuid
  vendorId         String?   @db.Uuid
  /// Bank reconciliation: when this line was cleared, and in which reconciliation.
  clearedAt        DateTime? @db.Timestamptz(6)
  reconciliationId String?   @db.Uuid

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([tenantId, accountId])
  @@index([tenantId, clientId])
  @@index([reconciliationId])
}

/// A month of the books. status: OPEN | CLOSED. A CLOSED period takes no posting.
model FiscalPeriod {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  periodKey     String    @db.VarChar(7)
  status        String    @default("OPEN") @db.VarChar(8)
  closedAt      DateTime? @db.Timestamptz(6)
  closedById    String?   @db.Uuid
  /// The second person who signed the close.
  signedOffById String?   @db.Uuid
  signedOffAt   DateTime? @db.Timestamptz(6)
  reopenedAt    DateTime? @db.Timestamptz(6)
  reopenedById  String?   @db.Uuid
  reopenReason  String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  closeTasks CloseTask[]

  @@unique([tenantId, periodKey])
}

/// One step of a month's close checklist. status: OPEN | DONE | SKIPPED.
model CloseTask {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  periodId    String    @db.Uuid
  key         String    @db.VarChar(48)
  title       String    @db.VarChar(200)
  detail      String?   @db.VarChar(1000)
  sortOrder   Int       @default(0)
  ownerUserId String?   @db.Uuid
  status      String    @default("OPEN") @db.VarChar(8)
  doneAt      DateTime? @db.Timestamptz(6)
  doneById    String?   @db.Uuid
  note        String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  period FiscalPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, key])
  @@index([tenantId])
}

/// Someone the company pays. paymentMethod: ACH | CHECK | CARD | OTHER.
model Vendor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name                    String    @db.VarChar(160)
  email                   String?   @db.VarChar(200)
  phone                   String?   @db.VarChar(40)
  addressLine1            String?   @db.VarChar(200)
  addressLine2            String?   @db.VarChar(200)
  city                    String?   @db.VarChar(100)
  state                   String?   @db.VarChar(2)
  zip                     String?   @db.VarChar(10)
  /// Gets a 1099-NEC; taxIdEnc is the EIN/SSN under the keyring, taxIdLast4 for display.
  is1099                  Boolean   @default(false)
  taxIdEnc                Bytes?
  taxIdLast4              String?   @db.VarChar(4)
  defaultExpenseAccountId String?   @db.Uuid
  paymentMethod           String    @default("ACH") @db.VarChar(8)
  routingNumberEnc        Bytes?
  accountNumberEnc        Bytes?
  accountLast4            String?   @db.VarChar(4)
  termsDays               Int       @default(30)
  notes                   String?   @db.VarChar(1000)
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime? @db.Timestamptz(6)

  bills    Bill[]
  payments BillPayment[]

  @@index([tenantId, isActive])
}

/// A vendor's bill. status: DRAFT | PENDING_APPROVAL | APPROVED | PARTIALLY_PAID | PAID | VOID.
model Bill {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  vendorId          String    @db.Uuid
  billNumber        String?   @db.VarChar(60)
  billDate          DateTime  @db.Date
  dueDate           DateTime  @db.Date
  status            String    @default("DRAFT") @db.VarChar(16)
  total             Decimal   @db.Decimal(14, 2)
  balance           Decimal   @db.Decimal(14, 2)
  memo              String?   @db.VarChar(500)
  /// The attached invoice (DocumentRecord / blob key).
  attachmentKey     String?   @db.VarChar(300)
  attachmentName    String?   @db.VarChar(200)
  approvalRequestId String?   @db.Uuid
  approvedById      String?   @db.Uuid
  approvedAt        DateTime? @db.Timestamptz(6)
  journalEntryId    String?   @db.Uuid
  /// A recurring bill's template made this one.
  recurringId       String?   @db.Uuid
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  voidedAt          DateTime? @db.Timestamptz(6)

  vendor       Vendor                   @relation(fields: [vendorId], references: [id])
  lines        BillLine[]
  applications BillPaymentApplication[]
  recurring    RecurringBill?           @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([vendorId])
  @@index([tenantId, dueDate])
}

model BillLine {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  billId       String  @db.Uuid
  lineNo       Int
  accountId    String  @db.Uuid
  description  String? @db.VarChar(300)
  amount       Decimal @db.Decimal(14, 2)
  clientId     String? @db.Uuid
  siteId       String? @db.Uuid
  departmentId String? @db.Uuid
  costCenterId String? @db.Uuid

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([tenantId])
}

/// A bill on a schedule (rent, the van lease). frequency: WEEKLY | MONTHLY | QUARTERLY | YEARLY.
model RecurringBill {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  vendorId    String    @db.Uuid
  name        String    @db.VarChar(160)
  frequency   String    @db.VarChar(10)
  nextDate    DateTime  @db.Date
  endDate     DateTime? @db.Date
  /// The lines to copy: [{ accountId, description, amount, clientId?, siteId?, departmentId?, costCenterId? }].
  template    Json
  memo        String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  bills Bill[]

  @@index([tenantId, isActive, nextDate])
}

/// Money paid to a vendor. method: ACH | CHECK | CARD | OTHER. status: SCHEDULED | SENT | CLEARED | VOID.
model BillPayment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  vendorId       String    @db.Uuid
  paidOn         DateTime  @db.Date
  method         String    @db.VarChar(8)
  amount         Decimal   @db.Decimal(14, 2)
  /// The bank or card account it came out of.
