// Alto People — Prisma schema (Phase 2)
// Conventions:
// - UUID primary keys (gen_random_uuid)
// - Timestamptz timestamps everywhere
// - deletedAt on PII / compliance-relevant tables (retention then delete)
// - Explicit onDelete on every relation
// - Denormalized clientId on documents/bg-checks/audit-log for future RLS
// - Money: Decimal(12,2). Encrypted PII: Bytes. Files: S3 keys, never blobs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  EXECUTIVE_CHAIRMAN
  HR_ADMINISTRATOR
  OPERATIONS_MANAGER
  LIVE_ASN
  ASSOCIATE
  CLIENT_PORTAL
  FINANCE_ACCOUNTANT
  INTERNAL_RECRUITER
  // Phase 76 — line manager. Has a small subset of HR power scoped to
  // their direct reports: approve their team's time entries / time-off /
  // schedule changes, view their team's performance reviews. Not a
  // replacement for OPERATIONS_MANAGER (which is org-wide ops admin).
  MANAGER
  // Workforce Manager — org-wide workforce planning + admin. Same
  // capability surface as HR_ADMINISTRATOR; distinct role label so audit
  // logs show who acted in which functional capacity.
  WORKFORCE_MANAGER
  // Marketing Manager — same admin surface as HR_ADMINISTRATOR; distinct
  // role label keeps audit attribution for marketing-driven actions.
  MARKETING_MANAGER
  // Shift Supervisor — client-scoped floor supervisor. Manages scheduling
  // and time & attendance for a single client's associates only (via
  // User.clientId + the scope* helpers). No HR/payroll surface.
  SHIFT_SUPERVISOR
  // Floor Supervisor — watch-only step-down from SHIFT_SUPERVISOR: the
  // live clocked-in board for a single client, nothing else. No time
  // approvals, edits, or walk-in decisions.
  FLOOR_SUPERVISOR
  // Runs the Alto vans: bookings, dispatch, vans, drivers, stops, fares,
  // ride charges, riders' issues. Org-wide.
  TRANSPORTATION_DIRECTOR
  // Drives an Alto van: their own runs only.
  DRIVER
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
