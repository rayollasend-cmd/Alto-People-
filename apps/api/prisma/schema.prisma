model Notification {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId          String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  // Recipient: a user (in-app), or by phone/email for SMS/EMAIL when the
  // recipient may not be a User yet.
  recipientUserId   String?             @db.Uuid
  recipientPhone    String?
  recipientEmail    String?
  subject           String?
  body              String
  // Optional template/category so HR can filter ("shift_reminder", etc.).
  category          String?
  // Provider's id for the sent message (Twilio SID, FCM message id).
  externalRef       String?
  // Resend's message id for real EMAIL sends. Kept as its own (indexed)
  // column — externalRef also carries STUB-* refs and other providers' ids
  // — so the /resend/webhook handler can match async delivery events
  // (delivered / bounced / complained) back to this row. Nullable: stub
  // sends, non-EMAIL channels, and rows created before this column.
  providerMessageId String?
  failureReason     String?
  sentAt            DateTime?           @db.Timestamptz(6)
  readAt            DateTime?           @db.Timestamptz(6)
  // Seen ≠ read: opening the bell panel stamps seenAt (clears the badge);
  // clicking the row stamps readAt (clears the highlight). Without the
  // distinction the badge nagged until every row was clicked — the
  // Slack/GitHub-standard behavior needs both.
  seenAt            DateTime?           @db.Timestamptz(6)
  // Sender: HR user, or null for system-triggered notifications.
  senderUserId      String?             @db.Uuid
  /// AI disclosure: the agent (Worker id) whose action this notice reports, so the bell can badge it "AI". Null for people and the system.
  byAgentId         String?             @db.Uuid
  // Optional deeplink for IN_APP notifications. The bell renders the row
  // as a link when set; un-set means click only marks-read. First use:
  // payroll Branch-webhook FAILED/RETURNED → "/payroll?run={runId}".
  linkUrl           String?
  recipientUser     User?               @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  senderUser        User?               @relation("NotificationSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  // Sort: Desc — invite-delivery + recent-notification queries always
  // ORDER BY createdAt DESC. Matching index order lets the planner do an
  // in-order index scan instead of reverse-scanning.
  @@index([recipientUserId, createdAt(sort: Desc)])
  // Latest invite delivery per associate: recipient + category, newest first.
  @@index([recipientUserId, category, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([channel, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  // Webhook-event matching. providerMessageId is the primary key for the
  // lookup; externalRef is the fallback for rows written by send paths
  // that only stored the Resend id there (it equals the Resend id for
  // every real send made before providerMessageId existed).
  @@index([providerMessageId])
  @@index([externalRef])
  @@index([tenantId])
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  clientId    String?  @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Stays nullable (migration C): a null tenant is the platform's own audit chain (lib/auditChain).
  tenantId    String?  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  action      String
  entityType  String
  entityId    String
  /// Brief 1D-1: the Worker that acted or was acted on, when one did —
  /// an agent on its own API credential (1D-2), a robot (3-1).
  workerId    String?  @db.Uuid
  /// Brief 2-4: the /v1 API client that acted (its owner's user id rides in metadata).
  apiClientId String?  @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  /// Brief 2-3 step 4: the tenant's hash chain, set by the audit_log_chain trigger (never by the app).
  seq         BigInt?
  prevHash    String?  @db.VarChar(64)
  hash        String?  @db.VarChar(64)
  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // Composite covers (entityType, entityId) prefix queries AND the timeline
  // pattern WHERE entityType=X AND entityId=Y ORDER BY createdAt DESC.
  // Drops the previously-separate (entityType, entityId) index since this
  // composite is a strict superset.
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([action, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([tenantId, seq])
}

// ===== Phase 42 — Benefits enrollment =====================================
//
// Categories the IRS treats as Section 125 / pre-tax deductions. Every kind
// in this enum is treated as pre-tax in the v1 payroll engine — taxable
// income (federal + FICA + Medicare) drops by the enrolled amount before
// the tax engine runs. Post-tax deductions (e.g. Roth 401k, garnishments)
// will get a separate isPretax flag in a follow-up.
enum BenefitsPlanKind {
  HEALTH_MEDICAL
  DENTAL
  VISION
  HSA
  FSA_HEALTHCARE
  FSA_DEPENDENT_CARE
  RETIREMENT_401K
  RETIREMENT_403B
  LIFE_INSURANCE
  /// Employer contributions to a Trump account (IRC §128) — W-2 Box 12 TA.
  TRUMP_ACCOUNT
  DISABILITY
}

// Per-client benefits offering. The associate-side election picks an amount
// per pay period; the employer side has a flat per-period contribution that
// HR records here for reporting (not currently posted to payroll — only the
// associate election affects taxable income / net pay).
model BenefitsPlan {
  id                                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                                  String           @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId                                  String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind                                      BenefitsPlanKind
  name                                      String
  description                               String?
  // Per-pay-period amount the employer contributes. Reporting only for v1.
  employerContributionCentsPerPeriod        Int              @default(0)
  // Default amount shown to the associate when they enroll. They can
  // override; the actual deduction comes from BenefitsEnrollment.
  employeeContributionDefaultCentsPerPeriod Int              @default(0)
  isActive                                  Boolean          @default(true)
  /// SECURE 2.0: a higher earner's catch-up is treated as Roth automatically (deemed Roth election).
  allowsDeemedRoth                          Boolean          @default(true)
  /// EDI 834 feed: the carrier, the HD03 insurance line (HLT/DEN/VIS/LIF/…), the carrier's plan code.
  carrierId                                 String?          @db.Uuid
  insuranceLineCode                         String?          @db.VarChar(3)
  carrierPlanCode                           String?          @db.VarChar(50)
  createdAt                                 DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                                 DateTime         @updatedAt @db.Timestamptz(6)

  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enrollments BenefitsEnrollment[]

  @@index([clientId, isActive])
  @@index([clientId, kind])
  @@index([tenantId])
}

// One row per associate × plan. effectiveDate / terminationDate gate whether
// the deduction posts in a given payroll period; null terminationDate means
// "currently enrolled."
model BenefitsEnrollment {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId                 String    @db.Uuid
  planId                      String    @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId                    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  electedAmountCentsPerPeriod Int
  /// Designated Roth: the deferral is taken after tax (W-2 Box 12 AA/BB).
  rothElection                Boolean   @default(false)
  effectiveDate               DateTime  @db.Date
  terminationDate             DateTime? @db.Date
  /// HD05 coverage level: EMP, ESP, ECH, FAM, E1D… (lib/edi834).
  coverageLevel               String    @default("EMP") @db.VarChar(3)
  coveredDependentIds         String[]  @default([]) @db.Uuid
  /// A 401(k) rate: per paycheck = gross × percent (pre-tax, or Roth when rothElection); rothPercent adds a Roth part (lib/retirement).
  electedPercent              Decimal?  @db.Decimal(5, 2)
  rothPercent                 Decimal?  @db.Decimal(5, 2)
  /// The recordkeeper plan (RetirementPlan) this deferral reports to.
  retirementPlanId            String?   @db.Uuid
  /// LIFE_INSURANCE: the face amount of group-term coverage, in cents. Over $50,000 the Table I cost is imputed income (lib/groupTermLife).
  lifeCoverageCents           Int?
  createdAt                   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @db.Timestamptz(6)

  associate Associate    @relation(fields: [associateId], references: [id], onDelete: Cascade)
  plan      BenefitsPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  // One active election per (associate, plan) at a time. Re-enrolling after
  // a termination produces a new row (so the history is preserved).
  @@unique([associateId, planId, effectiveDate])
  @@index([associateId, terminationDate])
  @@index([retirementPlanId])
  @@index([planId])
  @@index([tenantId])
}

// ===== Phase 76 — Org hierarchy ===========================================
//
// Three sibling lookup entities that hang off Client. Department supports
// nested hierarchy via a self-FK; CostCenter is flat; JobProfile is a
// title taxonomy with FLSA exemption flag. Associate carries nullable FKs
// to all three plus a self-FK manager relationship.

model Department {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?   @db.Uuid
  parentId    String?   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name        String
  code        String?
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parent       Department?   @relation("DepartmentParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[]  @relation("DepartmentParent")
  associates   Associate[]
  positions    Position[]
  // Phase 87 — broadcast targeting.
  broadcasts   Broadcast[]
  // Phase 109 — pulse surveys scoped to this department.
  pulseSurveys PulseSurvey[]

  @@index([clientId, deletedAt])
  @@index([parentId])
  @@index([tenantId])
}

model CostCenter {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  code        String
  name        String
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  client      Client?                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  associates  Associate[]
  positions   Position[]
  // Phase 87 — broadcast targeting.
  broadcasts  Broadcast[]
  orgUnit     OrgUnit?

  @@index([clientId, deletedAt])
  @@index([tenantId])
}

// Per-client catalog of shift positions ("F&D Morning Shift", etc.).
// Constrains the free-text Shift.position field to an admin-curated list
// so scheduling stays consistent and groupable in reports. The chosen
// name is still stored as a string on Shift.position (no FK) — this table
// only governs the dropdown of allowed values. New clients are auto-seeded
// with a default set; admins edit the list under Org → Shift positions.
// Default pay/bill rate for a (client, position) pair. Shift positions are
// free text, so this is the lookup that turns "F&D Overnight @ Walmart"
// into an hourly rate. A shift's own payRate overrides it; when a shift
// has none, the scheduling KPIs + labor-cost footer resolve the rate from
// here so the numbers aren't $0. Position match is exact (the same string
// the shift carries). Resurrected from wip/scheduling-pay-rates.
model ShiftRateDefault {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String?   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  position      String
  // Cost side — what the associate is paid per hour. Drives labor cost.
  payRate       Decimal   @db.Decimal(8, 2)
  // Optional bill/revenue rate per hour.
  billRate      Decimal?  @db.Decimal(8, 2)
  /// Brief 1A-2: the card is in force from this date to effectiveTo (inclusive); null = open-ended.
  effectiveFrom DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  effectiveTo   DateTime? @db.Date
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, position, effectiveFrom])
  @@index([clientId, position, effectiveTo])
  @@index([clientId])
  @@index([tenantId])
}

/// Public wage data (BLS OEWS) by metro area (CBSA) and occupation (SOC).
