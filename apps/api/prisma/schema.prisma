  acknowledgedAt  DateTime?               @db.Timestamptz(6)
  /// Calibration: the reviewer's own rating, kept when HR moves overallRating.
  originalRating  Int?
  calibrationNote String?                 @db.VarChar(1000)
  calibratedById  String?                 @db.Uuid
  calibratedAt    DateTime?               @db.Timestamptz(6)
  associate       Associate               @relation(fields: [associateId], references: [id], onDelete: Cascade)
