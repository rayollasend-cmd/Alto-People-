model Client {
  /// Agent families step 5: credentials every site of this client requires.
  credentialRequirements CredentialRequirement[]
  /// The pipeline prospects that were won as this client.
  wonFromProspects       ClientProspect[]        @relation("ClientProspectWon")
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId               String                  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name                   String
  industry               String?
  status                 ClientStatus            @default(ACTIVE)
  contactEmail           String?
  // This client's scheduling week start, 0=Sunday … 6=Saturday. Some
  // clients run Sun–Sat weeks, others Wed–Tue; drives the associate
  // week-ahead digest (sent the evening before this day) and future
  // per-client week math.
  weekStartsOn           Int                     @default(0)
  // Tier-2 — this employer's actual SUTA experience rate + wage base
  // from the state agency's annual notice. Null = the new-employer
  // defaults baked into the engine's per-state table.
  sutaRateOverride       Decimal?                @db.Decimal(6, 5)
  sutaWageBaseOverride   Decimal?                @db.Decimal(12, 2)
  // Gap 1 — Employer identity used on tax forms (W-2, 941, 1099-NEC).
  // legalName is the IRS-registered name shown on the W-2 employer block;
  // it can differ from `name` (the brand / display name). ein is the EIN
  // formatted as "XX-XXXXXXX". HR fills these in before generating W-2s.
  legalName              String?                 @db.VarChar(255)
  ein                    String?                 @db.VarChar(20)
  // Gap 1 — Employer address used on tax forms. `state` already lives
  // below as the work-site code; reused for the W-2 employer block too.
  addressLine1           String?                 @db.VarChar(255)
  addressLine2           String?                 @db.VarChar(255)
  city                   String?                 @db.VarChar(120)
  zip                    String?                 @db.VarChar(10)
  // Verbatim SAP Fieldglass "Site" label for this client engagement (e.g.
  // "1 - Onsite - FL - Destin"), rendered on the Timesheets export so the
  // Site column matches Fieldglass character-for-character. Null = fall back
  // to the worksite/client name.
  fieldglassSiteName     String?                 @db.VarChar(255)
  // Fieldglass bill rate ($/hr) for this SOW — the client-billed "Rate" on
  // the Fieldglass timesheet accounting block (Amount = rate × hours). Not
  // the associate pay rate. Null = accounting Amount can't be computed.
  fieldglassBillRate     Decimal?                @db.Decimal(8, 2)
  // Invoicing terms. The client's standing purchase-order number prints on
  // every statement (a statement may carry its own); paymentTermsDays sets
  // each statement's due date from its finalization; the dunning cadence
  // (lib/statementDunning.ts) pauses per client when Finance says so.
  poNumber               String?                 @db.VarChar(60)
  paymentTermsDays       Int                     @default(30)
  /// The margin its bill rates are priced to (market rates desk).
  targetMarginPct        Decimal?                @db.Decimal(5, 2)
  dunningPausedAt        DateTime?               @db.Timestamptz(6)
  dunningPausedById      String?                 @db.Uuid
  dunningPauseNote       String?
  /// Finance walk (2026-10-21): sales tax on this client's statements — whether the
  /// services are taxable and at what rate (percent, e.g. 7.000). Off = no tax line.
  salesTaxable           Boolean                 @default(false)
  salesTaxRatePct        Decimal?                @db.Decimal(6, 3)
  // Two-letter USPS code of the work site. Drives Phase 23 OT/meal-break
  // policy AND Phase 25 predictive-scheduling enforcement (NY, IL, WA, PA,
  // OR demand 14-day notice). Null = federal default = no state-specific
  // rules enforced.
  state                  String?                 @db.VarChar(2)
  /// Who at the company owns this account: an internal user of the same
  /// tenant (never a portal or associate login). Null = nobody named yet.
  accountOwnerUserId     String?                 @db.Uuid
  accountOwner           User?                   @relation("ClientAccountOwner", fields: [accountOwnerUserId], references: [id], onDelete: SetNull)
  /// The contract's term, when one is on file (calendar days; end on or after start).
  contractStartDate      DateTime?               @db.Date
  contractEndDate        DateTime?               @db.Date
  /// The people at the client the account is run with.
  contacts               ClientContact[]
  // Phase 131 — geofence moved to Location. Each physical site has its
  // own coordinates and radius; lookups read Location.geofence with a
  // "first active Location under this client" fallback for associates
  // who haven't been placed at a Location yet.
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?               @db.Timestamptz(6)
  /// Brief 2-1b: the employer-of-record row that carries this client's legal facts, when it is one.
  employerOrganization   EmployerOrganization?
  orgUnits               OrgUnit[]

  applications            Application[]
  petitionPrograms        Program[]                 @relation("PetitionClient")
  users                   User[]
  driverAccess            DriverClientAccess[]
  policies                Policy[]
  templates               OnboardingTemplate[]
  readyToWorkHandoffs     ReadyToWorkHandoff[]
  shifts                  Shift[]
  statements              ClientStatement[]
  fieldglassRegistrations FieldglassRegistration[]
  fieldglassTimesheets    FieldglassTimesheet[]
  clientRequests          ClientRequest[]
  clientAcknowledgements  ClientAcknowledgement[]
  conversations           Conversation[]
  cohorts                 Cohort[]
  opsShifts               OpsShift[]
  payrollRuns             PayrollRun[]
  // Wave 1.1 — Pay schedules scoped to this client.
  payrollSchedules        PayrollSchedule[]
  jobs                    Job[]
  benefitsPlans           BenefitsPlan[]
  shiftTemplates          ShiftTemplate[]
  // Phase 76 — org hierarchy entities are per-client.
  departments             Department[]
  costCenters             CostCenter[]
  jobProfiles             JobProfile[]
  // Per-client catalog that constrains Shift.position to a curated list.
  shiftPositions          ShiftPosition[]
  shiftRateDefaults       ShiftRateDefault[]
  // Phase 78 — positions / seats.
  positions               Position[]
  // Phase 80 — workflow definitions can be client-scoped.
  workflows               WorkflowDefinition[]
  // Phase 81 — custom field definitions can be client-scoped.
  customFieldDefinitions  CustomFieldDefinition[]
  // Phase 83 — compensation bands + merit cycles.
  compBands               CompBand[]
  meritCycles             MeritCycle[]
  // Phase 85 — qualifications catalog.
  qualifications          Qualification[]
  // Phase 117 — client-specific holidays.
  holidays                Holiday[]
  // Phase 124 — client-specific KB articles.
  kbArticles              KbArticle[]
  // Phase 126 — career ladders defined for this client.
  careerLadders           CareerLadder[]
  // Phase 130 — VTO policy override (one-per-client; NULL = global default).
  vtoPolicy               VtoPolicy?
  // Phase 86 — projects, premium-pay rules, tip pools.
  projects                Project[]
  premiumPayRules         PremiumPayRule[]
  tipPools                TipPool[]
  // Phase 87 — broadcasts + surveys (when client-scoped).
  broadcasts              Broadcast[]
  surveys                 Survey[]
  // Phase 88 — OSHA incidents.
  oshaIncidents           OshaIncident[]
  unemploymentClaims      UnemploymentClaim[]
  wcClaims                WcClaim[]
  // Phase 89 — document templates can be client-scoped.
  documentTemplates       DocumentTemplate[]
  // Phase 90 — recruiting catalog.
  interviewKits           InterviewKit[]
  offers                  Offer[]
  candidateSubmittals     CandidateSubmittal[]
  jobPostings             JobPosting[]
  npsInvites              ClientNpsInvite[]
  // Phase 92 — open enrollment windows.
  openEnrollmentWindows   OpenEnrollmentWindow[]
  // Phase 93 — public API keys + outbound webhooks scoped to this client.
  apiKeys                 ApiKey[]
  webhooks                Webhook[]
  // Phase 94 — LMS courses scoped to this client.
  courses                 Course[]
  // Phase 99 — kiosk devices + PINs registered at this client.
  kioskDevices            KioskDevice[]
  kioskPins               KioskPin[]
  complianceSnapshots     ComplianceScoreSnapshot[]
  // Phase 109 — pulse surveys scoped to this client.
  pulseSurveys            PulseSurvey[]
  // Phase 114 — learning paths scoped to this client.
  learningPaths           LearningPath[]
  // Phase 131 — physical sites under this client (one Client can have
  // many Locations, e.g. Walmart → Destin / Front Beach / PCB).
  locations               Site[]
  shiftTeams              ShiftTeam[]
  seasonPlans             SeasonPlan[]
  billingTerms            ClientBillingTerms[]
  billingAdjustments      BillingAdjustment[]

  @@index([status])
  @@index([deletedAt])
  @@index([tenantId])
  @@index([accountOwnerUserId])
}

/// The people at a client the account is run with (CL-A, 2026-10-22): who
/// signs, who pays the statements, who runs the floor. One primary per
/// client (a partial unique index; the API moves the flag). Soft-deleted.
model ClientContact {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String            @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  clientId  String            @db.Uuid
  name      String            @db.VarChar(120)
  title     String?           @db.VarChar(120)
  email     String?           @db.VarChar(254)
  phone     String?           @db.VarChar(40)
  role      ClientContactRole @default(OTHER)
  isPrimary Boolean           @default(false)
  notes     String?           @db.VarChar(1000)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?         @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
}

enum ClientContactRole {
  PRIMARY
  BILLING
  SITE
  OPERATIONS
  OTHER
}

// Phase 131 — Site (table "Location", Brief 2-1b step 7 renamed the model, not the table): a physical work site, under a Client for a staffing tenant or under the tenant alone. State and
// geofence move here from Client because they're properties of the
// work site, not the customer. Client.state stays as the legal/tax
// employer address; Site.state is the actual work-site code that
// drives OT / meal-break / predictive-scheduling rules.
model Site {
  /// Agent families step 5: credentials this site requires (coverage.credentials).
  credentialRequirements CredentialRequirement[]
  /// Agent families step 3: the Workforce agent's daily coverage.forecast rows for this site.
  coverageForecasts      CoverageForecastDay[]
  forecastSiteWeeks      ForecastSiteWeek[]
  forecastSignals        ForecastSignal[]
  forecastAccuracies     ForecastAccuracy[]
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId               String?                 @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId               String                  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name                   String
  addressLine1           String?                 @db.VarChar(255)
  addressLine2           String?                 @db.VarChar(255)
  city                   String?                 @db.VarChar(120)
  state                  String?                 @db.VarChar(2)
  zip                    String?                 @db.VarChar(10)
  /// Metro area (CBSA) its wages are benchmarked against (lib/marketWages).
  marketAreaCode         String?                 @db.VarChar(7)
  marketAreaName         String?                 @db.VarChar(160)
  latitude               Decimal?                @db.Decimal(10, 7)
  longitude              Decimal?                @db.Decimal(10, 7)
  geofenceRadiusMeters   Int?
  // IANA timezone of the physical work site (e.g. "America/New_York").
  // Shifts store UTC instants; this is what turns a UTC instant into the
  // store's wall-clock time for availability matching, the schedule PDF,
  // and shift notifications. Defaults to Eastern (the current deployment);
  // admins set it per location. Validated against SUPPORTED_TIMEZONES on
  // write.
  timezone               String                  @default("America/New_York")
  /// Brief 2-1b step 7: what kind of site this is. The noun the tenant uses for it comes from the terminology table.
  type                   SiteType                @default(STORE)
  // The region this store rolls up to (the command center). Stores may
  // belong to different clients and still share a region.
  regionId               String?                 @db.Uuid
  /// Brief 2-1b step 5: the organizational unit this site belongs to (division / region / business unit / cost center).
  orgUnitId              String?                 @db.Uuid
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?               @db.Timestamptz(6)

  client                  Client?                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  employments             Employment[]             @relation("EmploymentSite")
  assignments             AssociateAssignment[]
  applications            Application[]
  shifts                  Shift[]
  supervisorShiftWindows  SupervisorShiftWindow[]
  emergencySites          EmergencySite[]
  seasonPlanSites         SeasonPlanSite[]
  workerAssignments       WorkerAssignment[]
  emergencyDestinations   Emergency[]              @relation("EmergencyDestination")
  opsShifts               OpsShift[]
  oshaIncidents           OshaIncident[]
  robotCommissionings     RobotCommissioning[]
  safetyZones             SiteSafetyZone[]
  robotChecklistTemplates RobotChecklistTemplate[]
  robotIncidents          RobotIncident[]
  storeShiftSops          StoreShiftSop[]
  kioskDevices            KioskDevice[]
  timeEntries             TimeEntry[]
  shiftTeams              ShiftTeam[]
  staffingTargets         StaffingTarget[]
  portalUsers             User[]                   @relation("UserStoreScope")
  clientRequests          ClientRequest[]          @relation("ClientRequestStore")
  conversations           Conversation[]
  region                  Region?                  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  orgUnit                 OrgUnit?                 @relation("OrgUnitSites", fields: [orgUnitId], references: [id], onDelete: SetNull)
  candidateSubmittals     CandidateSubmittal[]
  rides                   Ride[]
  rideSeries              RideSeries[]             @relation("RideSeriesStore")
  readyToWorkHandoffs     ReadyToWorkHandoff[]
  laborRuleSets           LaborRuleSet[]
  workTasks               WorkTask[]

  prevailingWageProjects PrevailingWageProject[]
  assetsHere             Asset[]                 @relation("AssetLocation")
  leadBench              LeadBenchCandidate[]    @relation("LeadBenchLocation")

  @@index([clientId, isActive])
  @@index([deletedAt])
  @@index([tenantId])
  @@map("Location")
}

// A standing crew at a work site — "Front Beach Morning", "Overnight team".
// Scheduling filters its roster to a team's members so a manager building
// the week sees only the people who actually work that shift, not the whole
// client roster. Optional default start/end minutes prefill the create-shift
// dialog when the team is selected.
model ShiftTeam {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?   @db.Uuid
  locationId  String    @db.Uuid
  name        String    @db.VarChar(80)
  /// Wall-clock minutes since local midnight at the site; null = no default.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  startMinute Int?
  endMinute   Int?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  client   Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  location Site              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  members  ShiftTeamMember[]

  @@index([clientId, deletedAt])
  @@index([locationId, deletedAt])
  @@index([tenantId])
}

model ShiftTeamMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String   @db.Uuid
  associateId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  team      ShiftTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([teamId, associateId])
  @@index([associateId])
  @@index([tenantId])
}

// Phase 131 — effective-dated record of which Location an associate is
// currently working at. Transfer = stamp endedAt on the open row,
// insert a new open row. The migration enforces "at most one open row
// per associate" with a partial unique index where endedAt IS NULL.
// Expected floor headcount per store, EFFECTIVE-DATED: the row whose
// effectiveFrom is the latest one on-or-before a given day is that day's
// target. Never overwritten in place — past days stay judged by the target
// that applied THEN, and the history doubles as an audit trail of when
// coverage expectations changed. Drives the labor-cost report's
// over/under-staffing numbers.
model StaffingTarget {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId    String   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  targetCount   Int
  effectiveFrom DateTime @db.Date
  // NULL label/window = the store's TOTAL floor target. A labeled row with
  // start/end minutes (site-local wall clock; end <= start wraps past
  // midnight, same convention as ShiftTemplate) is the expected headcount
  // for that shift window — what the live floor board compares clock-ins
  // against. Effective-dating applies per (location, label).
  label         String?
  startMinute   Int?
  endMinute     Int?
  note          String?
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  location  Site  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy User? @relation("StaffingTargetAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([locationId, effectiveFrom])
  @@index([tenantId])
}

enum AttendanceKind {
  LATE // punched in > 7 min after linked shift start
  EARLY_OUT // punched out > 30 min before linked shift end
  CALL_OUT // missed shift, but a time-off request covered the day
  NO_CALL_NO_SHOW // missed shift, no request, no word
}

// ----- AIOPS: call-outs, retention, assistant actions ----------------------

enum CallOutChannel {
  WHATSAPP
  SMS
  APP
  VOICE
  STAFF
}

enum CallOutReason {
  SICK
  FAMILY
  TRANSPORT
  EMERGENCY
  BEREAVEMENT
  JURY_DUTY
  OTHER
}

enum CallOutStatus {
  PENDING // asked on WhatsApp/SMS, waiting for the worker's YES
  CONFIRMED
  CANCELLED
}

/// A worker saying they can't make a shift — by WhatsApp, text, the app or a call.
/// One per (shift, worker): a repeated text never counts twice (lib/callOuts).
model CallOut {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  shiftId            String         @db.Uuid
  associateId        String         @db.Uuid
  clientId           String?        @db.Uuid
  locationId         String?        @db.Uuid
  channel            CallOutChannel
  reason             CallOutReason  @default(OTHER)
  note               String?        @db.VarChar(1000)
  recordingUrl       String?        @db.VarChar(500)
  status             CallOutStatus  @default(CONFIRMED)
  minutesBeforeStart Int
  late               Boolean        @default(false)
  excused            Boolean        @default(false)
  excusedWhy         String?        @db.VarChar(200)
  coverSteps         Json?
  confirmedAt        DateTime?      @db.Timestamptz(6)
  createdById        String?        @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(6)

  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([shiftId, associateId])
  @@index([tenantId, createdAt])
  @@index([clientId, createdAt])
  @@index([associateId, status])
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

enum RetentionPlayKind {
  MORE_HOURS
  CHECK_IN
  SCHEDULE_FIX
  RIDE_HELP
  RECOGNITION
  PAY_REVIEW
}

enum RetentionPlayStatus {
  OPEN
  DONE
}

enum RetentionOutcome {
  PENDING
  STAYED
  LEFT
}

/// The latest flight-risk score for a worker (lib/retention). Never shown to the worker.
model FlightRisk {
  associateId String    @id @db.Uuid
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  score       Int
  band        RiskBand
  /// The factors behind the score, strongest first: [{ key, label, points, detail }].
  reasons     Json
  /// Suggested plays, in order: RetentionPlayKind[].
  plays       Json
  computedAt  DateTime  @db.Timestamptz(6)
  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId, band])
}

/// Something a lead or HR did to keep a worker, and whether they stayed.
model RetentionPlay {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associateId    String              @db.Uuid
  kind           RetentionPlayKind
  status         RetentionPlayStatus @default(OPEN)
  note           String?             @db.VarChar(1000)
  riskAtStart    Int
  reasonsAtStart Json?
  takenById      String?             @db.Uuid
  approvalId     String?             @db.Uuid
  doneAt         DateTime?           @db.Timestamptz(6)
  outcome        RetentionOutcome    @default(PENDING)
  outcomeAt      DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  associate      Associate           @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
  @@index([associateId])
}

enum AssistantActionStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  FAILED
}

/// An action the assistant proposed; it runs only when the person taps Confirm (lib/assistantActions).
model AssistantAction {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  userId       String                @db.Uuid
  kind         String                @db.VarChar(60)
  params       Json
  title        String                @db.VarChar(300)
  detail       String?               @db.VarChar(1000)
  status       AssistantActionStatus @default(PROPOSED)
  expiresAt    DateTime              @db.Timestamptz(6)
  decidedAt    DateTime?             @db.Timestamptz(6)
  resultStatus Int?
  result       Json?
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([tenantId])
}

// One attendance signal, worth points on the rolling 90-day score.
// Auto-written by the clock-out hook and the no-show sweep; a supervisor
// excusal zeroes the points at read time but keeps the record.
model AttendanceEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String         @db.Uuid
  shiftId     String?        @db.Uuid
  clientId    String?        @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String         @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind        AttendanceKind
  points      Decimal        @db.Decimal(4, 1)
  occurredOn  DateTime       @db.Date
  source      String         @default("AUTO") // AUTO | MANUAL
  note        String?
  excusedById String?        @db.Uuid
  excusedAt   DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  excusedBy User?     @relation("AttendanceExcuser", fields: [excusedById], references: [id], onDelete: SetNull)

  // One event per (shift, kind) — sweeps and clock-out hooks are idempotent.
  // NULL shiftIds (manual events) don't collide under Postgres semantics.
  @@unique([shiftId, kind])
  @@index([associateId, occurredOn])
  @@index([clientId, occurredOn])
  @@index([tenantId])
  @@index([tenantId, occurredOn])
}

// Finance worklist state: the associate has been registered in
// Fieldglass. Queue = approved+scheduled associates with NO row here;
// "Mark added" on the finance dashboard inserts one with attribution.
model FieldglassRegistration {
  associateId String   @id @db.Uuid
  // WHICH client the worker is registered under in Fieldglass — a
  // mismatch against their current open assignment's client marks a
  // pending transfer (close old account, open new one).
  clientId    String?  @db.Uuid
  addedById   String?  @db.Uuid
  addedAt     DateTime @default(now()) @db.Timestamptz(6)
  /// The Fieldglass Worker ID the buyer's system assigned ("WKR00012345") —
  /// what ties Alto's hours to the worker's Fieldglass account.
  workerId    String?  @db.VarChar(40)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  addedBy   User?     @relation("FieldglassRegistrar", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

/// One worker's Fieldglass timesheet for one Sat→Fri week at one client:
/// Alto's side (entered into Fieldglass, when, by whom, at how many hours)
/// and Fieldglass's side (its status, timesheet ID, revision and hours —
/// from the buyer's timesheet list, imported back). Approved is what the
/// buyer invoices; a rejection or a difference in hours is money at risk.
model FieldglassTimesheet {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The Saturday that starts the week (store-local).
  weekStart     DateTime  @db.Date
  associateId   String    @db.Uuid
  clientId      String    @db.Uuid
  enteredAt     DateTime? @db.Timestamptz(6)
  enteredById   String?   @db.Uuid
  /// Alto's approved hours when it was entered.
  enteredHours  Decimal?  @db.Decimal(8, 2)
  /// DRAFT | SUBMITTED | APPROVED | REJECTED | INVOICED (from the import).
  fgStatus      String?   @db.VarChar(20)
  fgTimesheetId String?   @db.VarChar(40)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  fgRevision    Int?
  fgHours       Decimal?  @db.Decimal(8, 2)
  fgSyncedAt    DateTime? @db.Timestamptz(6)
  /// The buyer's comment on the timesheet (a rejection reason), from the import.
  fgComment     String?   @db.VarChar(500)
  /// A rejected timesheet fixed and sent back in Fieldglass.
  resubmittedAt DateTime? @db.Timestamptz(6)
  /// Finance's own note on this week ("buyer asked for Sunday split").
  note          String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([weekStart, associateId, clientId])
  @@index([weekStart, clientId])
  @@index([associateId, weekStart])
  @@index([tenantId])
}

// The client in the loop: a portal user's structured ask — staffing,
// feedback, or an issue — that lands as a baton on the right desk and
// whose status the client watches change in their own portal. The
// resolution text is CLIENT-VISIBLE by design; internal discussion
// belongs on WorkNote threads, never here.
enum ClientRequestKind {
  STAFFING
  FEEDBACK
  ISSUE
  // A statement question or dispute — rings the Finance desk.
  BILLING
}

enum ClientRequestStatus {
  RECEIVED
  IN_PROGRESS
  RESOLVED
}

model ClientRequest {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String              @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String              @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind            ClientRequestKind
  subject         String
  body            String
  status          ClientRequestStatus @default(RECEIVED)
  createdByUserId String?             @db.Uuid
  resolvedById    String?             @db.Uuid
  resolution      String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime?           @db.Timestamptz(6)
  // The SLA clock the client sees: stamped at creation from the kind
  // (staffing 24h, issue 48h, billing 72h, feedback 5d).
  dueAt           DateTime?           @db.Timestamptz(6)
  // Who picked it up (IN_PROGRESS) — the named owner the client sees.
  startedById     String?             @db.Uuid
  startedAt       DateTime?           @db.Timestamptz(6)
  // The person the request is about (feedback / issue), picked from the
  // store's own roster — never free text Alto has to decode.
  associateId     String?             @db.Uuid
  // The store it was raised for (the author's store); null = client-wide.
  locationId      String?             @db.Uuid

  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location      Site?      @relation("ClientRequestStore", fields: [locationId], references: [id], onDelete: SetNull)
  associate     Associate? @relation("ClientRequestSubject", fields: [associateId], references: [id], onDelete: SetNull)
  createdByUser User?      @relation("ClientRequestAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy    User?      @relation("ClientRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  startedBy     User?      @relation("ClientRequestStarter", fields: [startedById], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([locationId])
  @@index([tenantId])
}

// One row per (account, alert key): a short-staffed wave rings each
// person once, however many sweeps see it and across midnight.
model PortalAlertLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  alertKey  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation("PortalAlertLogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, alertKey])
  @@index([createdAt])
  @@index([tenantId])
}

// The client's "reviewed" mark on a statement or a weekly service report
// — timestamped, attributed, one per document per client. Disputes then
// have a record on both sides.
enum ClientAcknowledgementKind {
  STATEMENT
  SERVICE_REPORT
}

// A region: the stores a Manager, Business Operations Support runs. Stores
// may sit under different clients and still share a region.
model Region {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(120)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  locations Site[]
  users     User[]   @relation("UserRegionScope")
  orgUnit   OrgUnit?

  @@index([deletedAt])
  @@index([tenantId])
}

// The in-app messenger: a store manager texts the supervisor on the
// floor and the thread is the record. Conversations are direct, small
// groups, or the STORE_CHANNEL every store gets (the store's portal
// accounts + Alto's supervisors bound to the client). Messages are
// immutable — append-only, never edited or deleted — so a dispute six
// weeks later has the trail. Who may message whom is a rule, not a
// directory (lib/messaging.ts); associates are never reachable here.
enum ConversationKind {
  DIRECT
  GROUP
  STORE_CHANNEL
}

enum MessageKind {
  TEXT
  SYSTEM
}

model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId      String           @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind          ConversationKind
  // Tenant scope: set for STORE_CHANNEL (and for any thread that
  // includes a client account), null for purely internal threads.
  clientId      String?          @db.Uuid
  locationId    String?          @db.Uuid
  title         String?          @db.VarChar(120)
  createdById   String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  lastMessageAt DateTime?        @db.Timestamptz(6)
  lastPreview   String?          @db.VarChar(160)
  /// F500 G5: a DIRECT thread's two user ids, sorted and joined by ":" — one
  /// direct thread per pair of people per tenant (two clicks made two). Null
  /// for groups and store channels.
  directKey     String?          @db.VarChar(80)

  client       Client?                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location     Site?                     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy    User?                     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@unique([tenantId, directKey])
  @@index([clientId, kind])
  @@index([lastMessageAt(sort: Desc)])
  @@index([tenantId])
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now()) @db.Timestamptz(6)
  lastReadAt     DateTime? @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String?     @db.Uuid
  /// AI disclosure: the agent (Worker id) that wrote this message (senderId is null), so the thread can badge it "AI".
  byAgentId      String?     @db.Uuid
  kind           MessageKind @default(TEXT)
  body           String      @db.VarChar(4000)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  attachmentKey  String?
  attachmentType String?     @db.VarChar(100)
  attachmentName String?     @db.VarChar(255)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([tenantId])
}

model ClientAcknowledgement {
  id         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String                    @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId   String                    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind       ClientAcknowledgementKind
  // STATEMENT → the statement id; SERVICE_REPORT → the org week start (YYYY-MM-DD).
  subjectKey String                    @db.VarChar(64)
  userId     String?                   @db.Uuid
  createdAt  DateTime                  @default(now()) @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([clientId, kind, subjectKey])
  @@index([tenantId])
}

// A seasonal wave: N heads for a client by a date. Lanes on the relay
// group under their cohort's banner with a readiness bar and countdown,
// so three buildings staff the wave against the same clock.
model Cohort {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name            String
  clientId        String?   @db.Uuid
  targetHeadcount Int
  landByDate      DateTime  @db.Date
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  archivedAt      DateTime? @db.Timestamptz(6)

  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("CohortCreator", fields: [createdById], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([archivedAt])
  @@index([tenantId])
}

// The thread on the work itself — staff notes attached to an object
// (today: an associate record), with desk @mentions that ring the other
// building. Kills the cross-department phone call: the question, the
// answer, and the decision live where the work lives, forever.
// subjectType/subjectKey are deliberately generic strings so a thread
// can later hang off a timesheet week or a baton without a migration.
model WorkNote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  subjectType  String
  subjectKey   String
  body         String
  authorUserId String?  @db.Uuid
  // Desk tokens mentioned on this note ('FINANCE' | 'HR' | 'WORKFORCE').
  mentions     String[] @default([])
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  // Decisions with receipts: a note can demand a ruling from ONE desk.
  // It sits as a baton on that desk until someone answers Approve /
  // Decline with a note — the permanent "who authorized this" record.
  decisionDesk   String?
  decisionStatus String? // 'PENDING' | 'APPROVED' | 'DECLINED'
  decidedById    String?   @db.Uuid
  decidedAt      DateTime? @db.Timestamptz(6)
  decisionNote   String?

  authorUser User? @relation("WorkNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  decidedBy  User? @relation("WorkNoteDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectKey, createdAt(sort: Desc)])
  @@index([decisionStatus, decisionDesk])
  @@index([tenantId])
}

/// The workstation's four desks — the board's three, plus Recruiting.
enum RelayDesk {
  HR
  RECRUITING
  WORKFORCE
  FINANCE
}

enum RelayRequestKind {
  ASK
  SEND
  TASK
}

enum RelayRequestStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

/// What one desk sends another: a question, a document, or a task. It
/// lands on the desk (or on one person there), anyone on that desk can
/// pick it up, and the thread keeps the answer where the next person
/// will look for it.
model RelayRequest {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String             @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  kind             RelayRequestKind
  status           RelayRequestStatus @default(OPEN)
  fromUserId       String             @db.Uuid
  toDesk           RelayDesk
  /// Set: it was addressed to one person, not the whole desk.
  toUserId         String?            @db.Uuid
  subject          String             @db.VarChar(200)
  body             String
  dueAt            DateTime?          @db.Timestamptz(6)
  /// The person it's about, when it is about someone.
  aboutAssociateId String?            @db.Uuid
  claimedById      String?            @db.Uuid
  answeredAt       DateTime?          @db.Timestamptz(6)
  closedAt         DateTime?          @db.Timestamptz(6)
  closedById       String?            @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)

  from      User           @relation("RelayRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser    User?          @relation("RelayRequestTo", fields: [toUserId], references: [id], onDelete: SetNull)
  claimedBy User?          @relation("RelayRequestClaimer", fields: [claimedById], references: [id], onDelete: SetNull)
  closedBy  User?          @relation("RelayRequestCloser", fields: [closedById], references: [id], onDelete: SetNull)
  about     Associate?     @relation("RelayRequestAbout", fields: [aboutAssociateId], references: [id], onDelete: SetNull)
  messages  RelayMessage[]
  files     RelayFile[]

  @@index([toDesk, status])
  @@index([toUserId, status])
  @@index([fromUserId])
  @@index([updatedAt(sort: Desc)])
  @@index([tenantId])
}

model RelayMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId    String   @db.Uuid
  authorUserId String?  @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId     String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  request RelayRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?        @relation("RelayMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  files   RelayFile[]

  @@index([requestId, createdAt])
  @@index([tenantId])
}

/// The working shelf: the forms, spreadsheets, photos and PDFs the desks
/// run on. NOT the associate's document vault (DocumentRecord) — that
/// keeps its own retention and verification rules.
model RelayFile {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String     @db.VarChar(200)
  /// Blob key (the same store the document vault writes to).
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId         String     @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  key              String
  mime             String     @db.VarChar(160)
  size             Int
  uploadedById     String?    @db.Uuid
  /// Whose shelf: a desk's, or everyone's when null.
  desk             RelayDesk?
  tags             String[]   @default([])
  aboutAssociateId String?    @db.Uuid
  requestId        String?    @db.Uuid
  messageId        String?    @db.Uuid
  deletedAt        DateTime?  @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)

  uploadedBy User?         @relation("RelayFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  about      Associate?    @relation("RelayFileAbout", fields: [aboutAssociateId], references: [id], onDelete: SetNull)
  request    RelayRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  message    RelayMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([desk])
  @@index([uploadedById])
  @@index([requestId])
  @@index([createdAt(sort: Desc)])
  @@index([tenantId])
}

/// Who holds a piece of the relay — a first-paycheck lane (subjectKey =
/// the associate), a baton (its key, "timesheets"), or a client request
/// (its id). One holder at a time; claiming it yourself or handing it to a
/// teammate replaces the holder, releasing clears it.
model RelayClaim {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// LANE | BATON | REQUEST
  subjectType String   @db.VarChar(20)
  subjectKey  String   @db.VarChar(80)
  userId      String   @db.Uuid
  /// Who put it in their hands — themselves, or whoever handed it over.
  claimedById String?  @db.Uuid
  claimedAt   DateTime @default(now()) @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String  @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user      User    @relation("RelayClaimHolder", fields: [userId], references: [id], onDelete: Cascade)
  claimedBy User?   @relation("RelayClaimAssigner", fields: [claimedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, subjectType, subjectKey])
  @@index([userId])
  @@index([tenantId])
}

// One row per (associate, week) so the OT radar's morning digest alerts a
// supervisor about a projected-overtime week exactly once.
model OtAlertStamp {
  associateId String   @db.Uuid
  weekStart   DateTime @db.Date
  notifiedAt  DateTime @default(now()) @db.Timestamptz(6)

  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@id([associateId, weekStart])
  @@index([tenantId])
}

// Monthly client billing/SLA statement. DRAFT recomputes freely as late
// approvals land; FINAL locks an immutable snapshot with the next
// sequential number — a statement must never change after the client has
// it. Totals and line items live in `snapshot`, frozen at finalize time.
model ClientStatement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String    @db.Uuid
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  // Assigned org-wide sequentially at finalize; null while DRAFT.
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  number         Int?
  status         String    @default("DRAFT") // DRAFT | FINAL
  snapshot       Json
  finalizedById  String?   @db.Uuid
  finalizedAt    DateTime? @db.Timestamptz(6)
  // Receivables: stamped when the client's payment lands. Null on a FINAL
  // statement = outstanding — the executive AR view ages it from
  // finalizedAt. paymentRef holds the check/ACH reference.
  paidAt         DateTime? @db.Timestamptz(6)
  paidById       String?   @db.Uuid
  paymentRef     String?
  // Invoicing: the PO this statement bills against (defaults to the
  // client's), when it falls due (finalizedAt + the client's terms), and
  // where the reminder cadence stands (0 none … 5 = 30 days past due).
  poNumber       String?   @db.VarChar(60)
  dueAt          DateTime? @db.Date
  reminderStage  Int       @default(0)
  lastReminderAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  client      Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  finalizedBy User?                     @relation("StatementFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  paidBy      User?                     @relation("StatementPaymentRecorder", fields: [paidById], references: [id], onDelete: SetNull)
  reminders   ClientStatementReminder[]

  @@unique([clientId, periodStart, periodEnd])
  @@index([clientId, status])
  @@index([status, dueAt])
  @@index([tenantId])
}

// One row per reminder the dunning cadence sent for a statement — the
// record Finance points at when a client says "nobody told us".
model ClientStatementReminder {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  statementId String          @db.Uuid
  // 1 = three days before due, 2 = due, 3 = 7 past, 4 = 14 past, 5 = 30 past.
  stage       Int
  sentAt      DateTime        @default(now()) @db.Timestamptz(6)
  recipients  Int             @default(0)
  statement   ClientStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, stage])
  @@index([tenantId])
}

/// Finance walk 7 (2026-10-21): the collections worklist's notes — a promise to pay
/// (with the date and amount promised), a call made, a note. Per client, optionally
/// on one statement. Append-only in practice: the worklist shows the latest.
model ClientCollectionNote {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  clientId        String    @db.Uuid
  statementId     String?   @db.Uuid
  /// PROMISE | CALL | NOTE
  kind            String    @default("NOTE") @db.VarChar(10)
  note            String    @db.VarChar(1000)
  promisedOn      DateTime? @db.Date
  promisedAmount  Decimal?  @db.Decimal(14, 2)
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenantId, clientId, createdAt(sort: Desc)])
  @@index([statementId])
}

// Quarterly executive targets — what "on plan" means. One row per
// quarter key ('2026-Q3'); admins (manage:org) set them, the executive
// dashboard and board pack show actual-vs-target pace.
model ExecTarget {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quarter           String   @db.VarChar(8)
  revenueTarget     Decimal? @db.Decimal(12, 2)
  marginTarget      Decimal? @db.Decimal(12, 2)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId          String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  headcountTarget   Int?
  turnoverPctTarget Decimal? @db.Decimal(5, 2)
  fillRatePctTarget Decimal? @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, quarter])
  @@index([tenantId])
}

// Per-client custom order for the scheduling grid's associate rows —
// the supervisor's whiteboard order (leads first, openers together…),
// SHARED by everyone who schedules that client. Associates without a
// row sort after the positioned ones, alphabetically, so new hires
// join at the bottom until placed.
model SchedulingRosterOrder {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String?  @db.Uuid
  associateId String   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  position    Int
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([clientId, associateId])
  @@index([clientId, position])
  @@index([tenantId])
}

// State overlay for the chairman's decision queue. Decisions themselves
// are GENERATED from live data (lib/executiveDecisions.ts) under stable
// keys; this table stores only what a human did about one — dismissed,
// snoozed, or delegated. A decision auto-clears when its condition
// resolves (the generator stops emitting it); a DISMISSED one re-raises
// if the stakes grow materially past what was dismissed.
model ExecDecisionState {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String    @db.VarChar(120)
  status         String    @db.VarChar(12) // DISMISSED | SNOOZED | DELEGATED
  snoozeUntil    DateTime? @db.Timestamptz(6)
  // Dollar stakes at the moment of dismissal — the re-raise baseline.
  stakesAtAction Decimal?  @db.Decimal(12, 2)
  actedById      String?   @db.Uuid
  actedAt        DateTime  @default(now()) @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  note           String?
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Collaboration overlay for the role decision queues: who has TAKEN an
// item ("I've got this"), so teammates sharing the same queue scope
// don't double-work it, and whether it was escalated upward. Keys are
// scope-aware (client-clamped items carry the clientId), and rows are
// cleaned up lazily — a claim on a resolved item simply never renders.
model DecisionClaim {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String    @db.VarChar(160)
  claimedById    String    @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId       String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  claimedBy      User      @relation("DecisionClaimer", fields: [claimedById], references: [id], onDelete: Cascade)
  claimedAt      DateTime  @default(now()) @db.Timestamptz(6)
  // Set when the item was ASSIGNED to claimedBy by someone else (vs
  // self-claimed) — the assigner keeps reassign rights.
  assignedById   String?   @db.Uuid
  // Postponed items are hidden from every queue until this instant.
  postponedUntil DateTime? @db.Timestamptz(6)
  note           String?
  escalatedAt    DateTime? @db.Timestamptz(6)
  escalatedById  String?   @db.Uuid
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// The flight-director rule: a room is never just chat — it carries ONE
// agreed next step with an owner. Echoed onto the queue rows; cleared
// when the item resolves (the row is keyed to the item and simply stops
// rendering).
model DecisionNextStep {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String    @db.VarChar(160)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  text      String
  ownerId   String?   @db.Uuid
  owner     User?     @relation("NextStepOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueDay    DateTime? @db.Date
  setById   String    @db.Uuid
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// The item's conversation — comments live ON the decision key, visible
// to everyone whose queue shows that item (Ops, Finance, the chairman),
// so cross-functional work happens in one room instead of notification
// ping-pong. Rows outlive claims: the thread is the item's memory.
model DecisionComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @db.VarChar(160)
  userId    String   @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId  String   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user      User     @relation("DecisionCommenter", fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([key, createdAt])
  @@index([tenantId])
}

// Personal day/week planner — each user's own list, mixing queue items
// they pulled in ("Add to my day") with free-form tasks they typed.
model WorkPlanItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  user        User      @relation("WorkPlanOwner", fields: [userId], references: [id], onDelete: Cascade)
  day         DateTime  @db.Date
  title       String
  decisionKey String?   @db.VarChar(160)
  linkUrl     String?
  doneAt      DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@index([userId, day])
  @@index([tenantId])
}

enum ProspectStage {
  LEAD
  CONTACTED
  PROPOSAL
  VERBAL
  WON
  LOST
}

// New-business pipeline — the diversification answer to single-client
// concentration. A prospect is not a Client: it becomes one only on WON,
// by the normal client-creation flow, and then points at the client it
// became (wonClientId).
model ClientProspect {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId          String        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name              String
  stage             ProspectStage @default(LEAD)
  estWeeklyHours    Int?
  estBillRate       Decimal?      @db.Decimal(8, 2)
  notes             String?
  /// Who on our side is working this prospect.
  ownerUserId       String?       @db.Uuid
  owner             User?         @relation("ClientProspectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// When the work would start if it is won (a calendar day).
  expectedStartDate DateTime?     @db.Date
  contactName       String?       @db.VarChar(120)
  contactEmail      String?       @db.VarChar(254)
  /// Why it was lost; required on the move to LOST.
  lostReason        String?       @db.VarChar(500)
  /// The client this prospect became on WON.
  wonClientId       String?       @db.Uuid
  wonClient         Client?       @relation("ClientProspectWon", fields: [wonClientId], references: [id], onDelete: SetNull)
  /// When the stage last changed — "days in stage" on the board.
  stageChangedAt    DateTime      @default(now()) @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?     @db.Timestamptz(6)

  @@index([stage])
  @@index([tenantId])
  @@index([ownerUserId])
  @@index([wonClientId])
}

enum ClockInRequestStatus {
  PENDING // waiting on a supervisor's decision
  APPROVED // decision created a backdated ACTIVE time entry
  DENIED // turned away; no entry created
}

// A kiosk clock-in the schedule gate refused (associate not on the
// schedule) — parked here for a supervisor to approve or deny, mirroring
// the shift-swap decision flow. Approval clocks the associate in from the
// ORIGINAL punch instant so waiting on the decision never shorts them.
model ClockInRequest {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String               @db.Uuid
  clientId    String?              @db.Uuid
  locationId  String?              @db.Uuid
  // The refused punch instant — what an approval backdates the entry to.
  requestedAt DateTime             @db.Timestamptz(6)
  status      ClockInRequestStatus @default(PENDING)
  decidedById String?              @db.Uuid
  decidedAt   DateTime?            @db.Timestamptz(6)
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String               @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  denyReason  String?
  // The entry an approval created, for the audit trail.
  timeEntryId String?              @db.Uuid
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("ClockInRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([associateId, status])
  @@index([clientId, status])
  @@index([tenantId])
}

model AssociateAssignment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  associateId String    @db.Uuid
  locationId  String    @db.Uuid
  startedAt   DateTime  @db.Date
  endedAt     DateTime? @db.Date
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  reason      String?
  notedById   String?   @db.Uuid
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Restrict)
  location  Site      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  notedBy   User?     @relation("AssociateAssignmentNoter", fields: [notedById], references: [id], onDelete: SetNull)

  @@index([associateId, endedAt])
  @@index([locationId, startedAt])
  @@index([locationId, endedAt])
  @@index([tenantId])
}

model Associate {
  /// Agent families step 4: the Compliance agent's chases of this person's expiring documents.
  documentChases          DocumentChase[]
  /// Agent families step 2: the attendance.confirm asks this person received.
  attendanceConfirmations AttendanceConfirmation[]
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Brief 2-1: the tenant this row belongs to. Required; the database default (Alto HR) fills a row written outside any tenant context.
  tenantId                String                   @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  firstName               String
  lastName                String
  // E-Verify / Form I-9 Section 1 identity fields. Both are optional on the
  // federal form but asked for, and without them the verifier hand-types
  // them into the portal every time. otherLastNames is a Postgres text
  // array — E-Verify collects prior surnames as a repeatable list, and an
  // array matches that without a join table for what is usually 0-2 values.
  middleInitial           String?                  @db.VarChar(1)
  otherLastNames          String[]                 @default([])
  dob                     DateTime?                @db.Date
  email                   String
  phone                   String?
  ssnLast4                String?                  @db.VarChar(4)
  /// Last 4 of a passport / travel document number — the Fieldglass
  /// Security ID's fallback for a worker with no SSN.
  travelDocLast4          String?                  @db.VarChar(4)
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?                  @db.VarChar(2)
  zip                     String?                  @db.VarChar(10)
  j1Status                Boolean                  @default(false)
  // Phase 41 — W-2 vs 1099. Default W2 keeps every existing record's
  // payroll math identical; 1099 records skip W-4 / FICA / Medicare.
  employmentType          EmploymentType           @default(W2_EMPLOYEE)
  // Gap 11 — Recipient TIN for Form 1099-NEC. SSN for
  // CONTRACTOR_1099_INDIVIDUAL, EIN for CONTRACTOR_1099_BUSINESS.
  // Encrypted at rest with the same PAYOUT_ENCRYPTION_KEY scheme as
  // W4Submission.ssnEncrypted. Null for W-2 employees (their SSN
  // lives on W4Submission). Surfaces as `missing_tin` 400 in the
  // 1099-NEC PDF + IRS-FIRE routes when null.
  tinEncrypted            Bytes?
  // Phase 76 — org hierarchy. All four are nullable: existing rows
  // continue to work with NULLs and HR fills them in over time. The
  // managerId self-reference enables direct-reports queries.
  managerId               String?                  @db.Uuid
  departmentId            String?                  @db.Uuid
  costCenterId            String?                  @db.Uuid
  /// Brief 2-1b step 5: the home unit (the cost center folded into the tree).
  orgUnitId               String?                  @db.Uuid
  jobProfileId            String?                  @db.Uuid
  // Wave 1.1 — pay schedule assignment. Drives the payroll run wizard's
  // "next period to run" calculation and determines pay frequency for
  // tax annualization. NULL = legacy associates that haven't been
  // assigned to a schedule yet (treated as biweekly default until set).
  payrollScheduleId       String?                  @db.Uuid
  // Stamped when HR approves the associate's onboarding application
  // (POST /onboarding/applications/:id/approve). The date HR enters in
  // the approve dialog — distinct from Application.startDate (the
  // *planned* start at invitation time, which can differ if HR changes
  // their mind during review).
  hireDate                DateTime?                @db.Date
  wagePayNotices          WagePayNotice[]
  newHireReports          NewHireReport[]
  // Tier-1 — when this hire was reported to the state new-hire directory
  // (federally required within ~20 days of hire). Null = not yet
  // reported; the new-hire report endpoints surface and stamp this.
  newHireReportedAt       DateTime?                @db.Timestamptz(6)
  // Tier-2 — city/county withholding rule for this associate (null =
  // no local tax). Withheld into PayrollItem.localWithholding.
  localTaxRuleId          String?                  @db.Uuid
  localTaxRule            LocalTaxRule?            @relation(fields: [localTaxRuleId], references: [id], onDelete: SetNull)
  // Tier-3 — workers-comp classification for the premium accrual report.
  wcClassCodeId           String?                  @db.Uuid
  wcClassCode             WcClassCode?             @relation(fields: [wcClassCodeId], references: [id], onDelete: SetNull)
  // Profile photo. photoS3Key is the storage path under uploads/profile-photos/;
  // photoUpdatedAt is the cache-buster the API stamps onto the photo URL so
  // the browser refetches after an upload. Null when no photo on file —
  // Avatar then falls back to initials.
  photoS3Key              String?
  photoUpdatedAt          DateTime?                @db.Timestamptz(6)
  // Kiosk face-verification consent (BIPA-style biometric laws require
  // affirmative consent BEFORE collecting face geometry). NULL = never
  // asked — the kiosk shows a one-time consent screen after the first
  // successful PIN entry. DECLINED associates punch PIN-only: no
  // selfie, no descriptor, ever.
  faceConsentStatus       FaceConsentStatus?
  faceConsentAt           DateTime?                @db.Timestamptz(6)
  // iCal feed revocation. The feed token is HMAC(secret, associateId
  // [+ ":v" + version]), so bumping this number invalidates ONE
  // associate's leaked calendar URL without rotating the global
  // CALENDAR_FEED_SECRET (which would break every subscription).
  // 1 = the original pre-version token format, so URLs minted before
  // this column existed keep verifying.
  calendarFeedVersion     Int                      @default(1)
  // Privacy erasure (admin-initiated, lib/erasure.ts). Set exactly once —
  // identity fields are anonymized in place while payroll/tax history rows
  // stay untouched (IRS 4-year / FLSA 3-year retention). erasedById is the
  // admin who ran it; the written reason + per-category scrub counts live
  // on the privacy.associate_erased AuditLog row.
  // Stamped when a Separation completes (cleared on rehire re-invite).
  // Drives the directory's INACTIVE status — without it, "Active" derived
  // purely from "has an approved application" and separated associates
  // stayed active forever.
  separatedAt             DateTime?                @db.Timestamptz(6)
  // Manual pause — "Deactivate" on the People profile. Distinct from a
  // completed Separation (formal offboarding): a deactivated associate is
  // expected back, and Reactivate restores them in one click with their
  // whole record (I-9, E-Verify, banking, training, kiosk PIN) intact.
  // While set: login DISABLED (same transaction), kiosk punches that
  // would open a new entry rejected, excluded from the schedulable pool,
  // directory shows INACTIVE.
  deactivatedAt           DateTime?                @db.Timestamptz(6)
  deactivatedById         String?                  @db.Uuid
  deactivatedBy           User?                    @relation("AssociateDeactivator", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivationReason      String?
  erasedAt                DateTime?                @db.Timestamptz(6)
  erasedById              String?                  @db.Uuid
  erasedBy                User?                    @relation("AssociateEraser", fields: [erasedById], references: [id], onDelete: SetNull)
  // Onboarding purge final notice (lib/onboardingPurge.ts). Stamped when
  // the "your onboarding will be removed in 48 hours" email goes out to an
  // accepted-but-abandoned onboarder; any later onboarding activity makes
  // the stamp stale (activity > stamp), which re-arms a fresh warning
  // before any purge. Never set for people with work history — the sweep's
  // guards exclude them entirely.
  purgeWarnedAt           DateTime?                @db.Timestamptz(6)
  // Dormancy sweep (lib/dormancySweep.ts). dormancyWarnedAt stamps the
  // admin heads-up ("inactive, auto-deactivation in ~7 days"); any later
  // activity makes the stamp stale (activity > stamp), which re-arms a
  // fresh warning before any auto-deactivation — nobody is deactivated
  // un-warned. reactivatedAt stamps each Reactivate so a just-restored
  // associate gets a full fresh dormancy window instead of being swept
  // again the same night (their last clock-in may be months old).
  dormancyWarnedAt        DateTime?                @db.Timestamptz(6)
  reactivatedAt           DateTime?                @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime?                @db.Timestamptz(6)

  user                     User?
