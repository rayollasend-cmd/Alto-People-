  document        DocumentRecord?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  esignAgreements EsignAgreement[]
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  @@index([checklistId])
  @@index([status])
  @@index([tenantId])
}

