  planId         String   @db.Uuid
  associateId    String   @db.Uuid
  payrollRunId   String   @db.Uuid
  payrollItemId  String?  @db.Uuid
  payDate        DateTime @db.Date
  eligibleComp   Decimal  @default(0) @db.Decimal(12, 2)
  preTax         Decimal  @default(0) @db.Decimal(10, 2)
  roth           Decimal  @default(0) @db.Decimal(10, 2)
  catchUpPreTax  Decimal  @default(0) @db.Decimal(10, 2)
  catchUpRoth    Decimal  @default(0) @db.Decimal(10, 2)
