/// One record kept in step with QuickBooks. owner: SITE (made here) | QUICKBOOKS (made there).
/// localType: LedgerAccount | Vendor | Client | Site | Department | JournalEntry | Bill | BillPayment | ClientStatement | ClientPayment.
model QboSyncLink {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  localType    String    @db.VarChar(24)
  localId      String    @db.Uuid
  qboType      String    @db.VarChar(24)
  qboId        String    @db.VarChar(40)
  syncToken    String?   @db.VarChar(20)
  owner        String    @db.VarChar(12)
  /// A hash of the fields last agreed on both sides — an edit on either side changes it.
  localHash    String?   @db.VarChar(64)
  remoteHash   String?   @db.VarChar(64)
  lastSyncedAt DateTime? @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, localType, localId])
  @@unique([tenantId, qboType, qboId])
