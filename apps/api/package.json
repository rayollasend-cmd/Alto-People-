{
  "name": "@alto-people/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate",
    "build": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.json",
    "prestart": "prisma migrate deploy",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:analytics": "tsx scripts/seed-demo-analytics.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:studio": "prisma studio",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.json --noEmit && node ../../node_modules/typescript-native/bin/tsc -p tsconfig.test.json && node ../../node_modules/typescript-native/bin/tsc -p tsconfig.scripts.json",
    "typecheck:test": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.test.json",
    "lint": "eslint src"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@alto-people/shared": "*",
    "@anthropic-ai/sdk": "^0.135.0",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/lib-storage": "^3.1066.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@types/multer": "^2.1.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "fontkit": "^2.0.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-forge": "^1.4.0",
    "otplib": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "ssh2-sftp-client": "^12.1.1",
    "tar": "^7.5.16",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@eslint/js": "^10.0.1",
    "@sentry/node": "^11.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/archiver": "^8.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fontkit": "^2.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.13.6",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/tar": "^6.1.13",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/ui": "^4.1.12",
    "archiver": "^8.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
